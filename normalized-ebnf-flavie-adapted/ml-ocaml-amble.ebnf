N("Boolean") ::= ("true" | "false");
N("String") ::= value("string");
N("Integer") ::= value("int");
N("Element") ::= N("Program");
N("Element") ::= N("Process");
N("Element") ::= N("State");
N("Element") ::= N("Guard");
N("Element") ::= N("Action");
N("Element") ::= N("Network");
N("Element") ::= N("Channel");
N("Element") ::= N("Message");
N("Element") ::= N("Variable");
N("Program") ::= ((select("processes", N("Process")))+ (select("networks", N("Network")))+);
N("Process") ::= (select("minId", N("Integer")) select("maxId", N("Integer")) select("instancesNb", N("Integer")) (select("states", N("State")))+ (select("transitions", N("Transition")))+ select("initial", N("Action")) (select("variables", N("Variable")))+ (select("connectedTo", N("Network")))+);
N("State") ::= (select("isInitial", N("Boolean")) (select("incoming", N("Transition")))+ (select("outgoing", N("Transition")))+);
N("Transition") ::= N("Trans");
N("Transition") ::= N("Strans");
N("Transition") ::= N("Transall");
N("Trans") ::= select("waitFor", N("Message"));
N("Strans") ::= (select("guard", N("Guard")) select("action", N("Action")) select("source", N("State")) select("target", N("State")));
N("Transall") ::= select("waitFor", N("Message"));
N("Guard") ::= (select("name", N("String")));
N("Action") ::= (select("name", N("String")));
N("Network") ::= (select("channels", N("Channel")))+;
N("Channel") ::= ((select("messages", N("Message")))+ select("source", N("Process")) select("target", N("Process")));
N("Message") ::= (select("name", N("String")));
N("Variable") ::= (select("type", N("String")) select("initValue", N("String")));
