tant") ":"))+ "PROCEDURE" [("(" sep+(N("parameter"), ",") ")")] [("RETURNS" "(" (N("attribute"))+ ")")] [("OPTIONS" "(" N("characteristic-list") ")")] [("REDUCIBLE" | "IRREDUCIBLE")] ["RECURSIVE"] [("ORDER" | "REORDER")] [("CHARGRAPHIC" | "NOCHARGRAPHIC")] ";") | ("WAIT" "(" sep+(N("event-reference"), ",") ")" [("(" N("expression") ")")] ";") | ("STOP" ";") | ("SELECT" [("(" N("exp1") ")")] ";" (("WHEN" "(" sep+(N("exp2"), ",") ")" N("unit")))* [("OTHERWISE" N("unit"))]) | ";" | ("LEAVE" [N("label-constant")] ";") | ("IF" N("expression") "THEN" N("unit1") [("ELSE" N("unit2"))]) | ((("GO" "TO") | "GOTO") N("label_reference") ";") | ("END" [N("statement-label")] ";") | ("DO" N("reference") "=" sep+(N("specification"), ",") ";") | ("DO" (("WHILE" "(" N("exp4") ")" [("UNTIL" "(" N("exp5") ")")]) | ("UNTIL" "(" N("exp5") ")" [("WHILE" "(" N("exp4") ")")])) ";") | ("DO" ";") | ("DISPLAY" "(" N("expression") ")" (("REPLY" "(" N("character_reference") ")" [("EVENT" "(" N("event_reference") ")")]) | ("EVENT" "(" N("event_reference") ")" N("reply") "(" N("character_reference") ")")) ";") | ("DISPLAY" "(" N("expression") ")" ";") | ("DELAY" "(" N("expression") ")" ";") | (sep+(N("reference"), ",") "=" N("expression") [("," "BY" "NAME")] ";") | ("FREE" sep+(N("option"), ",") ";") | ("ALLOCATE" sep+((N("based_variable") [N("reference")]), ",") ";") | ("FREE" sep+(N("controlled-variable"), ",") ";") | ("ALLOCATE" sep+(([N("level")] N("controlled-variable") [N("attribute")]), ",")) | ("RELEASE" (N("entry-constant"))+ ";") | ("BEGIN" [("ORDER" | "REORDER")] [("CHARGRAPHIC" | "NOCHARGRAPHIC")] ";") | ("DECLARE" sep+(([N("level")] N("name") (N("attribute"))* ["SYSTEM"]), ",") ";") | ("DEFAULT" sep+((N("simple_specification") | N("factored_specification")), ",") ";"));
N("statement-simple-specification") ::= (("RANGE" "(" (((N("letter"))+ | (N("letter") ":" N("letter"))))+ ")" [N("attribute_specification")]) | ("RANGE" "(" "*" ")" [N("attribute_specification")]) | ("DESCRIPTORS" [N("attribute_specifications")]));
