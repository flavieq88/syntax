@root N("top_level");

N("top_level") ::= (((N("statement") | N("expression")))* N("EOF"));
N("statement") ::= ((N("expression") [";"]) | (N("declaration") [";"]) | (N("loop_statement") [";"]) | (N("branch_statement") [";"]) | N("labeled_statement") | (N("control_transfer_statement") [";"]));
N("statements") ::= (N("statement"))+;
N("loop_statement") ::= (N("for_statement") | N("for_in_statement") | N("while_statement") | N("do_while_statement"));
N("for_statement") ::= (("for" [N("for_init")] ";" [N("expression")] ";" [N("expression")] N("code_block")) | ("for" ([N("for_init")] ";" [N("expression")] ";" [N("expression")]) N("code_block")));
N("for_init") ::= (N("variable_declaration") | N("expression_list"));
N("for_in_statement") ::= ("for" N("pattern") "in" N("expression") N("code_block"));
N("while_statement") ::= ("while" N("while_condition") N("code_block"));
N("while_condition") ::= (N("expression") | N("declaration"));
N("do_while_statement") ::= ("do" N("code_block") "while" N("while_condition"));
N("branch_statement") ::= (N("if_statement") | N("switch_statement"));
N("if_statement") ::= ("if" N("if_condition") N("code_block") [N("else_clause")]);
N("if_condition") ::= (N("expression") | N("declaration"));
N("else_clause") ::= (("else" N("code_block")) | ("else" N("if_statement")));
N("switch_statement") ::= ("switch" N("expression") "{" [N("switch_cases")] "}");
N("switch_cases") ::= (N("switch_case") [N("switch_cases")]);
N("switch_case") ::= ((N("case_label") N("statements")) | (N("default_label") N("statements")) | (N("case_label") ";") | (N("default_label") ";"));
N("case_label") ::= ("case" N("case_item_list") ":");
N("case_item_list") ::= (N("pattern") [N("guard_clause")] N("pattern") [N("guard_clause")] "," N("case_item_list"));
N("default_label") ::= ("default" ":");
N("guard_clause") ::= ("where" N("guard_expression"));
N("guard_expression") ::= N("expression");
N("labeled_statement") ::= ((N("statement_label") N("loop_statement")) | (N("statement_label") N("switch_statement")));
N("statement_label") ::= (N("label_name") ":");
N("label_name") ::= N("identifier");
N("control_transfer_statement") ::= (N("break_statement") | N("continue_statement") | N("fallthrough_statement") | N("return_statement"));
N("break_statement") ::= ("break" [N("label_name")]);
N("continue_statement") ::= ("continue" [N("label_name")]);
N("fallthrough_statement") ::= "fallthrough";
N("return_statement") ::= ("return" [N("expression")]);
N("generic_parameter_clause") ::= ("<" N("generic_parameter_list") [N("requirement_clause")] ">");
N("generic_parameter_list") ::= (N("generic_parameter") | (N("generic_parameter") "," N("generic_parameter_list")));
N("generic_parameter") ::= (N("type_name") | (N("type_name") ":" N("type_identifier")) | (N("type_name") ":" N("protocol_composition_type")));
N("requirement_clause") ::= ("where" N("requirement_list"));
N("requirement_list") ::= (N("requirement") | (N("requirement") "," N("requirement_list")));
N("requirement") ::= (N("conformance_requirement") | N("same_type_requirement"));
N("conformance_requirement") ::= ((N("type_identifier") ":" N("type_identifier")) | (N("type_identifier") ":" N("protocol_composition_type")));
N("same_type_requirement") ::= (N("type_identifier") "==" N("type_identifier"));
N("generic_argument_clause") ::= ("<" N("generic_argument_list") ">");
N("generic_argument_list") ::= (N("generic_argument") (("," N("generic_argument")))*);
N("generic_argument") ::= N("type");
N("declaration") ::= (N("import_declaration") | N("constant_declaration") | N("variable_declaration") | N("typealias_declaration") | N("function_declaration") | N("enum_declaration") | N("struct_declaration") | N("class_declaration") | N("protocol_declaration") | N("initializer_declaration") | N("deinitializer_declaration") | N("extension_declaration") | N("subscript_declaration") | N("operator_declaration"));
N("declarations") ::= (N("declaration") [N("declarations")]);
N("declaration_specifiers") ::= (N("declaration_specifier") [N("declaration_specifiers")]);
N("declaration_specifier") ::= ("class" | "mutating" | "nonmutating" | "override" | "static" | "unowned" | "unowned(safe)" | "unowned(unsafe)" | "weak");
N("code_block") ::= ("{" [N("statements")] "}");
N("import_declaration") ::= ([N("attributes")] "import" [N("import_kind")] N("import_path"));
N("import_kind") ::= ("typealias" | "struct" | "class" | "enum" | "protocol" | "var" | "func");
N("import_path") ::= (N("import_path_identifier") | (N("import_path_identifier") "." N("import_path")));
N("import_path_identifier") ::= (N("identifier") | N("operator"));
N("constant_declaration") ::= ([N("attributes")] [N("declaration_specifiers")] "let" N("pattern_initializer_list"));
N("pattern_initializer_list") ::= (N("pattern_initializer") (("," N("pattern_initializer")))*);
N("pattern_initializer") ::= (N("pattern") [N("initializer")]);
N("initializer") ::= ("=" N("expression"));
N("variable_declaration") ::= ((N("variable_declaration_head") N("pattern_initializer_list")) | (N("variable_declaration_head") N("variable_name") N("type_annotation") N("code_block")) | (N("variable_declaration_head") N("variable_name") N("type_annotation") N("getter_setter_block")) | (N("variable_declaration_head") N("variable_name") N("type_annotation") N("getter_setter_keyword_block")) | (N("variable_declaration_head") N("variable_name") N("type_annotation") [N("initializer")] N("willSet_didSet_block")));
N("variable_declaration_head") ::= ([N("attributes")] [N("declaration_specifiers")] "var");
N("variable_name") ::= N("identifier");
N("getter_setter_block") ::= (("{" N("getter_clause") [N("setter_clause")] "}") | ("{" N("setter_clause") N("getter_clause") "}"));
N("getter_clause") ::= ([N("attributes")] "get" N("code_block"));
N("setter_clause") ::= ([N("attributes")] "set" [N("setter_name")] N("code_block"));
N("setter_name") ::= N("identifier");
N("getter_setter_keyword_block") ::= (("{" N("getter_keyword_clause") [N("setter_keyword_clause")] "}") | ("{" N("setter_keyword_clause") N("getter_keyword_clause") "}"));
N("getter_keyword_clause") ::= ([N("attributes")] "get");
N("setter_keyword_clause") ::= ([N("attributes")] "set");
N("willSet_didSet_block") ::= (("{" N("willSet_clause") [N("didSet_clause")] "}") | ("{" N("didSet_clause") N("willSet_clause") "}"));
N("willSet_clause") ::= ([N("attributes")] "willSet" [N("setter_name")] N("code_block"));
N("didSet_clause") ::= ([N("attributes")] "didSet" [N("setter_name")] N("code_block"));
N("typealias_declaration") ::= (N("typealias_head") N("typealias_assignment"));
N("typealias_head") ::= ("typealias" N("typealias_name"));
N("typealias_name") ::= N("identifier");
N("typealias_assignment") ::= ("=" N("type"));
N("function_declaration") ::= (N("function_head") N("function_name") [N("generic_parameter_clause")] N("function_signature") N("function_body"));
N("function_head") ::= ([N("attributes")] [N("declaration_specifiers")] "func");
N("function_name") ::= (N("identifier") | N("operator"));
N("function_signature") ::= (N("parameter_clauses") [N("function_result")]);
N("function_result") ::= ("->" [N("attributes")] N("type"));
N("function_body") ::= N("code_block");
N("parameter_clauses") ::= (N("parameter_clause") [N("parameter_clauses")]);
N("parameter_clause") ::= (("(" ")") | ("(" N("parameter_list") ["..."] ")"));
N("parameter_list") ::= (N("parameter") | (N("parameter") "," N("parameter_list")));
N("parameter") ::= ((["inout"] ["let"] ["#"] N("parameter_name") [N("local_parameter_name")] N("type_annotation") [N("default_argument_clause")]) | (["inout"] "var" ["#"] N("parameter_name") [N("local_parameter_name")] N("type_annotation") [N("default_argument_clause")]) | ([N("attributes")] N("type")));
N("parameter_name") ::= (N("identifier") | "_");
N("local_parameter_name") ::= (N("identifier") | "_");
N("default_argument_clause") ::= ("=" N("expression"));
N("enum_declaration") ::= (([N("attributes")] N("union_style_enum")) | ([N("attributes")] N("raw_value_style_enum")));
N("union_style_enum") ::= (N("enum_name") [N("generic_parameter_clause")] "{" [N("union_style_enum_members")] "}");
N("union_style_enum_members") ::= (N("union_style_enum_member") [N("union_style_enum_members")]);
N("union_style_enum_member") ::= (N("declaration") | N("union_style_enum_case_clause"));
N("union_style_enum_case_clause") ::= ([N("attributes")] "case" N("union_style_enum_case_list"));
N("union_style_enum_case_list") ::= (N("union_style_enum_case") | (N("union_style_enum_case") "," N("union_style_enum_case_list")));
N("union_style_enum_case") ::= (N("enum_case_name") [N("tuple_type")]);
N("enum_name") ::= N("identifier");
N("enum_case_name") ::= N("identifier");
N("raw_value_style_enum") ::= (N("enum_name") [N("generic_parameter_clause")] ":" N("type_identifier") "{" [N("raw_value_style_enum_members")] "}");
N("raw_value_style_enum_members") ::= (N("raw_value_style_enum_member") [N("raw_value_style_enum_members")]);
N("raw_value_style_enum_member") ::= (N("declaration") | N("raw_value_style_enum_case_clause"));
N("raw_value_style_enum_case_clause") ::= ([N("attributes")] "case" N("raw_value_style_enum_case_list"));
N("raw_value_style_enum_case_list") ::= (N("raw_value_style_enum_case") | (N("raw_value_style_enum_case") "," N("raw_value_style_enum_case_list")));
N("raw_value_style_enum_case") ::= (N("enum_case_name") [N("raw_value_assignment")]);
N("raw_value_assignment") ::= ("=" N("literal"));
N("struct_declaration") ::= ([N("attributes")] "struct" N("struct_name") [N("generic_parameter_clause")] [N("type_inheritance_clause")] N("struct_body"));
N("struct_name") ::= N("identifier");
N("struct_body") ::= ("{" [N("declarations")] "}");
N("class_declaration") ::= ([N("attributes")] "class" N("class_name") [N("generic_parameter_clause")] [N("type_inheritance_clause")] N("class_body"));
N("class_name") ::= N("identifier");
N("class_body") ::= ("{" [N("declarations")] "}");
N("protocol_declaration") ::= ([N("attributes")] "protocol" N("protocol_name") [N("type_inheritance_clause")] N("protocol_body"));
N("protocol_name") ::= N("identifier");
N("protocol_body") ::= ("{" [N("protocol_member_declarations")] "}");
N("protocol_member_declaration") ::= (N("protocol_property_declaration") | N("protocol_method_declaration") | N("protocol_initializer_declaration") | N("protocol_subscript_declaration") | N("protocol_associated_type_declaration"));
N("protocol_member_declarations") ::= (N("protocol_member_declaration") [N("protocol_member_declarations")]);
N("protocol_property_declaration") ::= (N("variable_declaration_head") N("variable_name") N("type_annotation") N("getter_setter_keyword_block"));
N("protocol_method_declaration") ::= (N("function_head") N("function_name") [N("generic_parameter_clause")] N("function_signature"));
N("protocol_initializer_declaration") ::= (N("initializer_head") [N("generic_parameter_clause")] N("parameter_clause"));
N("protocol_subscript_declaration") ::= (N("subscript_head") N("subscript_result") N("getter_setter_keyword_block"));
N("protocol_associated_type_declaration") ::= (N("typealias_head") [N("type_inheritance_clause")] [N("typealias_assignment")]);
N("initializer_declaration") ::= (N("initializer_head") [N("generic_parameter_clause")] N("parameter_clause") N("initializer_body"));
N("initializer_head") ::= ([N("attributes")] ["convenience"] "init");
N("initializer_body") ::= N("code_block");
N("deinitializer_declaration") ::= ([N("attributes")] "deinit" N("code_block"));
N("extension_declaration") ::= ("extension" N("type_identifier") [N("type_inheritance_clause")] N("extension_body"));
N("extension_body") ::= ("{" [N("declarations")] "}");
N("subscript_declaration") ::= ((N("subscript_head") N("subscript_result") N("code_block")) | (N("subscript_head") N("subscript_result") N("getter_setter_block")) | (N("subscript_head") N("subscript_result") N("getter_setter_keyword_block")));
N("subscript_head") ::= ([N("attributes")] "subscript" N("parameter_clause"));
N("subscript_result") ::= ("->" [N("attributes")] N("type"));
N("operator_declaration") ::= (N("prefix_operator_declaration") | N("postfix_operator_declaration") | N("infix_operator_declaration"));
N("prefix_operator_declaration") ::= ("operator" "prefix" "operator" "{" "}");
N("postfix_operator_declaration") ::= ("operator" "postfix" "operator" "{" "}");
N("infix_operator_declaration") ::= ("operator" "infix" "operator" "{" N("infix_operator_attributes") "}");
N("infix_operator_attributes") ::= ([N("precedence_clause")] [N("associativity_clause")]);
N("precedence_clause") ::= ("precedence" N("precedence_level"));
N("precedence_level") ::= N("integer_literal");
N("associativity_clause") ::= ("associativity" N("associativity"));
N("associativity") ::= ("left" | "right" | "none");
N("pattern") ::= ((N("wildcard_pattern") [N("type_annotation")]) | (N("identifier_pattern") [N("type_annotation")]) | N("value_binding_pattern") | (N("tuple_pattern") [N("type_annotation")]) | N("enum_case_pattern") | ("is" N("type")) | (N("pattern") "as" N("type")) | N("expression_pattern"));
N("wildcard_pattern") ::= "_";
N("identifier_pattern") ::= N("identifier");
N("value_binding_pattern") ::= (("var" N("pattern")) | ("let" N("pattern")));
N("tuple_pattern") ::= ("(" [N("tuple_pattern_element_list")] ")");
N("tuple_pattern_element_list") ::= (N("tuple_pattern_element") (("," N("tuple_pattern_element")))*);
N("tuple_pattern_element") ::= N("pattern");
N("enum_case_pattern") ::= ([N("type_identifier")] "." N("enum_case_name") [N("tuple_pattern")]);
N("type_casting_pattern") ::= (N("is_pattern") | N("as_pattern"));
N("is_pattern") ::= ("is" N("type"));
N("as_pattern") ::= (N("pattern") "as" N("type"));
N("expression_pattern") ::= N("expression");
N("attribute") ::= ("@" N("attribute_name") [N("attribute_argument_clause")]);
N("attribute_name") ::= N("identifier");
N("attribute_argument_clause") ::= ("(" [N("balanced_tokens")] ")");
N("attributes") ::= (N("attribute"))+;
N("balanced_tokens") ::= (N("balanced_token"))+;
N("balanced_token") ::= (("(" [N("balanced_tokens")] ")") | ("[" [N("balanced_tokens")] "]") | ("{" [N("balanced_tokens")] "}") | N("identifier") | N("expression") | N("context_sensitive_keyword") | N("literal") | N("operator"));
N("expression_list") ::= (N("expression") (("," N("expression")))*);
N("expression") ::= ((N("prefix_operator") N("expression")) | N("in_out_expression") | N("primary_expression") | (N("expression") N("binary_operator") N("expression")) | (N("expression") N("assignment_operator") N("expression")) | (N("expression") N("conditional_operator") N("expression")) | (N("expression") N("type_casting_operator")) | (N("expression") N("postfix_operator")) | (N("expression") N("parenthesized_expression") [N("trailing_closure")]) | (N("expression") "." "init") | (N("expression") "." N("Decimal_literal")) | (N("expression") "." N("identifier") [N("generic_argument_clause")]) | (N("expression") "." "self") | (N("expression") "." "dynamicType") | (N("expression") "[" N("expression_list") "]") | (N("expression") "!") | (N("expression") "?"));
N("in_out_expression") ::= ("&" N("identifier"));
N("assignment_operator") ::= "=";
N("conditional_operator") ::= ("?" N("expression") ":");
N("type_casting_operator") ::= (("is" N("type")) | ("as" ["?"] N("type")));
N("trailing_closure") ::= N("closure_expression");
N("primary_expression") ::= ((N("identifier") [N("generic_argument_clause")]) | N("literal_expression") | N("self_expression") | N("superclass_expression") | N("closure_expression") | N("parenthesized_expression") | N("implicit_member_expression") | N("wildcard_expression"));
N("literal_expression") ::= (N("literal") | N("array_literal") | N("dictionary_literal") | "__FILE__" | "__LINE__" | "__COLUMN__" | "__FUNCTION__");
N("array_literal") ::= ("[" [N("array_literal_items")] "]");
N("array_literal_items") ::= ((N("array_literal_item") [","]) | (N("array_literal_item") "," N("array_literal_items")));
N("array_literal_item") ::= N("expression");
N("dictionary_literal") ::= (("[" N("dictionary_literal_items") "]") | ("[" ":" "]"));
N("dictionary_literal_items") ::= (N("dictionary_literal_item") [","] N("dictionary_literal_item") "," N("dictionary_literal_items"));
N("dictionary_literal_item") ::= (N("expression") ":" N("expression"));
N("self_expression") ::= ("self" | ("self" "." N("identifier")) | ("self" "[" N("expression") "]") | ("self" "." "init"));
N("superclass_expression") ::= (N("superclass_method_expression") | (N("superclass_subscript_expression") N("superclass_initializer_expression")));
N("superclass_method_expression") ::= ("super" "." N("identifier"));
N("superclass_subscript_expression") ::= ("super" "[" N("expression") "]");
N("superclass_initializer_expression") ::= ("super" "." "init");
N("closure_expression") ::= ("{" [N("closure_signature")] N("statements") "}");
N("closure_signature") ::= ((N("parameter_clause") [N("function_result")] "in") | (N("identifier_list") [N("function_result")] "in") | (N("capture_list") N("parameter_clause") [N("function_result")] "in") | (N("capture_list") N("identifier_list") [N("function_result")] "in") | (N("capture_list") "in"));
N("capture_list") ::= ("[" N("capture_specifier") N("expression") "]");
N("capture_specifier") ::= ("weak" | "unowned" | "unowned(safe)" | "unowned(unsafe)");
N("implicit_member_expression") ::= ("." N("identifier"));
N("parenthesized_expression") ::= ("(" [N("expression_element_list")] ")");
N("expression_element_list") ::= (N("expression_element") | (N("expression_element") "," N("expression_element_list")));
N("expression_element") ::= (N("expression") | (N("identifier") ":" N("expression")));
N("wildcard_expression") ::= "_";
N("operator") ::= ("/" | "=" | "\\" | "-" | "+" | "!" | "*" | "%" | "<" | ">" | "&" | "|" | "^" | "!" | ".");
N("binary_operator") ::= N("operator");
N("prefix_operator") ::= N("operator");
N("postfix_operator") ::= N("operator");
N("type") ::= ((N("type") "[" "]") | (N("type") "->" N("type")) | N("type_identifier") | N("tuple_type") | (N("type") "?") | (N("type") "!") | N("protocol_composition_type") | (N("type") "." "Type") | (N("type") "." "Protocol"));
N("type_annotation") ::= (":" [N("attributes")] N("type"));
N("type_identifier") ::= ((N("type_name") [N("generic_argument_clause")]) | (N("type_name") [N("generic_argument_clause")] "." N("type_identifier")));
N("type_name") ::= N("identifier");
N("tuple_type") ::= ("(" [N("tuple_type_body")] ")");
N("tuple_type_body") ::= (N("tuple_type_element_list") ["..."]);
N("tuple_type_element_list") ::= (N("tuple_type_element") | (N("tuple_type_element") "," N("tuple_type_element_list")));
N("tuple_type_element") ::= (([N("attributes")] ["inout"] N("type")) | (["inout"] N("element_name") N("type_annotation")));
N("element_name") ::= N("identifier");
N("protocol_composition_type") ::= ("protocol" "<" [N("protocol_identifier_list")] ">");
N("protocol_identifier_list") ::= (N("protocol_identifier") | (N("protocol_identifier") "," N("protocol_identifier_list")));
N("protocol_identifier") ::= N("type_identifier");
N("metatype_type") ::= ((N("type") "." "Type") | (N("type") "." "Protocol"));
N("type_inheritance_clause") ::= (":" N("type_inheritance_list"));
N("type_inheritance_list") ::= (N("type_identifier") (("," N("type_identifier")))*);
N("identifier") ::= (N("Identifier") | N("context_sensitive_keyword"));
N("keyword") ::= ("convenience" | "class" | "deinit" | "enum" | "extension" | "func" | "import" | "init" | "let" | "protocol" | "static" | "struct" | "subscript" | "typealias" | "var" | "break" | "case" | "continue" | "default" | "do" | "else" | "fallthrough" | "if" | "in" | "for" | "return" | "switch" | "where" | "while" | "as" | "dynamicType" | "is" | "new" | "super" | "self" | "Self" | "Type");
N("context_sensitive_keyword") ::= ("associativity" | "didSet" | "get" | "infix" | "inout" | "left" | "mutating" | "none" | "nonmutating" | "operator" | "override" | "postfix" | "precedence" | "prefix" | "right" | "set" | "unowned" | "unowned(safe)" | "unowned(unsafe)" | "weak" | "willSet");
