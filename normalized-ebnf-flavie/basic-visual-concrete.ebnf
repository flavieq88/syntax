@root N("program");

N("program") ::= ([N("class_file_header")] (N("declaration_or_statement"))*);
N("class_file_header") ::= ("version" N("number") "class" (N("eol"))+ N("class_begin_block"));
N("class_begin_block") ::= ("begin" [N("reference")] N("IN") (N("class_begin_item"))* N("EX") "end");
N("class_begin_item") ::= (N("assignment_statement") | N("class_begin_block") | N("eol"));
N("declaration_or_statement") ::= ((N("declaration") N("eol")) | (N("statement") N("eol")) | N("eol"));
N("single_declaration_or_statement") ::= ((N("declaration") (N("colon_declaration_or_statement"))*) | (N("statement") (N("colon_declaration_or_statement"))*));
N("colon_declaration_or_statement") ::= (":" [N("declaration_or_statement")]);
N("declaration") ::= (N("variable_declaration") | N("implements_declaration") | N("subprogram_declaration") | N("constant_declaration") | N("class_declaration") | N("declare_subprogram_declaration") | N("defletter_declaration") | N("enum_declaration") | N("type_declaration"));
N("implements_declaration") ::= ("implements" N("id"));
N("enum_declaration") ::= ([N("access_modifier")] "enum" N("id") N("eol") N("IN") (N("enum_member_definition"))* N("EX") "end" "enum");
N("enum_member_definition") ::= ((N("id") "=" N("expn") N("eol")) | N("eol"));
N("type_declaration") ::= ([N("access_modifier")] "type" N("id") N("eol") N("IN") (N("type_member_definition"))* N("EX") "end" "type");
N("type_member_definition") ::= ((N("id") [N("parens")] [N("as_type")] N("eol")) | N("eol"));
N("defletter_declaration") ::= (N("def_keyword") (N("letterrange"))+);
N("letterrange") ::= (N("id") N("SPOFF") "-" N("id") N("SPON"));
N("def_keyword") ::= ("defbool" | "defbyte" | "defcur" | "defdate" | "defdbl" | "defdec" | "defint" | "deflng" | "defobj" | "defsng" | "defstr" | "defvar");
N("variable_declaration") ::= (N("variable_declaration_keyword") (N("variable_description"))+);
N("variable_declaration_keyword") ::= ("dim" | "redim" | N("access_modifier"));
N("access_modifier") ::= ("public" | "private" | "friend" | "static");
N("variable_description") ::= (N("array_description") | N("single_var_description"));
N("single_var_description") ::= (N("id") [N("initial_value")] [N("as_type")]);
N("initial_value") ::= ("=" N("expn"));
N("array_description") ::= (["withevents"] ["preserve"] N("id") "(" sep*(N("subscript_expn"), ",") ")" [N("as_type")]);
N("subscript_expn") ::= (N("expn") [N("to_expn")]);
N("constant_declaration") ::= ([N("access_modifier")] "const" N("constant_description"));
N("constant_description") ::= (N("id") [N("as_type")] N("initial_value"));
N("declare_subprogram_declaration") ::= ([N("access_modifier")] "declare" N("sub_or_function") N("id") N("lib_description") [N("alias_description")] [N("subprogram_argument_description")] [N("as_type")]);
N("subprogram_declaration") ::= ([N("access_modifier")] ["static"] N("sub_or_function") N("id") [N("lib_description")] [N("subprogram_argument_description")] [N("as_type")] N("eol") N("IN") N("sub_scope") N("EX") "end" N("sub_or_function"));
N("lib_description") ::= ("lib" N("stringlit"));
N("alias_description") ::= ("alias" N("stringlit"));
N("sub_scope") ::= (N("declaration_or_statement"))*;
N("sub_or_function") ::= ("sub" | "function");
N("subprogram_argument_description") ::= ("(" sep*(N("subprogram_argument"), ",") ")");
N("subprogram_argument") ::= (["optional"] [N("byref_or_byval")] [N("id")] [N("parens")] [N("as_type")] [N("equals_expn")]);
N("as_type") ::= ("as" ["new"] N("reference") [N("star_size")]);
N("star_size") ::= ("*" N("expn"));
N("byref_or_byval") ::= ("byref" | "byval");
N("class_declaration") ::= ("class" N("id") N("eol") N("IN") N("sub_scope") N("EX") "end" "class");
N("expn") ::= (N("primary") (N("operator_primary"))*);
N("operator_primary") ::= (N("op") N("primary"));
N("op") ::= ("^" | "*" | "/" | "\\" | "mod" | "+" | "-" | "&" | "=" | "<>" | "<=" | ">=" | ":=" | ">" | "<" | "!" | "is" | "not" | "and" | "or" | "xor" | "eqv" | "imp" | "like");
N("primary") ::= (N("reference") | N("stringlit") | N("number") | N("hexnumber") | N("octnumber") | N("datelit") | N("returncode") | N("filenumber") | (N("prefix_op") N("primary")) | ("(" sep*(N("expn"), ",") ")"));
N("prefix_op") ::= ("+" | "-" | "not" | "typeof" | "addressof");
N("reference") ::= ((["."] ["!"] N("id") (N("component_selector"))*) | ("." N("key") (N("component_selector"))*));
N("filenumber") ::= ("#" N("primary"));
N("component_selector") ::= (("." N("id")) | ("." N("key")) | N("subscript"));
N("subscript") ::= ("(" sep*(N("optional_subscript"), ",") ")");
N("optional_subscript") ::= ((N("expn") [N("to_expn")]) | (N("SP") epsilon));
N("statement") ::= (N("label_statement") | N("assignment_statement") | N("app_activate_statement") | N("attribute_statement") | N("beep_statement") | N("call_statement") | N("chdir_statement") | N("chdrive_statement") | N("close_statement") | N("date_statement") | N("deletesetting_statement") | N("do_statement") | N("end_statement") | N("erase_statement") | N("error_statement") | N("event_statement") | N("exit_statement") | N("filecopy_statement") | N("for_each_statement") | N("for_next_statement") | N("get_statement") | N("gosub_statement") | N("return_statement") | N("goto_statement") | N("if_statement") | N("input_statement") | N("kill_statement") | N("line_input_statement") | N("load_statement") | N("lock_statement") | N("lset_statement") | N("mid_statement") | N("mkdir_statement") | N("name_statement") | N("on_error_statement") | N("open_statement") | N("option_statement") | N("preprocessor_if_statement") | N("print_statement") | N("property_statement") | N("put_statement") | N("randomize_statement") | N("reset_statement") | N("resume_statement") | N("rmdir_statement") | N("rset_statement") | N("savepicture_statement") | N("savesetting_statement") | N("select_case_statement") | N("set_statement") | N("stop_statement") | N("time_statement") | N("unload_statement") | N("unlock_statement") | N("while_statement") | N("with_statement") | N("width_statement") | N("write_statement"));
N("assignment_statement") ::= (["let"] N("reference") "=" N("expn"));
N("app_activate_statement") ::= ("appactivate" N("expn") [N("comma_expn")]);
N("comma_expn") ::= ("," N("expn"));
N("beep_statement") ::= "beep";
N("chdir_statement") ::= ("chdir" N("filepath"));
N("mkdir_statement") ::= ("mkdir" N("filepath"));
N("rmdir_statement") ::= ("rmdir" N("filepath"));
N("mid_statement") ::= ("mid" N("reference") "=" N("stringlit"));
N("name_statement") ::= ("name" N("filepath") "as" N("filepath"));
N("filepath") ::= (([N("drive")] N("id") (N("slash_id"))*) | N("stringlit"));
N("slash_id") ::= (("\\" N("id")) | ("/" N("id")));
N("chdrive_statement") ::= ("chdrive" N("drive"));
N("drive") ::= (N("id") ":");
N("open_statement") ::= ("open" N("filepath") "for" N("mode") [N("access_spec")] [N("lock")] "as" N("filenumber") [N("length_spec")]);
N("mode") ::= ("append" | "binary" | "input" | "output" | "random");
N("access_spec") ::= ("access" N("access_mode"));
N("access_mode") ::= ("read" | "write" | ("read" "write"));
N("lock") ::= ("shared" | ("lock" "read") | ("lock" "write") | ("lock" "read" "write"));
N("length_spec") ::= ("len" "=" N("expn"));
N("close_statement") ::= ("close" sep*(N("filenumber"), ","));
N("seek_statement") ::= ("seek" N("filenumber") "," N("expn"));
N("unlock_statement") ::= ("unlock" N("filenumber") [N("comma_recordrange")]);
N("get_statement") ::= ("get" N("filenumber") [N("comma_recordnumber")] "," N("reference"));
N("comma_recordnumber") ::= ("," N("expn"));
N("input_statement") ::= ("input" N("filenumber") "," sep*(N("reference"), ","));
N("line_input_statement") ::= ("line" "input" N("filenumber") "," N("reference"));
N("width_statement") ::= ("width" N("filenumber") "," N("expn"));
N("write_statement") ::= ("write" N("filenumber") "," sep*(N("print_item"), ","));
N("print_statement") ::= ("print" N("filenumber") "," sep*(N("print_item"), ","));
N("print_item") ::= (([N("spc_tab")] N("expn") [N("charpos")]) | N("spc_tab"));
N("spc_tab") ::= (("spc" "(" [N("expn")] ")") | ("tab" "(" [N("expn")] ")"));
N("charpos") ::= (N("expn") | ";");
N("put_statement") ::= ("put" N("filenumber") [N("comma_expn")] "," N("reference"));
N("kill_statement") ::= ("kill" N("filepath"));
N("lock_statement") ::= ("lock" N("filenumber") [N("comma_recordrange")]);
N("comma_recordrange") ::= ("," N("number") [N("to_number")]);
N("to_number") ::= ("to" N("number"));
N("load_statement") ::= ("load" N("expn"));
N("lset_statement") ::= ("lset" N("reference") "=" N("expn"));
N("rset_statement") ::= ("rset" N("reference") "=" N("expn"));
N("date_statement") ::= ("date" "=" N("expn"));
N("time_statement") ::= ("time" "=" N("expn"));
N("deletesetting_statement") ::= ("deletesetting" (N("expn"))+);
N("end_statement") ::= "end";
N("erase_statement") ::= ("erase" sep*(N("id"), ","));
N("error_statement") ::= ("error" N("expn"));
N("event_statement") ::= (["public"] "event" N("id") [N("event_argument_list")]);
N("event_argument_list") ::= ("(" (N("event_argument"))+ ")");
N("event_argument") ::= ([N("byref_or_byval")] N("id") [N("parens")] [N("as_type")]);
N("parens") ::= ("(" ")");
N("filecopy_statement") ::= ("filecopy" N("filepath") "," N("filepath"));
N("gosub_statement") ::= ([N("on_expn")] "gosub" N("expn"));
N("return_statement") ::= "return";
N("goto_statement") ::= ([N("on_expn")] "goto" N("expn"));
N("on_expn") ::= ("on" N("expn"));
N("option_statement") ::= (("option" "base" N("number")) | ("option" "compare" N("compare_mode")) | ("option" "explicit") | ("option" "private" "module"));
N("compare_mode") ::= ("binary" | "text" | "database");
N("attribute_statement") ::= ("attribute" (N("attribute_definition"))+);
N("attribute_definition") ::= (N("reference") "=" (N("expn"))+);
N("if_statement") ::= (N("full_if_statement") | N("short_if_statement"));
N("full_if_statement") ::= ("if" N("expn") "then" N("eol") N("IN") N("sub_scope") N("EX") (N("elsif_clause"))* [N("else_clause")] "end" "if");
N("elsif_clause") ::= ("elseif" N("expn") "then" N("eol") N("IN") N("sub_scope") N("EX"));
N("else_clause") ::= ("else" N("eol") N("IN") N("sub_scope") N("EX"));
N("short_if_statement") ::= ("if" N("expn") "then" N("single_declaration_or_statement") [N("short_else_clause")]);
N("short_else_clause") ::= ("else" N("single_declaration_or_statement"));
N("select_case_statement") ::= ("select" "case" N("expn") N("eol") N("IN") (N("case_alternative"))* [N("last_case_alternative")] N("EX") "end" "select");
N("eol") ::= (([N("tab_vbcomment")] N("newline")) | ":");
N("tab_vbcomment") ::= (N("TAB") N("vbcomment"));
N("case_alternative") ::= ((N("eol"))* "case" [N("is_operator")] (N("case_expn"))+ N("eol") N("IN") N("sub_scope") N("EX"));
N("is_operator") ::= ("is" [N("op")]);
N("case_expn") ::= (N("expn") [N("to_expn")]);
N("to_expn") ::= ("to" N("expn"));
N("last_case_alternative") ::= ((N("eol"))* "case" "else" N("eol") N("IN") N("sub_scope") N("EX"));
N("for_next_statement") ::= (N("full_for_next_statement") | N("short_for_next_statement"));
N("short_for_next_statement") ::= ("for" N("id") "=" N("expn") N("to_or_downto") N("expn") [N("step_clause")] (N("colon_declaration_or_statement"))* ":" "next" [N("id")]);
N("full_for_next_statement") ::= ("for" N("id") "=" N("expn") N("to_or_downto") N("expn") [N("step_clause")] N("eol") N("IN") N("sub_scope") N("EX") "next" [N("id")]);
N("to_or_downto") ::= ("to" | "downto");
N("step_clause") ::= ("step" N("expn"));
N("for_each_statement") ::= (N("full_for_each_statement") | N("short_for_each_statement"));
N("short_for_each_statement") ::= ("for" "each" N("id") "in" N("expn") N("eol") (N("colon_declaration_or_statement"))* ":" "next" [N("id")]);
N("full_for_each_statement") ::= ("for" "each" N("id") "in" N("expn") N("eol") N("IN") N("sub_scope") N("EX") "next" [N("id")]);
N("do_statement") ::= ("do" [N("while_or_until_clause")] N("eol") N("IN") N("sub_scope") N("EX") "loop" [N("while_or_until_clause")]);
N("while_or_until_clause") ::= (N("while_clause") | N("until_clause"));
N("while_clause") ::= ("while" N("expn"));
N("until_clause") ::= ("until" N("expn"));
N("while_statement") ::= ("while" N("expn") N("eol") N("IN") N("sub_scope") N("EX") "wend");
N("call_statement") ::= (["call"] N("reference") [N("subroutine_bracketless_params")]);
N("subroutine_bracketless_params") ::= (N("expn") sep*(N("optional_expn"), ","));
N("optional_expn") ::= (N("expn") | (epsilon N("SP")));
N("set_statement") ::= ("set" N("reference") "=" N("set_object_expn"));
N("set_object_expn") ::= ((["new"] N("expn")) | "nothing");
N("setattr_statement") ::= ("setattr" N("filepath") "," N("expn"));
N("exit_statement") ::= ("exit" N("exit_what_indicator"));
N("exit_what_indicator") ::= ("do" | "for" | "function" | "property" | "sub");
N("on_error_statement") ::= ("on" ["local"] "error" N("on_error_action"));
N("on_error_action") ::= (("resume" "next") | ("goto" N("expn")));
N("with_statement") ::= ("with" N("reference") N("eol") N("IN") N("sub_scope") N("EX") "end" "with");
N("property_statement") ::= ([N("access_modifier")] ["static"] "property" N("get_let_set") N("id") [N("property_argument_list")] [N("as_type")] N("eol") N("IN") N("sub_scope") N("EX") "end" "property");
N("get_let_set") ::= ("get" | "let" | "set");
N("property_argument_list") ::= ("(" sep*(N("property_argument"), ",") ")");
N("property_argument") ::= (["optional"] [N("byref_or_byval")] ["paramarray"] N("id") [N("parens")] [N("as_type")] [N("equals_expn")]);
N("equals_expn") ::= ("=" N("expn"));
N("randomize_statement") ::= ("randomize" [N("number")]);
N("reset_statement") ::= "reset";
N("resume_statement") ::= (("resume" "next") | ("resume" [N("number")]));
N("savepicture_statement") ::= ("savepicture" N("expn") "," N("expn"));
N("savesetting_statement") ::= ("savesetting" sep*(N("expn"), ","));
N("stop_statement") ::= "stop";
N("unload_statement") ::= ("unload" N("expn"));
N("label_statement") ::= (N("EX") N("id") ":" N("IN"));
N("preprocessor_if_statement") ::= ("#if" N("expn") "then" N("eol") N("IN") N("sub_scope") N("EX") (N("preprocessor_elsif_clause"))* [N("preprocessor_else_clause")] "#end" "if");
N("preprocessor_elsif_clause") ::= ("#elseif" N("expn") "then" N("eol") N("IN") N("sub_scope") N("EX"));
N("preprocessor_else_clause") ::= ("#else" N("eol") N("IN") N("sub_scope") N("EX"));
