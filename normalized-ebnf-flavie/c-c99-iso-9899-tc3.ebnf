@root N("translation-unit");

N("translation-unit") ::= (N("external-declaration") | (N("translation-unit") N("external-declaration")));
N("external-declaration") ::= (N("function-definition") | N("declaration"));
N("function-definition") ::= (N("declaration-specifiers") N("declarator") [N("declaration-list")] N("compound-statement"));
N("declaration-specifiers") ::= ((N("storage-class-specifier") [N("declaration-specifiers")]) | (N("type-specifier") [N("declaration-specifiers")]) | (N("type-qualifier") [N("declaration-specifiers")]) | (N("function-specifier") [N("declaration-specifiers")]));
N("storage-class-specifier") ::= ("typedef" | "extern" | "static" | "auto" | "register");
N("type-specifier") ::= ("void" | "char" | "short" | "int" | "long" | "float" | "double" | "signed" | "unsigned" | "_Bool" | "_Complex" | N("struct-or-union-specifier") | N("enum-specifier") | N("typedef-name"));
N("struct-or-union-specifier") ::= ((N("struct-or-union") [N("identifier")] "{" N("struct-declaration-list") "}") | (N("struct-or-union") N("identifier")));
N("struct-or-union") ::= ("struct" | "union");
N("struct-declaration-list") ::= (N("struct-declaration") | (N("struct-declaration-list") N("struct-declaration")));
N("struct-declaration") ::= (N("specifier-qualifier-list") N("struct-declarator-list") ";");
N("specifier-qualifier-list") ::= ((N("type-specifier") [N("specifier-qualifier-list")]) | (N("type-qualifier") [N("specifier-qualifier-list")]));
N("type-qualifier") ::= ("const" | "restrict" | "volatile");
N("struct-declarator-list") ::= (N("struct-declarator") | (N("struct-declarator-list") "," N("struct-declarator")));
N("struct-declarator") ::= (N("declarator") | ([N("declarator")] ":" N("constant-expression")));
N("declarator") ::= ([N("pointer")] N("direct-declarator"));
N("pointer") ::= (("*" [N("type-qualifier-list")]) | ("*" [N("type-qualifier-list")] N("pointer")));
N("type-qualifier-list") ::= (N("type-qualifier") | (N("type-qualifier-list") N("type-qualifier")));
N("direct-declarator") ::= (N("identifier") | ("(" N("declarator") ")") | (N("direct-declarator") "[" [N("type-qualifier-list")] [N("assignment-expression")] "]") | (N("direct-declarator") "[" "static" [N("type-qualifier-list")] N("assignment-expression") "]") | (N("direct-declarator") "[" N("type-qualifier-list") "static" N("assignment-expression") "]") | (N("direct-declarator") "[" [N("type-qualifier-list")] "*" "]") | (N("direct-declarator") "(" N("parameter-type-list") ")") | (N("direct-declarator") "(" [N("identifier-list")] ")"));
N("assignment-expression") ::= (N("conditional-expression") | (N("unary-expression") N("assignment-operator") N("assignment-expression")));
N("conditional-expression") ::= (N("logical-OR-expression") | (N("logical-OR-expression") "?" N("expression") ":" N("conditional-expression")));
N("logical-OR-expression") ::= (N("logical-AND-expression") | (N("logical-OR-expression") "||" N("logical-AND-expression")));
N("logical-AND-expression") ::= (N("inclusive-OR-expression") | (N("logical-AND-expression") "&&" N("inclusive-OR-expression")));
N("inclusive-OR-expression") ::= (N("exclusive-OR-expression") | (N("inclusive-OR-expression") "|" N("exclusive-OR-expression")));
N("exclusive-OR-expression") ::= (N("AND-expression") | (N("exclusive-OR-expression") "^" N("AND-expression")));
N("AND-expression") ::= (N("equality-expression") | (N("AND-expression") "&" N("equality-expression")));
N("equality-expression") ::= (N("relational-expression") | (N("equality-expression") "==" N("relational-expression")) | (N("equality-expression") "!=" N("relational-expression")));
N("relational-expression") ::= (N("shift-expression") | (N("relational-expression") "<" N("shift-expression")) | (N("relational-expression") ">" N("shift-expression")) | (N("relational-expression") "<=" N("shift-expression")) | (N("relational-expression") ">=" N("shift-expression")));
N("shift-expression") ::= (N("additive-expression") | (N("shift-expression") "<<" N("additive-expression")) | (N("shift-expression") ">>" N("additive-expression")));
N("additive-expression") ::= (N("multiplicative-expression") | (N("additive-expression") "+" N("multiplicative-expression")) | (N("additive-expression") "-" N("multiplicative-expression")));
N("multiplicative-expression") ::= (N("cast-expression") | (N("multiplicative-expression") "*" N("cast-expression")) | (N("multiplicative-expression") "/" N("cast-expression")) | (N("multiplicative-expression") "%" N("cast-expression")));
N("cast-expression") ::= (N("unary-expression") | ("(" N("type-name") ")" N("cast-expression")));
N("unary-expression") ::= (N("postfix-expression") | ("++" N("unary-expression")) | ("--" N("unary-expression")) | (N("unary-operator") N("cast-expression")) | ("sizeof" N("unary-expression")) | ("sizeof" "(" N("type-name") ")"));
N("postfix-expression") ::= (N("primary-expression") | (N("postfix-expression") "[" N("expression") "]") | (N("postfix-expression") "(" [N("argument-expression-list")] ")") | (N("postfix-expression") "." N("identifier")) | (N("postfix-expression") "->" N("identifier")) | (N("postfix-expression") "++") | (N("postfix-expression") "--") | ("(" N("type-name") ")" "{" N("initializer-list") "}") | ("(" N("type-name") ")" "{" N("initializer-list") "," "}"));
N("primary-expression") ::= (N("identifier") | N("constant") | N("string-literal") | ("(" N("expression") ")"));
N("expression") ::= (N("assignment-expression") | (N("expression") "," N("assignment-expression")));
N("argument-expression-list") ::= (N("assignment-expression") | (N("argument-expression-list") "," N("assignment-expression")));
N("type-name") ::= (N("specifier-qualifier-list") [N("abstract-declarator")]);
N("abstract-declarator") ::= (N("pointer") | ([N("pointer")] N("direct-abstract-declarator")));
N("direct-abstract-declarator") ::= (("(" N("abstract-declarator") ")") | ([N("direct-abstract-declarator")] "[" [N("type-qualifier-list")] [N("assignment-expression")] "]") | ([N("direct-abstract-declarator")] "[" "static" [N("type-qualifier-list")] N("assignment-expression") "]") | ([N("direct-abstract-declarator")] "[" N("type-qualifier-list") "static" N("assignment-expression") "]") | ([N("direct-abstract-declarator")] "[" "*" "]") | ([N("direct-abstract-declarator")] "(" [N("parameter-type-list")] ")"));
N("parameter-type-list") ::= (N("parameter-list") | (N("parameter-list") "," "..."));
N("parameter-list") ::= (N("parameter-declaration") | (N("parameter-list") "," N("parameter-declaration")));
N("parameter-declaration") ::= ((N("declaration-specifiers") N("declarator")) | (N("declaration-specifiers") [N("abstract-declarator")]));
N("initializer-list") ::= (([N("designation")] N("initializer")) | (N("initializer-list") "," [N("designation")] N("initializer")));
N("designation") ::= (N("designator-list") "=");
N("designator-list") ::= (N("designator") | (N("designator-list") N("designator")));
N("designator") ::= (("[" N("constant-expression") "]") | ("." N("identifier")));
N("constant-expression") ::= N("conditional-expression");
N("initializer") ::= (N("assignment-expression") | ("{" N("initializer-list") "}") | ("{" N("initializer-list") "," "}"));
N("unary-operator") ::= ("&" | "*" | "+" | "-" | "~" | "!");
N("assignment-operator") ::= ("=" | "*=" | "/=" | "%=" | "+=" | "-=" | "<<=" | ">>=" | "&=" | "^=" | "|=");
N("identifier-list") ::= (N("identifier") | (N("identifier-list") "," N("identifier")));
N("enum-specifier") ::= (("enum" [N("identifier")] "{" N("enumerator-list") "}") | ("enum" [N("identifier")] "{" N("enumerator-list") "," "}") | ("enum" N("identifier")));
N("enumerator-list") ::= (N("enumerator") | (N("enumerator-list") "," N("enumerator")));
N("enumerator") ::= (N("enumeration-constant") | (N("enumeration-constant") "=" N("constant-expression")));
N("typedef-name") ::= N("identifier");
N("function-specifier") ::= "inline";
N("declaration-list") ::= (N("declaration") | (N("declaration-list") N("declaration")));
N("declaration") ::= (N("declaration-specifiers") [N("init-declarator-list")] ";");
N("init-declarator-list") ::= (N("init-declarator") | (N("init-declarator-list") "," N("init-declarator")));
N("init-declarator") ::= (N("declarator") | (N("declarator") "=" N("initializer")));
N("compound-statement") ::= ("{" [N("block-item-list")] "}");
N("block-item-list") ::= (N("block-item") | (N("block-item-list") N("block-item")));
N("block-item") ::= (N("declaration") | N("statement"));
N("statement") ::= (N("labeled-statement") | N("compound-statement") | N("expression-statement") | N("selection-statement") | N("iteration-statement") | N("jump-statement"));
N("labeled-statement") ::= ((N("identifier") ":" N("statement")) | ("case" N("constant-expression") ":" N("statement")) | ("default" ":" N("statement")));
N("expression-statement") ::= ([N("expression")] ";");
N("selection-statement") ::= (("if" "(" N("expression") ")" N("statement")) | ("if" "(" N("expression") ")" N("statement") "else" N("statement")) | ("switch" "(" N("expression") ")" N("statement")));
N("iteration-statement") ::= (("while" "(" N("expression") ")" N("statement")) | ("do" N("statement") "while" "(" N("expression") ")" ";") | ("for" "(" [N("expression")] ";" [N("expression")] ";" [N("expression")] ")" N("statement")) | ("for" "(" N("declaration") [N("expression")] ";" [N("expression")] ")" N("statement")));
N("jump-statement") ::= (("goto" N("identifier") ";") | ("continue" ";") | ("break" ";") | ("return" [N("expression")] ";"));
