N("COBOLUsageValue") ::= (select("cuv_binary", epsilon) | select("cuv_dbcs", epsilon) | select("cuv_double", epsilon) | select("cuv_display", epsilon) | select("cuv_float", epsilon) | select("cuv_index", epsilon) | select("cuv_objectReference", epsilon) | select("cuv_packedDecimal", epsilon) | select("cuv_pointer", epsilon) | select("cuv_procedurePointer", epsilon));
N("COBOLInitialValueKind") ::= (select("civk_string_value", epsilon) | select("civk_low_value", epsilon) | select("civk_high_value", epsilon) | select("civk_zero_value", epsilon) | select("civk_quotes", epsilon) | select("civk_null", epsilon) | select("civk_all_literal", epsilon));
N("COBOLElement") ::= N("COBOLRedefiningElement");
N("COBOLElement") ::= (select("level", N("String")) select("refined", N("Boolean")) select("name", N("String")) select("sharedType", N("COBOLClassifier")) select("group", N("COBOLComposedType")) (select("initial", N("COBOLElementInitialValue")))+ (select("contains", N("COBOL88Element")))+ select("source", N("COBOLSourceText")) select("array", N("COBOLFixedLengthArray")));
N("COBOLClassifier") ::= N("COBOLSimpleType");
N("COBOLClassifier") ::= N("COBOLComposedType");
N("COBOLClassifier") ::= (select("typeded", N("Boolean")) select("name", N("String")) (select("typedElements", N("COBOLElement")))+);
N("COBOLSimpleType") ::= (select("usageValue", N("COBOLUsageValue")) select("pictureString", N("String")) select("usage", N("Boolean")));
N("COBOLComposedType") ::= (select("elements", N("COBOLElement")))+;
N("COBOLElementInitialValue") ::= (select("initVal", N("String")) select("valueKind", N("COBOLInitialValueKind")));
N("COBOL88Element") ::= (select("name", N("String")) (select("has", N("COBOL88ElementValue")))+);
N("COBOL88ElementValue") ::= (select("lowerLimit", N("String")) select("upperLimit", N("String")) select("range", N("Boolean")));
N("COBOLRedefiningElement") ::= select("redefines", N("COBOLElement"));
N("COBOL66Element") ::= (select("name", N("String")) select("end", N("COBOLElement")) select("start", N("COBOLElement")));
N("COBOLSourceText") ::= (select("source", N("String")) select("fileName", N("String")));
N("COBOLFixedLengthArray") ::= N("COBOLVariableLengthArray");
N("COBOLFixedLengthArray") ::= select("maxUpper", N("Integer"));
N("COBOLVariableLengthArray") ::= (select("minUpper", N("Integer")) select("dependingOn", N("COBOLElement")));
N("Integer") ::= value("int");
N("String") ::= value("string");
N("Boolean") ::= ("true" | "false");
