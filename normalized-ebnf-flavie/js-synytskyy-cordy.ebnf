N("program") ::= N("js_program");
N("js_program") ::= (N("js_declaration_or_statement"))*;
N("js_subscope") ::= (N("js_declaration_or_statement"))*;
N("js_declaration_or_statement") ::= ((N("js_declaration") N("NL")) | ([N("js_label")] N("js_statement") N("NL")) | (N("comment") N("NL")));
N("js_label") ::= (N("id") ":");
N("js_declaration") ::= ((N("js_variable_declaration") [";"]) | (N("js_constant_declaration") [";"]) | (N("js_function_declaration") [";"]));
N("js_variable_declaration") ::= ("var" sep*(N("js_variable_description"), ","));
N("js_variable_description") ::= (N("id") [N("js_variable_initialization")]);
N("js_variable_initialization") ::= ("=" N("js_assignment_expn"));
N("js_constant_declaration") ::= ("const" sep*(N("js_constant_description"), ","));
N("js_constant_description") ::= (N("id") N("js_variable_initialization"));
N("js_function_declaration") ::= (N("NL") "function" N("id") "(" sep*(N("js_formal_parameter"), ",") ")" N("NL") "{" (N("NL") N("IN")) N("js_subscope") N("EX") "}" N("NL"));
N("js_function_expn") ::= ("function" [N("id")] "(" sep*(N("js_formal_parameter"), ",") ")" N("NL") "{" (N("NL") N("IN")) N("js_subscope") N("EX") "}");
N("js_formal_parameter") ::= N("id");
N("js_expn") ::= (N("js_assignment_expn"))+;
N("js_assignment_expn") ::= (N("js_conditional_expn") (N("assign_js_conditional_expn"))*);
N("assign_js_conditional_expn") ::= (N("js_assignment_op") N("js_conditional_expn"));
N("js_assignment_op") ::= ("=" | "*=" | ("/" N("SPOFF") "=" N("SPON")) | "%=" | "+=" | "-=" | "<<=" | ">>=" | ">>>=" | "&=" | "^=" | "|=");
N("js_conditional_expn") ::= (N("js_logical_or_expn") [N("js_conditional_clause")]);
N("js_conditional_clause") ::= ("?" N("js_assignment_expn") ":" N("js_assignment_expn"));
N("js_logical_or_expn") ::= (N("js_logical_and_expn") (N("js_logical_or_logical_and_expn"))*);
N("js_logical_or_logical_and_expn") ::= ("||" N("js_logical_and_expn"));
N("js_logical_and_expn") ::= (N("js_bitwise_or_expn") (N("js_logical_and_bitwise_or_expn"))*);
N("js_logical_and_bitwise_or_expn") ::= ("&&" N("js_bitwise_or_expn"));
N("js_bitwise_or_expn") ::= (N("js_bitwise_xor_expn") (N("js_bitwise_or_bitwise_xor_expn"))*);
N("js_bitwise_or_bitwise_xor_expn") ::= ("|" N("js_bitwise_xor_expn"));
N("js_bitwise_xor_expn") ::= (N("js_bitwise_and_expn") (N("js_bitwise_xor_bitwise_and_expn"))*);
N("js_bitwise_xor_bitwise_and_expn") ::= ("^" N("js_bitwise_and_expn"));
N("js_bitwise_and_expn") ::= (N("js_equality_expn") (N("js_bitwise_and_equality_expn"))*);
N("js_bitwise_and_equality_expn") ::= ("&" N("js_equality_expn"));
N("js_equality_expn") ::= (N("js_relational_expn") (N("js_equality_op_relational_expn"))*);
N("js_equality_op_relational_expn") ::= (N("js_equality_op") N("js_relational_expn"));
N("js_equality_op") ::= ("==" | "!=" | "===" | "!==" | "in" | "instanceof");
N("js_relational_expn") ::= (N("js_shift_expn") (N("js_relational_op_shift_expn"))*);
N("js_relational_op_shift_expn") ::= (N("js_relational_op") N("js_shift_expn"));
N("js_relational_op") ::= ("<" | ">" | "<=" | ">=");
N("js_shift_expn") ::= (N("js_additive_expn") (N("js_shift_op_additive_expn"))*);
N("js_shift_op_additive_expn") ::= (N("js_shift_op") N("js_additive_expn"));
N("js_shift_op") ::= ("<<" | ">>" | ">>>");
N("js_additive_expn") ::= (N("js_multiplicative_expn") (N("js_additive_op_multiplicative_expn"))*);
N("js_additive_op_multiplicative_expn") ::= (N("js_additive_op") N("js_multiplicative_expn"));
N("js_additive_op") ::= ("+" | "-");
N("js_multiplicative_expn") ::= (N("js_unary_expn") (N("js_multiplicative_op_unary_expn"))*);
N("js_multiplicative_op_unary_expn") ::= (N("js_multiplicative_op") N("js_unary_expn"));
N("js_multiplicative_op") ::= ("*" | "/" | "%");
N("js_unary_expn") ::= ((N("js_unary_op"))* N("js_postfix_expn"));
N("js_unary_op") ::= ("delete" | "void" | "typeof" | "++" | "--" | "+" | "-" | "~" | "!");
N("js_postfix_expn") ::= (N("js_lefthand_side_expn") [N("js_postfix_op")]);
N("js_postfix_op") ::= ("++" | "--");
N("js_lefthand_side_expn") ::= (["new"] N("js_member_expn"));
N("js_member_expn") ::= (N("js_primary_expn") (N("js_selector"))*);
N("js_selector") ::= (N("js_arguments") | N("js_subscripts") | N("js_field_selector"));
N("js_arguments") ::= ("(" sep*(N("js_assignment_expn"), ",") ")");
N("js_subscripts") ::= ("[" N("js_expn") "]");
N("js_field_selector") ::= ("." N("id"));
N("js_primary_expn") ::= ("this" | "class" | N("id") | N("js_literal") | N("js_array_literal") | N("js_object_literal") | N("js_function_expn") | ("(" N("js_expn") ")"));
N("js_literal") ::= ("null" | "true" | "false" | N("js_numeric_literal") | N("js_string_literal") | N("js_regular_expn_literal"));
N("js_numeric_literal") ::= (N("number") | N("js_hex_number"));
N("js_string_literal") ::= (N("stringlit") | N("charlit"));
N("js_regular_expn_literal") ::= N("js_regexp");
N("js_array_literal") ::= ("[" sep*(N("js_array_element"), ",") "]");
N("js_array_element") ::= [N("js_assignment_expn")];
N("js_object_literal") ::= ("{" sep*(N("js_property_assignment"), ",") [","] "}");
N("js_property_assignment") ::= ((N("js_property_name") ":" N("js_expn")) | ("get" N("js_property_name") "(" ")" "{" N("js_subscope") "}") | ("set" N("js_property_name") "(" N("js_property_set_parameter") ")" "{" N("js_subscope") "}"));
N("js_property_name") ::= (N("id") | N("js_string_literal") | N("number"));
N("js_property_set_parameter") ::= N("id");
N("js_statement") ::= ((N("js_compound_statement") [";"]) | (N("js_expression_statement") [";"]) | (N("js_if_statement") [";"]) | (N("js_for_statement") [";"]) | (N("js_while_statement") [";"]) | (N("js_break_statement") [";"]) | (N("js_continue_statement") [";"]) | (N("js_return_statement") [";"]) | (N("js_with_statement") [";"]) | (N("js_switch_statement") [";"]) | (N("js_do_statement") [";"]) | (N("js_try_catch_statement") [";"]) | (N("js_throw_statement") [";"]) | (N("js_debugger_statement") [";"]) | N("js_empty_statement"));
N("js_empty_statement") ::= ";";
N("js_compound_statement") ::= ("{" (N("NL") N("IN")) N("js_subscope") N("EX") "}");
N("js_expression_statement") ::= (N("js_expn"));
N("js_if_statement") ::= ("if" "(" N("js_expn") ")" N("js_declaration_or_statement") [N("js_else_clause")]);
N("js_else_clause") ::= ("else" N("js_declaration_or_statement"));
N("js_for_statement") ::= (("for" "(" sep*(N("js_declaration_or_statement_no_nl"), ",") ";" [N("js_expn")] ";" [N("js_expn")] ")" N("js_statement")) | ("for" ["each"] "(" N("js_declaration_or_statement_no_nl") "in" N("js_expn") ")" N("js_statement")));
N("js_declaration_or_statement_no_nl") ::= ((N("js_declaration")) | N("js_statement"));
N("js_while_statement") ::= ("while" "(" N("js_expn") ")" N("js_statement"));
N("js_break_statement") ::= ("break" [N("id")]);
N("js_continue_statement") ::= ("continue" [N("id")]);
N("js_return_statement") ::= ("return" [N("js_expn")]);
N("js_with_statement") ::= ("with" "(" N("js_expn") ")" N("js_statement"));
N("js_switch_statement") ::= ("switch" "(" N("js_expn") ")" "{" N("NL") (N("js_case_clause"))* "}");
N("js_case_clause") ::= (N("js_case_clause_value") (N("NL") N("IN")) N("js_subscope") N("EX"));
N("js_case_clause_value") ::= (("case" N("js_expn") ":") | ("default" ":"));
N("js_do_statement") ::= ("do" N("js_statement") "while" "(" N("js_expn") ")");
N("js_try_catch_statement") ::= ("try" N("js_compound_statement") [N("js_catch_clause")] [N("js_finally_clause")]);
N("js_catch_clause") ::= (N("NL") "catch" "(" N("id") ")" N("js_compound_statement"));
N("js_finally_clause") ::= (N("NL") "finally" N("js_compound_statement"));
N("js_throw_statement") ::= ("throw" N("js_expn"));
N("js_debugger_statement") ::= "debugger";
