@root N("program");

N("program") ::= N("compilation");
N("identifier") ::= (N("id") | N("wide_identifier"));
N("wide_identifier") ::= ("[" N("stringlit") "]");
N("numeric_literal") ::= (N("decimal_literal") | N("based_literal"));
N("character_literal") ::= N("charlit");
N("string_literal") ::= N("stringlit");
N("pragma") ::= (("pragma" N("id") N("blocksemi")) | ("pragma" N("id") N("pragma_arguments") N("blocksemi")));
N("pragma_arguments") ::= ("(" sep+(N("pragma_argument_association"), ",") ")");
N("semi") ::= (";" N("NL"));
N("blocksemi") ::= (";" N("NL"));
N("unitsemi") ::= (";" (N("NL") N("NL")));
N("eol") ::= N("NL");
N("blockeol") ::= N("NL");
N("colon") ::= ":";
N("colon_equals") ::= ":=";
N("arrow") ::= "=>";
N("pragma_argument_association") ::= ([N("identifier_arrow")] N("expression"));
N("identifier_arrow") ::= (N("identifier") N("arrow"));
N("basic_declaration") ::= (N("type_declaration") | N("subtype_declaration") | N("object_declaration") | N("number_declaration") | N("subprogram_declaration") | N("abstract_subprogram_declaration") | N("null_procedure_declaration") | N("package_declaration") | N("renaming_declaration") | N("exception_declaration") | N("generic_declaration") | N("generic_instantiation") | N("pragma"));
N("defining_identifier") ::= N("identifier");
N("type_declaration") ::= (N("full_type_declaration") | N("incomplete_type_declaration") | N("private_type_declaration") | N("private_extension_declaration"));
N("full_type_declaration") ::= (("type" N("defining_identifier") [N("known_discriminant_part")] "is" N("type_definition") N("blocksemi")) | N("task_type_declaration") | N("protected_type_declaration"));
N("type_definition") ::= (N("enumeration_type_definition") | N("integer_type_definition") | N("real_type_definition") | N("array_type_definition") | N("record_type_definition") | N("access_type_definition") | N("derived_type_definition") | N("interface_type_definition"));
N("subtype_declaration") ::= ("subtype" N("defining_identifier") "is" N("subtype_indication") N("semi"));
N("subtype_indication") ::= ([N("null_exclusion")] N("subtype_mark") [N("constraint")]);
N("subtype_mark") ::= N("name");
N("constraint") ::= (N("scalar_constraint") | N("composite_constraint"));
N("scalar_constraint") ::= (N("range_constraint") | N("digits_constraint") | N("delta_constraint"));
N("composite_constraint") ::= (N("index_constraint") | N("discriminant_constraint"));
N("object_declaration") ::= ((N("defining_identifier_list") N("colon") ["aliased"] ["constant"] N("subtype_access_or_array_type_definition") [N("object_declaration_expression")] N("semi")) | N("single_task_declaration") | N("single_protected_declaration"));
N("subtype_access_or_array_type_definition") ::= (N("subtype_indication") | N("access_definition") | N("array_type_definition"));
N("object_declaration_expression") ::= (N("colon_equals") N("expression"));
N("defining_identifier_list") ::= sep+(N("defining_identifier"), ",");
N("number_declaration") ::= (N("defining_identifier_list") N("colon") "constant" N("colon_equals") N("expression") N("semi"));
N("derived_type_definition") ::= (["abstract"] ["limited"] "new" N("subtype_indication") [N("interface_and_record_extension_specification")]);
N("interface_and_record_extension_specification") ::= (("and" N("interface_list") [N("record_extension_part")]) | N("record_extension_part"));
N("range_constraint") ::= ("range" N("range"));
N("range") ::= (N("range_attribute_reference") | (N("simple_expression") N("SP") ".." N("SP") N("simple_expression")));
N("enumeration_type_definition") ::= ("(" sep+(N("enumeration_literal_specification"), ",") ")");
N("enumeration_literal_specification") ::= (N("defining_identifier") | N("defining_character_literal"));
N("defining_character_literal") ::= N("character_literal");
N("integer_type_definition") ::= (N("signed_integer_type_definition") | N("modular_type_definition"));
N("signed_integer_type_definition") ::= ("range" N("simple_expression") N("SP") ".." N("SP") N("simple_expression"));
N("modular_type_definition") ::= ("mod" N("expression"));
N("real_type_definition") ::= (N("floating_point_definition") | N("fixed_point_definition"));
N("floating_point_definition") ::= ("digits" N("expression") [N("real_range_specification")]);
N("real_range_specification") ::= ("range" N("simple_expression") N("SP") ".." N("SP") N("simple_expression"));
N("fixed_point_definition") ::= (N("ordinary_fixed_point_definition") | N("decimal_fixed_point_definition"));
N("ordinary_fixed_point_definition") ::= ("delta" N("expression") N("real_range_specification"));
N("decimal_fixed_point_definition") ::= ("delta" N("expression") "digits" N("expression") [N("real_range_specification")]);
N("digits_constraint") ::= ("digits" N("expression") [N("range_constraint")]);
N("array_type_definition") ::= (N("unconstrained_array_definition") | N("constrained_array_definition"));
N("unconstrained_array_definition") ::= ("array" "(" sep+(N("index_subtype_definition"), ",") ")" "of" N("component_definition"));
N("index_subtype_definition") ::= (N("subtype_mark") "range" "<>");
N("constrained_array_definition") ::= ("array" "(" sep+(N("discrete_subtype_definition"), ",") ")" "of" N("component_definition"));
N("discrete_subtype_definition") ::= (N("subtype_indication") | N("range"));
N("component_definition") ::= ((["aliased"] N("subtype_indication")) | (["aliased"] N("access_definition")));
N("index_constraint") ::= ("(" sep+(N("discrete_range"), ",") ")");
N("discrete_range") ::= (N("subtype_indication") | N("range"));
N("discriminant_part") ::= (N("unknown_discriminant_part") | N("known_discriminant_part"));
N("unknown_discriminant_part") ::= ("(" "<>" ")");
N("known_discriminant_part") ::= ("(" N("discriminant_specification_list") ")");
N("discriminant_specification_list") ::= (N("discriminant_specification") (N("semi_discriminant_specification"))*);
N("semi_discriminant_specification") ::= (";" N("discriminant_specification"));
N("discriminant_specification") ::= ((N("defining_identifier_list") N("colon") [N("null_exclusion")] N("subtype_mark") [N("discriminant_specification_default")]) | (N("defining_identifier_list") N("colon") N("access_definition") [N("discriminant_specification_default")]));
N("discriminant_specification_default") ::= (N("colon_equals") N("default_expression"));
N("default_expression") ::= N("expression");
N("discriminant_constraint") ::= ("(" sep*(N("discriminant_association"), ",") ")");
N("discriminant_association") ::= ([N("discriminant_selector_name_arrow")] N("expression"));
N("discriminant_selector_name_arrow") ::= (N("selector_name") (N("or_selector_name"))* N("arrow"));
N("or_selector_name") ::= (N("orbar") N("selector_name"));
N("orbar") ::= ("|" | "!");
N("record_type_definition") ::= ([N("record_type_definition_tagged")] ["limited"] N("record_definition"));
N("record_type_definition_tagged") ::= (["abstract"] "tagged");
N("record_definition") ::= ((N("IN") N("eol") "record" N("IN") N("eol") N("component_list") N("EX") "end" "record" N("EX")) | ("null" "record"));
N("component_list") ::= ((N("component_item"))+ | ((N("component_item"))* N("variant_part")) | ("null" N("semi")));
N("component_item") ::= (N("component_declaration") | N("aspect_clause") | N("pragma"));
N("component_declaration") ::= (N("defining_identifier_list") N("colon") N("component_definition") [N("component_declaration_default")] N("semi"));
N("component_declaration_default") ::= (N("colon_equals") N("default_expression"));
N("variant_part") ::= ("case" N("direct_name") "is" N("IN") N("blockeol") (N("variant"))+ N("EX") "end" "case" N("blocksemi"));
N("variant") ::= ("when" N("discrete_choice_list") N("arrow") N("component_list"));
N("discrete_choice_list") ::= (N("discrete_choice") (N("or_discrete_choice"))*);
N("or_discrete_choice") ::= (N("orbar") N("discrete_choice"));
N("discrete_choice") ::= (N("expression") | N("discrete_range") | "others");
N("record_extension_part") ::= ("with" N("record_definition"));
N("abstract_subprogram_declaration") ::= ([N("overriding_indicator")] N("subprogram_specification") "is" "abstract" N("blocksemi"));
N("interface_type_definition") ::= ([N("interface_type_definition_modifier")] "interface" [N("interface_type_definition_list")]);
N("interface_type_definition_modifier") ::= ("limited" | "task" | "protected" | "synchronized");
N("interface_type_definition_list") ::= ("and" N("interface_list"));
N("interface_list") ::= (N("subtype_mark") | (N("subtype_mark") "and" N("interface_list")));
N("access_type_definition") ::= (([N("null_exclusion")] N("access_to_object_definition")) | ([N("null_exclusion")] N("access_to_subprogram_definition")));
N("access_to_object_definition") ::= ("access" [N("general_access_modifier")] N("subtype_indication"));
N("general_access_modifier") ::= ("all" | "constant");
N("access_to_subprogram_definition") ::= (("access" ["protected"] "procedure" N("parameter_profile")) | ("access" ["protected"] "function" N("parameter_and_result_profile")));
N("null_exclusion") ::= ("not" "null");
N("access_definition") ::= (([N("null_exclusion")] "access" ["constant"] N("subtype_mark")) | ([N("null_exclusion")] "access" ["protected"] "procedure" N("parameter_profile")) | ([N("null_exclusion")] "access" ["protected"] "function" N("parameter_and_result_profile")));
N("incomplete_type_declaration") ::= ("type" N("defining_identifier") [N("discriminant_part")] [N("incomplete_type_declaration_modifier")] N("blocksemi"));
N("incomplete_type_declaration_modifier") ::= ("is" "tagged");
N("declarative_part") ::= (N("declarative_item"))*;
N("declarative_item") ::= (N("basic_declarative_item") | N("body"));
N("basic_declarative_item") ::= (N("basic_declaration") | N("aspect_clause") | N("use_clause"));
N("body") ::= (N("proper_body") | N("body_stub"));
N("proper_body") ::= (N("subprogram_body") | N("package_body") | N("task_body") | N("protected_body"));
N("name") ::= ((N("direct_name") (N("name_component"))*) | N("character_literal"));
N("name_component") ::= (N("explicit_dereference_component") | N("indexed_slice_type_conv_or_function_call_component") | N("selected_component_component") | N("attribute_reference_component"));
N("indexed_slice_type_conv_or_function_call_component") ::= ("(" sep+(N("index_or_parameter_value"), ",") ")");
N("index_or_parameter_value") ::= (N("expression") | N("discrete_range") | N("parameter_association"));
N("direct_name") ::= (N("identifier") | N("operator_symbol"));
N("prefix") ::= N("name");
N("explicit_dereference") ::= (N("name") N("explicit_dereference_component"));
N("explicit_dereference_component") ::= ("." "all");
N("implicit_dereference") ::= N("name");
N("indexed_component") ::= (N("prefix") N("indexed_component_component"));
N("indexed_component_component") ::= ("(" sep+(N("index_expression"), ",") ")");
N("index_expression") ::= N("expression");
N("slice") ::= (N("prefix") N("slice_component"));
N("slice_component") ::= ("(" N("discrete_range") ")");
N("selected_component") ::= (N("prefix") N("selected_component_component"));
N("selected_component_component") ::= ("." N("selector_name"));
N("selector_name") ::= (N("identifier") | N("character_literal") | N("operator_symbol"));
N("attribute_reference") ::= (N("prefix") N("attribute_reference_component"));
N("attribute_reference_component") ::= (N("SPOFF") "'" N("attribute_designator") N("SPON"));
N("attribute_designator") ::= ((N("identifier") [N("attribute_designator_expression")]) | "access" | "delta" | "digits");
N("attribute_designator_expression") ::= ("(" N("expression") ")");
N("range_attribute_reference") ::= (N("prefix") N("SPOFF") "'" N("range_attribute_designator"));
N("range_attribute_designator") ::= ("range" N("SPON") [N("range_attribute_designator_expression")]);
N("range_attribute_designator_expression") ::= ("(" N("expression") ")");
N("aggregate") ::= (N("record_aggregate") | N("extension_aggregate") | N("array_aggregate"));
N("record_aggregate") ::= ("(" N("record_component_association_list") ")");
N("record_component_association_list") ::= (sep+(N("record_component_association"), ",") | ("null" "record"));
N("record_component_association") ::= (N("expression") | (N("component_choice_list") N("arrow") N("expression_or_null")));
N("component_choice_list") ::= ((N("selector_name") (N("or_selector_name"))*) | "others");
N("extension_aggregate") ::= ("(" N("ancestor_part") "with" N("record_component_association_list") ")");
N("ancestor_part") ::= (N("expression") | N("subtype_mark"));
N("array_aggregate") ::= (N("positional_array_aggregate") | N("named_array_aggregate"));
N("positional_array_aggregate") ::= ("(" sep+(N("index_expression"), ",") (N("comma_others"))* ")");
N("comma_others") ::= ("," "others" N("arrow") N("expression_or_null"));
N("named_array_aggregate") ::= ("(" sep+(N("array_component_association"), ",") ")");
N("array_component_association") ::= (N("discrete_choice_list") N("arrow") N("expression_or_null"));
N("expression_or_null") ::= (N("expression") | "<>");
N("expression") ::= (N("relation") (N("and_or_xor_relation"))*);
N("and_or_xor_relation") ::= (N("and_or_xor") N("relation"));
N("and_or_xor") ::= (("and" ["then"]) | ("or" ["else"]) | "xor");
N("relation") ::= ((N("simple_expression") [N("relational_operator_simple_expression")]) | (N("simple_expression") ["not"] "in" N("range")) | (N("simple_expression") ["not"] "in" N("subtype_mark")));
N("relational_operator_simple_expression") ::= (N("relational_operator") N("simple_expression"));
N("simple_expression") ::= ([N("unary_adding_operator")] N("term") (N("binary_adding_operator_term"))*);
N("binary_adding_operator_term") ::= (N("binary_adding_operator") N("term"));
N("term") ::= (N("factor") (N("multiplying_operator_factor"))*);
N("multiplying_operator_factor") ::= (N("multiplying_operator") N("factor"));
N("factor") ::= ((N("primary") [N("starstar_primary")]) | ("abs" N("primary")) | ("not" N("primary")));
N("starstar_primary") ::= ("**" N("primary"));
N("primary") ::= (N("numeric_literal") | "null" | N("string_literal") | N("aggregate") | N("name") | N("qualified_expression") | N("allocator") | ("(" N("expression") ")") | N("if_expression"));
N("if_expression") ::= ("if" N("expression") "then" N("expression") (N("elsif_expression"))* [N("else_expression")]);
N("elsif_expression") ::= ("elsif" N("expression") "then" N("expression"));
N("else_expression") ::= ("else" N("expression"));
N("logical_operator") ::= ("and" | "or" | "xor");
N("relational_operator") ::= ("=" | "/=" | "<" | "<=" | ">" | ">=");
N("binary_adding_operator") ::= ("+" | "-" | ((N("IN") N("NL")) "&" N("EX")));
N("unary_adding_operator") ::= ("+" | "-");
N("multiplying_operator") ::= ("*" | "/" | "mod" | "rem");
N("highest_precedence_operator") ::= ("**" | "abs" | "not");
N("type_conversion") ::= (N("subtype_mark") "(" N("expression") ")");
N("qualified_expression") ::= (N("subtype_mark") N("SPOFF") "'" N("expression_or_aggregate"));
N("expression_or_aggregate") ::= (("(" N("SPON") N("expression") ")") | (N("SPON") N("aggregate")));
N("allocator") ::= (("new" N("subtype_indication")) | ("new" N("qualified_expression")));
N("sequence_of_statements") ::= (N("statement"))+;
N("statement") ::= ((N("label"))* N("unlabeled_statement"));
N("unlabeled_statement") ::= (N("simple_statement") | N("compound_statement"));
N("simple_statement") ::= (N("null_statement") | N("procedure_call_statement") | N("assignment_statement") | N("exit_statement") | N("goto_statement") | N("simple_return_statement") | N("entry_call_statement") | N("requeue_statement") | N("delay_statement") | N("abort_statement") | N("raise_statement") | N("code_statement") | N("pragma"));
N("compound_statement") ::= (N("if_statement") | N("case_statement") | N("loop_statement") | N("block_statement") | N("extended_return_statement") | N("accept_statement") | N("select_statement"));
N("null_statement") ::= ("null" N("semi"));
N("label") ::= ("<<" N("statement_identifier") ">>");
N("statement_identifier") ::= N("direct_name");
N("assignment_statement") ::= (N("name") N("colon_equals") N("expression") N("semi"));
N("if_statement") ::= ("if" N("condition") "then" N("IN") N("eol") N("sequence_of_statements") (N("if_statement_elsif"))* [N("if_statement_else")] N("EX") "end" "if" N("semi"));
N("if_statement_elsif") ::= (N("EX") "elsif" N("condition") "then" N("IN") N("eol") N("sequence_of_statements"));
N("if_statement_else") ::= (N("EX") "else" N("IN") N("eol") N("sequence_of_statements"));
N("condition") ::= N("expression");
N("case_statement") ::= ("case" N("expression") "is" N("IN") N("blockeol") (N("case_statement_alternative"))+ N("EX") "end" "case" N("blocksemi"));
N("case_statement_alternative") ::= ("when" N("discrete_choice_list") N("arrow") N("sequence_of_statements"));
N("loop_statement") ::= ([N("loop_statement_identifier")] [N("iteration_scheme")] "loop" N("IN") N("eol") N("sequence_of_statements") N("EX") "end" "loop" [N("identifier")] N("blocksemi"));
N("loop_statement_identifier") ::= (N("statement_identifier") N("colon"));
N("iteration_scheme") ::= (("while" N("condition")) | ("for" N("loop_parameter_specification")));
N("loop_parameter_specification") ::= (N("defining_identifier") "in" ["reverse"] N("discrete_subtype_definition"));
N("block_statement") ::= ([N("block_statement_identifier_colon")] [N("declare_declarative_part")] "begin" N("IN") N("eol") N("handled_sequence_of_statements") N("EX") "end" [N("identifier")] N("unitsemi"));
N("block_statement_identifier_colon") ::= (N("statement_identifier") N("colon"));
N("declare_declarative_part") ::= ("declare" N("IN") N("eol") N("declarative_part") N("EX"));
N("exit_statement") ::= ("exit" [N("name")] [N("exit_statement_when_condition")] N("semi"));
N("exit_statement_when_condition") ::= ("when" N("condition"));
N("goto_statement") ::= ("goto" N("name") N("semi"));
N("subprogram_declaration") ::= ([N("overriding_indicator")] N("subprogram_specification") N("blocksemi"));
N("subprogram_specification") ::= (N("procedure_specification") | N("function_specification"));
N("procedure_specification") ::= ("procedure" N("defining_program_unit_name") N("parameter_profile"));
N("function_specification") ::= ("function" N("defining_designator") N("parameter_and_result_profile"));
N("designator") ::= (([N("designator_parent_unit_name")] N("identifier")) | N("operator_symbol"));
N("designator_parent_unit_name") ::= (N("parent_unit_name") ".");
N("defining_designator") ::= (N("defining_program_unit_name") | N("defining_operator_symbol"));
N("defining_program_unit_name") ::= ([N("defining_program_unit_name_parent")] N("defining_identifier"));
N("defining_program_unit_name_parent") ::= (N("parent_unit_name") ".");
N("operator_symbol") ::= N("string_literal");
N("defining_operator_symbol") ::= N("operator_symbol");
N("parameter_profile") ::= [N("formal_part")];
N("parameter_and_result_profile") ::= ([N("formal_part")] "return" N("subtype_or_access_definition"));
N("subtype_or_access_definition") ::= (([N("null_exclusion")] N("subtype_mark")) | N("access_definition"));
N("formal_part") ::= ("(" N("parameter_specification") (N("semi_parameter_specification"))* ")");
N("semi_parameter_specification") ::= (";" N("parameter_specification"));
N("parameter_specification") ::= (N("defining_identifier_list") N("colon") N("parameter_type_specification"));
N("parameter_type_specification") ::= ((N("mode") [N("null_exclusion")] N("subtype_mark") [N("parameter_specification_default")]) | (N("access_definition") [N("parameter_specification_default")]));
N("parameter_specification_default") ::= (N("colon_equals") N("default_expression"));
N("mode") ::= (["in"] | ("in" "out") | "out");
N("subprogram_body") ::= (N("NL") [N("overriding_indicator")] N("subprogram_specification") "is" N("IN") N("blockeol") N("declarative_part") N("EX") "begin" N("IN") N("eol") N("handled_sequence_of_statements") N("EX") "end" [N("designator")] N("unitsemi"));
N("procedure_call_statement") ::= (N("prefix") [N("actual_parameter_part")] N("semi"));
N("function_call") ::= (N("prefix") N("function_call_component"));
N("function_call_component") ::= N("actual_parameter_part");
N("actual_parameter_part") ::= ("(" sep+(N("parameter_association"), ",") ")");
N("parameter_association") ::= (N("parameter_association_selector_name") N("explicit_actual_parameter"));
N("parameter_association_selector_name") ::= (N("selector_name") N("arrow"));
N("explicit_actual_parameter") ::= N("expression");
N("simple_return_statement") ::= ("return" [N("expression")] N("semi"));
N("extended_return_statement") ::= ("return" N("defining_identifier") N("colon") ["aliased"] N("return_subtype_indication") [N("extended_return_statement_expression")] [N("extended_return_statement_do")] N("unitsemi"));
N("extended_return_statement_expression") ::= (N("colon_equals") N("expression"));
N("extended_return_statement_do") ::= ("do" N("IN") N("eol") N("handled_sequence_of_statements") N("EX") "end" "return");
N("return_subtype_indication") ::= (N("subtype_indication") | N("access_definition"));
N("null_procedure_declaration") ::= ([N("overriding_indicator")] N("procedure_specification") "is" "null" N("blocksemi"));
N("package_declaration") ::= (N("package_specification") N("unitsemi"));
N("package_specification") ::= (N("NL") "package" N("defining_program_unit_name") "is" N("IN") N("blockeol") (N("basic_declarative_item"))* N("EX") [N("package_specification_private")] "end" [N("package_specification_identifier")]);
N("package_specification_private") ::= ("private" N("IN") N("eol") (N("basic_declarative_item"))* N("EX"));
N("package_specification_identifier") ::= ([N("parent_name_dot")] N("identifier"));
N("parent_name_dot") ::= (N("parent_unit_name") ".");
N("package_body") ::= (N("NL") "package" "body" N("defining_program_unit_name") "is" N("IN") N("blockeol") N("declarative_part") N("EX") [N("package_body_statements")] "end" [N("package_body_identifier")] N("unitsemi"));
N("package_body_statements") ::= ("begin" N("IN") N("eol") N("handled_sequence_of_statements") N("EX"));
N("package_body_identifier") ::= ([N("parent_name_dot")] N("identifier"));
N("private_type_declaration") ::= ("type" N("defining_identifier") [N("discriminant_part")] "is" N("blockeol") [N("private_type_declaration_tagged")] ["limited"] "private" N("blocksemi"));
N("private_type_declaration_tagged") ::= (["abstract"] "tagged");
N("private_extension_declaration") ::= ("type" N("defining_identifier") [N("discriminant_part")] "is" N("blockeol") ["abstract"] [N("private_extension_declaration_modifier")] "new" N("subtype_indication") [N("private_extension_declaration_interface_list")] "with" "private" N("blocksemi"));
N("private_extension_declaration_modifier") ::= ("limited" | "synchronized");
N("private_extension_declaration_interface_list") ::= ("and" N("interface_list"));
N("overriding_indicator") ::= (["not"] "overriding");
N("use_clause") ::= (N("use_package_clause") | N("use_type_clause"));
N("use_package_clause") ::= ("use" sep+(N("used_name"), ",") N("semi"));
N("used_name") ::= N("name");
N("use_type_clause") ::= ("use" "type" sep+(N("used_subtype_mark"), ",") N("semi"));
N("used_subtype_mark") ::= N("subtype_mark");
N("renaming_declaration") ::= (N("object_renaming_declaration") | N("exception_renaming_declaration") | N("package_renaming_declaration") | N("subprogram_renaming_declaration") | N("generic_renaming_declaration"));
N("object_renaming_declaration") ::= ((N("defining_identifier") N("colon") [N("null_exclusion")] N("subtype_mark") "renames" N("name") N("semi")) | (N("defining_identifier") N("colon") N("access_definition") "renames" N("name") N("semi")));
N("exception_renaming_declaration") ::= (N("defining_identifier") N("colon") "exception" "renames" N("name") N("semi"));
N("package_renaming_declaration") ::= (N("NL") "package" N("defining_program_unit_name") "renames" N("name") N("blocksemi"));
N("subprogram_renaming_declaration") ::= ([N("overriding_indicator")] N("subprogram_specification") "renames" N("name") N("blocksemi"));
N("generic_renaming_declaration") ::= (("generic" "package" N("defining_program_unit_name") "renames" N("name") N("blocksemi")) | ("generic" "procedure" N("defining_program_unit_name") "renames" N("name") N("blocksemi")) | ("generic" "function" N("defining_program_unit_name") "renames" N("name") N("blocksemi")));
N("task_type_declaration") ::= ("task" "type" N("defining_identifier") [N("known_discriminant_part")] [N("task_type_declaration_definition")] N("blocksemi"));
N("task_type_declaration_definition") ::= ("is" N("IN") N("blockeol") [N("task_type_declaration_definition_interface_list")] N("task_definition") N("EX"));
N("task_type_declaration_definition_interface_list") ::= ("new" N("interface_list") "with");
N("single_task_declaration") ::= ("task" N("defining_identifier") [N("single_task_declaration_definition")] N("unitsemi"));
N("single_task_declaration_definition") ::= ("is" N("IN") N("blockeol") [N("single_task_declaration_definition_interface_list")] N("EX") N("task_definition"));
N("single_task_declaration_definition_interface_list") ::= ("new" N("interface_list") "with");
N("task_definition") ::= (N("IN") (N("task_item"))* [N("task_definition_private")] N("EX") "end" [N("identifier")]);
N("task_definition_private") ::= ("private" N("IN") N("eol") (N("task_item"))* N("EX"));
N("task_item") ::= (N("entry_declaration") | N("aspect_clause") | N("pragma"));
N("task_body") ::= (N("NL") "task" "body" N("defining_identifier") "is" N("IN") N("blockeol") N("declarative_part") N("EX") "begin" N("IN") N("eol") N("handled_sequence_of_statements") N("EX") "end" [N("identifier")] N("unitsemi"));
N("protected_type_declaration") ::= (N("NL") "protected" "type" N("defining_identifier") [N("known_discriminant_part")] "is" [N("protected_type_declaration_interface_list")] N("eol") N("protected_definition") N("unitsemi"));
N("protected_type_declaration_interface_list") ::= ("new" N("interface_list") "with");
N("single_protected_declaration") ::= ("protected" N("defining_identifier") "is" N("blockeol") [N("single_protected_declaration_interface_list")] N("protected_definition") N("unitsemi"));
N("single_protected_declaration_interface_list") ::= ("new" N("interface_list") "with");
N("protected_definition") ::= (N("IN") (N("protected_operation_declaration"))* [N("protected_definition_private")] N("EX") "end" [N("identifier")]);
N("protected_definition_private") ::= (N("EX") "private" N("IN") N("eol") (N("protected_element_declaration"))*);
N("protected_operation_declaration") ::= (N("subprogram_declaration") | N("entry_declaration") | N("aspect_clause") | N("pragma"));
N("protected_element_declaration") ::= (N("protected_operation_declaration") | N("component_declaration"));
N("protected_body") ::= ("protected" "body" N("defining_identifier") "is" N("IN") N("blockeol") (N("protected_operation_item"))* N("EX") "end" [N("identifier")] N("unitsemi"));
N("protected_operation_item") ::= (N("subprogram_declaration") | N("subprogram_body") | N("entry_body") | N("aspect_clause"));
N("entry_declaration") ::= ([N("overriding_indicator")] "entry" N("defining_identifier") [N("entry_declaration_subtype")] N("parameter_profile") N("blocksemi"));
N("entry_declaration_subtype") ::= ("(" N("discrete_subtype_definition") ")");
N("accept_statement") ::= ("accept" N("direct_name") [N("accept_statement_entry_index")] N("parameter_profile") [N("accept_statement_statements")] N("unitsemi"));
N("accept_statement_entry_index") ::= ("(" N("entry_index") ")");
N("accept_statement_statements") ::= ("do" N("IN") N("eol") N("handled_sequence_of_statements") N("EX") "end" [N("identifier")]);
N("entry_index") ::= N("expression");
N("entry_body") ::= (N("NL") "entry" N("defining_identifier") N("entry_body_formal_part") N("entry_barrier") "is" N("IN") N("blockeol") N("declarative_part") N("EX") "begin" N("IN") N("eol") N("handled_sequence_of_statements") N("EX") "end" [N("identifier")] N("unitsemi"));
N("entry_body_formal_part") ::= ([N("entry_body_formal_part_specification")] N("parameter_profile"));
N("entry_body_formal_part_specification") ::= ("(" N("entry_index_specification") ")");
N("entry_barrier") ::= ("when" N("condition"));
N("entry_index_specification") ::= ("for" N("defining_identifier") "in" N("discrete_subtype_definition"));
N("entry_call_statement") ::= (N("name") [N("actual_parameter_part")] N("semi"));
N("requeue_statement") ::= ("requeue" N("name") [N("requeue_statement_with_abort")] N("semi"));
N("requeue_statement_with_abort") ::= ("with" "abort");
N("delay_statement") ::= (N("delay_until_statement") | N("delay_relative_statement"));
N("delay_until_statement") ::= ("delay" "until" N("expression") N("semi"));
N("delay_relative_statement") ::= ("delay" N("expression") N("semi"));
N("select_statement") ::= (N("selective_accept") | N("timed_entry_call") | N("conditional_entry_call") | N("asynchronous_select"));
N("selective_accept") ::= ("select" N("IN") N("eol") [N("guard")] N("select_alternative") (N("selective_accept_or_alternative"))* [N("selective_accept_else_alternative")] N("EX") "end" "select" N("unitsemi"));
N("selective_accept_or_alternative") ::= (N("EX") "or" N("IN") N("eol") [N("guard")] N("select_alternative"));
N("selective_accept_else_alternative") ::= ("else" N("sequence_of_statements"));
N("guard") ::= ("when" N("condition") N("arrow"));
N("select_alternative") ::= (N("accept_alternative") | N("delay_alternative") | N("terminate_alternative"));
N("accept_alternative") ::= (N("accept_statement") [N("sequence_of_statements")]);
N("delay_alternative") ::= (N("delay_statement") [N("sequence_of_statements")]);
N("terminate_alternative") ::= ("terminate" N("semi"));
N("timed_entry_call") ::= ("select" N("IN") N("eol") N("entry_call_alternative") N("EX") "or" N("IN") N("eol") N("delay_alternative") N("EX") "end" "select" N("unitsemi"));
N("entry_call_alternative") ::= (N("procedure_or_entry_call") [N("sequence_of_statements")]);
N("procedure_or_entry_call") ::= (N("procedure_call_statement") | N("entry_call_statement"));
N("conditional_entry_call") ::= ("select" N("IN") N("eol") N("entry_call_alternative") N("EX") "else" N("IN") N("eol") N("sequence_of_statements") N("EX") "end" "select" N("unitsemi"));
N("asynchronous_select") ::= ("select" N("IN") N("eol") N("triggering_alternative") (N("EX") N("EX")) "then" "abort" N("IN") N("eol") N("abortable_part") N("EX") "end" "select" N("unitsemi"));
N("triggering_alternative") ::= (N("triggering_statement") [N("sequence_of_statements")]);
N("triggering_statement") ::= (N("procedure_or_entry_call") | N("delay_statement"));
N("abortable_part") ::= N("sequence_of_statements");
N("abort_statement") ::= ("abort" sep+(N("abort_name"), ",") N("semi"));
N("abort_name") ::= N("name");
N("compilation") ::= (N("compilation_unit"))*;
N("compilation_unit") ::= ((N("context_clause") N("library_item")) | (N("context_clause") N("subunit")) | N("pragma"));
N("library_item") ::= ((["private"] N("library_unit_declaration")) | N("library_unit_body") | (["private"] N("library_unit_renaming_declaration")));
N("library_unit_declaration") ::= (N("subprogram_declaration") | N("package_declaration") | N("generic_declaration") | N("generic_instantiation") | N("pragma"));
N("library_unit_renaming_declaration") ::= (N("package_renaming_declaration") | N("generic_renaming_declaration") | N("subprogram_renaming_declaration") | N("pragma"));
N("library_unit_body") ::= (N("subprogram_body") | N("package_body"));
N("parent_unit_name") ::= N("name");
N("context_clause") ::= (N("context_item"))*;
N("context_item") ::= (N("with_clause") | N("use_clause"));
N("with_clause") ::= (N("limited_with_clause") | N("nonlimited_with_clause"));
N("limited_with_clause") ::= ("limited" ["private"] "with" sep+(N("with_name"), ",") N("semi"));
N("with_name") ::= N("name");
N("nonlimited_with_clause") ::= (["private"] "with" sep+(N("with_name"), ",") N("semi"));
N("body_stub") ::= (N("subprogram_body_stub") | N("package_body_stub") | N("task_body_stub") | N("protected_body_stub"));
N("subprogram_body_stub") ::= ([N("overriding_indicator")] N("subprogram_specification") "is" "separate" N("blocksemi"));
N("package_body_stub") ::= (N("NL") "package" "body" N("defining_identifier") "is" "separate" N("blocksemi"));
N("task_body_stub") ::= ("task" "body" N("defining_identifier") "is" "separate" N("blocksemi"));
N("protected_body_stub") ::= ("protected" "body" N("defining_identifier") "is" "separate" N("blocksemi"));
N("subunit") ::= ("separate" "(" N("parent_unit_name") ")" N("proper_body"));
N("exception_declaration") ::= (N("defining_identifier_list") N("colon") "exception" N("semi"));
N("handled_sequence_of_statements") ::= (N("sequence_of_statements") [N("handled_sequence_of_statements_exception")]);
N("handled_sequence_of_statements_exception") ::= ("exception" N("IN") N("eol") (N("exception_handler"))+ N("EX"));
N("exception_handler") ::= ("when" [N("exception_handler_specification")] N("exception_choice") (N("or_exception_choice"))* N("arrow") N("sequence_of_statements"));
N("exception_handler_specification") ::= (N("choice_parameter_specification") N("colon"));
N("or_exception_choice") ::= (N("orbar") N("exception_choice"));
N("choice_parameter_specification") ::= N("defining_identifier");
N("exception_choice") ::= (N("name") | "others");
N("raise_statement") ::= (("raise" N("semi")) | ("raise" N("name") [N("raise_statement_expression")] N("semi")));
N("raise_statement_expression") ::= ("with" N("expression"));
N("generic_declaration") ::= (N("generic_subprogram_declaration") | N("generic_package_declaration"));
N("generic_subprogram_declaration") ::= (N("generic_formal_part") N("subprogram_specification") N("blocksemi"));
N("generic_package_declaration") ::= (N("generic_formal_part") N("package_specification") N("blocksemi"));
N("generic_formal_part") ::= ("generic" (N("generic_formal_parameter_declaration_or_use_clause"))*);
N("generic_formal_parameter_declaration_or_use_clause") ::= (N("generic_formal_parameter_declaration") | N("use_clause") | N("pragma"));
N("generic_formal_parameter_declaration") ::= (N("formal_object_declaration") | N("formal_type_declaration") | N("formal_subprogram_declaration") | N("formal_package_declaration"));
N("generic_instantiation") ::= (("package" N("defining_program_unit_name") "is" N("generic_instantiation_clause")) | ([N("overriding_indicator")] "procedure" N("defining_program_unit_name") "is" N("generic_instantiation_clause")) | ([N("overriding_indicator")] "function" N("defining_designator") "is" N("generic_instantiation_clause")));
N("generic_instantiation_clause") ::= ("new" N("name") [N("generic_actual_part")] N("blocksemi"));
N("generic_actual_part") ::= ("(" sep+(N("generic_association"), ",") ")");
N("generic_association") ::= ([N("generic_association_selector_name")] N("explicit_generic_actual_parameter"));
N("generic_association_selector_name") ::= (N("selector_name") N("arrow"));
N("explicit_generic_actual_parameter") ::= (N("expression") | N("name") | N("subtype_mark"));
N("formal_object_declaration") ::= ((N("defining_identifier_list") N("colon") N("mode") [N("null_exclusion")] N("subtype_mark") [N("formal_object_declaration_default")] N("semi")) | (N("defining_identifier_list") N("colon") N("mode") N("access_definition") [N("formal_object_declaration_default")] N("semi")));
N("formal_object_declaration_default") ::= (N("colon_equals") N("default_expression"));
N("formal_type_declaration") ::= ("type" N("defining_identifier") [N("discriminant_part")] "is" N("formal_type_definition") N("blocksemi"));
N("formal_type_definition") ::= (N("formal_private_type_definition") | N("formal_derived_type_definition") | N("formal_discrete_type_definition") | N("formal_signed_integer_type_definition") | N("formal_modular_type_definition") | N("formal_floating_point_definition") | N("formal_ordinary_fixed_point_definition") | N("formal_decimal_fixed_point_definition") | N("formal_array_type_definition") | N("formal_access_type_definition") | N("formal_interface_type_definition"));
N("formal_private_type_definition") ::= ([N("formal_private_type_definition_tagged")] ["limited"] "private");
N("formal_private_type_definition_tagged") ::= (["abstract"] "tagged");
N("formal_derived_type_definition") ::= (["abstract"] [N("formal_derived_type_definition_modifier")] "new" N("subtype_mark") [N("formal_derived_type_definition_interface_list")]);
N("formal_derived_type_definition_modifier") ::= ("limited" | "synchronized");
N("formal_derived_type_definition_interface_list") ::= ([N("and_interface_list")] "with" "private");
N("and_interface_list") ::= ("and" N("interface_list"));
N("formal_discrete_type_definition") ::= ("(" "<>" ")");
N("formal_signed_integer_type_definition") ::= ("range" "<>");
N("formal_modular_type_definition") ::= ("mod" "<>");
N("formal_floating_point_definition") ::= ("digits" "<>");
N("formal_ordinary_fixed_point_definition") ::= ("delta" "<>");
N("formal_decimal_fixed_point_definition") ::= ("delta" "<>" "digits" "<>");
N("formal_array_type_definition") ::= N("array_type_definition");
N("formal_access_type_definition") ::= N("access_type_definition");
N("formal_interface_type_definition") ::= N("interface_type_definition");
N("formal_subprogram_declaration") ::= (N("formal_concrete_subprogram_declaration") | N("formal_abstract_subprogram_declaration"));
N("formal_concrete_subprogram_declaration") ::= ("with" N("subprogram_specification") [N("formal_concrete_subprogram_declaration_default")] N("semi"));
N("formal_concrete_subprogram_declaration_default") ::= ("is" N("subprogram_default"));
N("formal_abstract_subprogram_declaration") ::= ("with" N("subprogram_specification") "is" "abstract" [N("subprogram_default")] N("semi"));
N("subprogram_default") ::= (N("default_name") | "<>" | "null");
N("default_name") ::= N("name");
N("formal_package_declaration") ::= ("with" "package" N("defining_identifier") "is" "new" N("name") N("formal_package_actual_part") N("semi"));
N("formal_package_actual_part") ::= (("(" [N("others_arrow")] "<>" ")") | [N("generic_actual_part")] | ("(" sep+(N("formal_package_association"), ",") [N("comma_others_arrow_null")] ")"));
N("others_arrow") ::= ("others" N("arrow"));
N("comma_others_arrow_null") ::= ("," "others" N("arrow") "<>");
N("formal_package_association") ::= (N("generic_association") | (N("selector_name") N("arrow") "<>"));
N("aspect_clause") ::= (N("attribute_definition_clause") | N("enumeration_representation_clause") | N("record_representation_clause") | N("at_clause"));
N("local_name") ::= (N("direct_name") | (N("direct_name") N("SPOFF") "'" N("attribute_designator") N("SPON")));
N("library_unit_name") ::= N("name");
N("attribute_definition_clause") ::= ("for" N("local_name") N("SPOFF") "'" N("attribute_designator") N("SPON") "use" N("expression") N("blocksemi"));
N("enumeration_representation_clause") ::= ("for" N("local_name") "use" N("enumeration_aggregate") N("blocksemi"));
N("enumeration_aggregate") ::= N("array_aggregate");
N("record_representation_clause") ::= ("for" N("local_name") "use" N("IN") N("eol") "record" [N("mod_clause")] N("IN") N("eol") (N("component_clause"))* N("EX") "end" "record" N("blocksemi") N("EX"));
N("component_clause") ::= (N("local_name") "at" N("position") "range" N("first_bit") N("SP") ".." N("SP") N("last_bit") N("semi"));
N("position") ::= N("expression");
N("first_bit") ::= N("simple_expression");
N("last_bit") ::= N("simple_expression");
N("code_statement") ::= (N("qualified_expression") N("semi"));
N("restriction") ::= (N("identifier") [N("arrow_restriction_parameter_argument")]);
N("arrow_restriction_parameter_argument") ::= (N("arrow") N("restriction_parameter_argument"));
N("restriction_parameter_argument") ::= N("expression");
N("delta_constraint") ::= ("delta" N("expression") [N("range_constraint")]);
N("at_clause") ::= ("for" N("direct_name") "use" "at" N("expression") N("semi"));
N("mod_clause") ::= ("at" "mod" N("expression") N("semi"));
