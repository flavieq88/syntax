N("identifier") ::= (N("letter") (([N("underscore")] N("letter_or_digit")))*);
N("letter_or_digit") ::= (N("letter") | N("digit"));
N("letter") ::= (N("upper_case_letter") | N("lower_case_letter"));
N("number") ::= (N("integer_number") | N("approximate_number"));
N("integer_number") ::= (N("integer") | N("based_integer"));
N("integer") ::= (N("digit") (([N("underscore")] N("digit")))*);
N("based_integer") ::= (N("base") "#" N("extended_digit") (([N("underscore")] N("extended_digit")))*);
N("base") ::= N("integer");
N("extended_digit") ::= (N("digit") | N("letter"));
N("approximate_number") ::= ((N("integer") "." N("integer") [("E" N("exponent"))]) | (N("integer") "E" N("exponent")));
N("exponent") ::= ((["+"] N("integer")) | ("-" N("integer")));
N("character_string") ::= (N("DQUOTE") (N("character"))* N("DQUOTE"));
N("pragma") ::= ("pragma" N("identifier") [("(" N("argument") (("," N("argument")))* ")")] ";");
N("argument") ::= (N("identifier") | N("character_string") | N("number"));
N("declaration") ::= (N("object_declaration") | N("type_declaration") | N("subtype_declaration") | N("private_type_declaration") | N("subprogram_declaration") | N("module_declaration") | N("entry_declaration") | N("exception_declaration") | N("renaming_declaration"));
N("object_declaration") ::= (N("identifier_list") ":" ["constant"] N("type") [(":=" N("expression"))] ";");
N("identifier_list") ::= (N("identifier") (("," N("identifier")))*);
N("type") ::= (N("type_definition") | (N("type_mark") [N("constraint")]));
N("type_definition") ::= (N("enumeration_type_definition") | N("integer_type_definition") | N("real_type_definition") | N("array_type_definition") | N("record_type_definition") | N("access_type_definition") | N("derived_type_definition"));
N("type_mark") ::= (N("type_name") | N("subtype_name"));
N("constraint") ::= (N("range_constraint") | N("accuracy_constraint") | N("index_constraint") | N("discriminant_constraint"));
N("type_declaration") ::= ("type" N("identifier") [("is" N("type_definition"))] ";");
N("subtype_declaration") ::= ("subtype" N("identifier") "is" N("type_mark") [N("constraint")] ";");
N("derived_type_definition") ::= ("new" N("type_mark") [N("constraint")]);
N("range_constraint") ::= ("range" N("range"));
N("range") ::= (N("simple_expression") ".." N("simple_expression"));
N("enumeration_type_definition") ::= ("(" N("enumeration_literal") (("," N("enumeration_literal")))* ")");
N("enumeration_literal") ::= (N("identifier") | N("character_literal"));
N("integer_type_definition") ::= N("range_constraint");
N("real_type_definition") ::= N("accuracy_constraint");
N("accuracy_constraint") ::= (("digits" N("simple_expression") [N("range_constraint")]) | ("delta" N("simple_expression") [N("range_constraint")]));
N("array_type_definition") ::= ("array" "(" N("index") (("," N("index")))* ")" "of" N("type_mark") [N("constraint")]);
N("index") ::= (N("discrete_range") | N("type_mark"));
N("discrete_range") ::= ([(N("type_mark") "range")] N("range"));
N("index_constraint") ::= ("(" N("discrete_range") (("," N("discrete_range")))* ")");
N("aggregate") ::= ("(" N("component_association") (("," N("component_association")))* ")");
N("component_association") ::= ([("choice" (("|" N("choice")))* "=>")] N("expression"));
N("choice") ::= (N("simple_expression") | N("discrete_range") | "others");
N("record_type_definition") ::= ("record" N("component_list") "end" "record");
N("component_list") ::= (((N("object_declaration"))* [N("variant_part")]) | ("null" ";"));
N("variant_part") ::= ("case" N("discriminant") "of" (("when" N("choice") (("|" N("choice")))* "=>" N("component_list")))* "end" "case" ";");
N("discriminant") ::= (N("constant_name") ".." N("component_name"));
N("discriminant_constraint") ::= N("aggregate");
N("access_type_definition") ::= ("access" N("type"));
N("name") ::= (N("identifier") | N("indexed_component") | N("selected_component") | N("predefined_attribute"));
N("indexed_component") ::= (N("name") "(" N("expression") (("," N("expression")))* ")");
N("selected_component") ::= (N("name") "." N("identifier"));
N("predefined_attribute") ::= (N("name") "'" N("identifier"));
N("literal") ::= (N("number") | N("enumeration_literal") | N("character_string") | "null");
N("variable") ::= ((N("name") [("(" N("discrete_range") ")")]) | (N("name") "." "all"));
N("expression") ::= ((N("relation") (("and" N("relation")))*) | (N("relation") (("or" N("relation")))*) | (N("relation") (("xor" N("relation")))*));
N("relation") ::= ((N("simple_expression") [(N("relational_operator") N("simple_expression"))]) | (N("simple_expression") ["not"] "in" N("range")) | (N("simple_expression") ["not"] "in" N("type_mark") [N("constraint")]));
N("simple_expression") ::= ([N("unary_operator")] N("term") ((N("adding_operator") N("term")))*);
N("term") ::= (N("factor") ((N("multiplying_operator") N("factor")))*);
N("factor") ::= (N("primary") [("**" N("primary"))]);
N("primary") ::= (N("literal") | N("aggregate") | N("variable") | N("allocator") | N("subprogram_call") | N("qualified_expression") | ("(" N("expression") ")"));
N("logical_operator") ::= ("and" | "or" | "xor");
N("relational_operator") ::= ("=" | "/=" | "<" | "<=" | ">" | ">=");
N("adding_operator") ::= ("+" | "-" | "&");
N("unary_operator") ::= ("+" | "-" | "not");
N("multiplying_operator") ::= ("*" | "/" | "mod");
N("exponentiating_operator") ::= "**";
N("qualified_expression") ::= ((N("type_mark") "(" N("expression") ")") | (N("type_mark") N("aggregate")));
N("allocator") ::= ("new" N("qualified_expression"));
N("seqence_of_statements") ::= (N("statement"))*;
N("statement") ::= (N("simple_statement") | N("compound_statement") | ("<<" N("identifier") ">>" N("statement")));
N("simple_statement") ::= (N("assignment_statement") | N("subprogram_call_statement") | N("exit_statement") | N("return_statement") | N("goto_statement") | N("assert_statement") | N("initiate_statement") | N("delay_statement") | N("raise_statement") | N("abort_statement") | N("code_statement") | ("null" ";"));
N("compound_statement") ::= (N("if_statement") | N("case_statement") | N("loop_statement") | N("accept_statement") | N("select_statement") | N("block"));
N("assignment_statement") ::= (N("variable") ":=" N("expression"));
N("subprogram_call_statement") ::= N("subprogram_call");
N("subprogram_call") ::= (N("subprogram_name") [("(" N("parameter_association") (("," N("parameter_association")))* ")")]);
N("parameter_association") ::= (([(N("formal_parameter") ":=")] N("actual_parameter")) | ([(N("formal_parameter") "=:")] N("actual_parameter")) | ([(N("formal_parameter") ":=:")] N("actual_parameter")));
N("formal_parameter") ::= N("identifier");
N("actual_parameter") ::= N("expression");
N("return_statement") ::= ("return" [N("expression")] ";");
N("if_statement") ::= ("if" N("condition") "then" N("seqence_of_statements") (("elseif" N("condition") "then" N("seqence_of_statements")))* [("else" N("seqence_of_statements"))] "end" "if" ";");
N("condition") ::= ((N("expression") (("and" "then" N("expression")))*) | (N("expression") (("or" "else" N("expression")))*));
N("case_statement") ::= ("case" N("expression") "of" (("when" N("choice") (("|" N("choice")))* "=>" N("seqence_of_statements")))* "end" "case" ";");
N("loop_statement") ::= ([N("iteration_specification")] N("basic_loop"));
N("basic_loop") ::= ("loop" N("seqence_of_statements") "end" "loop" [N("identifier")] ";");
N("iteration_specification") ::= (("for" N("loop_parameter") "in" ["reverse"] N("discrete_range")) | ("while" N("condition")));
N("loop_parameter") ::= N("identifier");
N("exit_statement") ::= ("exit" [N("identifier")] [("when" N("condition"))] ";");
N("goto_statement") ::= ("goto" N("identifier") ";");
N("assert_statement") ::= ("assert" N("condition") ";");
N("declarative_part") ::= ([N("use_clause")] (N("declaration"))* (N("representation_specification"))* (N("body"))*);
N("body") ::= (([N("visibility_restriction")] N("unit_body")) | N("body_stub"));
N("unit_body") ::= (N("subprogram_body") | N("module_specification") | N("module_body"));
N("subprogram_declaration") ::= ((N("subprogram_specification") ";") | (N("subprogram_nature") N("designator") "is" N("generic_instantiation") ";"));
N("subprogram_specification") ::= ([N("generic_clause")] N("subprogram_nature") N("designator") [N("formal_part")] [("return" N("type_mark") [N("constraint")])]);
N("subprogram_nature") ::= ("function" | "procedure");
N("designator") ::= (N("identifier") | N("character_string"));
N("formal_part") ::= ("(" N("parameter_declaration") ((";" N("parameter_declaration")))* ")");
N("parameter_declaration") ::= (N("identifier_list") ":" N("mode") N("type_mark") [N("constraint")] [(":=" N("expression"))]);
N("mode") ::= (["in"] | "out" | ("in" "out"));
N("subprogram_body") ::= (N("subprogram_specification") "is" N("declarative_part") "begin" N("seqence_of_statements") [("exception" (N("exception_handler"))*)] "end" [N("designator")] ";");
N("block") ::= ([("declare" N("declarative_part"))] "begin" N("seqence_of_statements") [("exception" (N("exception_handler"))*)] "end" [N("identifier")] ";");
N("module_declaration") ::= (([N("visibility_restriction")] N("module_declaration")) | (N("module_nature") N("identifier") [("(" N("discrete_range") ")")] "is" N("generic_instantiation") ";"));
N("module_specification") ::= ([N("generic_clause")] N("module_nature") N("identifier_list") [("(" N("discrete_range") ")")] [("is" N("declarative_part") [("private" N("declarative_part"))] "end" N("identifier"))] ";");
N("module_nature") ::= ("package" | "task");
N("module_body") ::= (N("module_nature") "body" N("identifier") "is" N("declarative_part") [("begin" N("seqence_of_statements"))] [("exception" (N("exception_handler"))*)] "end" [N("identifier")] ";");
N("private_type_declaration") ::= (["restricted"] "type" N("identifier") "is" "private" ";");
N("visibility_restriction") ::= ("restricted" [N("visibility_list")]);
N("visibility_list") ::= ("(" N("unit_name") (("," N("unit_name")))* ")");
N("use_clause") ::= ("use" N("module_name") (("," N("module_name")))* ";");
N("renaming_declaration") ::= ((N("identifier") ":" N("type_mark") "renames" N("name") ";") | (N("identifier") ":" "exception" "renames" N("name") ";") | (N("subprogram_nature") N("designator") "renames" [(N("name") ".")] N("designator") ";") | (N("module_nature") N("identifier") "renames" N("name") ";"));
N("initiate_statement") ::= ("initiate" N("task_designator") (("," N("task_designator")))* ";");
N("task_designator") ::= (N("task_name") [("(" N("discrete_range") ")")]);
N("entry_declaration") ::= ("entry" N("identifier") [("(" N("discrete_range") ")")] [N("formal_part")] ";");
N("accept_statement") ::= ("accept" N("entry_name") [N("formal_part")] [("do" N("seqence_of_statements") "end" [N("identifier")])] ";");
N("delay_statement") ::= ("delay" N("simple_expression") ";");
N("select_statement") ::= ("select" [("when" N("condition") "=>")] N("select_alternative") (("or" [("when" N("condition") "=>")] N("select_alternative")))* [("else" N("seqence_of_statements"))] "end" "select" ";");
N("select_alternative") ::= ((N("accept_statement") [N("seqence_of_statements")]) | (N("delay_statement") [N("seqence_of_statements")]));
N("abort_statement") ::= ("abort" N("task_designator") (("," N("task_designator")))* ";");
N("compilation") ::= (N("compilation_unit"))*;
N("compilation_unit") ::= ([N("visibility_restriction")] ["separate"] N("unit_body"));
N("body_stub") ::= ((N("subprogram_specification") "is" "separate" ";") | (N("module_nature") "body" N("identifier") "is" "separate" ";"));
N("exception_declaration") ::= (N("identifier_list") ":" "exception" ";");
N("exception_handler") ::= ("when" N("exception_choice") (("|" N("exception_choice")))* "=>" N("seqence_of_statements"));
N("exception_choice") ::= (N("exception_name") | "others");
N("raise_statement") ::= ("rause" [N("exception_name")] ";");
N("generic_clause") ::= ("generic" [("(" N("generic_parameter") ((";" N("generic_parameter")))* ")")]);
N("generic_parameter") ::= (N("parameter_declaration") | (N("subprogram_specification") [("is" [(N("name") ".")] N("designator"))]) | (["restricted"] "type" N("identifier")));
N("generic_instantiation") ::= ("new" N("name") [("(" N("generic_association") (("," N("generic_association")))* ")")]);
N("generic_association") ::= (N("parameter_association") | ([(N("formal_parameter") "is")] [(N("name") ".")] N("designator")) | ([(N("formal_parameter") "is")] N("type_mark")));
N("representation_specification") ::= (N("packing_specification") | N("length_specification") | N("record_type_representation") | N("address_specification") | N("enumeration_type_representation"));
N("packing_specification") ::= ("for" N("type_name") "use" "packing" ";");
N("length_specification") ::= ("for" N("name") "use" N("static_expression") ";");
N("enumeration_type_representation") ::= ("for" N("type_name") "use" N("aggregate") ";");
N("record_type_representation") ::= ("for" N("type_name") "use" "record" [(N("alignment_clause") ";")] ((N("component_name") N("location") ";"))* "end" "record" ";");
N("location") ::= ("at" N("static_expression") "range" N("range"));
N("alignment_clause") ::= ("at" "mod" N("static_expression"));
N("address_specification") ::= ("for" N("name") "use" "at" N("static_expression") ";");
N("code_statement") ::= (N("qualified_expression") ";");
