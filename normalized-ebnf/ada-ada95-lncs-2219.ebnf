N("character") ::= (N("graphic_character") | N("format_effector") | N("other_control_function"));
N("graphic_character") ::= (N("identifier_letter") | N("digit") | N("space_character") | N("special_character"));
N("identifier") ::= (N("identifier_letter") (([N("underline")] N("letter_or_digit")))*);
N("letter_or_digit") ::= (N("identifier_letter") | N("digit"));
N("numeric_literal") ::= (N("decimal_literal") | N("based_literal"));
N("decimal_literal") ::= (N("numeral") [("." N("numeral"))] [N("exponent")]);
N("numeral") ::= (N("digit") (([N("underline")] N("digit")))*);
N("exponent") ::= (("E" ["+"] N("numeral")) | ("E" "-" N("numeral")));
N("based_literal") ::= (N("base") "#" N("based_numeral") [("." N("based_numeral"))] "#" [N("exponent")]);
N("base") ::= N("numeral");
N("based_numeral") ::= (N("extended_digit") (([N("underline")] N("extended_digit")))*);
N("extended_digit") ::= (N("digit") | "A" | "B" | "C" | "D" | "E" | "F");
N("character_literal") ::= ("'" N("graphic_character") "'");
N("string_literal") ::= ("\"" (N("string_element"))* "\"");
N("string_element") ::= ("\"\"" | N("non_quotation_mark_graphic_character"));
N("comment") ::= ("-" "-" (N("non_end_of_line_character"))*);
N("pragma") ::= ("pragma" N("identifier") [("(" N("pragma_argument_association") (("," N("pragma_argument_association")))* ")")] ";");
N("pragma_argument_association") ::= (([(N("pragma_argument_identifier") "=>")] N("name")) | ([(N("pragma_argument_identifier") "=>")] N("expression")));
N("basic_declaration") ::= (N("type_declaration") | N("object_declaration") | N("subprogram_declaration") | N("package_declaration") | N("exception_declaration") | N("generic_instantiation") | N("subtype_declaration") | N("number_declaration") | N("abstract_subprogram_declaration") | N("renaming_declaration") | N("generic_declaration"));
N("defining_identifier") ::= N("identifier");
N("type_declaration") ::= (N("full_type_declaration") | N("incomplete_type_declaration") | N("private_type_declaration") | N("private_extension_declaration"));
N("full_type_declaration") ::= (("type" N("defining_identifier") [N("known_discriminant_part")] "is" N("type_definition") ";") | N("task_type_declaration") | N("protected_type_declaration"));
N("type_definition") ::= (N("enumeration_type_definition") | N("real_type_definition") | N("record_type_definition") | N("derived_type_definition") | N("integer_type_definition") | N("array_type_definition") | N("access_type_definition"));
N("subtype_declaration") ::= ("subtype" N("defining_identifier") "is" N("subtype_indication") ";");
N("subtype_indication") ::= (N("subtype_mark") [N("constraint")]);
N("subtype_mark") ::= N("subtype_name");
N("constraint") ::= (N("scalar_constraint") | N("composite_constraint"));
N("scalar_constraint") ::= (N("range_constraint") | N("digits_constraint") | N("delta_constraint"));
N("composite_constraint") ::= (N("index_constraint") | N("discriminant_constraint"));
N("object_declaration") ::= ((N("defining_identifier_list") ":" ["aliased"] ["constant"] N("subtype_indication") [(":=" N("expression"))] ";") | (N("defining_identifier_list") ":" ["aliased"] ["constant"] N("array_type_definition") [(":=" N("expression"))] ";") | N("single_task_declaration") | N("single_protected_declaration"));
N("defining_identifier_list") ::= (N("defining_identifier") (("," N("defining_identifier")))*);
N("number_declaration") ::= (N("defining_identifier_list") ":" "constant" ":=" N("static_expression") ";");
N("derived_type_definition") ::= (["abstract"] "new" N("parent_subtype_indication") [N("record_extension_part")]);
N("range_constraint") ::= ("range" N("range"));
N("range") ::= (N("range_attribute_reference") | (N("simple_expression") ".." N("simple_expression")));
N("enumeration_type_definition") ::= ("(" N("enumeration_literal_specification") (("," N("enumeration_literal_specification")))* ")");
N("enumeration_literal_specification") ::= (N("defining_identifier") | N("defining_character_literal"));
N("defining_character_literal") ::= N("character_literal");
N("integer_type_definition") ::= (N("signed_integer_type_definition") | N("modular_type_definition"));
N("signed_integer_type_definition") ::= ("range" N("static_simple_expression") ".." N("static_simple_expression"));
N("modular_type_definition") ::= ("mod" N("static_expression"));
N("real_type_definition") ::= (N("floating_point_definition") | N("fixed_point_definition"));
N("floating_point_definition") ::= ("digits" N("static_expression") [N("real_range_specification")]);
N("real_range_specification") ::= ("range" N("static_simple_expression") ".." N("static_simple_expression"));
N("fixed_point_definition") ::= (N("ordinary_fixed_point_definition") | N("decimal_fixed_point_definition"));
N("ordinary_fixed_point_definition") ::= ("delta" N("static_expression") N("real_range_specification"));
N("decimal_fixed_point_definition") ::= ("delta" N("static_expression") "digits" N("static_expression") [N("real_range_specification")]);
N("digits_constraint") ::= ("digits" N("static_expression") [N("range_constraint")]);
N("array_type_definition") ::= (N("unconstrained_array_definition") | N("constrained_array_definition"));
N("unconstrained_array_definition") ::= ("array" "(" N("index_subtype_definition") (("," N("index_subtype_definition")))* ")" "of" N("component_definition"));
N("index_subtype_definition") ::= (N("subtype_mark") "range" "<>");
N("constrained_array_definition") ::= ("array" "(" N("discrete_subtype_definition") (("," N("discrete_subtype_definition")))* ")" "of" N("component_definition"));
N("discrete_subtype_definition") ::= (N("discrete_subtype_indication") | N("range"));
N("component_definition") ::= (["aliased"] N("subtype_indication"));
N("index_constraint") ::= ("(" N("discrete_range") (("," N("discrete_range")))* ")");
N("discrete_range") ::= (N("discrete_subtype_indication") | N("range"));
N("discriminant_part") ::= (N("unknown_discriminant_part") | N("known_discriminant_part"));
N("unknown_discriminant_part") ::= "(<>)";
N("known_discriminant_part") ::= ("(" N("discriminant_specification") ((";" N("discriminant_specification")))* ")");
N("discriminant_specification") ::= ((N("defining_identifier_list") ":" N("subtype_mark") [(":=" N("default_expression"))]) | (N("defining_identifier_list") ":" N("access_definition") [(":=" N("default_expression"))]));
N("default_expression") ::= N("expression");
N("discriminant_constraint") ::= ("(" N("discriminant_association") (("," N("discriminant_association")))* ")");
N("discriminant_association") ::= ([(N("discriminant_selector_name") (("|" N("discriminant_selector_name")))* "=>")] N("expression"));
N("record_type_definition") ::= ([(["abstract"] "tagged")] ["limited"] N("record_definition"));
N("record_definition") ::= (("record" N("component_list") "end" "record") | ("null" "record"));
N("component_list") ::= ((N("component_item") (N("component_item"))*) | ((N("component_item"))* N("variant_part")) | ("null" ";"));
N("component_item") ::= (N("component_declaration") | N("aspect_clause"));
N("component_declaration") ::= (N("defining_identifier_list") ":" N("component_definition") [(":=" N("default_expression"))] ";");
N("variant_part") ::= ("case" N("discriminant_direct_name") "is" (N("variant"))+ "end" "case" ";");
N("variant") ::= ("when" N("discrete_choice_list") "=>" N("component_list"));
N("discrete_choice_list") ::= (N("discrete_choice") (("|" N("discrete_choice")))*);
N("discrete_choice") ::= (N("expression") | N("discrete_range") | "others");
N("record_extension_part") ::= ("with" N("record_definition"));
N("access_type_definition") ::= (N("access_to_object_definition") | N("access_to_subprogram_definition"));
N("access_to_object_definition") ::= ("access" [N("general_access_modifier")] N("subtype_indication"));
N("general_access_modifier") ::= ("all" | "constant");
N("access_to_subprogram_definition") ::= (("access" ["protected"] "procedure" N("parameter_profile")) | ("access" ["protected"] "function" N("parameter_and_result_profile")));
N("access_definition") ::= ("access" N("subtype_mark"));
N("incomplete_type_declaration") ::= ("type" N("defining_identifier") [N("discriminant_part")] ";");
N("declarative_part") ::= (N("declarative_item"))*;
N("declarative_item") ::= (N("basic_declarative_item") | N("body"));
N("basic_declarative_item") ::= (N("basic_declaration") | N("aspect_clause") | N("use_clause"));
N("body") ::= (N("proper_body") | N("body_stub"));
N("proper_body") ::= (N("subprogram_body") | N("package_body") | N("task_body") | N("protected_body"));
N("name") ::= (N("direct_name") | N("indexed_component") | N("selected_component") | N("type_conversion") | N("character_literal") | N("explicit_dereference") | N("slice") | N("attribute_reference") | N("function_call"));
N("direct_name") ::= (N("identifier") | N("operator_symbol"));
N("prefix") ::= (N("name") | N("implicit_dereference"));
N("explicit_dereference") ::= (N("name") "." "all");
N("implicit_dereference") ::= N("name");
N("indexed_component") ::= (N("prefix") "(" N("expression") (("," N("expression")))* ")");
N("slice") ::= (N("prefix") "(" N("discrete_range") ")");
N("selected_component") ::= (N("prefix") "." N("selector_name"));
N("selector_name") ::= (N("identifier") | N("character_literal") | N("operator_symbol"));
N("attribute_reference") ::= (N("prefix") "'" N("attribute_designator"));
N("attribute_designator") ::= ((N("identifier") [("(" N("static_expression") ")")]) | "Access" | "Delta" | "Digits");
N("range_attribute_reference") ::= (N("prefix") "'" N("range_attribute_designator"));
N("range_attribute_designator") ::= ("Range" [("(" N("static_expression") ")")]);
N("aggregate") ::= (N("record_aggregate") | N("extension_aggregate") | N("array_aggregate"));
N("record_aggregate") ::= ("(" N("record_component_association_list") ")");
N("record_component_association_list") ::= ((N("record_component_association") (("," N("record_component_association")))*) | ("null" "record"));
N("record_component_association") ::= ([(N("component_choice_list") "=>")] N("expression"));
N("component_choice_list") ::= ((N("component_selector_name") (("|" N("component_selector_name")))*) | "others");
N("extension_aggregate") ::= ("(" N("ancestor_part") "with" N("record_component_association_list") ")");
N("ancestor_part") ::= (N("expression") | N("subtype_mark"));
N("array_aggregate") ::= (N("positional_array_aggregate") | N("named_array_aggregate"));
N("positional_array_aggregate") ::= (("(" N("expression") "," N("expression") (("," N("expression")))* ")") | ("(" N("expression") (("," N("expression")))* "," "others" "=>" N("expression") ")"));
N("named_array_aggregate") ::= ("(" N("array_component_association") (("," N("array_component_association")))* ")");
N("array_component_association") ::= (N("discrete_choice_list") "=>" N("expression"));
N("expression") ::= ((N("relation") (("and" N("relation")))*) | (N("relation") (("or" N("relation")))*) | (N("relation") (("xor" N("relation")))*) | (N("relation") (("and" "then" N("relation")))*) | (N("relation") (("or" "else" N("relation")))*));
N("relation") ::= ((N("simple_expression") [(N("relational_operator") N("simple_expression"))]) | (N("simple_expression") ["not"] "in" N("range")) | (N("simple_expression") ["not"] "in" N("subtype_mark")));
N("simple_expression") ::= ([N("unary_adding_operator")] N("term") ((N("binary_adding_operator") N("term")))*);
N("term") ::= (N("factor") ((N("multiplying_operator") N("factor")))*);
N("factor") ::= ((N("primary") [("**" N("primary"))]) | ("abs" N("primary")) | ("not" N("primary")));
N("primary") ::= (N("numeric_literal") | "null" | N("string_literal") | N("aggregate") | N("name") | N("qualified_expression") | N("allocator") | ("(" N("expression") ")"));
N("logical_operator") ::= ("and" | "or" | "xor");
N("relational_operator") ::= ("=" | "/=" | "<" | "<=" | ">" | ">=");
N("binary_adding_operator") ::= ("+" | "-" | "&");
N("unary_adding_operator") ::= ("+" | "-");
N("multiplying_operator") ::= ("*" | "/" | "mod" | "rem");
N("highest_precedence_operator") ::= ("**" | "abs" | "not");
N("type_conversion") ::= ((N("subtype_mark") "(" N("expression") ")") | (N("subtype_mark") "(" N("name") ")"));
N("qualified_expression") ::= ((N("subtype_mark") "'(" N("expression") ")") | (N("subtype_mark") "'" N("aggregate")));
N("allocator") ::= (("new" N("subtype_indication")) | ("new" N("qualified_expression")));
N("sequence_of_statements") ::= (N("statement") (N("statement"))*);
N("statement") ::= (((N("label"))* N("simple_statement")) | ((N("label"))* N("compound_statement")));
N("simple_statement") ::= (N("null_statement") | N("assignment_statement") | N("goto_statement") | N("return_statement") | N("requeue_statement") | N("abort_statement") | N("code_statement") | N("exit_statement") | N("procedure_call_statement") | N("entry_call_statement") | N("delay_statement") | N("raise_statement"));
N("compound_statement") ::= (N("if_statement") | N("loop_statement") | N("accept_statement") | N("case_statement") | N("block_statement") | N("select_statement"));
N("null_statement") ::= ("null" ";");
N("label") ::= ("<<" N("label_statement_identifier") ">>");
N("statement_identifier") ::= N("direct_name");
N("assignment_statement") ::= (N("variable_name") ":=" N("expression") ";");
N("if_statement") ::= ("if" N("condition") "then" N("sequence_of_statements") (("elsif" N("condition") "then" N("sequence_of_statements")))* [("else" N("sequence_of_statements"))] "end" "if" ";");
N("condition") ::= N("boolean_expression");
N("case_statement") ::= ("case" N("expression") "is" N("case_statement_alternative") (N("case_statement_alternative"))* "end" "case" ";");
N("case_statement_alternative") ::= ("when" N("discrete_choice_list") "=>" N("sequence_of_statements"));
N("loop_statement") ::= ([(N("loop_statement_identifier") ":")] [N("iteration_scheme")] "loop" N("sequence_of_statements") "end" "loop" [N("loop_identifier")] ";");
N("iteration_scheme") ::= (("while" N("condition")) | ("for" N("loop_parameter_specification")));
N("loop_parameter_specification") ::= (N("defining_identifier") "in" ["reverse"] N("discrete_subtype_definition"));
N("block_statement") ::= ([(N("block_statement_identifier") ":")] [("declare" N("declarative_part"))] "begin" N("handled_sequence_of_statements") "end" [N("block_identifier")] ";");
N("exit_statement") ::= ("exit" [N("loop_name")] [("when" N("condition"))] ";");
N("goto_statement") ::= ("goto" N("label_name") ";");
N("subprogram_declaration") ::= (N("subprogram_specification") ";");
N("abstract_subprogram_declaration") ::= (N("subprogram_specification") "is" "abstract" ";");
N("subprogram_specification") ::= (("procedure" N("defining_program_unit_name") N("parameter_profile")) | ("function" N("defining_designator") N("parameter_and_result_profile")));
N("designator") ::= (([(N("parent_unit_name") ".")] N("identifier")) | N("operator_symbol"));
N("defining_designator") ::= (N("defining_program_unit_name") | N("defining_operator_symbol"));
N("defining_program_unit_name") ::= ([(N("parent_unit_name") ".")] N("defining_identifier"));
N("operator_symbol") ::= N("string_literal");
N("defining_operator_symbol") ::= N("operator_symbol");
N("parameter_profile") ::= [N("formal_part")];
N("parameter_and_result_profile") ::= ([N("formal_part")] "return" N("subtype_mark"));
N("formal_part") ::= ("(" N("parameter_specification") ((";" N("parameter_specification")))* ")");
N("parameter_specification") ::= ((N("defining_identifier_list") ":" N("mode") N("subtype_mark") [(":=" N("default_expression"))]) | (N("defining_identifier_list") ":" N("access_definition") [(":=" N("default_expression"))]));
N("mode") ::= (["in"] | ("in" "out") | "out");
N("subprogram_body") ::= (N("subprogram_specification") "is" N("declarative_part") "begin" N("handled_sequence_of_statements") "end" [N("designator")] ";");
N("procedure_call_statement") ::= ((N("procedure_name") ";") | (N("procedure_prefix") N("actual_parameter_part") ";"));
N("function_call") ::= (N("function_name") | (N("function_prefix") N("actual_parameter_part")));
N("actual_parameter_part") ::= ("(" N("parameter_association") (("," N("parameter_association")))* ")");
N("parameter_association") ::= ([(N("formal_parameter_selector_name") "=>")] N("explicit_actual_parameter"));
N("explicit_actual_parameter") ::= (N("expression") | N("variable_name"));
N("return_statement") ::= ("return" [N("expression")] ";");
N("package_declaration") ::= (N("package_specification") ";");
N("package_specification") ::= ("package" N("defining_program_unit_name") "is" (N("basic_declarative_item"))* [("private" (N("basic_declarative_item"))*)] "end" [([(N("parent_unit_name") ".")] N("identifier"))]);
N("package_body") ::= ("package" "body" N("defining_program_unit_name") "is" N("declarative_part") [("begin" N("handled_sequence_of_statements"))] "end" [([(N("parent_unit_name") ".")] N("identifier"))] ";");
N("private_type_declaration") ::= ("type" N("defining_identifier") [N("discriminant_part")] "is" [(["abstract"] "tagged")] ["limited"] "private" ";");
N("private_extension_declaration") ::= ("type" N("defining_identifier") [N("discriminant_part")] "is" ["abstract"] "new" N("ancestor_subtype_indication") "with" "private" ";");
N("use_clause") ::= (N("use_package_clause") | N("use_type_clause"));
N("use_package_clause") ::= ("use" N("package_name") (("," N("package_name")))* ";");
N("use_type_clause") ::= ("use" "type" N("subtype_mark") (("," N("subtype_mark")))* ";");
N("renaming_declaration") ::= (N("object_renaming_declaration") | N("exception_renaming_declaration") | N("package_renaming_declaration") | N("subprogram_renaming_declaration") | N("generic_renaming_declaration"));
N("object_renaming_declaration") ::= (N("defining_identifier") ":" N("subtype_mark") "renames" N("object_name") ";");
N("exception_renaming_declaration") ::= (N("defining_identifier") ":" "exception" "renames" N("exception_name") ";");
N("package_renaming_declaration") ::= ("package" N("defining_program_unit_name") "renames" N("package_name") ";");
N("subprogram_renaming_declaration") ::= (N("subprogram_specification") "renames" N("callable_entity_name") ";");
N("generic_renaming_declaration") ::= (("generic" "package" N("defining_program_unit_name") "renames" N("generic_package_name") ";") | ("generic" "procedure" N("defining_program_unit_name") "renames" N("generic_procedure_name") ";") | ("generic" "function" N("defining_program_unit_name") "renames" N("generic_function_name") ";"));
N("task_type_declaration") ::= ("task" "type" N("defining_identifier") [N("known_discriminant_part")] [("is" N("task_definition"))] ";");
N("single_task_declaration") ::= ("task" N("defining_identifier") [("is" N("task_definition"))] ";");
N("task_definition") ::= ((N("task_item"))* [("private" (N("task_item"))*)] "end" [N("task_identifier")]);
N("task_item") ::= (N("entry_declaration") | N("aspect_clause"));
N("task_body") ::= ("task" "body" N("defining_identifier") "is" N("declarative_part") "begin" N("handled_sequence_of_statements") "end" [N("task_identifier")] ";");
N("protected_type_declaration") ::= ("protected" "type" N("defining_identifier") [N("known_discriminant_part")] "is" N("protected_definition") ";");
N("single_protected_declaration") ::= ("protected" N("defining_identifier") "is" N("protected_definition") ";");
N("protected_definition") ::= ((N("protected_operation_declaration"))* [("private" (N("protected_element_declaration"))*)] "end" [N("protected_identifier")]);
N("protected_operation_declaration") ::= (N("subprogram_declaration") | N("entry_declaration") | N("aspect_clause"));
N("protected_element_declaration") ::= (N("protected_operation_declaration") | N("component_declaration"));
N("protected_body") ::= ("protected" "body" N("defining_identifier") "is" (N("protected_operation_item"))* "end" [N("protected_identifier")] ";");
N("protected_operation_item") ::= (N("subprogram_declaration") | N("subprogram_body") | N("entry_body") | N("aspect_clause"));
N("entry_declaration") ::= ("entry" N("defining_identifier") [("(" N("discrete_subtype_definition") ")")] N("parameter_profile") ";");
N("accept_statement") ::= ("accept" N("entry_direct_name") [("(" N("entry_index") ")")] N("parameter_profile") [("do" N("handled_sequence_of_statements") "end" [N("entry_identifier")])] ";");
N("entry_index") ::= N("expression");
N("entry_body") ::= ("entry" N("defining_identifier") N("entry_body_formal_part") N("entry_barrier") "is" N("declarative_part") "begin" N("handled_sequence_of_statements") "end" [N("entry_identifier")] ";");
N("entry_body_formal_part") ::= ([("(" N("entry_index_specification") ")")] N("parameter_profile"));
N("entry_barrier") ::= ("when" N("condition"));
N("entry_index_specification") ::= ("for" N("defining_identifier") "in" N("discrete_subtype_definition"));
N("entry_call_statement") ::= (N("entry_name") [N("actual_parameter_part")] ";");
N("requeue_statement") ::= ("requeue" N("entry_name") [("with" "abort")] ";");
N("delay_statement") ::= (N("delay_until_statement") | N("delay_relative_statement"));
N("delay_until_statement") ::= ("delay" "until" N("delay_expression") ";");
N("delay_relative_statement") ::= ("delay" N("delay_expression") ";");
N("select_statement") ::= (N("selective_accept") | N("timed_entry_call") | N("conditional_entry_call") | N("asynchronous_select"));
N("selective_accept") ::= ("select" [N("guard")] N("select_alternative") (("or" [N("guard")] N("select_alternative")))* [("else" N("sequence_of_statements"))] "end" "select" ";");
N("guard") ::= ("when" N("condition") "=>");
N("select_alternative") ::= (N("accept_alternative") | N("delay_alternative") | N("terminate_alternative"));
N("accept_alternative") ::= (N("accept_statement") [N("sequence_of_statements")]);
N("delay_alternative") ::= (N("delay_statement") [N("sequence_of_statements")]);
N("terminate_alternative") ::= ("terminate" ";");
N("timed_entry_call") ::= ("select" N("entry_call_alternative") "or" N("delay_alternative") "end" "select" ";");
N("entry_call_alternative") ::= (N("entry_call_statement") [N("sequence_of_statements")]);
N("triggering_alternative") ::= (N("triggering_statement") [N("sequence_of_statements")]);
N("triggering_statement") ::= (N("entry_call_statement") | N("delay_statement"));
N("abortable_part") ::= N("sequence_of_statements");
N("abort_statement") ::= ("abort" N("task_name") (("," N("task_name")))* ";");
N("compilation") ::= (N("compilation_unit"))*;
N("compilation_unit") ::= ((N("context_clause") N("library_item")) | (N("context_clause") N("subunit")));
N("library_item") ::= ((["private"] N("library_unit_declaration")) | N("library_unit_body") | (["private"] N("library_unit_renaming_declaration")));
N("library_unit_declaration") ::= (N("subprogram_declaration") | N("package_declaration") | N("generic_declaration") | N("generic_instantiation"));
N("library_unit_renaming_declaration") ::= (N("package_renaming_declaration") | N("generic_renaming_declaration") | N("subprogram_renaming_declaration"));
N("library_unit_body") ::= (N("subprogram_body") | N("package_body"));
N("parent_unit_name") ::= N("name");
N("context_clause") ::= (N("context_item"))*;
N("context_item") ::= (N("with_clause") | N("use_clause"));
N("with_clause") ::= ("with" N("library_unit_name") (("," N("library_unit_name")))* ";");
N("body_stub") ::= (N("subprogram_body_stub") | N("package_body_stub") | N("task_body_stub") | N("protected_body_stub"));
N("subprogram_body_stub") ::= (N("subprogram_specification") "is" "separate" ";");
N("conditional_entry_call") ::= ("select" N("entry_call_alternative") "else" N("sequence_of_statements") "end" "select" ";");
N("asynchronous_select") ::= ("select" N("triggering_alternative") "then" "abort" N("abortable_part") "end" "select" ";");
N("package_body_stub") ::= ("package" "body" N("defining_identifier") "is" "separate" ";");
N("task_body_stub") ::= ("task" "body" N("defining_identifier") "is" "separate" ";");
N("protected_body_stub") ::= ("protected" "body" N("defining_identifier") "is" "separate" ";");
N("subunit") ::= ("separate" "(" N("parent_unit_name") ")" N("proper_body"));
N("exception_declaration") ::= (N("defining_identifier_list") ":" "exception" ";");
N("handled_sequence_of_statements") ::= (N("sequence_of_statements") [("exception" N("exception_handler") (N("exception_handler"))*)]);
N("exception_handler") ::= ("when" [(N("choice_parameter_specification") ":")] N("exception_choice") (("|" N("exception_choice")))* "=>" N("sequence_of_statements"));
N("choice_parameter_specification") ::= N("defining_identifier");
N("exception_choice") ::= (N("exception_name") | "others");
N("raise_statement") ::= ("raise" [N("exception_name")] ";");
N("generic_declaration") ::= (N("generic_subprogram_declaration") | N("generic_package_declaration"));
N("generic_subprogram_declaration") ::= (N("generic_formal_part") N("subprogram_specification") ";");
N("generic_package_declaration") ::= (N("generic_formal_part") N("package_specification") ";");
N("generic_formal_part") ::= ("generic" ((N("generic_formal_parameter_declaration") | N("use_clause")))*);
N("generic_formal_parameter_declaration") ::= (N("formal_object_declaration") | N("formal_type_declaration") | N("formal_subprogram_declaration") | N("formal_package_declaration"));
N("generic_instantiation") ::= (("package" N("defining_program_unit_name") "is" "new" N("generic_package_name") [N("generic_actual_part")] ";") | ("procedure" N("defining_program_unit_name") "is" "new" N("generic_procedure_name") [N("generic_actual_part")] ";") | ("function" N("defining_designator") "is" "new" N("generic_function_name") [N("generic_actual_part")] ";"));
N("generic_actual_part") ::= ("(" N("generic_association") (("," N("generic_association")))* ")");
N("generic_association") ::= ([(N("generic_formal_parameter_selector_name") "=>")] N("explicit_generic_actual_parameter"));
N("explicit_generic_actual_parameter") ::= (N("expression") | N("variable_name") | N("subprogram_name") | N("entry_name") | N("subtype_mark") | N("package_instance_name"));
N("formal_object_declaration") ::= (N("defining_identifier_list") ":" N("mode") N("subtype_mark") [(":=" N("default_expression"))] ";");
N("formal_type_declaration") ::= ("type" N("defining_identifier") [N("discriminant_part")] "is" N("formal_type_definition") ";");
N("formal_type_definition") ::= (N("formal_private_type_definition") | N("formal_derived_type_definition") | N("formal_discrete_type_definition") | N("formal_signed_integer_type_definition") | N("formal_modular_type_definition") | N("formal_floating_point_definition") | N("formal_ordinary_fixed_point_definition") | N("formal_decimal_fixed_point_definition") | N("formal_array_type_definition") | N("formal_access_type_definition"));
N("formal_private_type_definition") ::= ([(["abstract"] "tagged")] ["limited"] "private");
N("formal_derived_type_definition") ::= (["abstract"] "new" N("subtype_mark") [("with" "private")]);
N("formal_discrete_type_definition") ::= "(<>)";
N("formal_signed_integer_type_definition") ::= ("range" "<>");
N("formal_modular_type_definition") ::= ("mod" "<>");
N("formal_floating_point_definition") ::= ("digits" "<>");
N("formal_ordinary_fixed_point_definition") ::= ("delta" "<>");
N("formal_decimal_fixed_point_definition") ::= ("delta" "<>" "digits" "<>");
N("formal_array_type_definition") ::= N("array_type_definition");
N("formal_access_type_definition") ::= N("access_type_definition");
N("formal_subprogram_declaration") ::= ("with" N("subprogram_specification") [("is" N("subprogram_default"))] ";");
N("subprogram_default") ::= (N("default_name") | "<>");
N("default_name") ::= N("name");
N("formal_package_declaration") ::= ("with" "package" N("defining_identifier") "is" "new" N("generic_package_name") N("formal_package_actual_part") ";");
N("formal_package_actual_part") ::= ("(<>)" | [N("generic_actual_part")]);
N("aspect_clause") ::= (N("attribute_definition_clause") | N("enumeration_representation_clause") | N("record_representation_clause") | N("at_clause"));
N("local_name") ::= (N("direct_name") | (N("direct_name") "'" N("attribute_designator")) | N("library_unit_name"));
N("attribute_definition_clause") ::= (("for" N("local_name") "'" N("attribute_designator") "use" N("expression") ";") | ("for" N("local_name") "'" N("attribute_designator") "use" N("name") ";"));
N("enumeration_representation_clause") ::= ("for" N("first_subtype_local_name") "use" N("enumeration_aggregate") ";");
N("enumeration_aggregate") ::= N("array_aggregate");
N("record_representation_clause") ::= ("for" N("first_subtype_local_name") "use" "record" [N("mod_clause")] (N("component_clause"))* "end" "record" ";");
N("component_clause") ::= (N("component_local_name") "at" N("position") "range" N("first_bit") ".." N("last_bit") ";");
N("position") ::= N("static_expression");
N("first_bit") ::= N("static_simple_expression");
N("last_bit") ::= N("static_simple_expression");
N("code_statement") ::= (N("qualified_expression") ";");
N("restriction") ::= (N("restriction_identifier") | (N("restriction_parameter_identifier") "=>" N("expression")));
N("delta_constraint") ::= ("delta" N("static_expression") [N("range_constraint")]);
N("at_clause") ::= ("for" N("direct_name") "use" "at" N("expression") ";");
N("mod_clause") ::= ("at" "mod" N("static_expression") ";");
