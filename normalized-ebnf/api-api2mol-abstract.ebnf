N("Definition") ::= ((select("context", value("string")))+ select("defaultMetaclass", N("DefaultMetaclassSection")) (select("mappings", N("Mapping")))+);
N("DefaultMetaclassSection") ::= (select("metaclassName", value("string")) select("attribute", value("string")));
N("Mapping") ::= (select("metaclass", value("string")) select("instanceClass", value("string")) (select("sections", N("Section")))+);
N("Section") ::= N("DefaultMetaclassSection");
N("Section") ::= N("PropertySection");
N("Section") ::= N("NewSection");
N("Section") ::= N("MultipleSection");
N("Section") ::= N("ValueSection");
N("PropertySection") ::= (select("property", value("string")) (select("statements", N("Statement")))+);
N("NewSection") ::= (select("constructors", N("Constructor")))+;
N("MultipleSection") ::= (select("statements", N("Statement")))+;
N("ValueSection") ::= (select("metaValue", value("string")) select("instanceValue", value("string")));
N("Statement") ::= (select("type", N("StatementType")) (select("variables", value("string")))+ (select("calls", N("MethodCall")))+);
N("StatementType") ::= (select("GET", epsilon) | select("SET", epsilon) | select("APPEND", epsilon) | select("INSERT_AT", epsilon) | select("REMOVE", epsilon) | select("REMOVE_AT", epsilon) | select("REMOVE_LAST", epsilon) | select("REMOVE_ALL", epsilon) | select("COUNT", epsilon) | select("ACCESSORS", epsilon) | select("DIRECT", epsilon));
N("NamedElement") ::= N("MethodCall");
N("NamedElement") ::= N("Parameter");
N("MethodCall") ::= N("Constructor");
N("MethodCall") ::= (select("params", N("Parameter")))+;
N("Parameter") ::= (select("name", value("string")));
N("Constructor") ::= ((select("params", N("Parameter")))+);
