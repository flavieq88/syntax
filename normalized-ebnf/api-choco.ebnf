N("LocatedElement") ::= N("Package");
N("LocatedElement") ::= N("Import");
N("LocatedElement") ::= N("ChocoProblem");
N("LocatedElement") ::= N("Element");
N("LocatedElement") ::= N("Domain");
N("OpConstraint") ::= (select("eq", epsilon) | select("and2", epsilon) | select("or2", epsilon) | select("gt", epsilon) | select("ge", epsilon) | select("lt", epsilon) | select("le", epsilon) | select("plus", epsilon));
N("Package") ::= (select("name", N("String")) (select("import", N("Import")))+ select("problem", N("ChocoProblem")));
N("Import") ::= select("fqn", N("String"));
N("ChocoProblem") ::= (select("name", N("String")) (select("elements", N("Element")))+);
N("Element") ::= N("Expression");
N("Element") ::= N("PostConstraint");
N("Expression") ::= N("ConstraintDef");
N("Expression") ::= N("IntVar");
N("Expression") ::= N("IntConstant");
N("Expression") ::= N("SymbolicTerm");
N("Expression") ::= N("IntValue");
N("Expression") ::= N("IntExp");
N("Expression") ::= N("Constraint");
N("ConstraintDef") ::= (select("op", N("OpConstraint")) select("left", N("Expression")) select("right", N("Expression")));
N("IntVar") ::= select("domain", N("Domain"));
N("Domain") ::= (select("lower", N("Integer")) select("upper", N("Integer")));
N("IntConstant") ::= select("val", N("Integer"));
N("SymbolicTerm") ::= select("term", N("Expression"));
N("IntValue") ::= select("val", N("Integer"));
N("IntExp") ::= (select("op", N("OpConstraint")) select("left", N("Expression")) select("right", N("Expression")));
N("Constraint") ::= (select("op", N("OpConstraint")) select("left", N("Expression")) select("right", N("Expression")));
N("PostConstraint") ::= (select("op", N("OpConstraint")) select("constraint", N("ConstraintDef")));
N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
N("String") ::= value("string");
