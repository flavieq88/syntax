N("Symbol") ::= (select("int", epsilon) | select("bool", epsilon) | select("real", epsilon) | select("rat", epsilon) | select("str", epsilon) | select("num", epsilon) | select("node", epsilon) | select("void", epsilon) | select("value", epsilon) | select("loc", epsilon) | select("datetime", epsilon));
N("Symbol") @label("label") ::= (marked("name", value("string")) marked("symbol", N("Symbol")));
N("Symbol") ::= (select("set", marked("symbol", N("Symbol"))) | select("rel", marked("symbols", (N("Symbol"))*)) | select("lrel", marked("symbols", (N("Symbol"))*)) | select("tuple", marked("symbols", (N("Symbol"))*)) | select("list", marked("symbol", N("Symbol"))) | select("map", (marked("from", N("Symbol")) marked("to", N("Symbol")))) | select("bag", marked("symbol", N("Symbol"))) | select("adt", (marked("name", value("string")) marked("parameters", (N("Symbol"))*))) | select("cons", (marked("adt", N("Symbol")) marked("name", value("string")) marked("parameters", (N("Symbol"))*))) | select("alias", (marked("name", value("string")) marked("parameters", (N("Symbol"))*) marked("aliased", N("Symbol")))) | select("func", (marked("ret", N("Symbol")) marked("parameters", (N("Symbol"))*))) | select("var-func", (marked("ret", N("Symbol")) marked("parameters", (N("Symbol"))*) marked("varArg", N("Symbol")))) | select("reified", marked("symbol", N("Symbol"))));
N("Symbol") @label("parameter") ::= (marked("name", value("string")) marked("bound", N("Symbol")));
N("Production") ::= (select("cons", (marked("def", N("Symbol")) marked("symbols", (N("Symbol"))*) marked("kwTypes", (N("Symbol"))*) marked("kwDefaults", ((value("string") ((value("string") any))*))*) marked("attributes", (N("Attr"))*))) | select("func", (marked("def", N("Symbol")) marked("symbols", (N("Symbol"))*) marked("kwTypes", (N("Symbol"))*) marked("kwDefaults", ((value("string") ((value("string") any))*))*) marked("attributes", (N("Attr"))*))) | select("choice", (marked("def", N("Symbol")) marked("alternatives", (N("Production"))*))));
N("Attr") @label("tag") ::= marked("tag", any);
N("Exception") @label("typeCastException") ::= (marked("from", N("Symbol")) marked("to", empty));
