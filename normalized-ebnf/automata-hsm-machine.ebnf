N("MgaObject") ::= N("StateBase");
N("MgaObject") ::= N("DataVar");
N("MgaObject") ::= N("Transition");
N("MgaObject") ::= N("StateDateRelation");
N("MgaObject") ::= (select("name", N("String")) select("position", N("String")));
N("StateBase") ::= N("CompoundState");
N("StateBase") ::= N("PrimitiveState");
N("StateBase") ::= (select("defaultTransition", N("String")) select("marked", N("Boolean")) (select("associationStateStatedst", N("AssociationStateState")))+ (select("associationStateStatesrc", N("AssociationStateState")))+ (select("data", N("DataVar")))+ select("associationDataStateBase", N("AssociationDataStateBase")));
N("DataVar") ::= ((select("stateBase", N("StateBase")))+ select("orState", N("OrState")) select("associationDataStateBase", N("AssociationDataStateBase")));
N("Transition") ::= (select("guard", N("String")) select("trigger", N("String")) select("action", N("String")) select("isSync", N("Boolean")) select("orState", N("OrState")) select("associationStateState", N("AssociationStateState")));
N("StateDateRelation") ::= (select("value", N("String")) select("color", N("String")));
N("RootFolder") ::= (select("name", N("String")) (select("rootFolders", N("RootFolder")))+ (select("orState", N("OrState")))+);
N("OrState") ::= (select("rootFolder", N("RootFolder")) (select("state", N("State")))+ select("init", N("Init")) (select("dataVar", N("DataVar")))+ (select("stateDataRelation", N("StateDataRelation")))+ (select("transition", N("Transition")))+ (select("compoundState", N("CompoundState")))+);
N("AndState") ::= (select("compoundState", N("CompoundState")))+;
N("CompoundState") ::= N("OrState");
N("CompoundState") ::= N("AndState");
N("CompoundState") ::= (select("andState", N("AndState")) select("orState", N("OrState")));
N("PrimitiveState") ::= N("Init");
N("PrimitiveState") ::= N("State");
N("PrimitiveState") ::= N("StateDataRelation");
N("PrimitiveState") ::= (N("Init") | N("State") | N("StateDataRelation"));
N("Init") ::= select("orState", N("OrState"));
N("State") ::= select("orState", N("OrState"));
N("StateDataRelation") ::= (select("value", N("String")) select("color", N("String")) select("orState", N("OrState")) select("associationDataStateBase1", N("AssociationDataStateBase")));
N("AssociationStateState") ::= (select("transition", N("Transition")) (select("dstTransition", N("StateBase")))+ (select("srcTransition", N("StateBase")))+);
N("AssociationDataStateBase") ::= (select("stateDataRelation", N("StateDataRelation")) (select("dataVar", N("DataVar")))+ (select("stateBase", N("StateBase")))+);
N("String") ::= value("string");
N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
