N("LocatedElement") ::= N("NamedElement");
N("NamedElement") ::= N("PetriNet");
N("NamedElement") ::= N("Element");
N("NamedElement") ::= N("Arc");
N("PetriNet") ::= ((select("elements", N("Element")))+ (select("arcs", N("Arc")))+ (select("execs", N("Execution")))+);
N("Element") ::= N("Place");
N("Element") ::= N("Transition");
N("Place") ::= ((select("incomingArc", N("TransitionToPlace")))+ (select("outgoingArc", N("PlaceToTransition")))+);
N("Transition") ::= ((select("incomingArc", N("PlaceToTransition")))+ (select("outgoingArc", N("TransitionToPlace")))+);
N("Arc") ::= N("PlaceToTransition");
N("Arc") ::= N("TransitionToPlace");
N("PlaceToTransition") ::= (select("from", N("Place")) select("to", N("Transition")));
N("TransitionToPlace") ::= (select("from", N("Transition")) select("to", N("Place")));
N("Execution") ::= (select("net", N("PetriNet")) (select("markings", N("Marking")))+ (select("movements", N("Movement")))+);
N("Token") ::= (select("placedAt", N("Place")) select("marking", N("Marking")));
N("Marking") ::= (select("exec", N("Execution")) (select("tokens", N("Token")))+);
N("Movement") ::= (select("exec", N("Execution")) select("fire", N("Transition")) select("source", N("Marking")) select("target", N("Marking")));
N("String") ::= value("string");
N("Integer") ::= value("int");
