@root N("pnml.element");

N("arc.labels") ::= N("ArcType");
N("nettype.uri") ::= select("type", "http://www.pnml.org/version-2009/grammar/ptnet");
N("PTMarking") ::= select("initialMarking", N("nonnegativeintegerlabel.content"));
N("PTArcAnnotation") ::= select("inscription", N("positiveintegerlabel.content"));
N("place.labels") ::= [N("PTMarking")];
N("arc.labels") ::= [N("PTArcAnnotation")];
N("nonnegativeintegerlabel.content") ::= (select("text", value("int")) N("annotationstandard.content"));
N("positiveintegerlabel.content") ::= (select("text", value("int")) N("annotationstandard.content"));
N("pnml.element") ::= select("pnml", (N("pnml.content"))+);
N("pnml.content") ::= N("net.element");
N("net.element") ::= select("net", (N("identifier.content") N("nettype.uri") ([N("Name")] N("net.labels") (N("page.content"))+ (N("toolspecific.element"))*)));
N("identifier.content") ::= select("id", value("string"));
N("nettype.uri") ::= select("type", "http://www.pnml.org/version-2009/grammar/pnmlcoremodel");
N("net.labels") ::= epsilon;
N("basicobject.content") ::= ([N("Name")] (N("toolspecific.element"))*);
N("page.content") ::= select("page", (N("identifier.content") (N("basicobject.content") N("page.labels") (N("netobject.content"))* [select("graphics", N("pagegraphics.content"))])));
N("netobject.content") ::= (N("page.content") | N("place.content") | N("transition.content") | N("refplace.content") | N("reftrans.content") | N("arc.content"));
N("page.labels") ::= epsilon;
N("place.content") ::= select("place", (N("identifier.content") (N("basicobject.content") N("place.labels") N("node.content"))));
N("place.labels") ::= epsilon;
N("transition.content") ::= select("transition", (N("identifier.content") (N("basicobject.content") N("transition.labels") N("node.content"))));
N("transition.labels") ::= epsilon;
N("node.content") ::= [select("graphics", N("nodegraphics.content"))];
N("reference") ::= select("ref", value("string"));
N("refplace.content") ::= select("referencePlace", N("refnode.content"));
N("reftrans.content") ::= select("referenceTransition", N("refnode.content"));
N("refnode.content") ::= (N("identifier.content") N("reference") N("basicobject.content") N("node.content"));
N("arc.content") ::= select("arc", (N("identifier.content") select("source", value("string")) select("target", value("string")) ([N("Name")] N("arc.labels") [select("graphics", N("edgegraphics.content"))] (N("toolspecific.element"))*)));
N("arc.labels") ::= epsilon;
N("pagegraphics.content") ::= N("nodegraphics.content");
N("nodegraphics.content") ::= (N("position.element") [N("dimension.element")] [N("fill.element")] [N("line.element")]);
N("edgegraphics.content") ::= ((N("position.element"))* [N("line.element")]);
N("simpletext.content") ::= [select("text", value("string"))];
N("annotationstandard.content") ::= ([select("graphics", N("annotationgraphics.content"))] (N("toolspecific.element"))*);
N("simpletextlabel.content") ::= (N("simpletext.content") N("annotationstandard.content"));
N("Name") ::= select("name", N("simpletextlabel.content"));
N("annotationgraphics.content") ::= (N("offset.element") ([N("fill.element")] [N("line.element")] [N("font.element")]));
N("position.element") ::= select("position", N("coordinate.attributes"));
N("offset.element") ::= select("offset", N("coordinate.attributes"));
N("coordinate.attributes") ::= (select("x", value("int")) select("y", value("int")));
N("dimension.element") ::= select("dimension", (select("x", N("positiveDecimal.content")) select("y", N("positiveDecimal.content"))));
N("positiveDecimal.content") ::= value("int");
N("fill.element") ::= select("fill", ([select("color", N("color.type"))] [select("gradient-color", N("color.type"))] [select("gradient-rotation", ("vertical" | "horizontal" | "diagonal"))] [select("image", value("string"))]));
N("line.element") ::= select("line", ([select("shape", ("line" | "curve"))] [select("color", N("color.type"))] [select("width", N("positiveDecimal.content"))] [select("style", ("solid" | "dash" | "dot"))]));
N("color.type") ::= value("string");
N("font.element") ::= select("font", ([select("family", value("string"))] [select("style", value("string"))] [select("weight", value("string"))] [select("size", value("string"))] [select("decoration", ("underline" | "overline" | "line-through"))] [select("align", ("left" | "center" | "right"))] [select("rotation", value("int"))]));
N("toolspecific.element") ::= select("toolspecific", (select("tool", value("string")) select("version", value("string")) (N("anyElement"))*));
N("anyElement") ::= ((any | value("string") | N("anyElement")))*;
N("specialarc.value") ::= ("normal" | "inhibitor" | "read" | "reset");
N("ArcType") ::= select("arctype", N("specialarc.value"));
