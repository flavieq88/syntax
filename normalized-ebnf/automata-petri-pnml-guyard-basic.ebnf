N("IdedElement") ::= N("NetElement");
N("IdedElement") ::= N("Node");
N("IdedElement") ::= N("Arc");
N("URI") ::= select("value", N("String"));
N("Color") ::= epsilon;
N("AnyElement") ::= (select("name", N("String")) select("text", N("String")));
N("RotationType") ::= (select("rtvertical", epsilon) | select("rthorizontal", epsilon) | select("rtdiagonal", epsilon));
N("ShapeType") ::= (select("shtline", epsilon) | select("shtcurve", epsilon));
N("StyleType") ::= (select("sttsolid", epsilon) | select("sttdash", epsilon) | select("sttdot", epsilon));
N("DecorationType") ::= (select("dtunderligne", epsilon) | select("dtoverligne", epsilon) | select("dtlinethrough", epsilon));
N("AlignType") ::= (select("atleft", epsilon) | select("atcenter", epsilon) | select("atright", epsilon));
N("PNMLDocument") ::= (select("xmlns", N("URI")) (select("nets", N("NetElement")))+);
N("NetElement") ::= (select("type", N("URI")) select("document", N("PNMLDocument")) (select("contents", N("NetContent")))+ (select("tools", N("ToolSpecific")))+ select("netgraphics", N("NetGraphics")) select("name", N("Name")));
N("NetContent") ::= N("NetContentElement");
N("NetContent") ::= N("Arc");
N("ToolSpecific") ::= (select("tool", N("String")) select("version", N("String")) (select("anyelement", N("AnyElement")))+ select("net", N("NetElement")) select("arc", N("Arc")) select("node", N("Node")));
N("LabeledElement") ::= N("Name");
N("LabeledElement") ::= N("Inscription");
N("LabeledElement") ::= N("InitialMarking");
N("Label") ::= (select("text", N("String")) select("namedelement", N("LabeledElement")));
N("Name") ::= (select("net", N("NetElement")) select("netcontent", N("NetContent")));
N("Inscription") ::= select("arc", N("Arc"));
N("InitialMarking") ::= select("place", N("Place"));
N("NetContentElement") ::= N("Place");
N("NetContentElement") ::= N("Transition");
N("Arc") ::= (select("source", N("NetContentElement")) select("target", N("NetContentElement")) (select("tools", N("ToolSpecific")))+ select("edgegraphics", N("EdgeGraphics")) select("inscription", N("Inscription")));
N("Node") ::= (select("netcontentelement", N("NetContentElement")) (select("tools", N("ToolSpecific")))+ select("nodegraphics", N("NodeGraphics")));
N("Place") ::= select("initialmarking", N("InitialMarking"));
N("Transition") ::= (select("node", N("Node")));
N("Graphics") ::= N("NetGraphics");
N("Graphics") ::= N("NodeGraphics");
N("Graphics") ::= N("EdgeGraphics");
N("Graphics") ::= N("AnnotationGraphics");
N("NetGraphics") ::= select("net", N("NetElement"));
N("NodeGraphics") ::= (select("node", N("Node")) select("position", N("Position")) select("dimension", N("Dimension")) select("fill", N("Fill")) select("line", N("Line")));
N("EdgeGraphics") ::= (select("arc", N("Arc")) (select("position", N("Position")))+ select("fill", N("Fill")) select("line", N("Line")));
N("AnnotationGraphics") ::= (select("namedelement", N("LabeledElement")) select("offset", N("Offset")) select("font", N("Font")) select("fill", N("Fill")) select("line", N("Line")));
N("Coordinate") ::= N("Position");
N("Coordinate") ::= N("Offset");
N("Position") ::= (select("nodegraphics", N("NodeGraphics")) select("edgegraphics", N("EdgeGraphics")));
N("Offset") ::= select("annotationgraphics", N("AnnotationGraphics"));
N("Dimension") ::= (select("width", N("Integer")) select("height", N("Integer")) select("nodegraphics", N("NodeGraphics")));
N("Fill") ::= (select("gradientrotation", N("RotationType")) select("interiorcolor", N("Color")) select("gradientcolor", N("Color")) select("image", N("URI")) select("nodegraphics", N("NodeGraphics")) select("edgegraphics", N("EdgeGraphics")) select("annotationgraphics", N("AnnotationGraphics")));
N("Line") ::= (select("color", N("Color")) select("width", N("Integer")) select("shape", N("ShapeType")) select("style", N("StyleType")) select("nodegraphics", N("NodeGraphics")) select("edgegraphics", N("EdgeGraphics")) select("annotationgraphics", N("AnnotationGraphics")));
N("Font") ::= (select("family", N("String")) select("style", N("String")) select("weight", N("String")) select("size", N("String")) select("decoration", N("DecorationType")) select("align", N("AlignType")) select("rotation", N("Integer")) select("annotationgraphics", N("AnnotationGraphics")));
N("Integer") ::= value("int");
N("String") ::= value("string");
