N("LocatedElement") ::= N("IdedElement");
N("LocatedElement") ::= N("URI");
N("LocatedElement") ::= N("PNMLDocument");
N("LocatedElement") ::= N("NetContent");
N("LocatedElement") ::= N("LabeledElement");
N("LocatedElement") ::= N("Label");
N("IdedElement") ::= N("NetElement");
N("IdedElement") ::= N("NetContentElement");
N("IdedElement") ::= N("Arc");
N("URI") ::= select("value", N("String"));
N("PNMLDocument") ::= (select("xmlns", N("URI")) (select("nets", N("NetElement")))+);
N("NetElement") ::= (select("type", N("URI")) select("document", N("PNMLDocument")) (select("contents", N("NetContent")))+ select("name", N("Name")));
N("NetContent") ::= N("NetContentElement");
N("NetContent") ::= N("Arc");
N("LabeledElement") ::= N("Name");
N("Label") ::= (select("text", N("String")) select("labeledElement", N("LabeledElement")));
N("Name") ::= (select("net", N("NetElement")) select("netContent", N("NetContent")));
N("NetContentElement") ::= N("Place");
N("NetContentElement") ::= N("Transition");
N("Arc") ::= (select("source", N("NetContentElement")) select("target", N("NetContentElement")));
N("Place") ::= epsilon;
N("Transition") ::= epsilon;
N("Integer") ::= value("int");
N("String") ::= value("string");
