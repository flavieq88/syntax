@root N("pnml.element");

N("nettype.uri") ::= select("type", "http://www.pnml.org/version-2009/grammar/highlevelnet");
N("BuiltInSort") ::= N("List");
N("BuiltInOperator") ::= N("ListOperator");
N("List") ::= select("list", N("Sort"));
N("BuiltInConstant") ::= N("EmptyList");
N("ListOperator.content") ::= N("BuiltInOperator.content");
N("ListOperator") ::= (N("ListAppend") | N("ListConcatenation") | N("MakeList") | N("ListLength") | N("MemberAtIndex") | N("Sublist"));
N("EmptyList") ::= select("emptylist", (N("Sort") N("BuiltInConstant.content")));
N("ListLength") ::= select("listlength", N("ListOperator.content"));
N("MakeList") ::= select("makelist", (N("Sort") N("ListOperator.content")));
N("ListConcatenation") ::= select("listconcatenation", N("ListOperator.content"));
N("ListAppend") ::= select("listappend", N("ListOperator.content"));
N("MemberAtIndex") ::= select("memberatindex", (select("index", value("int")) N("ListOperator.content")));
N("Sublist") ::= select("sublist", (select("start", value("int")) select("length", value("int")) N("ListOperator.content")));
N("BuiltInSort") ::= N("String");
N("BuiltInOperator") ::= N("StringOperator");
N("BuiltInConstant") ::= N("StringConstant");
N("String") ::= select("string", epsilon);
N("StringConstant.content") ::= select("value", value("string"));
N("StringConstant") ::= select("stringconstant", (N("StringConstant.content") N("BuiltInConstant.content")));
N("StringOperator.content") ::= N("BuiltInOperator.content");
N("StringOperator") ::= (N("StringLessThan") | N("StringLessThanOrEqual") | N("StringGreaterThan") | N("StringGreaterThanOrEqual") | N("StringConcatenation") | N("StringAppend") | N("StringLength") | N("Substring"));
N("StringLessThan") ::= select("lts", N("StringOperator.content"));
N("StringLessThanOrEqual") ::= select("leqs", N("StringOperator.content"));
N("StringGreaterThan") ::= select("gts", N("StringOperator.content"));
N("StringGreaterThanOrEqual") ::= select("geqs", N("StringOperator.content"));
N("StringConcatenation") ::= select("stringconcatenation", N("StringOperator.content"));
N("StringLength") ::= select("stringlength", N("StringOperator.content"));
N("StringAppend") ::= select("stringappend", N("StringOperator.content"));
N("Substring") ::= select("substring", (select("start", value("int")) select("length", value("int")) N("StringOperator.content")));
N("Declaration") ::= N("Unparsed");
N("SortDeclaration") ::= N("ArbitrarySort");
N("OperatorDeclaration") ::= N("ArbitraryOperator");
N("ArbitrarySort") ::= select("arbitrarysort", N("SortDeclaration.content"));
N("ArbitraryOperator") ::= select("arbitraryoperator", (N("OperatorDeclaration.content") (select("input", N("Sort")))* select("output", N("Sort"))));
N("Unparsed") ::= select("unparsed", (N("Declaration.content") (N("anyElement"))*));
N("nettype.uri") ::= select("type", "http://www.pnml.org/version-2009/grammar/symmetricnet");
N("SortDeclaration") ::= N("Partition");
N("OperatorDeclaration") ::= N("PartitionElement");
N("BuiltInOperator") ::= N("PartitionOperator");
N("Partition") ::= select("partition", (N("SortDeclaration.content") N("Sort") (N("PartitionElement"))+));
N("PartitionElement") ::= select("partitionelement", (N("OperatorDeclaration.content") (N("Term"))+));
N("PartitionOperator.content") ::= N("BuiltInOperator.content");
N("PartitionOperator") ::= (N("PartitionLessThan") | N("PartitionGreaterThan") | N("PartitionElementOf"));
N("PartitionLessThan") ::= select("ltp", N("PartitionOperator.content"));
N("PartitionGreaterThan") ::= select("gtp", N("PartitionOperator.content"));
N("PartitionElementOf") ::= select("partitionelementof", (select("refpartition", value("string")) N("PartitionOperator.content")));
N("BuiltInSort") ::= N("CyclicEnumeration");
N("BuiltInOperator") ::= N("CyclicEnumOperator");
N("CyclicEnumeration") ::= select("cyclicenumeration", N("FiniteEnumeration.content"));
N("CyclicEnumOperator.content") ::= N("BuiltInOperator.content");
N("CyclicEnumOperator") ::= (N("Successor") | N("Predecessor"));
N("Successor") ::= select("successor", N("CyclicEnumOperator.content"));
N("Predecessor") ::= select("predecessor", N("CyclicEnumOperator.content"));
N("OperatorDeclaration") ::= N("FEConstant");
N("BuiltInSort") ::= N("FiniteEnumeration");
N("FiniteEnumeration.content") ::= (N("FEConstant"))*;
N("FiniteEnumeration") ::= select("finiteenumeration", N("FiniteEnumeration.content"));
N("FEConstant") ::= select("feconstant", N("OperatorDeclaration.content"));
N("BuiltInSort") ::= N("FiniteIntRange");
N("BuiltInOperator") ::= N("FiniteIntRangeOperator");
N("BuiltInConstant") ::= N("FiniteIntRangeConstant");
N("FiniteIntRange") ::= select("finiteintrange", (select("start", value("int")) select("end", value("int"))));
N("FiniteIntRangeOperator.content") ::= N("BuiltInOperator.content");
N("FiniteIntRangeOperator") ::= (N("FIRLessThan") | N("FIRLessThanOrEqual") | N("FIRGreaterThan") | N("FIRGreaterThanOrEqual"));
N("FIRLessThan") ::= select("lessthan", N("FiniteIntRangeOperator.content"));
N("FIRLessThanOrEqual") ::= select("lessthanorequal", N("FiniteIntRangeOperator.content"));
N("FIRGreaterThan") ::= select("greaterthan", N("FiniteIntRangeOperator.content"));
N("FIRGreaterThanOrEqual") ::= select("greaterthanorequal", N("FiniteIntRangeOperator.content"));
N("FiniteIntRangeConstant") ::= select("finiteintrangeconstant", (select("value", value("int")) N("FiniteIntRange") N("BuiltInConstant.content")));
N("Operator") ::= (N("Equality") | N("Inequality"));
N("BuiltInSort") ::= N("Bool");
N("BuiltInOperator") ::= N("BooleanOperator");
N("BuiltInConstant") ::= N("BooleanConstant");
N("Bool") ::= select("bool", epsilon);
N("BooleanOperator.content") ::= N("BuiltInOperator.content");
N("BooleanOperator") ::= (N("And") | N("Or") | N("Imply") | N("Not"));
N("And") ::= select("and", N("BooleanOperator.content"));
N("Or") ::= select("or", N("BooleanOperator.content"));
N("Not") ::= select("not", N("BooleanOperator.content"));
N("Imply") ::= select("imply", N("BooleanOperator.content"));
N("Equality") ::= select("equality", N("Operator.content"));
N("Inequality") ::= select("inequality", N("Operator.content"));
N("BooleanConstant") ::= select("booleanconstant", (select("value", ("true" | "false")) N("BuiltInConstant.content")));
N("BuiltInOperator") ::= (N("Cardinality") | N("CardinalityOf") | N("Contains"));
N("MultisetOperator") ::= (N("Add") | N("All") | N("NumberOf") | N("Subtract") | N("ScalarProduct") | N("Empty"));
N("Add") ::= select("add", N("MultisetOperator.content"));
N("Subtract") ::= select("subtract", N("MultisetOperator.content"));
N("All") ::= select("all", (N("MultisetOperator.content") N("Sort")));
N("Empty") ::= select("empty", (N("MultisetOperator.content") N("Sort")));
N("ScalarProduct") ::= select("scalarproduct", N("MultisetOperator.content"));
N("NumberOf") ::= select("numberof", N("MultisetOperator.content"));
N("Cardinality") ::= select("cardinality", N("BuiltInOperator.content"));
N("CardinalityOf") ::= select("cardinalityof", N("BuiltInOperator.content"));
N("Contains") ::= select("contains", N("BuiltInOperator.content"));
N("BuiltInSort") ::= N("Dot");
N("BuiltInConstant") ::= N("DotConstant");
N("Dot") ::= select("dot", epsilon);
N("DotConstant") ::= select("dotconstant", epsilon);
N("BuiltInSort") ::= N("Number");
N("BuiltInOperator") ::= N("IntegerOperator");
N("BuiltInConstant") ::= N("NumberConstant");
N("Number") ::= (N("Natural") | N("Positive") | N("Integer"));
N("Integer") ::= select("integer", epsilon);
N("Natural") ::= select("natural", epsilon);
N("Positive") ::= select("positive", epsilon);
N("IntegerOperator.content") ::= N("BuiltInOperator.content");
N("IntegerOperator") ::= (N("Addition") | N("Subtraction") | N("Multiplication") | N("Division") | N("Modulo") | N("GreaterThan") | N("GreaterThanOrEqual") | N("LessThan") | N("LessThanOrEqual"));
N("NumberConstant") ::= select("numberconstant", (select("value", value("int")) (N("BuiltInConstant.content") N("Number"))));
N("LessThan") ::= select("lt", N("IntegerOperator"));
N("LessThanOrEqual") ::= select("leq", N("IntegerOperator"));
N("GreaterThan") ::= select("gt", N("IntegerOperator"));
N("GreaterThanOrEqual") ::= select("geq", N("IntegerOperator"));
N("Addition") ::= select("addition", N("IntegerOperator"));
N("Subtraction") ::= select("subtraction", N("IntegerOperator"));
N("Multiplication") ::= select("mult", N("IntegerOperator"));
N("Division") ::= select("div", N("IntegerOperator"));
N("Modulo") ::= select("mod", N("IntegerOperator"));
N("net.labels") ::= (N("HLDeclaration"))*;
N("page.labels") ::= (N("HLDeclaration"))*;
N("place.labels") ::= ([N("Type")] [N("HLMarking")]);
N("transition.labels") ::= [N("Condition")];
N("arc.labels") ::= [N("HLAnnotation")];
N("HLDeclaration") ::= select("declaration", (N("simpletextlabel.content") [select("structure", N("Declarations"))]));
N("Type") ::= select("type", (N("simpletextlabel.content") [select("structure", N("Sort"))]));
N("HLMarking") ::= select("hlinitialMarking", (N("simpletextlabel.content") [select("structure", N("Term"))]));
N("Condition") ::= select("condition", (N("simpletextlabel.content") [select("structure", N("Term"))]));
N("HLAnnotation") ::= select("hlinscription", (N("simpletextlabel.content") [select("structure", N("Term"))]));
N("Declarations") ::= select("declarations", (N("Declaration"))*);
N("Declaration.content") ::= (select("id", value("string")) select("name", value("string")));
N("Declaration") ::= (N("SortDeclaration") | N("VariableDeclaration") | N("OperatorDeclaration"));
N("VariableDeclaration") ::= select("variabledecl", (N("Declaration.content") N("Sort")));
N("SortDeclaration.content") ::= N("Declaration.content");
N("SortDeclaration") ::= N("NamedSort");
N("OperatorDeclaration.content") ::= N("Declaration.content");
N("OperatorDeclaration") ::= N("NamedOperator");
N("Variable") ::= select("variable", select("refvariable", value("string")));
N("NamedSort") ::= select("namedsort", (N("SortDeclaration.content") N("Sort")));
N("NamedOperator") ::= select("namedoperator", (N("OperatorDeclaration.content") select("parameter", (N("VariableDeclaration"))*) select("def", N("Term"))));
N("Term.content") ::= epsilon;
N("Term") ::= (N("Variable") | N("Operator"));
N("Sort.content") ::= epsilon;
N("Sort") ::= (N("BuiltInSort") | N("MultisetSort") | N("ProductSort") | N("UserSort"));
N("BuiltInSort") ::= epsilon;
N("MultisetSort") ::= select("multisetsort", N("Sort"));
N("ProductSort") ::= select("productsort", (N("Sort"))*);
N("UserSort") ::= select("usersort", select("declaration", value("string")));
N("Operator.content") ::= (select("subterm", N("Term")))*;
N("Operator") ::= (N("BuiltInOperator") | N("BuiltInConstant") | N("MultisetOperator") | N("Tuple") | N("UserOperator"));
N("BuiltInOperator.content") ::= N("Operator.content");
N("BuiltInOperator") ::= epsilon;
N("BuiltInConstant.content") ::= N("Operator.content");
N("BuiltInConstant") ::= epsilon;
N("MultisetOperator.content") ::= N("Operator.content");
N("MultisetOperator") ::= epsilon;
N("Tuple") ::= select("tuple", N("Operator.content"));
N("UserOperator") ::= select("useroperator", (select("declaration", value("string")) N("Operator.content")));
N("pnml.element") ::= select("pnml", (N("pnml.content"))+);
N("pnml.content") ::= N("net.element");
N("net.element") ::= select("net", (N("identifier.content") N("nettype.uri") ([N("Name")] N("net.labels") (N("page.content"))+ (N("toolspecific.element"))*)));
N("identifier.content") ::= select("id", value("string"));
N("nettype.uri") ::= select("type", "http://www.pnml.org/version-2009/grammar/pnmlcoremodel");
N("net.labels") ::= epsilon;
N("basicobject.content") ::= ([N("Name")] (N("toolspecific.element"))*);
N("page.content") ::= select("page", (N("identifier.content") (N("basicobject.content") N("page.labels") (N("netobject.content"))* [select("graphics", N("pagegraphics.content"))])));
N("netobject.content") ::= (N("page.content") | N("place.content") | N("transition.content") | N("refplace.content") | N("reftrans.content") | N("arc.content"));
N("page.labels") ::= epsilon;
N("place.content") ::= select("place", (N("identifier.content") (N("basicobject.content") N("place.labels") N("node.content"))));
N("place.labels") ::= epsilon;
N("transition.content") ::= select("transition", (N("identifier.content") (N("basicobject.content") N("transition.labels") N("node.content"))));
N("transition.labels") ::= epsilon;
N("node.content") ::= [select("graphics", N("nodegraphics.content"))];
N("reference") ::= select("ref", value("string"));
N("refplace.content") ::= select("referencePlace", N("refnode.content"));
N("reftrans.content") ::= select("referenceTransition", N("refnode.content"));
N("refnode.content") ::= (N("identifier.content") N("reference") N("basicobject.content") N("node.content"));
N("arc.content") ::= select("arc", (N("identifier.content") select("source", value("string")) select("target", value("string")) ([N("Name")] N("arc.labels") [select("graphics", N("edgegraphics.content"))] (N("toolspecific.element"))*)));
N("arc.labels") ::= epsilon;
N("pagegraphics.content") ::= N("nodegraphics.content");
N("nodegraphics.content") ::= (N("position.element") [N("dimension.element")] [N("fill.element")] [N("line.element")]);
N("edgegraphics.content") ::= ((N("position.element"))* [N("line.element")]);
N("simpletext.content") ::= [select("text", value("string"))];
N("annotationstandard.content") ::= ([select("graphics", N("annotationgraphics.content"))] (N("toolspecific.element"))*);
N("simpletextlabel.content") ::= (N("simpletext.content") N("annotationstandard.content"));
N("Name") ::= select("name", N("simpletextlabel.content"));
N("annotationgraphics.content") ::= (N("offset.element") ([N("fill.element")] [N("line.element")] [N("font.element")]));
N("position.element") ::= select("position", N("coordinate.attributes"));
N("offset.element") ::= select("offset", N("coordinate.attributes"));
N("coordinate.attributes") ::= (select("x", value("int")) select("y", value("int")));
N("dimension.element") ::= select("dimension", (select("x", N("positiveDecimal.content")) select("y", N("positiveDecimal.content"))));
N("positiveDecimal.content") ::= value("int");
N("fill.element") ::= select("fill", ([select("color", N("color.type"))] [select("gradient-color", N("color.type"))] [select("gradient-rotation", ("vertical" | "horizontal" | "diagonal"))] [select("image", value("string"))]));
N("line.element") ::= select("line", ([select("shape", ("line" | "curve"))] [select("color", N("color.type"))] [select("width", N("positiveDecimal.content"))] [select("style", ("solid" | "dash" | "dot"))]));
N("color.type") ::= value("string");
N("font.element") ::= select("font", ([select("family", value("string"))] [select("style", value("string"))] [select("weight", value("string"))] [select("size", value("string"))] [select("decoration", ("underline" | "overline" | "line-through"))] [select("align", ("left" | "center" | "right"))] [select("rotation", value("int"))]));
N("toolspecific.element") ::= select("toolspecific", (select("tool", value("string")) select("version", value("string")) (N("anyElement"))*));
N("anyElement") ::= ((any | value("string") | N("anyElement")))*;
