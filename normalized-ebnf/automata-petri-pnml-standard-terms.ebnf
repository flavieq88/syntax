N("Declarations") ::= select("declarations", (N("Declaration"))*);
N("Declaration.content") ::= (select("id", value("string")) select("name", value("string")));
N("Declaration") ::= (N("SortDeclaration") | N("VariableDeclaration") | N("OperatorDeclaration"));
N("VariableDeclaration") ::= select("variabledecl", (N("Declaration.content") N("Sort")));
N("SortDeclaration.content") ::= N("Declaration.content");
N("SortDeclaration") ::= N("NamedSort");
N("OperatorDeclaration.content") ::= N("Declaration.content");
N("OperatorDeclaration") ::= N("NamedOperator");
N("Variable") ::= select("variable", select("refvariable", value("string")));
N("NamedSort") ::= select("namedsort", (N("SortDeclaration.content") N("Sort")));
N("NamedOperator") ::= select("namedoperator", (N("OperatorDeclaration.content") select("parameter", (N("VariableDeclaration"))*) select("def", N("Term"))));
N("Term.content") ::= epsilon;
N("Term") ::= (N("Variable") | N("Operator"));
N("Sort.content") ::= epsilon;
N("Sort") ::= (N("BuiltInSort") | N("MultisetSort") | N("ProductSort") | N("UserSort"));
N("BuiltInSort") ::= epsilon;
N("MultisetSort") ::= select("multisetsort", N("Sort"));
N("ProductSort") ::= select("productsort", (N("Sort"))*);
N("UserSort") ::= select("usersort", select("declaration", value("string")));
N("Operator.content") ::= (select("subterm", N("Term")))*;
N("Operator") ::= (N("BuiltInOperator") | N("BuiltInConstant") | N("MultisetOperator") | N("Tuple") | N("UserOperator"));
N("BuiltInOperator.content") ::= N("Operator.content");
N("BuiltInOperator") ::= epsilon;
N("BuiltInConstant.content") ::= N("Operator.content");
N("BuiltInConstant") ::= epsilon;
N("MultisetOperator.content") ::= N("Operator.content");
N("MultisetOperator") ::= epsilon;
N("Tuple") ::= select("tuple", N("Operator.content"));
N("UserOperator") ::= select("useroperator", (select("declaration", value("string")) N("Operator.content")));
