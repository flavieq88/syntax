N("String") ::= value("string");
N("Integer") ::= value("int");
N("Boolean") ::= ("true" | "false");
N("LocatedElement") ::= N("XAsmFile");
N("LocatedElement") ::= N("Asm");
N("LocatedElement") ::= N("Signature");
N("LocatedElement") ::= N("MetaInformation");
N("LocatedElement") ::= N("AccessUpdateFunction");
N("LocatedElement") ::= N("Declaration");
N("LocatedElement") ::= N("Parameter");
N("LocatedElement") ::= N("Initialization");
N("LocatedElement") ::= N("Term");
N("LocatedElement") ::= N("Rule");
N("LocatedElement") ::= N("ElseIf");
N("LocatedElement") ::= N("ElementDecl");
N("LocatedElement") ::= N("Extension");
N("XAsmFile") ::= N("XAsmSpec");
N("XAsmFile") ::= N("Body");
N("XAsmSpec") ::= (select("Asm", N("Asm")))+;
N("Asm") ::= (select("signature", N("Signature")) select("returnType", N("String")) select("metaInformation", N("MetaInformation")) select("body", N("Body")));
N("Signature") ::= (select("isMain", N("Boolean")) select("name", N("String")) (select("arguments", N("Argument")))+);
N("Argument") ::= select("type", N("String"));
N("Body") ::= ((select("declarations", N("Declaration")))+ select("initialization", N("Initialization")) (select("rules", N("Rule")))+);
N("MetaInformation") ::= ((select("usedAsIn", N("Signature")))+ select("usedAs", N("AsmType")) (select("accessUpdateFunctions", N("AccessUpdateFunction")))+);
N("AccessUpdateFunction") ::= (select("type", N("AccessUpdateType")) (select("functions", N("Function")))+);
N("Declaration") ::= N("Universe");
N("Declaration") ::= N("Function");
N("Function") ::= ((select("parameters", N("Parameter")))+ select("returnType", N("String")) select("initTerm", N("Term")) select("isExternal", N("Boolean")));
N("Parameter") ::= (select("name", N("String")) select("type", N("String")));
N("Universe") ::= (select("name", N("String")) (select("contents", N("String")))+ (select("superUniverses", N("Universe")))+);
N("Initialization") ::= (select("rules", N("Rule")))+;
N("Term") ::= N("Constant");
N("Term") ::= N("FunctionOrVariableTerm");
N("Term") ::= N("OperatorTerm");
N("Constant") ::= N("BooleanConstant");
N("Constant") ::= N("IntegerConstant");
N("Constant") ::= N("StringConstant");
N("Constant") ::= N("UndefConstant");
N("FunctionOrVariableTerm") ::= (select("declaration", N("ElementDecl")) (select("terms", N("Term")))+);
N("OperatorTerm") ::= (select("opName", N("String")) select("leftExp", N("Term")) select("rightExp", N("Term")));
N("BooleanConstant") ::= select("value", N("Boolean"));
N("IntegerConstant") ::= select("value", N("Integer"));
N("StringConstant") ::= select("value", N("String"));
N("UndefConstant") ::= epsilon;
N("Rule") ::= N("SkipRule");
N("Rule") ::= N("AsmInvocation");
N("Rule") ::= N("UpdateRule");
N("Rule") ::= N("ChooseRule");
N("Rule") ::= N("DoForallRule");
N("Rule") ::= N("ConditionalRule");
N("Rule") ::= N("ExtendRule");
N("Rule") ::= N("ReturnRule");
N("SkipRule") ::= select("inSequence", N("Boolean"));
N("AsmInvocation") ::= (select("asmName", N("String")) (select("arguments", N("Term")))+);
N("UpdateRule") ::= (select("function", N("FunctionOrVariableTerm")) select("updateTerm", N("Term")));
N("ChooseRule") ::= (select("chooseId", N("VariableDecl")) select("inSet", N("Universe")) select("guard", N("Term")) (select("ifChoosenRules", N("Rule")))+ select("ifNotChoosenRule", N("Rule")));
N("DoForallRule") ::= (select("id", N("VariableDecl")) select("inSet", N("Universe")) select("condition", N("Term")) (select("doRule", N("Rule")))+);
N("ConditionalRule") ::= (select("condition", N("Term")) (select("thenRule", N("Rule")))+ select("elseRule", N("Rule")) select("elseIfRule", N("ElseIf")));
N("ElseIf") ::= (select("condition", N("Term")) (select("thenRule", N("Rule")))+ select("elseRule", N("Rule")) select("elseIfRule", N("ElseIf")));
N("ExtendRule") ::= ((select("extensions", N("Extension")))+ (select("rules", N("Rule")))+);
N("ElementDecl") ::= N("VariableDecl");
N("ElementDecl") ::= N("Function");
N("VariableDecl") ::= N("Argument");
N("Extension") ::= ((select("elements", N("VariableDecl")))+ select("universe", N("Universe")));
N("ReturnRule") ::= select("term", N("Term"));
N("AccessUpdateType") ::= (select("access", epsilon) | select("update", epsilon));
N("AsmType") ::= (select("function", epsilon) | select("subasm", epsilon));
