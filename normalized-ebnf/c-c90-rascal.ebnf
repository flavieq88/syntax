N("StructDeclarator") ::= N("Declarator");
N("StructDeclarator") ::= ([N("Declarator")] ":" N("Expression"));
N("PrototypeParameter") ::= ((N("Specifier"))* N("AbstractDeclarator"));
N("TypeSpecifier") @label("StructDecl") ::= ("struct" N("Identifier") "{" (N("StructDeclaration"))* "}");
N("TypeSpecifier") @label("Union") ::= ("union" N("Identifier"));
N("TypeSpecifier") @label("Int") ::= "int";
N("TypeSpecifier") @label("Void") ::= "void";
N("TypeSpecifier") @label("StructAnonDecl") ::= ("struct" "{" (N("StructDeclaration"))* "}");
N("TypeSpecifier") @label("Short") ::= "short";
N("TypeSpecifier") @label("Identifier") ::= N("Identifier");
N("TypeSpecifier") @label("EnumDecl") ::= ("enum" N("Identifier") "{" sep+(N("Enumerator"), ",") "}");
N("TypeSpecifier") ::= "signed";
N("TypeSpecifier") @label("UnionDecl") ::= ("union" N("Identifier") "{" (N("StructDeclaration"))* "}");
N("TypeSpecifier") @label("UnionAnonDecl") ::= ("union" "{" (N("StructDeclaration"))* "}");
N("TypeSpecifier") @label("Enum") ::= ("enum" N("Identifier"));
N("TypeSpecifier") @label("Struct") ::= ("struct" N("Identifier"));
N("TypeSpecifier") ::= "unsigned";
N("TypeSpecifier") @label("Long") ::= "long";
N("TypeSpecifier") @label("Double") ::= "double";
N("TypeSpecifier") @label("Float") ::= "float";
N("TypeSpecifier") @label("EnumAnonDecl") ::= ("enum" "{" sep+(N("Enumerator"), ",") "}");
N("TypeSpecifier") @label("Char") ::= "char";
N("StructDeclaration") @label("StructDeclWithoutDecl") ::= (select("specs", (N("Specifier"))+) ";");
N("StructDeclaration") @label("StructDeclWithDecl") ::= (select("specs", (N("Specifier"))+) sep+(N("StructDeclarator"), ",") ";");
N("TypeName") ::= ((N("Specifier"))+ N("AbstractDeclarator"));
N("Initializer") ::= ("{" sep+(N("Initializer"), ",") [","] "}");
N("Initializer") ::= N("NonCommaExpression");
N("InitDeclarator") ::= (select("decl", N("Declarator")) "=" N("Initializer"));
N("InitDeclarator") @label("decl") ::= N("Declarator");
N("Statement") ::= ("default" ":" N("Statement"));
N("Statement") ::= ("switch" "(" N("Expression") ")" N("Statement"));
N("Statement") ::= ("return" ";");
N("Statement") ::= ("for" "(" [N("Expression")] ";" [N("Expression")] ";" [N("Expression")] ")" N("Statement"));
N("Statement") ::= ("case" N("Expression") ":" N("Statement"));
N("Statement") ::= ("continue" ";");
N("Statement") ::= ";";
N("Statement") ::= ("goto" N("Identifier") ";");
N("Statement") ::= ("do" N("Statement") "while" "(" N("Expression") ")" ";");
N("Statement") ::= ("{" (N("Declaration"))* (N("Statement"))* "}");
N("Statement") ::= ("while" "(" N("Expression") ")" N("Statement"));
N("Statement") ::= ("break" ";");
N("Statement") ::= ("if" "(" N("Expression") ")" N("Statement"));
N("Statement") ::= (N("Identifier") ":" N("Statement"));
N("Statement") ::= (N("Expression") ";");
N("Statement") ::= ("if" "(" N("Expression") ")" N("Statement") "else" N("Statement"));
N("Statement") ::= ("return" N("Expression") ";");
N("ExternalDeclaration") ::= N("FunctionPrototype");
N("ExternalDeclaration") ::= N("FunctionDefinition");
N("ExternalDeclaration") ::= N("GlobalDeclaration");
N("PrototypeParameters") ::= "void";
N("PrototypeParameters") ::= (sep+(N("PrototypeParameter"), ",") [N("MoreParameters")]);
N("Parameters") ::= (sep+(N("Parameter"), ",") [N("MoreParameters")]);
N("Parameters") ::= "void";
N("FunctionPrototype") @label("DefaultFunctionPrototype") ::= (select("specs", (N("Specifier"))*) select("decl", N("PrototypeDeclarator")) ";");
N("Parameter") ::= ((N("Specifier"))* N("Declarator"));
N("AnonymousIdentifier") ::= epsilon;
N("PrototypeDeclarator") @label("FunctionDeclarator") ::= (select("decl", N("PrototypeDeclarator")) "(" select("params", [N("PrototypeParameters")]) ")");
N("PrototypeDeclarator") @label("Identifier") ::= N("Identifier");
N("PrototypeDeclarator") @label("Bracket") ::= ("(" select("decl", N("AbstractDeclarator")) ")");
N("PrototypeDeclarator") @label("ArrayDeclarator") ::= (select("decl", N("PrototypeDeclarator")) "[" select("exp", [N("Expression")]) "]");
N("PrototypeDeclarator") @label("PointerDeclarator") ::= ("*" select("qualifiers", (N("TypeQualifier"))*) select("decl", N("PrototypeDeclarator")));
N("AbstractDeclarator") @label("Identifier") ::= N("AnonymousIdentifier");
N("AbstractDeclarator") @label("ArrayDeclarator") ::= (select("decl", N("AbstractDeclarator")) "[" select("exp", [N("Expression")]) "]");
N("AbstractDeclarator") @label("Bracket") ::= ("(" select("decl", N("AbstractDeclarator")) ")");
N("AbstractDeclarator") @label("FunctionDeclarator") ::= (select("decl", N("AbstractDeclarator")) "(" select("params", [N("Parameters")]) ")");
N("AbstractDeclarator") @label("PointerDeclarator") ::= ("*" select("qualifiers", (N("TypeQualifier"))*) select("decl", N("AbstractDeclarator")));
N("Declarator") @label("ArrayDeclarator") ::= (select("decl", N("Declarator")) "[" select("exp", [N("Expression")]) "]");
N("Declarator") @label("Identifier") ::= N("Identifier");
N("Declarator") @label("FunctionDeclarator") ::= (select("decl", N("Declarator")) "(" select("params", [N("Parameters")]) ")");
N("Declarator") @label("Bracket") ::= ("(" select("decl", N("Declarator")) ")");
N("Declarator") @label("PointerDeclarator") ::= ("*" select("qualifiers", (N("TypeQualifier"))*) select("decl", N("Declarator")));
N("Specifier") @label("StorageClass") ::= N("StorageClass");
N("Specifier") @label("TypeQualifier") ::= N("TypeQualifier");
N("Specifier") @label("TypeSpecifier") ::= N("TypeSpecifier");
N("StorageClass") ::= "register";
N("StorageClass") ::= "static";
N("StorageClass") ::= "extern";
N("StorageClass") ::= "auto";
N("StorageClass") @label("TypeDef") ::= "typedef";
N("Declaration") @label("DeclarationWithoutInitDecls") ::= (select("specs", (N("Specifier"))+) ";");
N("Declaration") @label("DeclarationWithInitDecls") ::= (select("specs", (N("Specifier"))+) select("initDeclarators", sep+(N("InitDeclarator"), ",")) ";");
N("Enumerator") ::= N("Identifier");
N("Enumerator") ::= (N("Identifier") "=" N("NonCommaExpression"));
N("NonCommaExpression") @label("NonCommaExpression") ::= select("expr", N("Expression"));
N("FunctionDefinition") @label("DefaultFunctionDefinition") ::= (select("specs", (N("Specifier"))*) N("Declarator") (N("Declaration"))* "{" (N("Declaration"))* (N("Statement"))* "}");
N("GlobalDeclaration") @label("GlobalDeclarationWithoutInitDecls") ::= (select("specs", (N("Specifier"))+) ";");
N("GlobalDeclaration") @label("GlobalDeclarationWithInitDecls") ::= (select("specs", (N("Specifier"))*) select("initDeclarators", sep+(N("InitDeclarator"), ",")) ";");
N("TranslationUnit") ::= (N("ExternalDeclaration"))+;
N("TypeQualifier") ::= "const";
N("TypeQualifier") ::= "volatile";
N("MoreParameters") ::= ("," "...");
N("Expression") ::= N("CharacterConstant");
N("Expression") ::= (N("Expression") "--");
N("Expression") @label("Variable") ::= N("Identifier");
N("Expression") ::= (N("Expression") "[" N("Expression") "]");
N("Expression") @label("Bracket") ::= ("(" N("Expression") ")");
N("Expression") ::= ("sizeof" "(" N("TypeName") ")");
N("Expression") ::= (N("Expression") "++");
N("Expression") ::= N("FloatingPointConstant");
N("Expression") ::= (N("Expression") "." N("Identifier"));
N("Expression") ::= N("StringConstant");
N("Expression") ::= N("IntegerConstant");
N("Expression") ::= N("HexadecimalConstant");
N("Expression") ::= (N("Expression") "->" N("Identifier"));
N("Expression") ::= (N("Expression") "(" sep*(N("NonCommaExpression"), ",") ")");
N("Expression") ::= N("Expression");
N("Expression") @label("SizeOfExpression") ::= ("sizeof" select("exp", N("Expression")));
N("Expression") ::= ("&" N("Expression"));
N("Expression") ::= ("!" N("Expression"));
N("Expression") ::= ("(" N("TypeName") ")" N("Expression"));
N("Expression") ::= ("*" N("Expression"));
N("Expression") ::= ("+" N("Expression"));
N("Expression") ::= ("-" N("Expression"));
N("Expression") ::= ("~" N("Expression"));
N("Expression") @label("MultiplicationExpression") ::= (select("lexp", N("Expression")) "*" select("rexp", N("Expression")));
N("Expression") ::= (N("Expression") "/" N("Expression"));
N("Expression") ::= (N("Expression") "%" N("Expression"));
N("Expression") ::= (N("Expression") "+" N("Expression"));
N("Expression") ::= (N("Expression") "-" N("Expression"));
N("Expression") ::= (N("Expression") ">>" N("Expression"));
N("Expression") ::= (N("Expression") "<<" N("Expression"));
N("Expression") ::= (N("Expression") "<=" N("Expression"));
N("Expression") ::= (N("Expression") ">=" N("Expression"));
N("Expression") ::= (N("Expression") ">" N("Expression"));
N("Expression") ::= (N("Expression") "<" N("Expression"));
N("Expression") ::= (N("Expression") "==" N("Expression"));
N("Expression") ::= (N("Expression") "!=" N("Expression"));
N("Expression") ::= (N("Expression") "&" N("Expression"));
N("Expression") ::= (N("Expression") "^" N("Expression"));
N("Expression") ::= (N("Expression") "|" N("Expression"));
N("Expression") ::= (N("Expression") "&&" N("Expression"));
N("Expression") ::= (N("Expression") "||" N("Expression"));
N("Expression") ::= (N("Expression") "?" N("Expression") ":" N("Expression"));
N("Expression") ::= (N("Expression") "|=" N("Expression"));
N("Expression") ::= (N("Expression") "&=" N("Expression"));
N("Expression") ::= (N("Expression") "*=" N("Expression"));
N("Expression") ::= (N("Expression") "/=" N("Expression"));
N("Expression") ::= (N("Expression") "+=" N("Expression"));
N("Expression") ::= (N("Expression") ">>=" N("Expression"));
N("Expression") ::= (N("Expression") "^=" N("Expression"));
N("Expression") ::= (N("Expression") "-=" N("Expression"));
N("Expression") ::= (N("Expression") "<<=" N("Expression"));
N("Expression") ::= (N("Expression") "%=" N("Expression"));
N("Expression") ::= (N("Expression") "=" N("Expression"));
N("Expression") @label("CommaExpression") ::= (N("Expression") "," N("Expression"));
