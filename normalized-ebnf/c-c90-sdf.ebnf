N("TranslationUnit") ::= (N("ExternalDeclaration"))+;
N("ExternalDeclaration") ::= N("FunctionDefinition");
N("ExternalDeclaration") ::= N("Declaration");
N("FunctionDefinition") ::= ((N("Specifier"))* N("Declarator") (N("Declaration"))* "{" (N("Declaration"))* (N("Statement"))* "}");
N("Declaration") ::= ((N("Specifier"))+ (N("InitDeclarator") (("," N("InitDeclarator")))*) ";");
N("Declaration") ::= ((N("Specifier"))+ ";");
N("InitDeclarator") ::= N("Declarator");
N("InitDeclarator") ::= (N("Declarator") "=" N("Initializer"));
N("Specifier") ::= N("Identifier");
N("Specifier") ::= "typedef";
N("Specifier") ::= "extern";
N("Specifier") ::= "static";
N("Specifier") ::= "auto";
N("Specifier") ::= "register";
N("Specifier") ::= "void";
N("Specifier") ::= "char";
N("Specifier") ::= "short";
N("Specifier") ::= "int";
N("Specifier") ::= "long";
N("Specifier") ::= "float";
N("Specifier") ::= "double";
N("Specifier") ::= "signed";
N("Specifier") ::= "unsigned";
N("Specifier") ::= "const";
N("Specifier") ::= "volatile";
N("Specifier") ::= (("struct" | "union") N("Identifier") "{" (N("StructDeclaration"))+ "}");
N("Specifier") ::= (("struct" | "union") "{" (N("StructDeclaration"))+ "}");
N("Specifier") ::= (("struct" | "union") N("Identifier"));
N("Specifier") ::= ("enum" "{" (N("Enumerator") (("," N("Enumerator")))*) "}");
N("Specifier") ::= ("enum" N("Identifier") "{" (N("Enumerator") (("," N("Enumerator")))*) "}");
N("Specifier") ::= ("enum" N("Identifier"));
N("StructDeclaration") ::= ((N("Specifier"))+ (N("StructDeclarator") (("," N("StructDeclarator")))*) ";");
N("StructDeclarator") ::= N("Declarator");
N("StructDeclarator") ::= (":" N("Expression"));
N("StructDeclarator") ::= (N("Declarator") ":" N("Expression"));
N("Enumerator") ::= N("Identifier");
N("Enumerator") ::= (N("Identifier") "=" N("Expression"));
N("Pointer") ::= (("*" (N("Specifier"))*))+;
N("Parameters") ::= ((N("Parameter") (("," N("Parameter")))*) [N("MoreParameters")]);
N("MoreParameters") ::= ("," "...");
N("Parameter") ::= ((N("Specifier"))+ N("Declarator"));
N("Parameter") ::= ((N("Specifier"))+ N("AbstractDeclarator"));
N("TypeName") ::= ((N("Specifier"))+ N("AbstractDeclarator"));
N("Initializer") ::= N("Expression");
N("Initializer") ::= ("{" (N("Initializer") (("," N("Initializer")))*) [","] "}");
N("D") ::= (N("Pointer") N("D"));
N("D") ::= N("I");
N("D") ::= ("(" N("D") ")");
N("D") ::= (N("D") "[" [N("Expression")] "]");
N("D") ::= (N("D") "(" [N("Parameters")] ")");
N("D") ::= (N("D") "(" [N("Parameters")] ")");
N("D") ::= (N("D") "[" [N("Expression")] "]");
N("Expression") ::= ("__builtin_va_arg" "(" N("Expression") "," N("TypeName") ")");
N("LineDirective") ::= ("#" select("linenum", N("IntegerConstant")) select("filename", N("StringConstant")) (N("Flag"))*);
N("Flag") ::= "1";
N("Flag") ::= "2";
N("Flag") ::= "3";
N("Flag") ::= "4";
N("ExternalDeclaration") ::= N("LineDirective");
N("Statement") ::= N("LineDirective");
N("StructDeclarator") ::= N("LineDirective");
N("Expression") ::= ("va_arg" "(" N("Expression") "," N("TypeName") ")");
N("Expression") ::= N("Identifier");
N("Expression") ::= N("HexadecimalConstant");
N("Expression") ::= N("IntegerConstant");
N("Expression") ::= N("CharacterConstant");
N("Expression") ::= N("FloatingPointConstant");
N("Expression") ::= N("StringConstant");
N("Expression") ::= ("(" N("Expression") ")");
N("Expression") ::= ("sizeof" "(" N("TypeName") ")");
N("Expression") ::= (N("Expression") "[" N("Expression") "]");
N("Expression") ::= (N("Expression") "(" [(N("Expression") (("," N("Expression")))*)] ")");
N("Expression") ::= (N("Expression") "." N("Identifier"));
N("Expression") ::= (N("Expression") "->" N("Identifier"));
N("Expression") ::= (N("Expression") "++");
N("Expression") ::= (N("Expression") "--");
N("Expression") ::= ("++" N("Expression"));
N("Expression") ::= ("--" N("Expression"));
N("Expression") ::= ("&" N("Expression"));
N("Expression") ::= ("*" N("Expression"));
N("Expression") ::= ("+" N("Expression"));
N("Expression") ::= ("-" N("Expression"));
N("Expression") ::= ("~" N("Expression"));
N("Expression") ::= ("!" N("Expression"));
N("Expression") ::= ("sizeof" N("Expression"));
N("Expression") ::= ("(" N("TypeName") ")" N("Expression"));
N("Expression") ::= (N("Expression") "*" N("Expression"));
N("Expression") ::= (N("Expression") "/" N("Expression"));
N("Expression") ::= (N("Expression") "%" N("Expression"));
N("Expression") ::= (N("Expression") "+" N("Expression"));
N("Expression") ::= (N("Expression") "-" N("Expression"));
N("Expression") ::= (N("Expression") "<<" N("Expression"));
N("Expression") ::= (N("Expression") ">>" N("Expression"));
N("Expression") ::= (N("Expression") "<" N("Expression"));
N("Expression") ::= (N("Expression") ">" N("Expression"));
N("Expression") ::= (N("Expression") "<=" N("Expression"));
N("Expression") ::= (N("Expression") ">=" N("Expression"));
N("Expression") ::= (N("Expression") "==" N("Expression"));
N("Expression") ::= (N("Expression") "!=" N("Expression"));
N("Expression") ::= (N("Expression") "=" N("Expression"));
N("Expression") ::= (N("Expression") "*=" N("Expression"));
N("Expression") ::= (N("Expression") "/=" N("Expression"));
N("Expression") ::= (N("Expression") "%=" N("Expression"));
N("Expression") ::= (N("Expression") "+=" N("Expression"));
N("Expression") ::= (N("Expression") "-=" N("Expression"));
N("Expression") ::= (N("Expression") "<<=" N("Expression"));
N("Expression") ::= (N("Expression") ">>=" N("Expression"));
N("Expression") ::= (N("Expression") "&=" N("Expression"));
N("Expression") ::= (N("Expression") "^=" N("Expression"));
N("Expression") ::= (N("Expression") "|=" N("Expression"));
N("Statement") ::= ("(" N("Statement") ")" ";");
N("Specifier") ::= (("struct" | "union") [N("Identifier")] "{" "}");
N("Statement") ::= ("{" (N("Declaration"))* (N("Statement"))* "}");
N("Statement") ::= (N("Identifier") ":" N("Statement"));
N("Statement") ::= ("case" N("Expression") ":" N("Statement"));
N("Statement") ::= ("default" ":" N("Statement"));
N("Statement") ::= ";";
N("Statement") ::= (N("Expression") ";");
N("Statement") ::= ("if" "(" N("Expression") ")" N("Statement"));
N("Statement") ::= ("if" "(" N("Expression") ")" N("Statement") "else" N("Statement"));
N("Statement") ::= ("switch" "(" N("Expression") ")" N("Statement"));
N("Statement") ::= ("while" "(" N("Expression") ")" N("Statement"));
N("Statement") ::= ("do" N("Statement") "while" "(" N("Expression") ")" ";");
N("Statement") ::= ("for" "(" [N("Expression")] ";" [N("Expression")] ";" [N("Expression")] ")" N("Statement"));
N("Statement") ::= ("goto" N("Identifier") ";");
N("Statement") ::= ("continue" ";");
N("Statement") ::= ("break" ";");
N("Statement") ::= ("return" ";");
N("Statement") ::= ("return" N("Expression") ";");
