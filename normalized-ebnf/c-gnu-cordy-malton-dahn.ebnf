@root N("program");

N("program") ::= N("compilation_unit");
N("compilation_unit") ::= (N("function_definition_or_declaration"))*;
N("function_definition_or_declaration") ::= (N("function_definition") | N("declaration") | N("preprocessor") | (N("compound_statement") N("NL")) | N("macro_declaration_or_statement") | N("unknown_declaration_or_statement"));
N("function_definition") ::= (N("NL") N("function_header") (N("preprocessor_function_header"))* [N("KR_parameter_decls")] N("compound_statement") N("NL"));
N("function_header") ::= (([N("decl_specifiers")] N("declarator") N("function_declarator_extension") (N("attribute_spec"))*) | ("YY_DECL" N("NL")));
N("preprocessor_function_header") ::= ((N("NL") N("preprocessor") N("function_header")) | (N("NL") N("function_header")));
N("preprocessor") ::= (N("TAB_1") N("preprocessor_line") N("NL"));
N("KR_parameter_decls") ::= ((N("NL") N("IN")) (N("KR_simple_declaration"))+ N("EX"));
N("KR_simple_declaration") ::= ([N("decl_specifiers")] N("KR_simple_type_name") [N("decl_specifiers")] (N("declarator"))+ N("semi"));
N("KR_simple_type_name") ::= (N("simple_type_name") | (N("struct_or_union") N("id")) | N("enum_specifier") | N("bit_qualifier"));
N("declaration") ::= ((N("decl_specifiers") sep*(N("init_declarator"), ",") N("semi")) | (N("decl_specifiers") N("declarator") "=" N("compound_initializer") N("NL")) | N("extern_langauge_declaration") | N("null_declaration") | (N("local_label") (N("declarator"))+) | N("asm_spec") | N("machinestart_declaration") | N("preprocessor"));
N("extern_langauge_declaration") ::= ("extern" N("stringlit") "{" (N("IN") N("NL")) (N("declaration"))* N("EX") "}" [";"] N("NL"));
N("null_declaration") ::= N("semi");
N("semi") ::= (";" N("NL"));
N("local_label") ::= "__label__";
N("decl_specifiers") ::= (N("decl_qualifier_or_type_specifier"))+;
N("decl_qualifier_or_type_specifier") ::= (N("decl_qualifier") | N("type_specifier") | (N("macro_specifier") [N("nosemiNL")]));
N("nosemiNL") ::= N("NL");
N("struct_or_union_specifier") ::= ((N("struct_or_union") (N("attribute_spec"))* [N("reference_id")] N("struct_or_union_body") (N("attribute_spec"))*) | (N("struct_or_union") (N("attribute_spec"))* N("reference_id") (N("attribute_spec"))*));
N("struct_or_union_body") ::= ("{" (N("IN") N("NL")) (N("member_declaration"))* N("EX") "}");
N("member_declaration") ::= ((N("decl_specifiers") sep*(N("member_declarator"), ",") N("semi")) | N("null_declaration") | N("preprocessor"));
N("member_declarator") ::= ((N("declarator") [N("bitfieldsize")] [N("sub_member_declarators")] (N("attributes_or_asm"))*) | N("bitfieldsize"));
N("sub_member_declarators") ::= ("(" sep*(N("member_declarator"), ",") ")");
N("attributes_or_asm") ::= (N("attribute_spec") | N("asm_spec"));
N("attribute_spec") ::= ((N("attribute_specifier") "('(" sep*(N("attribute_extension"), ",") ")')") | ((N("IN") N("NL")) N("acquires_releases") "(" N("expression") ")" N("EX")) | N("upper_macro_name"));
N("acquires_releases") ::= ("__acquires" | "__releases");
N("attribute_specifier") ::= ("__attribute__" | "__attribute");
N("attribute_extension") ::= (N("attribute_name") [N("attribute_arguments")]);
N("attribute_name") ::= (N("id") | N("cv_qualifier"));
N("attribute_arguments") ::= ("(" (N("attribute_argument"))+ ")");
N("attribute_argument") ::= (("(" (N("attribute_argument"))* ")") | N("token_or_key"));
N("bitfieldsize") ::= (":" N("constant_expression"));
N("decl_qualifier") ::= (N("sc_specifier") | N("type_qualifier") | N("extension_specifier") | N("weak_specifier") | N("declspec_specifier"));
N("macro_specifier") ::= N("macro_call");
N("sc_specifier") ::= ("auto" | "register" | "static" | "extern" | "far" | "near" | "typedef" | "local" | "vector" | "const_debug" | "INIT" | "STATIC" | "NEAR" | "FAR");
N("type_specifier") ::= (N("simple_type_name") | N("enum_specifier") | N("struct_or_union_specifier") | N("typeof_expression") | N("complex_specifier"));
N("typeof_expression") ::= (N("typeof_specifier") "(" N("expression_or_type_name") ")");
N("expression_or_type_name") ::= (N("type_name") | N("expression"));
N("typeof_specifier") ::= ("__typeof" | "typeof" | "__typeof__" | "typeof__");
N("complex_specifier") ::= (N("complex") (N("simple_type_or_qualifier"))*);
N("complex") ::= ("__complex" | "__complex__" | "__Complex");
N("simple_type_or_qualifier") ::= (N("simple_type_name") | N("type_qualifier"));
N("type_qualifier") ::= (N("bit_qualifier") | N("cv_qualifier") | N("inline_qualifier") | N("restrict_qualifier") | N("init_qualifier") | N("exit_qualifier") | N("user_qualifier") | N("force_qualifier") | N("asmlinkage_qualifier") | N("zexport_qualifier") | N("attribute_spec"));
N("bit_qualifier") ::= ("long" | "short" | "signed" | "unsigned" | "__signed__" | "__signed");
N("inline_qualifier") ::= ("__inline" | "__inline__" | "inline__" | "inline" | "SBA_INLINE");
N("init_qualifier") ::= ("__init" | "init__" | "init" | "__init__");
N("exit_qualifier") ::= ("__exit" | "exit__" | "exit" | "__exit__");
N("user_qualifier") ::= ("__user" | "user__" | "user" | "__user__");
N("force_qualifier") ::= ("__force" | "force__" | "force" | "__force__");
N("asmlinkage_qualifier") ::= "asmlinkage";
N("zexport_qualifier") ::= "ZEXPORT";
N("simple_type_name") ::= ("char" | "int" | "void" | "float" | "double" | N("type_id"));
N("type_id") ::= N("reference_id");
N("macro_type_arguments") ::= ("(" sep*(N("macro_type_argument"), ",") ")");
N("macro_type_argument") ::= N("argument_expression");
N("struct_or_union") ::= ("struct" | "union");
N("enum_specifier") ::= (("enum" N("reference_id")) | ("enum" [N("reference_id")] "{" sep*(N("enumerator"), ",") [","] (N("preprocessor"))* "}"));
N("enumerator") ::= ((N("preprocessor"))* N("reference_id") [N("enumerator_value")]);
N("enumerator_value") ::= ("=" N("constant_expression"));
N("extension_specifier") ::= ("__extension__" | "__extension");
N("weak_specifier") ::= ("__weak__" | "__weak");
N("declspec_specifier") ::= ("__declspec" "(" N("decl_specifiers") ")");
N("init_declarator") ::= (N("declarator") (N("attributes_or_asm"))* [N("initialization")]);
N("declarator") ::= ((N("attribute_spec"))* (N("ptr_operator"))* N("base_declarator") N("SPON") (N("declarator_extension"))* (N("attribute_spec"))*);
N("base_declarator") ::= (N("reference_id") | (N("SPON") "(" [N("decl_specifiers")] N("declarator") ")"));
N("declarator_extension") ::= (N("function_declarator_extension") | N("array_declarator_extension"));
N("function_declarator_extension") ::= ("(" N("argument_declaration_list") ")" (N("cv_qualifier"))*);
N("array_declarator_extension") ::= ("[" [N("constant_expression")] "]");
N("ptr_operator") ::= (([N("nf_qualifier")] "*" N("SPOFF") (N("ptr_qualifier"))*) | ([N("nf_qualifier")] "(" "*" ")" N("SPOFF") (N("ptr_qualifier"))*));
N("nf_qualifier") ::= ("near" | "far" | "NEAR" | "FAR");
N("ptr_qualifier") ::= ((N("SPON") N("cv_qualifier")) | (N("SPON") N("inline_qualifier")) | (N("SPON") N("restrict_qualifier")) | (N("SPON") N("init_qualifier")) | (N("SPON") N("exit_qualifier")) | (N("SPON") N("user_qualifier")) | (N("SPON") N("zexport_qualifier")));
N("cv_qualifier") ::= ("const" | "volatile" | "CONST" | "__const" | "__const__" | "const__" | "__volatile__" | "__volatile" | "volatile__" | "__iomem" | N("initdata") | "internal_function" | "yyconst" | "pascal" | N("upper_macro_name"));
N("restrict_qualifier") ::= ("__restrict" | "restrict__" | "restrict" | "__restrict__");
N("type_name") ::= (N("type_specifiers") (N("abstract_declarator"))*);
N("type_specifiers") ::= (((N("type_qualifier"))* N("type_specifier") (N("type_qualifier"))*) | (N("type_qualifier"))+);
N("abstract_declarator") ::= (((N("ptr_operator"))+ (N("declarator_extension"))* N("SPON")) | N("array_declarator_extension") | ("(" (N("abstract_declarator"))+ ")" (N("declarator_extension"))*) | ("(" (N("type_name"))+ ")") | "static");
N("argument_declaration_list") ::= (sep*(N("argument_declaration"), ",") [N("comma_dotdotdot")]);
N("argument_declaration") ::= ((N("decl_specifiers") [N("argument_declarator")]) | ("(" N("argument_declaration") ")"));
N("comma_dotdotdot") ::= ("," N("SP") "..." N("SP"));
N("argument_declarator") ::= ((N("declarator") (N("attributes_or_asm"))*) | (N("abstract_declarator") (N("attributes_or_asm"))*));
N("initialization") ::= (([N("initdata")] "=" N("initializer")) | ("(" N("constant_expression") ")") | N("macro_call"));
N("initdata") ::= ("__initdata" | "__devinitdata" | "__cpuinitdata" | "__read_mostly" | "__initmv" | "__initdata_or_module" | "__pminitdata" | "__cpuinit" | "__devinit" | "BDATA" | "compat_init_data" | "in2000__INITDATA");
N("initializer") ::= (((N("preprocessor"))* (N("initializer_unit"))+) | (epsilon N("initializer_unit")));
N("initializer_unit") ::= (N("assignment_expression") | N("compound_initializer") | (N("NL") N("element_label") [N("colon_equals_or_equals")] N("initializer") [";"]) | (N("NL") "[" N("constant_expression") [N("dotdotdot")] [N("constant_expression")] "]" ["="] N("initializer") [";"]) | N("macro_call"));
N("colon_equals_or_equals") ::= (":" | "=" | "|=");
N("compound_initializer") ::= (("{" "}") | ("{" N("IN") sep*(N("initializer"), ",") [","] [";"] (N("preprocessor_list_initializer"))* (N("EX") N("NL")) "}"));
N("dotdotdot") ::= (N("SP") "..." N("SP"));
N("element_label") ::= (["."] N("element_name") (N("element_name_extension"))*);
N("element_name_extension") ::= (("." N("element_name")) | ("[" N("constant_expression") "]"));
N("element_name") ::= N("id");
N("preprocessor_list_initializer") ::= (N("preprocessor") sep*(N("initializer"), ",") [","]);
N("statement") ::= (((N("preprocessor"))* (N("label"))* N("unlabeled_statement")) | N("label") | N("preprocessor"));
N("label") ::= ((N("EX") N("label_id") ":" (N("IN") N("NL"))) | (N("EX") N("SP") N("SP") "case" N("constant_expression") ":" (N("IN") N("NL"))) | (N("EX") N("SP") N("SP") "default" ":" (N("IN") N("NL"))) | (N("EX") N("SP") N("SP") "case" N("constant_expression") N("SP") "..." N("SP") N("constant_expression") ":" (N("IN") N("NL"))));
N("label_id") ::= N("id");
N("unlabeled_statement") ::= (N("c_unlabeled_statement") | N("gnu_statement"));
N("gnu_statement") ::= (N("error_statement") | N("else_statement"));
N("error_statement") ::= ("error" [":"] (N("id"))+ ["+"] (N("id"))* [N("semi")]);
N("c_unlabeled_statement") ::= ((N("simple_statement") N("semi")) | N("structured_statement"));
N("simple_statement_opt_semi") ::= (N("simple_statement") [N("semi")]);
N("structured_statement") ::= (N("if_statement") | N("for_statement") | N("while_statement") | N("switch_statement") | N("do_statement") | N("compound_statement") | N("asm_statement"));
N("simple_statement") ::= (N("jump_statement") | N("null_statement") | N("expression_statement"));
N("null_statement") ::= epsilon;
N("compound_statement") ::= ("{" (N("IN") N("NL")) N("compound_statement_body") N("EX") "}" [";"] N("NL") (N("preprocessor"))*);
N("compound_statement_body") ::= (N("declaration_or_statement"))*;
N("declaration_or_statement") ::= (N("declaration") | N("statement") | N("preprocessor") | N("function_definition") | N("macro_declaration_or_statement") | N("unknown_declaration_or_statement"));
N("expression_statement") ::= ((N("pre_increment_operator"))* N("assignment_expression") (N("assign_assignment_expression"))* [N("comma_expression_statement")]);
N("assign_assignment_expression") ::= (N("assignment_operator") N("assignment_expression"));
N("comma_expression_statement") ::= ("," N("expression_statement"));
N("if_statement") ::= (("if" "(" N("expression_list") (N("preprocessor"))* ")" N("sub_statement") [N("else_statement")]) | ("if" N("postfix_expression") N("sub_statement") [N("else_statement")]));
N("sub_statement") ::= (N("compound_statement") | ((N("IN") N("NL")) N("statement") N("EX")) | ((N("IN") N("NL")) N("macro_declaration_or_statement") N("EX")));
N("switch_statement") ::= (("switch" "(" N("expression_list") ")" N("sub_statement")) | ("switch" N("macro_call") N("sub_statement")));
N("else_statement") ::= ((N("preprocessor"))* "else" N("else_sub_statement"));
N("else_sub_statement") ::= (N("if_statement") | N("sub_statement"));
N("while_statement") ::= (("while" "(" N("expression_list") ")" N("sub_statement") [N("else_statement")]) | (N("whileeachid") "(" N("expression_list") ")" N("sub_statement") [N("else_statement")]));
N("do_statement") ::= (("do" N("sub_statement") "while" "(" N("expression_list") ")" N("semi")) | ("do" N("sub_statement") "while" N("macro_call") N("semi")) | ("do" N("sub_statement") N("whileeachid") "(" N("expression_list") ")" N("semi")));
N("for_statement") ::= (("for" "(" [N("expression_list")] ";" [N("expression_list")] ";" [N("expression_list")] ")" N("sub_statement")) | ("for" "(" N("decl_specifiers") (N("init_declarator"))+ ";" [N("expression_list")] ";" [N("expression_list")] ")" N("sub_statement")) | ("for" "(" [N("expression_list")] ";" [N("expression_list")] ")" N("sub_statement")) | (N("foreachid") "(" N("expression_list") ")" N("sub_statement")));
N("jump_statement") ::= (("goto" N("label_id")) | "continue" | "break" | ("return" [N("expression")]) | ("goto" N("ptr_operator") N("expression")) | ("return" N("expression") [N("attribute_spec")]));
N("asm_statement") ::= N("asm_spec");
N("asm_spec") ::= ((N("asm") (N("cv_qualifier"))* "(" N("IN") N("asm_template") [N("asm_output_operands")] [N("asm_input_operands")] [N("asm_clobbered_registers")] N("EX") ")") | (N("asm") (N("cv_qualifier"))* "{" N("IN") (N("asm_instruction_semi"))* N("asm_instruction") [N("semi")] N("EX") "}"));
N("asm_instruction_semi") ::= ((N("asm_unit"))+ ";" N("NL"));
N("asm_instruction") ::= ((N("asm_unit"))+ N("NL"));
N("asm_unit") ::= N("token_or_key");
N("token_or_key") ::= (N("token") | N("key"));
N("asm") ::= ("__asm__" | "asm" | "asm__" | "__asm");
N("asm_template") ::= (N("string_unit_NL"))+;
N("string_unit_NL") ::= (N("string_unit") N("NL"));
N("asm_output_operands") ::= (":" sep*(N("asm_operand"), ",") N("NL"));
N("asm_input_operands") ::= (":" sep*(N("asm_operand"), ",") N("NL"));
N("asm_operand") ::= (([N("bracketed_id")] N("string") "(" N("expression") ")") | (N("pseudo_string") "(" N("expression") ")"));
N("bracketed_id") ::= ("[" N("id") "]");
N("asm_clobbered_registers") ::= (":" sep*(N("asm_register"), ",") N("NL"));
N("asm_register") ::= (N("string") | N("pseudo_string"));
N("expression_list") ::= (N("expression"))+;
N("expression") ::= N("assignment_expression");
N("constant_expression") ::= N("conditional_expression");
N("assignment_expression") ::= (N("conditional_expression") | (N("unary_expression_assign") N("assignment_expression")));
N("unary_expression_assign") ::= (N("unary_expression") N("assignment_operator"));
N("assignment_operator") ::= ("=" | "*=" | "/=" | "%=" | "+=" | "-=" | ">>=" | "<<=" | "&=" | "^=" | "|=");
N("conditional_expression") ::= (N("logical_OR_expression") [N("conditional_operation")]);
N("conditional_operation") ::= ("?" [N("expression")] ":" N("conditional_expression"));
N("logical_OR_expression") ::= (N("logical_AND_expression") (N("OR_logical_AND_expression"))*);
N("OR_logical_AND_expression") ::= (N("logical_OR_operator") N("logical_AND_expression"));
N("logical_OR_operator") ::= ("||" | "OR" | "or");
N("logical_AND_expression") ::= (N("inclusive_OR_expression") (N("AND_inclusive_OR_expression"))*);
N("AND_inclusive_OR_expression") ::= ((N("preprocessor"))* N("logical_AND_operator") N("inclusive_OR_expression"));
N("logical_AND_operator") ::= ("&&" | "AND" | "and" | "ANDP");
N("inclusive_OR_expression") ::= (N("exclusive_OR_expression") (N("OR_exclusive_OR_expression"))*);
N("OR_exclusive_OR_expression") ::= (N("bit_OR_operator") N("exclusive_OR_expression"));
N("bit_OR_operator") ::= ("|" | "BIT_OR" | "bit_or");
N("exclusive_OR_expression") ::= (N("AND_expression") (N("exclusive_OR_AND_expression"))*);
N("exclusive_OR_AND_expression") ::= (N("bit_XOR_operator") N("AND_expression"));
N("bit_XOR_operator") ::= ("^" | "BIT_XOR" | "bit_xor");
N("AND_expression") ::= (N("equality_expression") (N("AND_equality_expression"))*);
N("AND_equality_expression") ::= (N("bit_AND_operator") N("equality_expression"));
N("bit_AND_operator") ::= ("&" | "BIT_AND" | "bit_and");
N("equality_expression") ::= (N("relational_expression") (N("equality_relational_expression"))*);
N("equality_relational_expression") ::= (N("equality_operator") N("relational_expression"));
N("equality_operator") ::= ("==" | "!=");
N("relational_expression") ::= (N("shift_expression") (N("relational_shift_expression"))*);
N("relational_shift_expression") ::= (N("relational_operator") N("shift_expression"));
N("relational_operator") ::= ("<" | ">" | "<=" | ">=");
N("shift_expression") ::= (N("additive_expression") (N("shift_additive_expression"))*);
N("shift_additive_expression") ::= (N("shift_operator") N("additive_expression"));
N("shift_operator") ::= ("<<" | ">>");
N("additive_expression") ::= (N("multiplicative_expression") (N("add_subtract_multiplicative_expression"))*);
N("add_subtract_multiplicative_expression") ::= (N("additive_operator") N("multiplicative_expression"));
N("additive_operator") ::= ("+" | "-");
N("multiplicative_expression") ::= (N("cast_expression") (N("multipy_divide_cast_expression"))*);
N("multipy_divide_cast_expression") ::= (N("multiplicative_operator") N("cast_expression"));
N("multiplicative_operator") ::= ("*" | "/" | "%" | "DIV" | "MOD");
N("cast_expression") ::= ((N("cast_operator"))* N("unary_expression"));
N("cast_operator") ::= ("(" N("type_name") ")");
N("unary_expression") ::= ((N("pre_increment_operator"))* N("sub_unary_expression") N("SPON"));
N("pre_increment_operator") ::= (("++" N("SPOFF")) | ("--" N("SPOFF")));
N("sub_unary_expression") ::= (N("postfix_expression") | (N("unary_operator") N("SPOFF") N("cast_expression") N("SPON")) | (N("SPON") N("sizeof_expression")) | (N("SPON") N("alignof_expression")));
N("unary_operator") ::= ("&" | "*" | "+" | "-" | "~" | "!" | "&&" | "NOT" | "not");
N("sizeof_expression") ::= (("sizeof" "(" N("type_name") ")") | ("sizeof" N("unary_expression")));
N("alignof_expression") ::= (N("alignof_specifier") "(" N("expression_or_type_name") ")");
N("alignof_specifier") ::= ("__alignof__" | "__alignof");
N("postfix_expression") ::= (N("primary") N("SPOFF") (N("postfix_extension"))* N("SPON"));
N("primary") ::= (N("reference_id") | N("constant") | N("string") | ("(" N("SPON") N("expression_list") [","] ")") | ("{" N("SPON") N("expression_list") [","] "}") | (N("SPON") N("extension_specifier") "(" N("expression_list") ")") | (N("SPON") N("constructor_expression")) | (N("SPON") N("asm_spec")));
N("reference_id") ::= (N("id") | N("foreachid") | N("whileeachid"));
N("compound_statement_expression") ::= ("(" N("compound_statement") ")");
N("constructor_expression") ::= (("(" N("constructor_type") ")" "{" sep*(N("initializer"), ",") [","] "}") | ("(" N("constructor_expression") ")"));
N("constructor_type") ::= (N("struct_or_union_specifier") | (N("type_specifiers") (N("ptr_operator"))* (N("array_declarator_extension"))*));
N("postfix_extension") ::= (("[" N("SPON") N("assignment_expression") N("SPOFF") "]") | (N("SP") "(" N("SPON") sep*(N("argument_expression"), ",") [N("dotdot")] N("SPOFF") ")") | ("." N("id")) | ("->" N("id") [N("macro_call")]) | "++" | "--");
N("dotdot") ::= (N("SP") ".." N("SP"));
N("argument_expression") ::= (((N("preprocessor"))* [N("id")] N("assignment_expression") [N("id")] [N("colon_number")] (N("preprocessor"))*) | N("type_name") | N("structured_statement") | N("equality_operator") | N("relational_operator") | (N("assignment_operator") N("assignment_expression")) | "do" | "extern" | "continue" | epsilon);
N("colon_number") ::= (":" N("number"));
N("constant") ::= (N("number") | N("float") | N("hex") | N("long") | (N("SP") N("dotfloat")) | N("charlit") | N("string") | N("gnu_long_int") | N("gnu_long_int_string") | N("hexfloat"));
N("gnu_long_int") ::= (N("gnu_long_int_string") | N("gnu_long_int_charlit"));
N("gnu_long_int_string") ::= ("L" N("SPOFF") N("string") N("SPON"));
N("gnu_long_int_charlit") ::= ("L" N("SPOFF") N("charlit") N("SPON"));
N("hexfloat") ::= (N("extension_specifier") N("hex"));
N("string") ::= ((N("stringlit") (N("string_unit"))*) | (N("pseudo_string") N("stringlit") (N("string_unit"))*));
N("string_unit") ::= (N("stringlit") | N("pseudo_string") | N("register_spec") | N("preprocessor"));
N("pseudo_string") ::= (N("ps_name") [N("ps_arguments")]);
N("ps_name") ::= N("id");
N("ps_arguments") ::= ("(" N("ps_argument_list") ")");
N("ps_argument_list") ::= sep*(N("ps_argument"), ",");
N("ps_argument") ::= (N("constant_expression") | N("register_spec"));
N("register_spec") ::= (("%" N("SPOFF") ["%"] N("id") N("SPON")) | ("%" N("SPOFF") ["%"] N("integernumber") [N("id")] N("SPON")));
N("machinestart_declaration") ::= ("MACHINE_START" "(" N("expression_list") ")" N("IN") sep*(N("initializer"), ",") [","] (N("EX") N("NL")) "MACHINE_END" [";"] N("NL"));
N("device_attr") ::= ("DEVICE_ATTR" | "SYSDEV_ATTR" | "DEFINE_TIMER" | "DECLARE_TASKLET");
N("macro_declaration_or_statement") ::= (([N("reference_id_equals")] N("macro_call") [N("equals_initializer")] [";"] N("NL")) | (N("upper_macro_name") [";"] N("NL")));
N("reference_id_equals") ::= (N("reference_id") "=");
N("statement_declaration_or_end") ::= (N("declaration_or_statement") | "}");
N("macro_call") ::= (N("macro_name") "(" N("macro_arguments") ")");
N("macro_arguments") ::= (N("macro_argument"))*;
N("macro_argument") ::= (("(" N("macro_arguments") ")") | N("token") | N("key"));
N("equals_initializer") ::= (("=" N("initializer")) | N("initializer"));
N("macro_name") ::= N("id");
N("upper_macro_name") ::= N("upperlowerid");
N("unknown_declaration_or_statement") ::= (((N("unknown_item"))+ ";" N("NL")) | ((N("unknown_item"))+ N("NL")));
N("unknown_item") ::= (("{" (N("unknown_item"))* "}") | N("token") | N("key"));
