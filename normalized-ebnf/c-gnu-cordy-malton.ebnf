@root N("program");

N("C_compilation_unit") ::= (N("declaration_or_function_definition"))*;
N("constant") ::= (N("number") | N("float") | N("hex") | N("long") | (N("SP") N("dotfloat")) | N("charlit") | N("string"));
N("string") ::= (N("stringlit"))+;
N("expression") ::= (N("assignment_expression"))+;
N("constant_expression") ::= N("conditional_expression");
N("assignment_expression") ::= (N("conditional_expression") [N("assignment_operation")]);
N("assignment_operation") ::= (N("assignment_operator") N("assignment_expression"));
N("assignment_operator") ::= ("=" | "*=" | "/=" | "%=" | "+=" | "-=" | ">>=" | "<<=" | "&=" | "^=" | "|=");
N("conditional_expression") ::= (N("binary_expression") [N("conditional_operation")]);
N("conditional_operation") ::= ("?" N("expression") ":" N("conditional_expression"));
N("binary_expression") ::= (N("unary_expression") | (N("binary_expression") N("binary_operator") N("unary_expression")));
N("binary_operator") ::= ("+" | "-" | "*" | "/" | "%" | "==" | "!=" | "<" | ">" | "<=" | ">=" | "||" | "&&" | "|" | "^" | "&" | "<<" | ">>");
N("unary_expression") ::= (N("postfix_expression") | (N("unary_operator") N("SPOFF") N("unary_expression") N("SPON")) | ("(" N("type_name") ")" N("unary_expression")) | N("sizeof_expression"));
N("sizeof_expression") ::= (("sizeof" "(" N("type_name") ")") | ("sizeof" N("unary_expression")));
N("unary_operator") ::= ("*" | "&" | "+" | "-" | "!" | "~" | "++" | "--");
N("postfix_expression") ::= (N("reference") | N("nonreference"));
N("reference") ::= (N("reference_id") | N("reference_expression"));
N("reference_id") ::= N("id");
N("reference_expression") ::= (N("unannotated_reference_base") (N("postfix_extension"))*);
N("unannotated_reference_base") ::= (N("reference_id") | N("nonreferential_primary"));
N("nonreference") ::= (N("nonreferential_primary") (N("postfix_extension"))*);
N("nonreferential_primary") ::= (N("constant") | N("string") | ("(" N("expression") ")"));
N("postfix_extension") ::= (("[" N("expression") "]") | ("(" [N("expression")] ")") | ("." N("id")) | ("->" N("id")) | "++" | "--");
N("declaration") ::= ((N("declaration_body") N("semi")) | N("preprocessor"));
N("declaration_body") ::= ((N("decl_specifiers") (N("init_declarator"))+) | N("enum_specifier") | N("struct_or_union_specifier"));
N("decl_specifiers") ::= ((N("decl_qualifier"))* [N("type_specifier")] (N("decl_qualifier"))*);
N("struct_or_union_specifier") ::= ((N("struct_or_union") [N("tagged_reference_id")] "{" (N("IN") N("NL")) (N("member_declaration"))* N("EX") "}") | (N("struct_or_union") N("tagged_reference_id")));
N("tagged_reference_id") ::= N("reference_id");
N("member_declaration") ::= ((N("decl_specifiers") (N("member_declarator"))+ N("semi")) | N("preprocessor"));
N("member_declarator") ::= ((N("declarator") [N("bitfieldsize")]) | N("bitfieldsize"));
N("bitfieldsize") ::= (":" N("constant_expression"));
N("decl_qualifier") ::= (N("sc_specifier") | N("cv_qualifier") | N("type_qualifier"));
N("sc_specifier") ::= ("auto" | "register" | "static" | "extern" | "typedef");
N("type_specifier") ::= (N("simple_type_name") | N("enum_specifier") | N("struct_or_union_specifier"));
N("type_qualifier") ::= ("long" | "short" | "signed" | "unsigned");
N("simple_type_name") ::= ("char" | "int" | "void" | "float" | "double" | N("type_id"));
N("type_id") ::= N("reference_id");
N("struct_or_union") ::= ("struct" | "union");
N("enum_specifier") ::= (("enum" [N("tagged_reference_id")] "{" sep*(N("enumerator"), ",") "}") | ("enum" N("tagged_reference_id")));
N("enumerator") ::= (N("reference_id") [N("enumerator_value")]);
N("enumerator_value") ::= ("=" N("constant_expression"));
N("init_declarator") ::= (N("declarator") [N("initialization")]);
N("declarator") ::= ((N("ptr_operator"))* N("base_declarator") N("SPON") (N("declarator_extension"))*);
N("base_declarator") ::= (N("reference_id") | ("(" N("declarator") ")"));
N("declarator_extension") ::= (N("function_declarator_extension") | N("array_declarator_extension"));
N("function_declarator_extension") ::= ("(" N("argument_declaration_list") ")" (N("cv_qualifier"))*);
N("array_declarator_extension") ::= ("[" [N("constant_expression")] "]");
N("ptr_operator") ::= ("*" (N("cv_qualifier"))* N("SPOFF"));
N("cv_qualifier") ::= ("const" | "volatile");
N("type_name") ::= (N("type_specifiers") [N("abstract_declarator")]);
N("type_specifiers") ::= (((N("type_qualifier"))+ [N("type_specifier")] (N("type_qualifier"))*) | (N("type_specifier") (N("type_qualifier"))*));
N("abstract_declarator") ::= (((N("ptr_operator"))+ (N("declarator_extension"))*) | ("(" N("abstract_declarator") ")" (N("declarator_extension"))*));
N("argument_declaration_list") ::= sep*(N("argument_declaration"), ",");
N("argument_declaration") ::= ((N("decl_specifiers") [N("argument_declarator")]) | "...");
N("argument_declarator") ::= (N("declarator") | N("abstract_declarator"));
N("initialization") ::= (("=" N("initializer")) | ("(" N("constant_expression") ")"));
N("initializer") ::= (N("expression") | (N("NL") "{" N("IN") sep*(N("initializer"), ",") [","] N("EX") "}"));
N("statement") ::= (((N("label"))* N("unlabeled_statement")) | N("preprocessor"));
N("label") ::= ((N("label_id") ":") | (N("EX") N("SP") N("SP") "case" N("constant_expression") ":" (N("IN") N("NL"))) | (N("EX") N("SP") N("SP") "default" ":" (N("IN") N("NL"))));
N("label_id") ::= N("id");
N("unlabeled_statement") ::= (N("expression_statement") | N("if_statement") | N("for_statement") | N("while_statement") | N("switch_statement") | N("do_statement") | N("null_statement") | N("jump_statement") | N("compound_statement"));
N("null_statement") ::= N("semi");
N("compound_statement") ::= ("{" (N("IN") N("NL")) N("compound_statement_body") "}" [";"] N("NL"));
N("compound_statement_body") ::= (((N("statement"))* N("EX")) | (N("declaration") N("compound_statement_body")));
N("expression_statement") ::= (N("expression") N("semi"));
N("if_statement") ::= ("if" "(" N("expression") ")" N("statement") [N("else_statement")]);
N("switch_statement") ::= ("switch" "(" N("expression") ")" N("statement"));
N("else_statement") ::= ("else" N("statement"));
N("while_statement") ::= ("while" "(" N("expression") ")" N("statement"));
N("do_statement") ::= ("do" N("statement") "while" "(" N("expression") ")" N("semi"));
N("for_statement") ::= ("for" "(" [N("expression")] ";" [N("expression")] ";" [N("expression")] ")" N("statement"));
N("jump_statement") ::= (("goto" N("label_id") N("semi")) | ("continue" N("semi")) | ("break" N("semi")) | ("return" [N("expression")] N("semi")));
N("declaration_or_function_definition") ::= (N("declaration") | N("function_definition"));
N("function_definition") ::= (N("NL") N("decl_specifiers") N("declarator") [N("KR_parameter_decls")] N("compound_statement") N("NL"));
N("KR_parameter_decls") ::= ((N("NL") N("IN")) (N("declaration"))+ N("EX"));
N("semi") ::= (";" N("NL"));
N("program") ::= N("C_compilation_unit");
N("preprocessor") ::= (("#define" N("id") "(" (N("id"))+ ")" N("expression") N("NL")) | ("#define" N("id") N("expression") N("NL")) | (N("EX") "#else" (N("IN") N("NL"))) | (N("EX") "#endif" (N("NL") N("NL"))) | (N("NL") "#if" N("expression") (N("IN") N("NL"))) | (N("NL") "#ifdef" N("id") (N("IN") N("NL"))) | (N("NL") "#ifndef" N("id") (N("IN") N("NL"))) | ("#ident" N("stringlit") N("NL")) | ("#include" N("stringlit") N("NL")) | ("#include" "<" N("SPOFF") N("filepath") ">" N("SPON") N("NL")) | ("#line" N("integernumber") [N("stringlit")] N("NL")) | ("#undef" N("id") N("NL")) | ("#LINK" N("stringlit") N("NL")));
N("filepath") ::= (N("file_id") (N("slash_fileid"))*);
N("file_id") ::= (N("id") | N("key"));
N("slash_fileid") ::= (N("slash") N("file_id"));
N("slash") ::= ("/" | "\\" | "." | ":");
