@root N("program");

N("C_compilation_unit") ::= (N("declaration_or_function_definition"))*;
N("constant") ::= (N("number") | N("float") | N("hex") | N("long") | (N("SP") N("dotfloat")) | N("charlit") | N("string"));
N("constant") ::= (N("gnu_long_int") | (N("gnu_long_int_string"))+ | N("hexfloat"));
N("string") ::= (N("stringlit"))+;
N("expression") ::= (N("assignment_expression"))+;
N("expression") ::= ((N("comment_NL"))* "...");
N("constant_expression") ::= N("conditional_expression");
N("constant_expression") ::= N("restrict_qualifier");
N("assignment_expression") ::= (N("conditional_expression") [N("assignment_operation")]);
N("assignment_expression") ::= (N("conditional_expression") | (N("conditional_expression") N("assignment_operation")));
N("assignment_operation") ::= (N("assignment_operator") N("assignment_expression"));
N("assignment_operator") ::= ("=" | "*=" | "/=" | "%=" | "+=" | "-=" | ">>=" | "<<=" | "&=" | "^=" | "|=");
N("conditional_expression") ::= (N("binary_expression") [N("conditional_operation")]);
N("conditional_expression") ::= (N("binary_expression") (N("conditional_operation"))*);
N("conditional_operation") ::= ("?" N("expression") ":" N("conditional_expression"));
N("conditional_operation") ::= ("?" [N("expression")] ":" N("binary_expression"));
N("binary_expression") ::= (N("unary_expression") | (N("binary_expression") N("binary_operator") N("unary_expression")));
N("binary_operator") ::= ("+" | "-" | "*" | "/" | "%" | "==" | "!=" | "<" | ">" | "<=" | ">=" | "||" | "&&" | "|" | "^" | "&" | "<<" | ">>");
N("unary_expression") ::= (N("postfix_expression") | (N("unary_operator") N("SPOFF") N("unary_expression") N("SPON")) | ("(" N("type_name") ")" N("unary_expression")) | N("sizeof_expression"));
N("unary_expression") ::= N("alignof_expression");
N("sizeof_expression") ::= (("sizeof" "(" N("type_name") ")") | ("sizeof" N("unary_expression")));
N("sizeof_expression") ::= (("sizeof" N("unary_expression")) | ("sizeof" "(" N("type_name") ")"));
N("unary_operator") ::= ("*" | "&" | "+" | "-" | "!" | "~" | "++" | "--");
N("unary_operator") ::= "&&";
N("postfix_expression") ::= (N("reference") | N("nonreference"));
N("reference") ::= (N("reference_id") | N("reference_expression"));
N("reference_id") ::= N("id");
N("reference_expression") ::= (N("unannotated_reference_base") (N("postfix_extension"))*);
N("unannotated_reference_base") ::= (N("reference_id") | N("nonreferential_primary"));
N("nonreference") ::= (N("nonreferential_primary") (N("postfix_extension"))*);
N("nonreferential_primary") ::= (N("constant") | N("string") | ("(" N("expression") ")"));
N("nonreferential_primary") ::= (N("constant") | N("string") | ("(" N("expression") ")") | N("compound_statement_expression") | N("compound_literal") | (N("extension_specifier") N("compound_statement_expression")) | (N("extension_specifier") "(" N("expression") ")"));
N("postfix_extension") ::= (("[" N("expression") "]") | ("(" [N("expression")] ")") | ("." N("id")) | ("->" N("id")) | "++" | "--");
N("postfix_extension") ::= (("[" N("expression") "]") | ("(" sep*(N("argument_expression"), ",") ")") | ("." N("id")) | ("->" N("id")) | "++" | "--");
N("declaration") ::= ((N("declaration_body") N("semi")) | N("preprocessor"));
N("declaration") ::= N("comment_NL");
N("declaration") ::= (N("null_declaration") | (N("declaration_body") N("semi")) | N("preprocessor"));
N("declaration_body") ::= ((N("decl_specifiers") (N("init_declarator"))+) | N("enum_specifier") | N("struct_or_union_specifier"));
N("declaration_body") ::= ((N("decl_specifiers") (N("init_declarator"))+) | ((N("decl_qualifier"))* N("struct_or_union_specifier")) | ((N("decl_qualifier"))* N("enum_specifier") (N("attribute_spec"))*) | (N("local_label") (N("declarator"))+) | N("asm_spec"));
N("decl_specifiers") ::= ((N("decl_qualifier"))* [N("type_specifier")] (N("decl_qualifier"))*);
N("decl_specifiers") ::= (((N("decl_qualifier"))* N("type_specifier") (N("decl_qualifier"))*) | (N("decl_qualifier"))*);
N("struct_or_union_specifier") ::= ((N("struct_or_union") [N("tagged_reference_id")] "{" N("IN") N("NL") (N("member_declaration"))* N("EX") "}") | (N("struct_or_union") N("tagged_reference_id")));
N("struct_or_union_specifier") ::= ((N("struct_or_union") (N("attribute_spec"))* [N("tagged_reference_id")] "{" N("IN") N("NL") (N("member_declaration"))* N("EX") "}" (N("attribute_spec"))*) | (N("struct_or_union") (N("attribute_spec"))* N("tagged_reference_id")));
N("tagged_reference_id") ::= N("reference_id");
N("member_declaration") ::= ((N("decl_specifiers") (N("member_declarator"))+ N("semi")) | N("preprocessor"));
N("member_declaration") ::= N("comment_NL");
N("member_declaration") ::= ((N("decl_specifiers") (N("member_declarator"))+ N("semi")) | ((N("decl_qualifier"))* N("struct_or_union_specifier") N("semi")) | N("semi") | N("preprocessor"));
N("member_declarator") ::= ((N("declarator") [N("bitfieldsize")]) | N("bitfieldsize"));
N("member_declarator") ::= ((N("declarator") [N("bitfieldsize")] (N("attributes_or_asm"))*) | N("bitfieldsize"));
N("bitfieldsize") ::= (":" N("constant_expression"));
N("decl_qualifier") ::= (N("sc_specifier") | N("cv_qualifier") | N("type_qualifier"));
N("decl_qualifier") ::= (N("sc_specifier") | N("type_qualifier") | N("attribute_spec") | N("extension_specifier"));
N("sc_specifier") ::= ("auto" | "register" | "static" | "extern" | "typedef");
N("type_specifier") ::= (N("simple_type_name") | N("enum_specifier") | N("struct_or_union_specifier"));
N("type_specifier") ::= (N("typeof_expression") | N("complex_specifier"));
N("type_qualifier") ::= ("long" | "short" | "signed" | "unsigned");
N("type_qualifier") ::= (N("bit_qualifier") | N("inline_qualifier") | N("cv_qualifier") | N("restrict_qualifier"));
N("simple_type_name") ::= ("char" | "int" | "void" | "float" | "double" | N("type_id"));
N("type_id") ::= N("reference_id");
N("struct_or_union") ::= ("struct" | "union");
N("enum_specifier") ::= (("enum" [N("tagged_reference_id")] "{" sep*(N("enumerator"), ",") "}") | ("enum" N("tagged_reference_id")));
N("enum_specifier") ::= (("enum" N("tagged_reference_id")) | ("enum" [N("tagged_reference_id")] "{" sep*(N("enumerator"), ",") [","] "}"));
N("enumerator") ::= (N("reference_id") [N("enumerator_value")]);
N("enumerator_value") ::= ("=" N("constant_expression"));
N("init_declarator") ::= (N("declarator") [N("initialization")]);
N("init_declarator") ::= (N("declarator") [N("initialization")] (N("attributes_or_asm"))*);
N("declarator") ::= ((N("ptr_operator"))* N("base_declarator") N("SPON") (N("declarator_extension"))*);
N("declarator") ::= ((N("attribute_spec"))* (N("ptr_operator"))* N("base_declarator") (N("declarator_extension"))* (N("attribute_spec"))*);
N("base_declarator") ::= (N("reference_id") | ("(" N("declarator") ")"));
N("base_declarator") ::= (((N("attribute_spec"))* N("reference_id")) | ((N("attribute_spec"))* "(" N("declarator") ")"));
N("declarator_extension") ::= (N("function_declarator_extension") | N("array_declarator_extension"));
N("function_declarator_extension") ::= ("(" N("argument_declaration_list") ")" (N("cv_qualifier"))*);
N("array_declarator_extension") ::= ("[" [N("constant_expression")] "]");
N("ptr_operator") ::= ("*" (N("cv_qualifier"))* N("SPOFF"));
N("ptr_operator") ::= ("*" (N("ptr_qualifier"))*);
N("cv_qualifier") ::= ("const" | "volatile");
N("cv_qualifier") ::= ("const" | "volatile" | "__const" | "__const__" | "const__" | "__volatile__" | "__volatile" | "volatile__");
N("type_name") ::= (N("type_specifiers") [N("abstract_declarator")]);
N("type_specifiers") ::= (((N("type_qualifier"))+ [N("type_specifier")] (N("type_qualifier"))*) | (N("type_specifier") (N("type_qualifier"))*));
N("type_specifiers") ::= (((N("type_qualifier"))* N("type_specifier") (N("type_qualifier"))*) | (N("type_qualifier"))*);
N("abstract_declarator") ::= (((N("ptr_operator"))+ (N("declarator_extension"))*) | ("(" N("abstract_declarator") ")" (N("declarator_extension"))*));
N("abstract_declarator") ::= (((N("ptr_operator"))+ (N("declarator_extension"))*) | (N("array_declarator_extension"))* | ("(" N("abstract_declarator") ")" (N("declarator_extension"))*));
N("argument_declaration_list") ::= sep*(N("argument_declaration"), ",");
N("argument_declaration_list") ::= ("..." (N("comment_NL"))*);
N("argument_declaration") ::= ((N("decl_specifiers") [N("argument_declarator")]) | "...");
N("argument_declaration") ::= ((N("comment_NL"))* "...");
N("argument_declaration") ::= ("..." (N("comment_NL"))*);
N("argument_declarator") ::= (N("declarator") | N("abstract_declarator"));
N("initialization") ::= (("=" N("initializer")) | ("(" N("constant_expression") ")"));
N("initialization") ::= ((N("comment_NL"))* "...");
N("initializer") ::= (N("expression") | (N("NL") "{" N("IN") sep*(N("initializer"), ",") [","] N("EX") "}"));
N("initializer") ::= ((N("comment_NL"))* "...");
N("initializer") ::= (N("assignment_expression") | (N("NL") "{" N("IN") sep*(N("designated_initializer"), ",") [","] N("EX") "}"));
N("statement") ::= (((N("label"))* N("unlabeled_statement")) | N("preprocessor"));
N("statement") ::= N("comment_NL");
N("statement") ::= N("label");
N("label") ::= ((N("label_id") ":") | (N("EX") N("SP") N("SP") "case" N("constant_expression") ":" N("IN") N("NL")) | (N("EX") N("SP") N("SP") "default" ":" N("IN") N("NL")));
N("label") ::= ((N("label_id") ":" (N("attribute_spec"))*) | (N("EX") N("SP") N("SP") "case" N("constant_expression") ":" N("IN") N("NL")) | (N("EX") N("SP") N("SP") "case" N("constant_expression") N("SP") "..." N("SP") N("constant_expression") ":" N("IN") N("NL")) | (N("EX") N("SP") N("SP") "default" ":" N("IN") N("NL")));
N("label_id") ::= N("id");
N("unlabeled_statement") ::= (N("expression_statement") | N("if_statement") | N("for_statement") | N("while_statement") | N("switch_statement") | N("do_statement") | N("null_statement") | N("jump_statement") | N("compound_statement"));
N("unlabeled_statement") ::= N("asm_statement");
N("null_statement") ::= N("semi");
N("compound_statement") ::= ("{" N("IN") N("NL") N("compound_statement_body") "}" [";"] N("NL"));
N("compound_statement") ::= ((N("comment_NL"))* "...");
N("compound_statement") ::= ("{" N("NL") (N("compound_statement_body"))* "}" [";"] N("NL"));
N("compound_statement_body") ::= (((N("statement"))* N("EX")) | (N("declaration") N("compound_statement_body")));
N("compound_statement_body") ::= ((N("IN") N("declaration") N("EX")) | (N("IN") N("function_definition") N("EX")) | (N("IN") N("statement") N("EX")));
N("expression_statement") ::= (N("expression") N("semi"));
N("if_statement") ::= ("if" "(" N("expression") ")" N("statement") [N("else_statement")]);
N("if_statement") ::= ("if" "(" N("expression") ")" (N("comment_NL"))* N("statement") [N("else_statement")]);
N("switch_statement") ::= ("switch" "(" N("expression") ")" N("statement"));
N("switch_statement") ::= ("switch" "(" N("expression") ")" (N("comment_NL"))* N("statement"));
N("else_statement") ::= ("else" N("statement"));
N("while_statement") ::= ("while" "(" N("expression") ")" N("statement"));
N("do_statement") ::= ("do" N("statement") "while" "(" N("expression") ")" N("semi"));
N("for_statement") ::= ("for" "(" [N("expression")] ";" [N("expression")] ";" [N("expression")] ")" N("statement"));
N("for_statement") ::= ("for" "(" N("declaration_body") ";" [N("expression")] ";" [N("expression")] ")" N("statement"));
N("jump_statement") ::= (("goto" N("label_id") N("semi")) | ("continue" N("semi")) | ("break" N("semi")) | ("return" [N("expression")] N("semi")));
N("jump_statement") ::= ("goto" N("ptr_operator") N("expression") N("semi"));
N("declaration_or_function_definition") ::= (N("declaration") | N("function_definition"));
N("function_definition") ::= (N("NL") N("decl_specifiers") N("declarator") [N("KR_parameter_decls")] N("compound_statement") N("NL"));
N("KR_parameter_decls") ::= (N("NL") N("IN") (N("declaration"))+ N("EX"));
N("semi") ::= (";" N("NL"));
N("program") ::= N("C_compilation_unit");
N("preprocessor") ::= (("#define" N("id") "(" (N("id"))+ ")" N("expression") N("NL")) | ("#define" N("id") N("expression") N("NL")) | (N("EX") "#else" N("IN") N("NL")) | (N("EX") "#endif" N("NL") N("NL")) | (N("NL") "#if" N("expression") N("IN") N("NL")) | (N("NL") "#ifdef" N("id") N("IN") N("NL")) | (N("NL") "#ifndef" N("id") N("IN") N("NL")) | ("#ident" N("stringlit") N("NL")) | ("#include" N("stringlit") N("NL")) | ("#include" "<" N("SPOFF") N("filepath") ">" N("SPON") N("NL")) | ("#line" N("integernumber") [N("stringlit")] N("NL")) | ("#undef" N("id") N("NL")) | ("#LINK" N("stringlit") N("NL")));
N("preprocessor") ::= ((N("EX") "#endif" [N("comment_NL")] N("NL")) | "...");
N("preprocessor") ::= ("..." [N("comment_NL")]);
N("preprocessor") ::= (("#" N("integernumber") N("string") (N("integernumber"))* N("NL")) | ("#pragma" N("SPON") (N("id"))* "(" sep*(N("id"), ",") ")" N("NL")));
N("filepath") ::= (N("file_id") (N("slash_fileid"))*);
N("file_id") ::= (N("id") | N("key"));
N("slash_fileid") ::= (N("slash") N("file_id"));
N("slash") ::= ("/" | "\\" | "." | ":");
N("comment_NL") ::= (N("comment") N("NL"));
N("null_declaration") ::= N("semi");
N("local_label") ::= "__label__";
N("ptr_qualifier") ::= (N("restrict_qualifier") | N("cv_qualifier"));
N("restrict_qualifier") ::= ("__restrict" | "restrict__" | "restrict" | "__restrict__");
N("designator") ::= (N("array_designator") | N("struct_or_union_designator"));
N("array_designator") ::= (("[" N("constant_expression") "]" (N("postfix_extension"))*) | ("[" N("constant_expression") N("SP") "..." N("SP") N("constant_expression") "]" (N("postfix_extension"))*));
N("struct_or_union_designator") ::= (["."] N("id") (N("postfix_extension"))*);
N("designator_assignment") ::= (":" | "=");
N("extension_specifier") ::= "__extension__";
N("bit_qualifier") ::= ("long" | "short" | "signed" | "unsigned" | "__signed__" | "__signed");
N("inline_qualifier") ::= ("__inline" | "__inline__" | "inline__" | "inline");
N("attributes_or_asm") ::= (N("attribute_spec") | N("asm_spec"));
N("attribute_spec") ::= ("__attribute__" "('(" sep*(N("attribute_extension"), ",") ")')");
N("attribute_extension") ::= ((N("attribute_alias") "(" N("string") ")") | N("attribute_aligned") | (N("attribute_aligned") "(" N("tagged_attribute_number") ")") | (N("attribute_aligned") "(" N("alignof_expression") ")") | N("attribute_always_inline") | N("attribute_cdecl") | (N("attribute_cleanup") "(" N("tagged_attribute_id") ")") | N("attribute_const") | N("attribute_constructor") | N("attribute_deprecated") | N("attribute_destructor") | N("attribute_dllexport") | N("attribute_dllimport") | N("attribute_eightbit") | (N("attribute_exception") "(" N("exception_function") sep*(N("exception_arg"), ",") ")") | N("attribute_far") | N("attribute_funvector") | (N("attribute_format") "(" N("format_archetype") "," N("tagged_attribute_number") "," N("tagged_attribute_number") ")") | (N("attribute_format_arg") "(" N("tagged_attribute_number") ")") | N("attribute_interrupt") | (N("attribute_interrupt") "(" N("string") ")") | N("attribute_interrupt_handler") | (N("attribute_interrupt_handler") "(" N("string") ")") | N("attribute_longcall") | N("attribute_long_call") | N("attribute_malloc") | N("attribute_may_alias") | (N("attribute_mode") "(" N("tagged_attribute_id") ")") | (N("attribute_model") "(" N("attribute_model_name") ")") | N("attribute_naked") | N("attribute_near") | N("attribute_no_check_mem") | N("attribute_no_instrument") | N("attribute_nocommon") | N("attribute_noinline") | N("attribute_nonnull") | (N("attribute_nonnull") "(" (N("tagged_attribute_number"))+ ")") | N("attribute_noreturn") | N("attribute_nothrow") | N("attribute_packed") | N("attribute_pure") | (N("attribute_regparm") "(" N("tagged_attribute_number") ")") | (N("attribute_section") "(" N("string") ")") | N("attribute_shared") | N("attribute_short_call") | (N("attribute_signal") "(" N("string") ")") | (N("attribute_sp_switch") "(" N("string") ")") | N("attribute_stdcall") | N("attribute_tiny") | (N("attribute_tls_model") "(" N("tls_model_type") ")") | N("attribute_trans_union") | (N("attribute_trap_exit") "(" N("tagged_attribute_number") ")") | N("attribute_used") | N("attribute_unused") | (N("attribute_vector_size") "(" N("tagged_attribute_number") ")") | (N("attribute_visibility") "(" N("visibility_type") ")") | N("attribute_weak"));
N("tagged_attribute_id") ::= N("id");
N("tagged_attribute_number") ::= N("number");
N("attribute_near") ::= ("__near__" | "__near" | "near__" | "near");
N("attribute_far") ::= ("__far__" | "__far" | "far__" | "far");
N("attribute_visibility") ::= ("__visibility__" | "__visibility" | "visibility__" | "visibility");
N("visibility_type") ::= ("default" | "hidden" | "protected" | "internal");
N("attribute_nonnull") ::= ("__nonnull__" | "__nonnull" | "nonnull__" | "nonnull");
N("attribute_nothrow") ::= ("__nothrow__" | "__nothrow" | "nothrow__" | "nothrow");
N("attribute_may_alias") ::= ("__may_alias__" | "__may_alias" | "may_alias__" | "may_alias");
N("attribute_tls_model") ::= ("__tls_model__" | "__tls_model" | "tls_model__" | "tls_model");
N("tls_model_type") ::= ("global-dynamic" | "local-dynamic" | "initial-exec" | "local-exec");
N("attribute_cleanup") ::= ("__cleanup__" | "__cleanup" | "cleanup__" | "cleanup");
N("attribute_dllexport") ::= ("__dllexport__" | "__dllexport" | "dllexport__" | "dllexport");
N("attribute_used") ::= ("__used__" | "__used" | "used__" | "used");
N("attribute_always_inline") ::= ("__always_inline__" | "__always_inline" | "always_inline__" | "always_inline");
N("attribute_noinline") ::= ("__noinline__" | "__noinline" | "noinline__" | "noinline");
N("attribute_vector_size") ::= ("__vector_size__" | "__vector_size" | "vector_size__" | "vector_size");
N("attribute_deprecated") ::= ("__deprecated__" | "__deprecated" | "deprecated__" | "deprecated");
N("attribute_mode") ::= ("__mode__" | "__mode" | "mode__" | "mode");
N("attribute_format") ::= ("__format__" | "__format" | "format__" | "format");
N("attribute_format_arg") ::= ("__format_arg__" | "__format_arg" | "format_arg__" | "format_arg");
N("attribute_aligned") ::= ("__aligned__" | "__aligned" | "aligned__" | "aligned");
N("attribute_weak") ::= ("weak" | "__weak__" | "__weak" | "weak__");
N("attribute_alias") ::= ("alias" | "__alias__" | "__alias" | "alias__");
N("attribute_no_check_mem") ::= ("no_check_memory_usage" | "__no_check_memory_usage__" | "__no_check_memory_usage" | "no_check_memory_usage__");
N("attribute_regparm") ::= ("regparm" | "__regparm__" | "__regparm" | "regparm__");
N("attribute_stdcall") ::= ("stdcall" | "__stdcall__" | "__stdcall" | "stdcall__");
N("attribute_cdecl") ::= ("cdecl" | "__cdecl__" | "__cdecl" | "cdecl__");
N("attribute_longcall") ::= ("longcall" | "__longcall__" | "__longcall" | "longcall__");
N("attribute_long_call") ::= ("long_call" | "__long_call__" | "__long_call" | "long_call__");
N("attribute_short_call") ::= ("short_call" | "__short_call__" | "__short_call" | "short_call__");
N("attribute_dllimport") ::= ("dllimport" | "__dllimport__" | "__dllimport" | "dllimport__");
N("attribute_exception") ::= ("exception" | "__exception__" | "__exception" | "exception__");
N("exception_function") ::= (((N("stringlit"))* N("stringlit")) | N("tagged_attribute_id"));
N("exception_arg") ::= (((N("stringlit"))* N("stringlit")) | N("tagged_attribute_id"));
N("attribute_funvector") ::= ("function_vector" | "__function_vector__" | "__function_vector" | "function_vector__");
N("attribute_interrupt") ::= ("interrupt" | "__interrupt__" | "__interrupt" | "interrupt__");
N("attribute_interrupt_handler") ::= ("interrupt_handler" | "__interrupt_handler__" | "__interrupt_handler" | "interrupt_handler__");
N("attribute_sp_switch") ::= ("sp_switch" | "__sp_switch__" | "__sp_switch" | "sp_switch__");
N("attribute_trap_exit") ::= ("trap_exit" | "__trap_exit__" | "__trap_exit" | "trap_exit__");
N("attribute_eightbit") ::= ("eightbit_data" | "__eightbit_data__" | "__eightbit_data" | "eightbit_data__");
N("attribute_tiny") ::= ("tiny_data" | "__tiny_data__" | "__tiny_data" | "tiny_data__");
N("attribute_signal") ::= ("signal" | "__signal__" | "__signal" | "signal__");
N("attribute_naked") ::= ("naked" | "__naked__" | "__naked" | "naked__");
N("attribute_model") ::= ("model" | "__model__" | "__model" | "model__");
N("attribute_model_name") ::= ("small" | "__small__" | "__small" | "small__" | "medium" | "__medium__" | "__medium" | "medium__" | "large" | "__large__" | "__large" | "large__");
N("attribute_nocommon") ::= ("nocommon" | "__nocommon__" | "nocommon__" | "__nocommon");
N("attribute_shared") ::= ("shared" | "__shared__" | "__shared" | "shared__");
N("attribute_malloc") ::= ("malloc" | "__malloc__" | "__malloc" | "malloc__");
N("format_archetype") ::= ("printf" | "__printf__" | "__printf" | "printf__" | "scanf" | "__scanf__" | "__scanf" | "scanf__" | "strftime" | "__strftime__" | "__strftime" | "strftime__" | "strfmon" | "__strfmon__" | "__strfmon" | "strfmon__");
N("attribute_noreturn") ::= ("__noreturn__" | "__noreturn" | "noreturn__" | "noreturn");
N("attribute_const") ::= ("__const__" | "__const" | "const__" | "const");
N("attribute_pure") ::= ("__pure__" | "__pure" | "pure__" | "pure");
N("attribute_trans_union") ::= ("__transparent_union__" | "__transparent_union" | "transparent_union__" | "transparent_union");
N("attribute_unused") ::= ("__unused__" | "__unused" | "unused__" | "unused");
N("attribute_packed") ::= ("__packed__" | "__packed" | "packed__" | "packed");
N("attribute_no_instrument") ::= ("no_instrument_function" | "__no_instrument_function__" | "__no_instrument_function" | "no_instrument_function__");
N("attribute_section") ::= ("section" | "__section__" | "__section" | "section__");
N("attribute_constructor") ::= ("constructor" | "__constructor__" | "__constructor" | "constructor__");
N("attribute_destructor") ::= ("destructor" | "__destructor__" | "__destructor" | "destructor__");
N("asm_statement") ::= (N("asm_spec") N("semi"));
N("asm_spec") ::= ((N("asm_or_cv"))+ "(" N("asm_template") [N("asm_output_operands")] [N("asm_input_operands")] [N("asm_clobbered_registers")] ")");
N("asm_or_cv") ::= ("__asm__" | "asm" | "asm__" | "__asm" | N("cv_qualifier"));
N("asm_template") ::= N("string");
N("asm_output_operands") ::= (":" sep*(N("asm_operand"), ","));
N("asm_input_operands") ::= (":" sep*(N("asm_operand"), ","));
N("asm_operand") ::= (N("string") "(" N("expression") ")");
N("asm_clobbered_registers") ::= (":" sep*(N("string"), ","));
N("compound_statement_expression") ::= ("(" N("compound_statement") ")");
N("compound_literal") ::= (("(" N("struct_or_union_specifier") ")" "{" sep*(N("designated_initializer"), ",") [","] "}") | ("(" N("compound_literal_array_type") ")" "{" sep*(N("designated_initializer"), ",") [","] "}") | ("(" N("compound_literal") ")"));
N("compound_literal_array_type") ::= (N("type_specifiers") N("compound_literal_array_declarator"));
N("compound_literal_array_declarator") ::= (((N("ptr_operator"))* (N("array_declarator_extension"))*) | ("(" N("compound_literal_array_declarator") ")" (N("array_declarator_extension"))*));
N("typeof_expression") ::= ((N("typeof_specifier") "(" N("simple_type_name") ")") | (N("typeof_specifier") "(" N("expression") ")"));
N("typeof_specifier") ::= ("__typeof" | "typeof" | "__typeof__" | "typeof__");
N("complex_specifier") ::= ("_Complex" (N("simple_type_or_qualifier"))*);
N("simple_type_or_qualifier") ::= (N("simple_type_name") | N("type_qualifier"));
N("gnu_long_int") ::= (N("gnu_long_int_string") | N("gnu_long_int_charlit"));
N("gnu_long_int_string") ::= ("L" N("SPOFF") N("string") N("SPON"));
N("gnu_long_int_charlit") ::= ("L" N("SPOFF") N("charlit") N("SPON"));
N("hexfloat") ::= (N("extension_specifier") N("hex"));
N("argument_expression") ::= (N("assignment_expression") | N("type_name"));
N("alignof_expression") ::= (("__alignof__" "(" N("unary_expression") ")") | ("__alignof" "(" N("unary_expression") ")") | ("__alignof__" "(" N("type_name") ")") | ("__alignof" "(" N("type_name") ")"));
N("designated_initializer") ::= (N("assignment_expression") | ((N("designator"))* [N("designator_assignment")] N("assignment_expression")) | ((N("designator"))* [N("designator_assignment")] N("NL") "{" N("IN") sep*(N("designated_initializer"), ",") [","] N("EX") "}"));
