N("Integer") ::= value("int");
N("String") ::= value("string");
N("Boolean") ::= ("true" | "false");
N("CDataType") ::= N("CIntegral");
N("CDataType") ::= N("CFloating");
N("CDataType") ::= N("CBitField");
N("CDataType") ::= N("CVoid");
N("CDataType") ::= (N("CIntegral") | N("CFloating") | N("CBitField") | N("CVoid"));
N("CIntegral") ::= N("CEnumeration");
N("CIntegral") ::= N("CInt");
N("CIntegral") ::= N("CChar");
N("CIntegral") ::= (N("CEnumeration") | N("CInt") | N("CChar"));
N("CFloating") ::= N("CDouble");
N("CFloating") ::= N("CFloat");
N("CFloating") ::= N("CLongDouble");
N("CFloating") ::= (N("CDouble") | N("CFloat") | N("CLongDouble"));
N("CBitField") ::= epsilon;
N("CVoid") ::= epsilon;
N("CEnumeration") ::= epsilon;
N("CInt") ::= N("CUnsignedInt");
N("CInt") ::= N("CLong");
N("CInt") ::= N("CLongLong");
N("CInt") ::= N("CShort");
N("CInt") ::= (N("CUnsignedInt") | N("CLong") | N("CLongLong") | N("CShort"));
N("CChar") ::= N("CSignedChar");
N("CChar") ::= N("CUnsignedChar");
N("CChar") ::= N("CWChar");
N("CChar") ::= (N("CSignedChar") | N("CUnsignedChar") | N("CWChar"));
N("CDouble") ::= epsilon;
N("CFloat") ::= epsilon;
N("CLongDouble") ::= epsilon;
N("CUnsignedInt") ::= N("UnsignedLong");
N("CUnsignedInt") ::= N("UnsignedLongLong");
N("CUnsignedInt") ::= N("UnsignedShort");
N("CUnsignedInt") ::= (N("UnsignedLong") | N("UnsignedLongLong") | N("UnsignedShort"));
N("CLong") ::= epsilon;
N("CLongLong") ::= epsilon;
N("CShort") ::= epsilon;
N("CSignedChar") ::= epsilon;
N("CUnsignedChar") ::= epsilon;
N("CWChar") ::= epsilon;
N("UnsignedLong") ::= epsilon;
N("UnsignedLongLong") ::= epsilon;
N("UnsignedShort") ::= epsilon;
N("CClassifier") ::= N("CDataType");
N("CClassifier") ::= N("Derived");
N("CClassifier") ::= N("CStructured");
N("CClassifier") ::= (N("CDataType") | N("Derived"));
N("Derived") ::= epsilon;
N("CStructureContents") ::= N("CStructuralFeature");
N("CStructureContents") ::= N("CStructured");
N("CStructureContents") ::= select("sc_container", N("CStructured"));
N("CStructured") ::= N("CStruct");
N("CStructured") ::= N("CUnion");
N("CStructured") ::= (select("contains", N("CStructureContents")))+;
N("CStruct") ::= (select("contains", N("CStructureContents")))+;
N("CUnion") ::= (select("contains", N("CStructureContents")))+;
N("CSourceText") ::= (select("source", N("String")) select("fileName", N("String")));
N("CTypedElement") ::= N("CParameter");
N("CTypedElement") ::= N("CStructuralFeature");
N("CTypedElement") ::= (select("type", N("CClassifier")) select("source", N("CSourceText")));
N("CStructuralFeature") ::= N("CField");
N("CField") ::= epsilon;
N("CParameter") ::= select("behavioralFeature", N("BehavioralFeature"));
N("BehavioralFeature") ::= N("CFunction");
N("BehavioralFeature") ::= (select("parameters", N("CParameter")))+;
N("CFunction") ::= select("isVarArg", N("Boolean"));
