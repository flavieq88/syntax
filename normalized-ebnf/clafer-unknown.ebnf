N("Module") ::= N("ListDeclaration");
N("Declaration") ::= (("enum" N("Ident") "=" N("ListEnumId")) | N("Clafer") | N("Constraint"));
N("Clafer") ::= (N("Abstract") N("GCard") N("Ident") N("Super") N("Card") N("Elements"));
N("Constraint") ::= ("[" N("ListLExp") "]");
N("Abstract") ::= (epsilon | "abstract");
N("Elements") ::= (epsilon | ("{" N("ListElement") "}"));
N("Element") ::= (N("Clafer") | ("‘" N("Name") N("Card") N("Elements")) | N("Constraint"));
N("Super") ::= (epsilon | (":" N("Name")) | ("extends" N("Name")) | ("−>" N("ListModId") N("SExp")));
N("GCard") ::= (epsilon | "xor" | "or" | "mux" | "opt" | ("<" N("GNCard") ">"));
N("Card") ::= (epsilon | "?" | "+" | "*" | N("NCard"));
N("GNCard") ::= (N("Integer") "−" N("ExInteger"));
N("NCard") ::= (N("Integer") ".." N("ExInteger"));
N("ExInteger") ::= ("*" | N("Integer"));
N("Name") ::= (N("ListModId") N("Ident"));
N("LExp") ::= ((N("LExp") N("Iff") N("LExp1")) | N("LExp1"));
N("LExp1") ::= ((N("LExp1") N("Implies") N("LExp2")) | (N("LExp1") N("Implies") N("LExp2") "else" N("LExp2")) | N("LExp2"));
N("LExp2") ::= ((N("LExp2") N("Or") N("LExp3")) | N("LExp3"));
N("LExp3") ::= ((N("LExp3") N("Xor") N("LExp4")) | N("LExp4"));
N("LExp4") ::= ((N("LExp4") N("And") N("LExp5")) | N("LExp5"));
N("LExp5") ::= ((N("Neg") N("LExp6")) | N("LExp6"));
N("LExp6") ::= (N("Term") | ("(" N("LExp") ")"));
N("Term") ::= (N("CmpExp") | N("SExp") | (N("Quant") N("SExp")) | N("ListDecl") | "|" | N("LExp"));
N("Iff") ::= "<=>";
N("Implies") ::= "=>";
N("And") ::= "&&";
N("Xor") ::= "xor";
N("Or") ::= "||";
N("Neg") ::= "~";
N("CmpExp") ::= ((N("Exp") "<" N("Exp")) | (N("Exp") ">" N("Exp")) | (N("Exp") "=" N("Exp")) | (N("Exp") "==" N("Exp")) | (N("Exp") "<=" N("Exp")) | (N("Exp") ">=" N("Exp")) | (N("Exp") "!=" N("Exp")) | (N("Exp") "/=" N("Exp")) | (N("Exp") "in" N("Exp")) | (N("Exp") "not" "in" N("Exp")));
N("Exp") ::= (N("AExp") | N("StrExp"));
N("Quant") ::= ("no" | "lone" | "one" | "some");
N("ExQuant") ::= ("all" | N("Quant"));
N("SExp") ::= ((N("SExp") "++" N("SExp1")) | N("SExp1"));
N("SExp1") ::= ((N("SExp1") "&" N("SExp2")) | N("SExp2"));
N("SExp2") ::= ((N("SExp2") "<:" N("SExp3")) | N("SExp3"));
N("SExp3") ::= ((N("SExp3") ":>" N("SExp4")) | N("SExp4"));
N("SExp4") ::= ((N("SExp4") "." N("SExp5")) | N("SExp5"));
N("SExp5") ::= (N("Ident") | ("(" N("SExp") ")"));
N("Decl") ::= (N("ExQuant") N("Disj") N("ListLocId") ":" N("SExp"));
N("Disj") ::= (epsilon | "disj");
N("AExp") ::= ((N("AExp") "+" N("AExp1")) | (N("AExp") "−" N("AExp1")) | N("AExp1"));
N("AExp1") ::= ((N("AExp1") "*" N("AExp2")) | N("AExp2"));
N("AExp2") ::= (("#" N("SExp")) | N("SExp") | N("Integer") | ("(" N("AExp") ")"));
N("StrExp") ::= ((N("StrExp") "++" N("StrExp")) | N("String"));
N("EnumId") ::= N("Ident");
N("ModId") ::= N("Ident");
N("LocId") ::= N("Ident");
N("ListDeclaration") ::= (epsilon | (N("Declaration") N("ListDeclaration")));
N("ListEnumId") ::= (N("EnumId") | N("EnumId") | (N("EnumId") "|" N("ListEnumId")));
N("ListElement") ::= (epsilon | (N("Element") N("ListElement")));
N("ListLExp") ::= (epsilon | (N("LExp") N("ListLExp")));
N("ListDecl") ::= (N("Decl") | (N("Decl") "," N("ListDecl")));
N("ListLocId") ::= (N("LocId") | (N("LocId") "," N("ListLocId")));
N("ListModId") ::= (epsilon | (N("ModId") "/" N("ListModId")));
