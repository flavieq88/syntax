N("program") ::= N("declaration_list");
N("declaration_list") ::= (N("declaration"))*;
N("declaration") ::= (N("asm_declaration") | N("class_definition") | N("function_definition") | N("namespace_definition") | N("template_declaration") | N("linkage_specification") | N("exception_specification") | N("using_declaration") | ([N("decl_specifiers")] N("declarator_list") ";" N("NL")) | (N("decl_specifiers") ";" N("NL")) | (";" N("NL")) | (N("preprocessor") N("NL")));
N("asm_declaration") ::= ("asm" "(" N("string_constant") ")" ";" N("NL"));
N("class_definition") ::= (N("NL") (N("storage_class_specifier"))* N("class_specifier") [N("declarator_list")] ";" (N("NL") N("NL")));
N("storage_class_specifier") ::= ("auto" | "register" | "static" | "extern");
N("class_specifier") ::= (N("class_head") "{" (N("NL") N("IN")) (N("member"))* N("EX") "}");
N("class_head") ::= ((N("class_key") [N("id")] [N("base_spec")]) | (N("class_key") N("nested_name_spec") N("id") [N("base_spec")]) | (N("class_key") N("class_name") [N("base_spec")]));
N("class_key") ::= ("class" | "struct" | "union");
N("base_spec") ::= (":" N("base_list"));
N("base_list") ::= (N("base_specifier") [","] sep*(N("base_specifier"), ","));
N("base_specifier") ::= ((["::"] [N("nested_name_spec")] N("class_name")) | ("virtual" [N("access_specifier")] ["::"] [N("nested_name_spec")] N("class_name")) | (N("access_specifier") ["virtual"] ["::"] [N("nested_name_spec")] N("class_name")));
N("access_specifier") ::= ("private" | "protected" | "public");
N("member") ::= ([N("access_specifier_colon")] N("member_declaration"));
N("access_specifier_colon") ::= (N("EX_2") N("NL") N("access_specifier") N("SPOFF") ":" N("SPON") N("IN_2") N("NL"));
N("member_declaration") ::= ((N("function_definition") [";"]) | (N("qualified_name") ";" N("NL")) | N("using_declaration") | ([N("decl_specifiers")] N("member_declarator_list") ";" N("NL")) | (N("decl_specifiers") ";" N("NL")) | (";" N("NL")) | (N("preprocessor") N("NL")));
N("member_declarator_list") ::= (N("member_declarator"))+;
N("member_declarator") ::= ((N("declarator") [N("initializer")]) | ([N("id")] N("SPOFF") ":" N("SPON") N("constant_expression")));
N("function_definition") ::= (N("NL") [N("decl_specifiers")] N("function_declarator") [N("ctor_initializer")] [N("exception_specification")] N("function_body"));
N("function_declarator") ::= ((N("pointer_operator"))* N("declared_item") (N("declarator_extension"))+);
N("function_body") ::= ((N("NL") N("compound_statement") [";"] N("NL")) | ("try" [N("ctor_initializer")] N("NL") N("compound_statement") [";"] N("NL") N("handler_list")));
N("ctor_initializer") ::= (N("SPOFF") ":" N("SPON") N("mem_initializer_list"));
N("mem_initializer_list") ::= (N("mem_initializer"))+;
N("mem_initializer") ::= (["::"] [N("nested_name_spec")] N("class_name") "(" [N("expression_list")] ")");
N("namespace_definition") ::= (("namespace" [N("id")] "{" (N("NL") N("IN")) [N("declaration_list")] N("EX") "}" (N("NL") N("NL"))) | ("namespace" N("id") "=" N("qualified_namespace_spec")));
N("qualified_namespace_spec") ::= (["::"] [N("nested_name_spec")] N("class_or_namespace_name"));
N("nested_name_spec") ::= (N("class_or_namespace_name") "::" [N("nested_name_spec")]);
N("class_or_namespace_name") ::= (N("class_name") | N("namespace_name"));
N("namespace_name") ::= N("id");
N("template_declaration") ::= ("template" "<" N("template_parameter_list") ">" N("declaration"));
N("template_parameter_list") ::= (N("template_parameter") | (N("template_parameter_list") "," N("template_parameter")));
N("template_parameter") ::= (N("type_parameter") | N("parameter_declaration"));
N("type_parameter") ::= ("class" N("id"));
N("linkage_specification") ::= ((N("NL") "extern" N("stringlit") "{" (N("NL") N("IN")) N("declaration_list") N("EX") "}" [";"] (N("NL") N("NL"))) | ("extern" N("stringlit") N("declaration")));
N("exception_specification") ::= ("throw" "(" [N("type_list")] ")");
N("type_list") ::= (N("type_name") | (N("type_list") "," N("type_name")));
N("using_declaration") ::= (("using" ["::"] [N("nested_name_spec")] N("name") ";") | ("using" "namespace" ["::"] [N("nested_name_spec")] N("id") ";"));
N("declarator_list") ::= (N("init_declarator"))+;
N("init_declarator") ::= (N("declarator") [N("initializer")]);
N("declarator") ::= ((N("pointer_operator"))* N("declared_item") (N("declarator_extension"))*);
N("declared_item") ::= (N("declared_name") | ("(" N("declarator") ")"));
N("declarator_extension") ::= ((N("parenthesized_parameter_declaration_list") [N("const_volatile_qualifier_list")]) | ("[" [N("constant_expression")] "]"));
N("parenthesized_parameter_declaration_list") ::= (("(" N("parameter_declaration_list") ")") | ("(" N("parenthesized_parameter_declaration_list") ")"));
N("pointer_operator") ::= ((N("stars") [N("const_volatile_qualifier_list")]) | ("&" [N("const_volatile_qualifier_list")]) | (N("id") "::" N("stars") [N("const_volatile_qualifier_list")]) | (["::"] N("nested_name_spec") "*" N("const_volatile_qualifier_list")));
N("stars") ::= ("*" | "**");
N("const_volatile_qualifier_list") ::= (N("const_volatile_qualifier"))+;
N("const_volatile_qualifier") ::= ("const" | "volatile");
N("declared_name") ::= (([N("nested_name_spec")] N("name")) | ("~" N("SPOFF") N("id") N("SPON")));
N("type_name") ::= (N("type_specifiers") [N("abstract_declarator")]);
N("abstract_declarator") ::= ((N("abstract_extension"))+ | ("(" N("abstract_declarator") ")" (N("abstract_extension"))*));
N("abstract_extension") ::= (("(" N("parameter_declaration_list") ")" [N("const_volatile_qualifier_list")]) | ("[" [N("constant_expression")] "]") | N("pointer_operator") | ("(" N("abstract_declarator") ")"));
N("parameter_declaration_list") ::= (sep*(N("parameter_declaration"), ",") [N("comma_dotdotdot")]);
N("comma_dotdotdot") ::= ([","] "...");
N("parameter_declaration") ::= (N("decl_specifiers") N("parameter_declarator") [N("equal_expression")]);
N("parameter_declarator") ::= (N("declarator") | [N("abstract_declarator")]);
N("equal_expression") ::= ("=" N("expression"));
N("initializer") ::= (("=" N("initial_value")) | ("(" [N("expression_list")] ")"));
N("initial_value") ::= (N("assignment_expression") | ("{" N("IN") N("initializer_list") [","] N("EX") "}"));
N("initializer_list") ::= (N("initializer_element"))+;
N("initializer_element") ::= (N("assignment_expression") | (N("NL") "{" N("IN") N("initializer_list") [","] N("EX") "}"));
N("decl_specifier") ::= (N("storage_class_specifier") | N("type_specifier") | N("function_specifier") | "friend" | "typedef");
N("decl_specifiers") ::= (N("decl_specifier"))+;
N("function_specifier") ::= ("inline" | "virtual");
N("type_specifier") ::= (N("simple_type_name") | N("class_specifier") | N("enum_specifier") | N("elaborated_type_specifier") | N("const_volatile_qualifier"));
N("type_specifiers") ::= (N("type_specifier"))+;
N("simple_type_name") ::= ("char" | "bool" | "short" | "int" | "long" | "signed" | "unsigned" | "float" | "double" | "void" | (["::"] [N("nested_name_spec")] N("id")) | (["::"] [N("nested_name_spec")] N("template_class_name")));
N("template_class_name") ::= (N("id") N("template_arguments"));
N("template_arguments") ::= ("<" N("template_argument_list") ">");
N("template_argument_list") ::= (N("template_argument") | (N("template_argument_list") "," N("template_argument")));
N("template_argument") ::= (N("type_name") | N("non_gt_binary_expression"));
N("non_gt_binary_expression") ::= (N("cast_expression") (N("non_gt_binary_operation"))*);
N("non_gt_binary_operation") ::= (N("non_gt_binary_operator") N("cast_expression"));
N("non_gt_binary_operator") ::= ("||" | "&&" | "|" | "^" | "&" | "==" | "!=" | "<" | "<=" | ">=" | "<<" | ">>" | "+" | "-" | "*" | "/" | "%" | ".*" | "->*");
N("elaborated_type_specifier") ::= ((N("class_key") ["::"] [N("nested_name_spec")] N("class_name")) | ("enum" ["::"] [N("nested_name_spec")] N("id")));
N("enum_specifier") ::= ("enum" [N("id")] "{" [N("enum_list")] "}");
N("enum_list") ::= ((N("enumerator"))+ [","]);
N("enumerator") ::= (N("id") [N("equal_constant_expression")]);
N("equal_constant_expression") ::= ("=" N("constant_expression"));
N("constant_expression") ::= N("conditional_expression");
N("conversion_function_name") ::= ("operator" N("conversion_type_name"));
N("conversion_type_name") ::= (N("type_specifiers") [N("pointer_operator")]);
N("operator_function_name") ::= ("operator" N("operator"));
N("operator") ::= ("new" | "delete" | "+" | "-" | "*" | "/" | "%" | "^" | "&" | "|" | "~" | "!" | "=" | "<" | ">" | "+=" | "-=" | "-+" | "*=" | "/=" | "%=" | "^=" | "&=" | "|=" | "<<" | ">>" | ">>=" | "<<=" | "==" | "!=" | "<=" | ">=" | "&&" | "||" | "++" | "--" | "," | "->*" | "->" | ("(" [N("type_specifier")] ")") | ("[" "]"));
N("statement") ::= ((N("label"))* N("unlabeled_statement"));
N("unlabeled_statement") ::= (N("null_statement") | N("expression_statement") | N("compound_statement") | N("selection_statement") | N("iteration_statement") | N("jump_statement") | N("declaration_statement") | N("try_block"));
N("try_block") ::= ("try" N("compound_statement") N("handler_list"));
N("handler_list") ::= (N("handler") [N("handler_list")]);
N("handler") ::= ("catch" "(" N("exception_declaration") ")" N("compound_statement"));
N("exception_declaration") ::= ((N("type_specifiers") [N("exception_declarator")]) | "...");
N("exception_declarator") ::= (N("declarator") | N("abstract_declarator"));
N("label") ::= ((N("id") N("SPOFF") ":" N("SPON")) | (N("EX") "case" N("constant_expression") N("SPOFF") ":" N("SPON") (N("NL") N("IN"))) | (N("EX") "default" N("SPOFF") ":" N("SPON") (N("NL") N("IN"))));
N("expression_statement") ::= (N("expression") ";" N("NL"));
N("null_statement") ::= (";" N("NL"));
N("compound_statement") ::= ("{" (N("NL") N("IN")) [N("statement_list")] N("EX") "}" N("NL"));
N("statement_list") ::= (N("statement"))+;
N("selection_statement") ::= (("if" "(" N("expression") ")" N("statement") [N("else_statement")]) | ("switch" "(" N("expression") ")" N("statement")));
N("else_statement") ::= ("else" N("statement"));
N("iteration_statement") ::= (("while" "(" N("expression") ")" N("statement")) | ("do" N("statement") "while" "(" N("expression") ")" ";" N("NL")) | ("for" "(" N("for_init_statement") [N("expression")] ";" [N("expression")] ")" N("for_body")));
N("for_init_statement") ::= ((N("expression") ";") | ([N("decl_specifiers")] N("declarator_list") ";") | (N("decl_specifiers") ";") | ";");
N("for_body") ::= (N("compound_statement") | ((N("IN") N("NL")) N("statement") N("EX")));
N("jump_statement") ::= (("break" ";" N("NL")) | ("continue" ";" N("NL")) | ("return" [N("expression")] ";" N("NL")) | ("goto" N("id") ";" N("NL")));
N("declaration_statement") ::= N("declaration");
N("preprocessor") ::= (("#define" N("id") "(" (N("id"))+ ")" N("expression")) | ("#define" N("id") N("expression")) | (N("EX") "#else" N("IN")) | (N("EX") "#endif" N("NL")) | (N("NL") "#if" N("expression") N("IN")) | (N("NL") "#ifdef" N("id") N("IN")) | (N("NL") "#ifndef" N("id") N("IN")) | ("#ident" N("stringlit")) | ("#include" N("stringlit")) | ("#include" "<" N("SPOFF") N("filename") ">" N("SPON")) | ("#line" N("integernumber") [N("stringlit")]) | ("#undef" N("id")) | ("#LINK" N("stringlit")));
N("file_identifier") ::= (N("id") | N("key"));
N("filename") ::= (N("file_identifier") (N("dot_slash_identifier"))*);
N("dot_slash_identifier") ::= (["."] ["/"] N("file_identifier"));
N("expression") ::= (N("assignment_expression") | (N("expression") "," N("assignment_expression")));
N("assignment_expression") ::= (N("conditional_expression") | (N("unary_expression") N("assignment_operator") N("assignment_expression")));
N("assignment_operator") ::= ("=" | "*=" | "/=" | "%=" | "+=" | "-=" | ">>=" | "<<=" | "&=" | "^=" | "|=");
N("conditional_expression") ::= (N("binary_expression") [N("conditional_operation")]);
N("conditional_operation") ::= ("?" N("expression") ":" N("conditional_expression"));
N("binary_expression") ::= (N("cast_expression") (N("binary_operation"))*);
N("binary_operation") ::= (N("binary_operator") N("cast_expression"));
N("binary_operator") ::= ("||" | "&&" | "|" | "^" | "&" | "==" | "!=" | "<" | ">" | "<=" | ">=" | "<<" | ">>" | "+" | "-" | "*" | "/" | "%" | ".*" | "->*");
N("cast_expression") ::= (N("unary_expression") | ("(" N("type_name") ")" N("cast_expression")));
N("unary_expression") ::= (N("postfix_expression") | ("++" N("unary_expression")) | ("--" N("unary_expression")) | (N("unary_operator") N("cast_expression")) | ("sizeof" N("unary_expression")) | ("sizeof" "(" N("type_name") ")") | N("allocation_expression") | N("deallocation_expression") | N("throw_expression"));
N("throw_expression") ::= ("throw" [N("assignment_expression")]);
N("unary_operator") ::= ("**" | "*" | "&" | "+" | "-" | "!" | "~");
N("allocation_expression") ::= (["::"] "new" [N("placement")] N("allocation_type_name") [N("initializer")]);
N("placement") ::= ("(" N("expression_list") ")");
N("allocation_type_name") ::= ((N("type_specifiers") [N("allocation_declarator")]) | ("(" N("type_name") ")" [N("allocation_declarator")]));
N("allocation_declarator") ::= (N("allocation_array_declarator") | ("*" [N("const_volatile_qualifier_list")] [N("allocation_declarator")]) | (["::"] N("nested_name_spec") "*" [N("const_volatile_qualifier_list")] [N("allocation_declarator")]) | (N("qualified_name") "::" "*" [N("const_volatile_qualifier_list")] [N("allocation_declarator")]));
N("allocation_array_declarator") ::= (("[" [N("expression")] "]") | (N("allocation_array_declarator") "[" [N("expression")] "]"));
N("deallocation_expression") ::= ((["::"] "delete" N("cast_expression")) | (["::"] "delete" "[" [N("expression")] "]" N("cast_expression")));
N("postfix_expression") ::= ((N("primary_expression") (N("postfix_extension"))*) | (N("simple_type_name") "(" [N("expression_list")] ")" (N("postfix_extension"))*));
N("postfix_extension") ::= (("[" [N("expression")] "]") | ("(" [N("expression_list")] ")") | ("." N("name")) | ("->" N("name")) | "++" | "--");
N("expression_list") ::= (N("assignment_expression"))+;
N("primary_expression") ::= (N("literal") | "this" | ("::" N("id")) | ("::" N("operator_function_name")) | ("(" N("expression") ")") | N("name"));
N("name") ::= (N("id") | N("template_class_name") | N("qualified_name") | N("operator_function_name") | N("conversion_function_name"));
N("class_name") ::= (N("id") [N("template_arguments")]);
N("qualified_name") ::= (N("class_name") "::" N("class_component"));
N("class_component") ::= (N("class_name") | ("~" N("SPOFF") N("class_name") N("SPON")) | N("operator_function_name") | N("conversion_function_name") | N("qualified_name"));
N("literal") ::= (N("number_constant") | N("character_constant") | N("string_constant"));
N("string_constant") ::= (N("stringlit") N("IN") (N("NL_stringlit"))* N("EX"));
N("NL_stringlit") ::= (N("NL") N("stringlit"));
N("character_constant") ::= N("charlit");
N("number_constant") ::= ((["-"] N("number")) | N("hexnumber"));
