N("Integer") ::= value("int");
N("String") ::= value("string");
N("Boolean") ::= ("true" | "false");
N("CDerived") ::= N("CPPReference");
N("CDerived") ::= N("CPPExtern");
N("CDerived") ::= N("CPPConst");
N("CDerived") ::= N("CPPTemplate");
N("CDerived") ::= (N("CPPReference") | N("CPPExtern") | N("CPPConst") | N("CPPTemplate"));
N("CStructured") ::= N("CPPClass");
N("CBehavorialFeature") ::= N("CFunction");
N("CFunction") ::= N("CPPOperation");
N("CFunction") ::= select("isVsrArg", N("Boolean"));
N("CStructureContents") ::= N("CPPOperator");
N("CStructureContents") ::= N("CPPOperation");
N("CField") ::= epsilon;
N("CDerivableType") ::= epsilon;
N("VisibilityKind") ::= (select("vk_public", epsilon) | select("vk_private", epsilon) | select("vk_protected", epsilon));
N("CPPReference") ::= epsilon;
N("CPPExtern") ::= select("linkage", N("String"));
N("CPPConst") ::= epsilon;
N("CPPTemplate") ::= (select("classes", N("CPPClass")))+;
N("CPPClass") ::= (select("isAbstract", N("Boolean")) select("isVolatile", N("Boolean")) select("visibility", N("VisibilityKind")) (select("templates", N("CPPTemplate")))+ (select("generalizations", N("CPPGeneralization")))+);
N("CPPGeneralization") ::= (select("visibility", N("VisibilityKind")) select("isVirtual", N("Boolean")) select("supertype", N("CPPClass")));
N("CPPOperation") ::= (select("isStatic", N("Boolean")) select("isExtern", N("Boolean")) select("isInline", N("Boolean")) select("isVirtual", N("Boolean")) select("isPure", N("Boolean")) select("visibility", N("VisibilityKind")) select("isCtor", N("Boolean")) select("isDtor", N("Boolean")) (select("throws", N("CPPClass")))+);
N("CPPOperator") ::= (select("isInline", N("Boolean")) select("visibility", N("VisibilityKind")));
N("CPPMember") ::= (select("isStatic", N("Boolean")) select("isVolatile", N("Boolean")) select("isRegister", N("Boolean")) select("visibility", N("VisibilityKind")));
