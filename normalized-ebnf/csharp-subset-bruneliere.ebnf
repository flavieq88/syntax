N("Member") ::= N("TypedAttribute");
N("Member") ::= N("MethodBase");
N("Member") ::= N("Type");
N("Member") ::= (select("name", N("String")) select("owner", N("Type")));
N("TypedAttribute") ::= N("Field");
N("TypedAttribute") ::= N("Property");
N("TypedAttribute") ::= select("type", N("Type"));
N("Field") ::= (select("type", N("Type")));
N("Property") ::= (select("isReadable", N("Boolean")) select("isWritable", N("Boolean")));
N("MethodBase") ::= N("Constructor");
N("MethodBase") ::= N("Method");
N("MethodBase") ::= (select("visibility", N("String")) select("isAbstract", N("Boolean")) select("isFinal", N("Boolean")) select("isStatic", N("Boolean")) (select("parameters", N("Parameter")))+);
N("Constructor") ::= (select("visibility", N("String")) select("isAbstract", N("Boolean")) select("isFinal", N("Boolean")) select("isStatic", N("Boolean")) (select("parameters", N("Parameter")))+);
N("Method") ::= select("returnType", N("Type"));
N("Type") ::= (select("qualifiedName", N("String")) select("isAbstract", N("Boolean")) select("visibility", N("String")) select("isSealed", N("Boolean")) select("nameSpace", N("String")) (select("members", N("Member")))+ select("t_container", N("Assembly")) select("super", N("Type")));
N("Parameter") ::= (select("isIn", N("Boolean")) select("isOut", N("Boolean")) select("name", N("Boolean")) select("position", N("Integer")) select("method", N("MethodBase")) select("type", N("Type")));
N("Assembly") ::= (select("name", N("String")) (select("content", N("Type")))+);
N("Integer") ::= value("int");
N("String") ::= value("string");
N("Boolean") ::= ("true" | "false");
