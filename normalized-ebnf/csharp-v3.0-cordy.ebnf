N("struct_modifier") ::= "unsafe";
N("struct_interfaces") ::= (":" N("interface_type_list"));
N("interface_type_list") ::= (N("interface_type"))+;
N("struct_body") ::= ("{" N("NL") N("IN") [N("struct_member_declarations")] N("EX") "}" [";"] N("NL"));
N("struct_member_declarations") ::= (N("struct_member_declaration"))+;
N("struct_member_declaration") ::= (N("constant_declaration") | N("field_declaration") | N("method_declaration") | N("property_declaration") | N("event_declaration") | N("indexer_declaration") | N("operator_declaration") | N("constructor_declaration") | N("static_constructor_declaration") | N("type_declaration"));
N("array_initializer") ::= ("{" [N("variable_initializer_list")] [","] "}");
N("variable_initializer_list") ::= (N("variable_initializer"))+;
N("interface_declaration") ::= ([N("attributes")] [N("interface_modifiers")] ["partial"] "interface" N("id") [N("type_parameter_list")] [N("interface_base")] [N("type_parameter_constraints_clauses")] N("NL") N("interface_body") N("NL"));
