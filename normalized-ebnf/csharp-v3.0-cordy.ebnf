N("static_constructor_declaration") ::= ([N("attributes")] N("static_constructor_modifiers") N("id") "(" ")" N("NL") N("static_constructor_body") N("NL"));
N("static_constructor_modifiers") ::= ((["extern"] "static") | ("static" ["extern"]));
N("static_constructor_modifiers") ::= ((["extern"] ["unsafe"] "static") | (["unsafe"] ["extern"] "static") | (["extern"] "static" ["unsafe"]) | (["unsafe"] "static" ["extern"]) | ("static" ["extern"] ["unsafe"]) | ("static" ["unsafe"] ["extern"]));
N("static_constructor_body") ::= ((N("block") N("NL")) | (";" N("NL")));
N("finalizer_declaration") ::= ([N("attributes")] ["extern"] "~" N("id") "(" ")" N("finalizer_body"));
N("finalizer_declaration") ::= (([N("attributes")] ["extern"] ["unsafe"] "~" N("id") "(" ")" N("NL") N("finalizer_body") N("NL")) | ([N("attributes")] ["unsafe"] ["extern"] "~" N("id") "(" ")" N("NL") N("finalizer_body") N("NL")));
N("finalizer_body") ::= ((N("block") N("NL")) | (";" N("NL")));
N("struct_declaration") ::= ([N("attributes")] [N("struct_modifiers")] ["partial"] "struct" N("id") [N("type_parameter_list")] [N("struct_interfaces")] [N("type_parameter_constraints_clauses")] N("NL") N("struct_body") N("NL"));
