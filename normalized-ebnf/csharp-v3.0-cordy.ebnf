N("interface_property_declaration") ::= ([N("attributes")] ["new"] N("type") N("id") N("NL") "{" N("NL") N("IN") N("interface_accessors") N("EX") "}" N("NL"));
N("interface_accessors") ::= (([N("attributes")] "get" ";") | ([N("attributes")] "set" ";") | ([N("attributes")] "get" ";" [N("attributes")] "set" ";") | ([N("attributes")] "set" ";" [N("attributes")] "get" ";"));
