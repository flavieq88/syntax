N("global_attribute_section") ::= ("[" N("global_attribute_target_specifier") N("attribute_list") [","] "]");
N("global_attribute_target_specifier") ::= (N("global_attribute_target") ":");
N("global_attribute_target") ::= (N("id") | N("key"));
N("attributes") ::= N("attribute_sections");
