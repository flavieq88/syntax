@root N("program");

N("literal") ::= (N("boolean_literal") | N("integer_literal") | N("real_literal") | N("character_literal") | N("string_literal") | N("null_literal"));
N("boolean_literal") ::= ("true" | "false");
N("integer_literal") ::= (N("decimal_integer_literal") | N("hexadecimal_integer_literal"));
N("character_literal") ::= N("charlit");
N("string_literal") ::= N("stringlit");
N("null_literal") ::= "null";
N("program") ::= N("compilation_unit");
N("compilation_unit") ::= ([N("extern_alias_directives")] [N("using_directives")] [N("global_attributes")] [N("namespace_member_declarations")]);
N("namespace_name") ::= N("namespace_or_type_name");
N("type_name") ::= N("namespace_or_type_name");
N("namespace_or_type_name") ::= (["this"] N("id") [N("colon_colon_id")] (N("dot_id"))* [N("type_argument_list")]);
N("colon_colon_id") ::= ("::" N("id"));
N("dot_id") ::= ("." N("id"));
N("type") ::= (N("value_type") | N("reference_type") | N("type_parameter"));
N("type") ::= N("pointer_type");
N("value_type") ::= (N("struct_type") | N("enum_type"));
N("struct_type") ::= (N("type_name") | N("simple_type") | N("nullable_type"));
N("simple_type") ::= (N("numeric_type") | "bool");
N("numeric_type") ::= (N("integral_type") | N("floating_point_type") | "decimal");
N("integral_type") ::= ("sbyte" | "byte" | "short" | "ushort" | "int" | "uint" | "long" | "ulong" | "char");
N("floating_point_type") ::= ("float" | "double");
N("enum_type") ::= N("type_name");
N("nullable_type") ::= (N("non_nullable_value_type") "?");
N("non_nullable_value_type") ::= (N("enum_type") | N("type_name") | N("simple_type"));
N("reference_type") ::= (N("class_type") | N("interface_type") | N("array_type") | N("delegate_type"));
N("class_type") ::= (N("type_name") | "object" | "string");
N("interface_type") ::= N("type_name");
N("array_type") ::= (N("non_array_type") N("rank_specifiers"));
N("non_array_type") ::= (N("value_type") | N("class_type") | N("interface_type") | N("delegate_type") | N("type_parameter"));
N("rank_specifiers") ::= (N("rank_specifier"))*;
N("rank_specifier") ::= ("[" (",")* "]");
N("delegate_type") ::= N("type_name");
N("variable_reference") ::= N("expression");
N("argument_list") ::= sep*(N("argument"), ",");
N("argument") ::= (N("expression") | ("ref" N("variable_reference")) | ("out" N("variable_reference")));
N("primary_expression") ::= (N("array_creation_expression") | N("primary_no_array_creation_expression") | N("object_initializer_expression"));
N("primary_no_array_creation_expression") ::= (N("simple_primary_expression") (N("primary_expression_modifier"))*);
N("primary_no_array_creation_expression") ::= N("sizeof_expression");
N("simple_primary_expression") ::= (N("literal") | N("simple_name") | N("parenthesized_expression") | N("this_access") | N("base_access") | N("object_or_delegate_creation_expression") | N("typeof_expression") | N("checked_expression") | N("unchecked_expression") | N("default_value_expression") | N("anonymous_method_expression") | (N("predefined_type") N("member_access_operator")) | (N("qualified_alias_member") N("member_access_operator")));
N("primary_expression_modifier") ::= (N("member_access_operator") | N("invocation_operator") | N("element_access_operator") | N("post_increment_operator") | N("post_decrement_operator"));
N("primary_expression_modifier") ::= (N("pointer_member_access_operator") | N("pointer_element_access_operator"));
N("simple_name") ::= (N("id") [N("type_argument_list")]);
N("parenthesized_expression") ::= ("(" N("expression") ")");
N("member_access_operator") ::= ("." N("id") [N("type_argument_list")]);
N("predefined_type") ::= ("bool" | "byte" | "char" | "decimal" | "double" | "float" | "int" | "long" | "object" | "sbyte" | "short" | "string" | "uint" | "ulong" | "ushort");
N("invocation_operator") ::= ("(" sep*(N("argument"), ",") ")");
N("invocation_operator") ::= ("((" (N("argument_list_or_key"))* "))");
N("element_access_operator") ::= ("[" (N("expression"))+ "]");
N("this_access") ::= "this";
N("base_access") ::= (("base" "." N("id") [N("type_argument_list")]) | ("base" "[" (N("expression"))+ "]"));
N("post_increment_operator") ::= "++";
N("post_decrement_operator") ::= "--";
N("object_or_delegate_creation_expression") ::= ("new" N("type") "(" [N("argument_list")] ")");
N("array_creation_expression") ::= (("new" N("non_array_type") "[" N("expression_list") "]" [N("rank_specifiers")] [N("array_initializer")]) | ("new" N("array_type") N("array_initializer")));
N("object_initializer_expression") ::= ("new" [N("array_type")] [N("object_formals")] [N("rank_specifiers")] N("object_initializer"));
N("object_formals") ::= ("(" [N("formal_parameter_list")] ")");
N("object_initializer") ::= ("{" [N("member_initializer_list")] [","] "}");
N("member_initializer_list") ::= (N("member_initializer"))+;
N("member_initializer") ::= (([N("member_name_equals")] N("expression")) | ([N("member_name_equals")] N("array_initializer")));
N("member_name_equals") ::= (N("simple_name") "=");
N("expression_list") ::= (N("expression"))+;
N("typeof_expression") ::= (("typeof" "(" N("type") ")") | ("typeof" "(" N("unbound_type_name") ")") | ("typeof" "(" "void" ")") | ("typeof" "(" ")"));
N("unbound_type_name") ::= (N("id") [N("colon_colon_id")] [N("generic_dimension_specifier")] (N("dot_id_generic_dimension_specifier"))*);
N("dot_id_generic_dimension_specifier") ::= ("." N("id") [N("generic_dimension_specifier")]);
N("generic_dimension_specifier") ::= ("<" (",")* ">");
N("checked_expression") ::= ("checked" "(" N("expression") ")");
N("unchecked_expression") ::= ("unchecked" "(" N("expression") ")");
N("default_value_expression") ::= ("default" "(" N("type") ")");
N("anonymous_method_expression") ::= ("delegate" [N("anonymous_method_signature")] N("block"));
N("anonymous_method_signature") ::= ("(" [N("anonymous_method_parameter_list")] ")");
N("anonymous_method_parameter_list") ::= (N("anonymous_method_parameter"))+;
N("anonymous_method_parameter") ::= ([N("parameter_modifier")] N("type") N("id"));
N("unary_expression") ::= (N("primary_expression") | ("+" N("unary_expression")) | ("-" N("unary_expression")) | ("!" N("unary_expression")) | ("~" N("unary_expression")) | N("pre_increment_expression") | N("pre_decrement_expression") | N("cast_expression"));
N("unary_expression") ::= (N("pointer_indirection_expression") | N("addressof_expression"));
N("pre_increment_expression") ::= ("++" N("unary_expression"));
N("pre_decrement_expression") ::= ("--" N("unary_expression"));
N("cast_expression") ::= ("(" N("type") ")" N("unary_expression"));
N("multiplicative_expression") ::= (N("unary_expression") | (N("multiplicative_expression") "*" N("unary_expression")) | (N("multiplicative_expression") "/" N("unary_expression")) | (N("multiplicative_expression") "%" N("unary_expression")));
N("additive_expression") ::= (N("multiplicative_expression") | (N("additive_expression") "+" N("multiplicative_expression")) | (N("additive_expression") "-" N("multiplicative_expression")));
N("shift_expression") ::= (N("additive_expression") | (N("shift_expression") "<<" N("additive_expression")) | (N("shift_expression") ">>" N("additive_expression")));
N("relational_expression") ::= (N("shift_expression") | (N("relational_expression") "<" N("shift_expression")) | (N("relational_expression") ">" N("shift_expression")) | (N("relational_expression") "<=" N("shift_expression")) | (N("relational_expression") ">=" N("shift_expression")) | (N("relational_expression") "is" N("type")) | (N("relational_expression") "as" N("type")));
N("equality_expression") ::= (N("relational_expression") | (N("equality_expression") "==" N("relational_expression")) | (N("equality_expression") "!=" N("relational_expression")));
N("and_expression") ::= (N("equality_expression") | (N("and_expression") "&" N("equality_expression")));
N("exclusive_or_expression") ::= (N("and_expression") | (N("exclusive_or_expression") "^" N("and_expression")));
N("inclusive_or_expression") ::= (N("exclusive_or_expression") | (N("inclusive_or_expression") "|" N("exclusive_or_expression")));
N("conditional_and_expression") ::= (N("inclusive_or_expression") | (N("conditional_and_expression") "&&" N("inclusive_or_expression")));
N("conditional_or_expression") ::= (N("conditional_and_expression") | (N("conditional_or_expression") "||" N("conditional_and_expression")));
N("null_coalescing_expression") ::= (N("conditional_or_expression") | (N("conditional_or_expression") "??" N("null_coalescing_expression")));
N("conditional_expression") ::= (N("null_coalescing_expression") | (N("null_coalescing_expression") "?" N("expression") ":" N("expression")));
N("assignment") ::= (N("unary_expression") N("assignment_operator") N("expression"));
N("assignment_operator") ::= ("=" | "+=" | "-=" | "*=" | "/=" | "%=" | "&=" | "|=" | "^=" | "<<=" | ">>=");
N("expression") ::= (N("conditional_expression") | N("assignment") | N("query_expression") | N("lambda_expression"));
N("constant_expression") ::= N("expression");
N("boolean_expression") ::= N("expression");
N("query_expression") ::= (N("from_clause") N("IN") N("query_body") N("EX"));
N("query_body") ::= ((N("query_body_clause"))* N("final_query_clause") [N("query_continuation")]);
N("query_body_clause") ::= ((N("NL") N("from_clause")) | (N("NL") N("join_clause")) | (N("NL") N("let_clause")) | (N("NL") N("where_clause")) | (N("NL") N("orderby_clause")));
N("from_clause") ::= ("from" N("item_name") "in" N("src_expr"));
N("join_clause") ::= ("join" N("item_name") "in" N("src_expr") "on" N("key_expr") "equals" N("key_expr") [N("into_item_name")]);
N("into_item_name") ::= ("into" N("item_name"));
N("let_clause") ::= ("let" N("item_name") "=" N("sel_expr"));
N("where_clause") ::= ("where" N("pred_expr"));
N("orderby_clause") ::= ("orderby" sep*(N("key_expr_ascending_descending"), ","));
N("key_expr_ascending_descending") ::= (N("key_expr") [N("ascending_descending")]);
N("ascending_descending") ::= ("ascending" | "descending");
N("final_query_clause") ::= ((N("NL") N("select_clause")) | (N("NL") N("groupby_clause")));
N("select_clause") ::= ("select" N("sel_expr"));
N("groupby_clause") ::= ("group" N("sel_expr") "by" N("key_expr"));
N("query_continuation") ::= ("into" N("item_name") N("query_body"));
N("item_name") ::= ([N("type")] N("simple_name"));
N("sel_expr") ::= N("expression");
N("key_expr") ::= N("expression");
N("src_expr") ::= N("expression");
N("pred_expr") ::= N("expression");
N("lambda_expression") ::= ((N("input_parameters") "=>" N("expression")) | (N("input_parameters") "=>" N("block")));
N("input_parameters") ::= (N("input_parameter") | ("(" sep*(N("input_parameter"), ",") ")"));
N("input_parameter") ::= ([N("type")] N("id"));
N("statement") ::= (N("labeled_statement") | N("declaration_statement") | N("embedded_statement"));
N("embedded_statement") ::= (N("block") | N("empty_statement") | N("expression_statement") | N("selection_statement") | N("iteration_statement") | N("jump_statement") | N("try_statement") | N("checked_statement") | N("unchecked_statement") | N("lock_statement") | N("using_statement") | N("yield_statement"));
N("embedded_statement") ::= N("unsafe_statement");
N("embedded_statement") ::= N("fixed_statement");
N("block") ::= ("{" N("NL") N("IN") [N("statement_list")] N("EX") "}" [";"]);
N("statement_list") ::= (N("statement"))+;
N("empty_statement") ::= ";";
N("labeled_statement") ::= (N("id") ":" N("statement"));
N("declaration_statement") ::= ((N("local_variable_declaration") ";" N("NL")) | (N("local_constant_declaration") ";" N("NL")));
N("local_variable_declaration") ::= (N("type") N("local_variable_declarators"));
N("local_variable_declarators") ::= (N("local_variable_declarator"))+;
N("local_variable_declarator") ::= (N("id") [N("equals_local_variable_initializer")]);
N("equals_local_variable_initializer") ::= ("=" N("local_variable_initializer"));
N("local_variable_initializer") ::= (N("expression") | N("array_initializer"));
N("local_variable_initializer") ::= (N("expression") | N("array_initializer") | N("stackalloc_initializer"));
N("local_constant_declaration") ::= ("const" N("type") N("constant_declarators"));
N("expression_statement") ::= (N("statement_expression") ";" N("NL"));
N("statement_expression") ::= (N("primary_no_array_creation_expression") | N("object_creation_expression") | N("assignment") | N("pre_increment_expression") | N("pre_decrement_expression"));
N("object_creation_expression") ::= ("new" N("type") "(" [N("argument_list")] ")");
N("selection_statement") ::= (N("if_statement") | N("switch_statement"));
N("if_statement") ::= ("if" "(" N("boolean_expression") ")" N("nested_statement") (N("else_if_clause"))* [N("else_clause")] N("NL"));
N("else_if_clause") ::= ("else" "if" "(" N("boolean_expression") ")" N("nested_statement"));
N("else_clause") ::= ("else" N("nested_statement"));
N("nested_statement") ::= (N("block") | (N("IN") N("NL") N("embedded_statement") N("EX")));
N("switch_statement") ::= ("switch" "(" N("expression") ")" N("switch_block"));
N("switch_block") ::= ("{" N("NL") N("IN") N("switch_sections") N("EX") "}" N("NL"));
N("switch_sections") ::= (N("switch_section"))+;
N("switch_section") ::= (N("switch_labels") N("NL") N("IN") N("statement_list") N("EX"));
N("switch_labels") ::= (N("switch_label"))+;
N("switch_label") ::= (("case" N("constant_expression") ":") | ("default" ":"));
N("iteration_statement") ::= (N("while_statement") | N("do_statement") | N("for_statement") | N("foreach_statement"));
N("while_statement") ::= ("while" "(" N("boolean_expression") ")" N("nested_statement") N("NL"));
N("do_statement") ::= ("do" N("NL") N("IN") N("embedded_statement") N("EX") "while" "(" N("boolean_expression") ")" ";" N("NL"));
N("for_statement") ::= ("for" "(" [N("for_initializer")] ";" [N("for_condition")] ";" [N("for_iterator")] ")" N("nested_statement") N("NL"));
N("for_initializer") ::= (N("local_variable_declaration") | N("statement_expression_list"));
N("for_condition") ::= N("boolean_expression");
N("for_iterator") ::= N("statement_expression_list");
N("statement_expression_list") ::= (N("statement_expression"))+;
N("foreach_statement") ::= ("foreach" "(" N("type") N("id") "in" N("expression") ")" N("nested_statement") N("NL"));
N("jump_statement") ::= (N("break_statement") | N("continue_statement") | N("goto_statement") | N("return_statement") | N("throw_statement"));
N("break_statement") ::= ("break" ";" N("NL"));
N("continue_statement") ::= ("continue" ";" N("NL"));
N("goto_statement") ::= (("goto" N("id") ";" N("NL")) | ("goto" "case" N("constant_expression") ";" N("NL")) | ("goto" "default" ";" N("NL")));
N("return_statement") ::= ("return" [N("expression")] ";" N("NL"));
N("throw_statement") ::= ("throw" [N("expression")] ";" N("NL"));
N("try_statement") ::= ("try" N("block") N("NL") [N("catch_clauses")] [N("finally_clause")]);
N("catch_clauses") ::= ([N("specific_catch_clauses")] [N("general_catch_clause")]);
N("specific_catch_clauses") ::= (N("specific_catch_clause"))+;
N("specific_catch_clause") ::= ("catch" "(" N("class_type") [N("id")] ")" N("block") N("NL"));
N("general_catch_clause") ::= ("catch" N("block") N("NL"));
N("finally_clause") ::= ("finally" N("block") N("NL"));
N("checked_statement") ::= ("checked" N("block") N("NL"));
N("unchecked_statement") ::= ("unchecked" N("block") N("NL"));
N("lock_statement") ::= ("lock" "(" N("expression") ")" N("NL") N("embedded_statement"));
N("using_statement") ::= ("using" "(" N("resource_acquisition") ")" N("NL") N("embedded_statement"));
N("resource_acquisition") ::= (N("local_variable_declaration") | N("expression"));
N("yield_statement") ::= (("yield" "return" N("expression") ";" N("NL")) | ("yield" "break" ";" N("NL")));
N("namespace_declaration") ::= ("namespace" N("qualified_identifier") N("NL") N("namespace_body"));
N("qualified_identifier") ::= (N("id") (N("dot_id"))*);
N("namespace_body") ::= ("{" N("NL") N("IN") [N("extern_alias_directives")] [N("using_directives")] [N("namespace_member_declarations")] N("EX") "}" [";"] N("NL"));
N("extern_alias_directives") ::= ((N("extern_alias_directive"))+ N("NL"));
N("extern_alias_directive") ::= ("extern" N("id") N("id") ";" N("NL"));
N("using_directives") ::= ((N("using_directive"))+ N("NL"));
N("using_directive") ::= (N("using_alias_directive") | N("using_namespace_directive"));
N("using_alias_directive") ::= ("using" N("id") "=" N("namespace_or_type_name") ";" N("NL"));
N("using_namespace_directive") ::= ("using" N("namespace_name") ";" N("NL"));
N("namespace_member_declarations") ::= (N("namespace_member_declaration"))+;
N("namespace_member_declaration") ::= ((N("namespace_declaration") N("NL")) | (N("type_declaration") N("NL")));
N("type_declaration") ::= (N("class_declaration") | N("struct_declaration") | N("interface_declaration") | N("enum_declaration") | N("delegate_declaration"));
N("qualified_alias_member") ::= (N("id") "::" N("id") [N("type_argument_list")]);
N("class_declaration") ::= ([N("attributes")] [N("class_modifiers")] ["partial"] "class" N("id") [N("type_parameter_list")] [N("class_base")] [N("type_parameter_constraints_clauses")] N("NL") N("class_body"));
N("class_modifiers") ::= (N("class_modifier"))+;
N("class_modifier") ::= ("new" | "public" | "protected" | "internal" | "private" | "abstract" | "sealed" | "static");
N("class_modifier") ::= "unsafe";
N("class_base") ::= (":" N("class_and_interface_type_ist"));
N("class_and_interface_type_ist") ::= (N("class_or_interface_type"))+;
N("class_or_interface_type") ::= (N("class_type") | N("interface_type"));
N("class_body") ::= ("{" N("NL") N("IN") [N("class_member_declarations")] N("EX") "}" [";"] N("NL"));
N("class_member_declarations") ::= (N("class_member_declaration"))+;
N("class_member_declaration") ::= (N("constant_declaration") | N("field_declaration") | N("method_declaration") | N("property_declaration") | N("event_declaration") | N("indexer_declaration") | N("operator_declaration") | N("constructor_declaration") | N("finalizer_declaration") | N("static_constructor_declaration") | N("type_declaration"));
N("constant_declaration") ::= ([N("attributes")] [N("constant_modifiers")] "const" N("type") N("constant_declarators") ";" N("NL"));
N("constant_modifiers") ::= (N("constant_modifier"))+;
N("constant_modifier") ::= ("new" | "public" | "protected" | "internal" | "private");
N("constant_declarators") ::= (N("constant_declarator"))+;
N("constant_declarator") ::= (N("id") "=" N("constant_expression"));
N("field_declaration") ::= ([N("attributes")] [N("field_modifiers")] N("type") N("variable_declarators") ";" N("NL"));
N("field_modifiers") ::= (N("field_modifier"))+;
N("field_modifier") ::= ("new" | "public" | "protected" | "internal" | "private" | "static" | "readonly" | "volatile");
N("field_modifier") ::= "unsafe";
N("variable_declarators") ::= (N("variable_declarator"))+;
N("variable_declarator") ::= (N("id") [N("equals_variable_initializer")]);
N("equals_variable_initializer") ::= ("=" N("variable_initializer"));
N("variable_initializer") ::= (N("expression") | N("array_initializer"));
N("method_declaration") ::= (N("method_header") N("NL") N("method_body") N("NL"));
N("method_header") ::= ([N("attributes")] [N("method_modifiers")] N("return_type") N("member_name") [N("type_parameter_list")] "(" [N("formal_parameter_list")] ")" [N("type_parameter_constraints_clauses")]);
N("method_modifiers") ::= (N("method_modifier"))+;
N("method_modifier") ::= ("new" | "public" | "protected" | "internal" | "private" | "static" | "virtual" | "sealed" | "override" | "abstract" | "extern" | "partial");
N("method_modifier") ::= "unsafe";
N("return_type") ::= (N("type") | "void");
N("member_name") ::= ([N("interface_type_dot")] N("id"));
N("interface_type_dot") ::= (N("interface_type") ".");
N("method_body") ::= ((N("block") N("NL")) | (";" N("NL")));
N("formal_parameter_list") ::= (N("fixed_parameters") [N("comma_parameter_array")]);
N("comma_parameter_array") ::= ("," N("parameter_array"));
N("fixed_parameters") ::= (N("fixed_parameter"))+;
N("fixed_parameter") ::= (([N("attributes")] [N("parameter_modifier")] N("type") N("id")) | N("parameter_array"));
N("parameter_modifier") ::= ("ref" | "out");
N("parameter_array") ::= ([N("attributes")] "params" N("array_type") N("id"));
N("property_declaration") ::= (N("NL") [N("attributes")] [N("property_modifiers")] N("type") N("member_name") "{" N("NL") N("IN") N("accessor_declarations") N("EX") "}" N("NL"));
N("property_modifiers") ::= (N("property_modifier"))+;
N("property_modifier") ::= ("new" | "public" | "protected" | "internal" | "private" | "static" | "virtual" | "sealed" | "override" | "abstract" | "extern");
N("property_modifier") ::= "unsafe";
N("accessor_declarations") ::= ((N("get_accessor_declaration") [N("set_accessor_declaration")]) | (N("set_accessor_declaration") [N("get_accessor_declaration")]));
N("get_accessor_declaration") ::= ([N("attributes")] [N("accessor_modifier")] "get" N("accessor_body"));
N("set_accessor_declaration") ::= ([N("attributes")] [N("accessor_modifier")] "set" N("accessor_body"));
N("accessor_modifier") ::= ("protected" | "internal" | "private" | ("protected" "internal") | ("internal" "protected"));
N("accessor_body") ::= ((N("block") N("NL")) | (";" N("NL")));
N("event_declaration") ::= (([N("attributes")] [N("event_modifiers")] "event" N("type") N("variable_declarators") ";" N("NL")) | ([N("attributes")] [N("event_modifiers")] "event" N("type") N("member_name") "{" N("NL") N("IN") N("event_accessor_declarations") N("EX") "}" N("NL") N("EX")));
N("event_modifiers") ::= (N("event_modifier"))+;
N("event_modifier") ::= ("new" | "public" | "protected" | "internal" | "private" | "static" | "virtual" | "sealed" | "override" | "abstract" | "extern");
N("event_modifier") ::= "unsafe";
N("event_accessor_declarations") ::= ((N("add_accessor_declaration") N("remove_accessor_declaration")) | (N("remove_accessor_declaration") N("add_accessor_declaration")));
N("add_accessor_declaration") ::= ([N("attributes")] "add" N("block") N("NL"));
N("remove_accessor_declaration") ::= ([N("attributes")] "remove" N("block") N("NL"));
N("indexer_declaration") ::= ([N("attributes")] [N("indexer_modifiers")] N("indexer_declarator") "{" N("NL") N("IN") N("accessor_declarations") N("EX") "}" N("NL"));
N("indexer_modifiers") ::= (N("indexer_modifier"))+;
N("indexer_modifier") ::= ("new" | "public" | "protected" | "internal" | "private" | "virtual" | "sealed" | "override" | "abstract" | "extern");
N("indexer_modifier") ::= "unsafe";
N("indexer_declarator") ::= (N("type") [N("interface_type_dot")] "this" "[" N("formal_parameter_list") "]");
N("operator_declaration") ::= ([N("attributes")] [N("operator_modifiers")] N("operator_declarator") N("operator_body"));
