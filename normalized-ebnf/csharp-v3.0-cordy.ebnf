N("interface_indexer_declaration") ::= ([N("attributes")] ["new"] N("type") "this" "[" N("formal_parameter_list") "]" "{" N("NL") N("IN") N("interface_accessors") N("EX") "}" N("NL"));
N("enum_declaration") ::= ([N("attributes")] [N("enum_modifiers")] "enum" N("id") [N("enum_base")] N("enum_body") N("NL"));
N("enum_base") ::= (":" N("integral_type"));
N("enum_body") ::= ("{" N("NL") N("IN") [N("enum_member_declarations")] [","] N("EX") "}" [";"] N("NL"));
N("enum_modifiers") ::= (N("enum_modifier"))+;
N("enum_modifier") ::= ("new" | "public" | "protected" | "internal" | "private");
