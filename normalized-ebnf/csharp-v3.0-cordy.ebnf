N("type_parameter_constraints_clause") ::= ("where" N("type_parameter") ":" N("type_parameter_constraints"));
N("type_parameter_constraints") ::= sep*(N("type_parameter_constraint"), ",");
N("type_parameter_constraint") ::= (N("primary_constraint") | N("secondary_constraint") | N("constructor_constraint"));
