N("declaration-statement") ::= ((N("local-variable-declaration") ";") | (N("local-constant-declaration") ";"));
N("local-variable-declaration") ::= (N("local-variable-type") N("local-variable-declarators"));
N("local-variable-type") ::= (N("type") | "var");
