N("for-iterator") ::= N("statement-expression-list");
N("statement-expression-list") ::= (N("statement-expression") | (N("statement-expression-list") "," N("statement-expression")));
N("foreach-statement") ::= ("foreach" "(" N("local-variable-type") N("identifier") "in" N("expression") ")" N("embedded-statement"));
