N("class-member-declaration") ::= (N("constant-declaration") | N("field-declaration") | N("method-declaration") | N("property-declaration") | N("event-declaration") | N("indexer-declaration") | N("operator-declaration") | N("constructor-declaration") | N("destructor-declaration") | N("static-constructor-declaration") | N("type-declaration"));
