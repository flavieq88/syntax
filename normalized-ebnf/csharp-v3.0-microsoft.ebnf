N("type-arguments") ::= (N("type-argument") | (N("type-arguments") "," N("type-argument")));
N("type-argument") ::= N("type");
N("type-parameter") ::= N("identifier");
N("variable-reference") ::= N("expression");
N("argument-list") ::= (N("argument") | (N("argument-list") "," N("argument")));
N("argument") ::= (N("expression") | ("ref" N("variable-reference")) | ("out" N("variable-reference")));
N("primary-expression") ::= (N("primary-no-array-creation-expression") | N("array-creation-expression"));
N("primary-no-array-creation-expression") ::= (N("literal") | N("simple-name") | N("parenthesized-expression") | N("member-access") | N("invocation-expression") | N("element-access") | N("this-access") | N("base-access") | N("post-increment-expression") | N("post-decrement-expression") | N("object-creation-expression") | N("delegate-creation-expression") | N("anonymous-object-creation-expression") | N("typeof-expression") | N("checked-expression") | N("unchecked-expression") | N("default-value-expression") | N("anonymous-method-expression"));
N("simple-name") ::= (N("identifier") [N("type-argument-list")]);
N("parenthesized-expression") ::= ("(" N("expression") ")");
