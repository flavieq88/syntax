N("namespace-name") ::= N("namespace-or-type-name");
N("type-name") ::= N("namespace-or-type-name");
N("namespace-or-type-name") ::= ((N("identifier") [N("type-argument-list")]) | (N("namespace-or-type-name") "." N("identifier") N("type-argument-listop")) | N("qualified-alias-member"));
N("type") ::= (N("value-type") | N("reference-type") | N("type-parameter"));
N("value-type") ::= (N("struct-type") | N("enum-type"));
N("struct-type") ::= (N("type-name") | N("simple-type") | N("nullable-type"));
N("simple-type") ::= (N("numeric-type") | "bool");
N("numeric-type") ::= (N("integral-type") | N("floating-point-type") | "decimal");
N("integral-type") ::= ("sbyte" | "byte" | "short" | "ushort" | "int" | "uint" | "long" | "ulong" | "char");
N("floating-point-type") ::= ("float" | "double");
N("nullable-type") ::= (N("non-nullable-value-type") "?");
N("non-nullable-value-type") ::= N("type");
N("enum-type") ::= N("type-name");
N("reference-type") ::= (N("class-type") | N("interface-type") | N("array-type") | N("delegate-type"));
N("class-type") ::= (N("type-name") | "object" | "string");
