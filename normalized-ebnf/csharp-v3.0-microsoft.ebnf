N("switch-labels") ::= (N("switch-label") | (N("switch-labels") N("switch-label")));
N("switch-label") ::= (("case" N("constant-expression") ":") | ("default" ":"));
N("iteration-statement") ::= (N("while-statement") | N("do-statement") | N("for-statement") | N("foreach-statement"));
N("while-statement") ::= ("while" "(" N("boolean-expression") ")" N("embedded-statement"));
N("do-statement") ::= ("do" N("embedded-statement") "while" "(" N("boolean-expression") ")" ";");
