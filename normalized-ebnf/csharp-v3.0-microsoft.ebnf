N("fixed-parameters") ::= (N("fixed-parameter") | (N("fixed-parameters") "," N("fixed-parameter")));
N("fixed-parameter") ::= ([N("attributes")] [N("parameter-modifier")] N("type") N("identifier"));
N("parameter-modifier") ::= ("ref" | "out" | "this");
N("parameter-array") ::= ([N("attributes")] "params" N("array-type") N("identifier"));
