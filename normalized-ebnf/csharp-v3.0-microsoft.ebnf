N("and-expression") ::= (N("equality-expression") | (N("and-expression") "&" N("equality-expression")));
N("exclusive-or-expression") ::= (N("and-expression") | (N("exclusive-or-expression") "^" N("and-expression")));
N("inclusive-or-expression") ::= (N("exclusive-or-expression") | (N("inclusive-or-expression") "|" N("exclusive-or-expression")));
N("conditional-and-expression") ::= (N("inclusive-or-expression") | (N("conditional-and-expression") "&&" N("inclusive-or-expression")));
N("conditional-or-expression") ::= (N("conditional-and-expression") | (N("conditional-or-expression") "||" N("conditional-and-expression")));
N("null-coalescing-expression") ::= (N("conditional-or-expression") | (N("conditional-or-expression") "??" N("null-coalescing-expression")));
N("conditional-expression") ::= (N("null-coalescing-expression") | (N("null-coalescing-expression") "?" N("expression") ":" N("expression")));
N("lambda-expression") ::= (N("anonymous-function-signature") "=>" N("anonymous-function-body"));
N("anonymous-method-expression") ::= ("delegate" [N("explicit-anonymous-function-signature")] N("block"));
N("anonymous-function-signature") ::= (N("explicit-anonymous-function-signature") | N("implicit-anonymous-function-signature"));
N("explicit-anonymous-function-signature") ::= (("(" [N("explicit-anonymous-function-parameter-list")] ")") | N("explicit-anonymous-function-parameter-list") | N("explicit-anonymous-function-parameter") | (N("explicit-anonymous-function-parameter-list") "," N("explicit-anonymous-function-parameter")));
N("explicit-anonymous-function-parameter") ::= ([N("anonymous-function-parameter-modifier")] N("type") N("identifier"));
N("anonymous-function-parameter-modifier") ::= ("ref" | "out");
N("implicit-anonymous-function-signature") ::= (("(" [N("implicit-anonymous-function-parameter-list")] ")") | N("implicit-anonymous-function-parameter") | N("implicit-anonymous-function-parameter-list") | N("implicit-anonymous-function-parameter") | (N("implicit-anonymous-function-parameter-list") "," N("implicit-anonymous-function-parameter")));
N("implicit-anonymous-function-parameter") ::= N("identifier");
N("anonymous-function-body") ::= (N("expression") | N("block"));
N("query-expression") ::= (N("from-clause") N("query-body"));
N("from-clause") ::= ("from" [N("type")] N("identifier") "in" N("expression"));
N("query-body") ::= ([N("query-body-clauses")] N("select-or-group-clause") [N("query-continuation")]);
N("query-body-clauses") ::= (N("query-body-clause") | (N("query-body-clauses") N("query-body-clause")));
N("query-body-clause") ::= (N("from-clause") | N("let-clause") | N("where-clause") | N("join-clause") | N("join-into-clause") | N("orderby-clause"));
N("let-clause") ::= ("let" N("identifier") "=" N("expression"));
N("where-clause") ::= ("where" N("boolean-expression"));
N("join-clause") ::= ("join" [N("type")] N("identifier") "in" N("expression") "on" N("expression") "equals" N("expression"));
N("join-into-clause") ::= ("join" [N("type")] N("identifier") "in" N("expression") "on" N("expression") "equals" N("expression") "into" N("identifier"));
N("orderby-clause") ::= ("orderby" N("orderings"));
N("orderings") ::= (N("ordering") | (N("orderings") "," N("ordering")));
N("ordering") ::= (N("expression") [N("ordering-direction")]);
N("ordering-direction") ::= ("ascending" | "descending");
N("select-or-group-clause") ::= (N("select-clause") | N("group-clause"));
N("select-clause") ::= ("select" N("expression"));
N("group-clause") ::= ("group" N("expression") "by" N("expression"));
N("query-continuation") ::= ("into" N("identifier") N("query-body"));
N("assignment") ::= (N("unary-expression") N("assignment-operator") N("expression"));
N("assignment-operator") ::= ("=" | "+=" | "-=" | "*=" | "/=" | "%=" | "&=" | "|=" | "^=" | "<<=" | N("right-shift-assignment"));
N("expression") ::= (N("non-assignment-expression") | N("assignment"));
N("non-assignment-expression") ::= (N("conditional-expression") | N("lambda-expression") | N("query-expression"));
N("constant-expression") ::= N("expression");
N("boolean-expression") ::= N("expression");
N("statement") ::= (N("labeled-statement") | N("declaration-statement") | N("embedded-statement"));
N("embedded-statement") ::= (N("block") | N("empty-statement") | N("expression-statement") | N("selection-statement") | N("iteration-statement") | N("jump-statement") | N("try-statement") | N("checked-statement") | N("unchecked-statement") | N("lock-statement") | N("using-statement") | N("yield-statement"));
N("block") ::= ("{" [N("statement-list")] "}");
N("statement-list") ::= (N("statement") | (N("statement-list") N("statement")));
