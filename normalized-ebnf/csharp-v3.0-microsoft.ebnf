N("namespace-declaration") ::= ("namespace" N("qualified-identifier") N("namespace-body") [";"]);
N("qualified-identifier") ::= (N("identifier") | (N("qualified-identifier") "." N("identifier")));
N("namespace-body") ::= ("{" [N("extern-alias-directives")] [N("using-directives")] [N("namespace-member-declarations")] "}");
N("extern-alias-directives") ::= (N("extern-alias-directive") | (N("extern-alias-directives") N("extern-alias-directive")));
