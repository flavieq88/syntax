N("constant-modifier") ::= ("new" | "public" | "protected" | "internal" | "private");
N("field-declaration") ::= ([N("attributes")] [N("field-modifiers")] N("type") N("variable-declarators") ";");
N("field-modifiers") ::= (N("field-modifier") | (N("field-modifiers") N("field-modifier")));
N("field-modifier") ::= ("new" | "public" | "protected" | "internal" | "private" | "static" | "readonly" | "volatile");
N("variable-declarators") ::= (N("variable-declarator") | (N("variable-declarators") "," N("variable-declarator")));
N("variable-declarator") ::= (N("identifier") | (N("identifier") "=" N("variable-initializer")));
N("variable-initializer") ::= (N("expression") | N("array-initializer"));
N("method-declaration") ::= (N("method-header") N("method-body"));
N("method-header") ::= (([N("attributes")] [N("method-modifiers")] ["partial"] N("return-type") N("member-name") [N("type-parameter-list")]) | ("(" [N("formal-parameter-list")] ")" [N("type-parameter-constraints-clauses")]));
N("method-modifiers") ::= (N("method-modifier") | (N("method-modifiers") N("method-modifier")));
N("method-modifier") ::= ("new" | "public" | "protected" | "internal" | "private" | "static" | "virtual" | "sealed" | "override" | "abstract" | "extern");
N("return-type") ::= (N("type") | "void");
