N("namespace-member-declarations") ::= (N("namespace-member-declaration") | (N("namespace-member-declarations") N("namespace-member-declaration")));
N("namespace-member-declaration") ::= (N("namespace-declaration") | N("type-declaration"));
N("type-declaration") ::= (N("class-declaration") | N("struct-declaration") | N("interface-declaration") | N("enum-declaration") | N("delegate-declaration"));
N("qualified-alias-member") ::= (N("identifier") "::" N("identifier") [N("type-argument-list")]);
N("class-declaration") ::= (([N("attributes")] [N("class-modifiers")] ["partial"] "class" N("identifier") [N("type-parameter-list")]) | ([N("class-base")] [N("type-parameter-constraints-clauses")] N("class-body") [";"]));
N("class-modifiers") ::= (N("class-modifier") | (N("class-modifiers") N("class-modifier")));
N("class-modifier") ::= ("new" | "public" | "protected" | "internal" | "private" | "abstract" | "sealed" | "static");
N("type-parameter-list") ::= ("<" N("type-parameters") ">");
N("type-parameters") ::= (([N("attributes")] N("type-parameter")) | (N("type-parameters") "," [N("attributes")] N("type-parameter")));
N("class-base") ::= ((":" N("class-type")) | (":" N("interface-type-list")) | (":" N("class-type") "," N("interface-type-list")));
N("interface-type-list") ::= (N("interface-type") | (N("interface-type-list") "," N("interface-type")));
N("type-parameter-constraints-clauses") ::= (N("type-parameter-constraints-clause") | (N("type-parameter-constraints-clauses") N("type-parameter-constraints-clause")));
N("type-parameter-constraints-clause") ::= ("where" N("type-parameter") ":" N("type-parameter-constraints"));
N("type-parameter-constraints") ::= (N("primary-constraint") | N("secondary-constraints") | N("constructor-constraint") | (N("primary-constraint") "," N("secondary-constraints")) | (N("primary-constraint") "," N("constructor-constraint")) | (N("secondary-constraints") "," N("constructor-constraint")) | (N("primary-constraint") "," N("secondary-constraints") "," N("constructor-constraint")));
N("primary-constraint") ::= (N("class-type") | "class" | "struct");
