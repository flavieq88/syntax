N("predefined-type") ::= ("bool" | "byte" | "char" | "decimal" | "double" | "float" | "int" | "long" | "object" | "sbyte" | "short" | "string" | "uint" | "ulong" | "ushort");
N("invocation-expression") ::= (N("primary-expression") "(" [N("argument-list")] ")");
N("element-access") ::= (N("primary-no-array-creation-expression") "[" N("expression-list") "]");
N("expression-list") ::= (N("expression") | (N("expression-list") "," N("expression")));
N("this-access") ::= "this";
N("base-access") ::= (("base" "." N("identifier")) | ("base" "[" N("expression-list") "]"));
N("post-increment-expression") ::= (N("primary-expression") "++");
N("post-decrement-expression") ::= (N("primary-expression") "--");
N("object-creation-expression") ::= (("new" N("type") "(" [N("argument-list")] ")" [N("object-or-collection-initializer")]) | ("new" N("type") N("object-or-collection-initializer")));
N("object-or-collection-initializer") ::= (N("object-initializer") | N("collection-initializer"));
N("object-initializer") ::= (("{" [N("member-initializer-list")] "}") | ("{" N("member-initializer-list") "," "}"));
N("member-initializer-list") ::= (N("member-initializer") | (N("member-initializer-list") "," N("member-initializer")));
