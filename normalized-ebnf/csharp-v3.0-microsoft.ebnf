N("break-statement") ::= ("break" ";");
N("continue-statement") ::= ("continue" ";");
N("goto-statement") ::= (("goto" N("identifier") ";") | ("goto" "case" N("constant-expression") ";") | ("goto" "default" ";"));
N("return-statement") ::= ("return" [N("expression")] ";");
N("throw-statement") ::= ("throw" [N("expression")] ";");
N("try-statement") ::= (("try" N("block") N("catch-clauses")) | ("try" N("block") N("finally-clause")) | ("try" N("block") N("catch-clauses") N("finally-clause")));
N("catch-clauses") ::= ((N("specific-catch-clauses") [N("general-catch-clause")]) | ([N("specific-catch-clauses")] N("general-catch-clause")));
N("specific-catch-clauses") ::= (N("specific-catch-clause") | (N("specific-catch-clauses") N("specific-catch-clause")));
