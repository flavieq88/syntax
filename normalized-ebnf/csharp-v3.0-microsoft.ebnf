N("constant-declarators") ::= (N("constant-declarator") | (N("constant-declarators") "," N("constant-declarator")));
N("constant-declarator") ::= (N("identifier") "=" N("constant-expression"));
N("expression-statement") ::= (N("statement-expression") ";");
N("statement-expression") ::= (N("invocation-expression") | N("object-creation-expression") | N("assignment") | N("post-increment-expression") | N("post-decrement-expression") | N("pre-increment-expression") | N("pre-decrement-expression"));
N("selection-statement") ::= (N("if-statement") | N("switch-statement"));
N("if-statement") ::= (("if" "(" N("boolean-expression") ")" N("embedded-statement")) | ("if" "(" N("boolean-expression") ")" N("embedded-statement") "else" N("embedded-statement")));
