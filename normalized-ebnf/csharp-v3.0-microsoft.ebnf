N("multiplicative-expression") ::= (N("unary-expression") | (N("multiplicative-expression") "*" N("unary-expression")) | (N("multiplicative-expression") "/" N("unary-expression")) | (N("multiplicative-expression") "%" N("unary-expression")));
N("additive-expression") ::= (N("multiplicative-expression") | (N("additive-expression") "+" N("multiplicative-expression")) | (N("additive-expression") "-" N("multiplicative-expression")));
N("shift-expression") ::= (N("additive-expression") | (N("shift-expression") "<<" N("additive-expression")) | (N("shift-expression") N("right-shift") N("additive-expression")));
N("relational-expression") ::= (N("shift-expression") | (N("relational-expression") "<" N("shift-expression")) | (N("relational-expression") ">" N("shift-expression")) | (N("relational-expression") "<=" N("shift-expression")) | (N("relational-expression") ">=" N("shift-expression")) | (N("relational-expression") "is" N("type")) | (N("relational-expression") "as" N("type")));
