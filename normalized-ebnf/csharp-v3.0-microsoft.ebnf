N("element-initializer-list") ::= (N("element-initializer") | (N("element-initializer-list") "," N("element-initializer")));
N("element-initializer") ::= (N("non-assignment-expression") | ("{" N("expression-list") "}"));
N("array-creation-expression") ::= (("new" N("non-array-type") "[" N("expression-list") "]" [N("rank-specifiers")] [N("array-initializer")]) | ("new" N("array-type") N("array-initializer")) | ("new" N("rank-specifier") N("array-initializer")));
N("delegate-creation-expression") ::= ("new" N("delegate-type") "(" N("expression") ")");
N("anonymous-object-creation-expression") ::= ("new" N("anonymous-object-initializer"));
N("anonymous-object-initializer") ::= (("{" [N("member-declarator-list")] "}") | ("{" N("member-declarator-list") "," "}"));
N("member-declarator-list") ::= (N("member-declarator") | (N("member-declarator-list") "," N("member-declarator")));
N("member-declarator") ::= (N("simple-name") | N("member-access") | (N("identifier") "=" N("expression")));
N("typeof-expression") ::= (("typeof" "(" N("type") ")") | ("typeof" "(" N("unbound-type-name") ")") | ("typeof" "(" "void" ")"));
N("unbound-type-name") ::= ((N("identifier") [N("generic-dimension-specifier")]) | (N("identifier") "::" N("identifier") [N("generic-dimension-specifier")]) | (N("unbound-type-name") "." N("identifier") [N("generic-dimension-specifier")]));
N("generic-dimension-specifier") ::= ("<" [N("commas")] ">");
N("commas") ::= ("," | (N("commas") ","));
N("checked-expression") ::= ("checked" "(" N("expression") ")");
N("unchecked-expression") ::= ("unchecked" "(" N("expression") ")");
N("default-value-expression") ::= ("default" "(" N("type") ")");
N("unary-expression") ::= (N("primary-expression") | ("+" N("unary-expression")) | ("-" N("unary-expression")) | ("!" N("unary-expression")) | ("~" N("unary-expression")) | N("pre-increment-expression") | N("pre-decrement-expression") | N("cast-expression"));
N("pre-increment-expression") ::= ("++" N("unary-expression"));
N("pre-decrement-expression") ::= ("--" N("unary-expression"));
