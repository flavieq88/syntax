N("Description") ::= select("date", N("Date"));
N("Citation") ::= (select("label", N("Label")) select("author", N("Author")) select("description", N("Description")) select("bibliography", N("Bibliography")));
N("Bibliography") ::= ((select("citations", N("Citation")))+ select("documentbody", N("DocumentBody")));
N("DocumentBody") ::= ((select("sections", N("Section")))+ (select("bibliography", N("Bibliography")))+ select("document", N("Document")));
N("Document") ::= (select("type", N("Type")) select("title", N("Title")) select("author", N("Author")) select("date", N("Date")) select("heading", N("Heading")) select("abstract", N("Abstract")) select("keywords", N("Keywords")) select("documentbody", N("DocumentBody")));
