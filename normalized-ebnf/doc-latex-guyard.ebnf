N("Type") ::= (select("value", N("String")));
N("Title") ::= (select("value", N("String")));
N("Name") ::= (select("author", N("Author")) select("organisation", N("Organisation")));
N("Date") ::= (select("value", N("String")));
N("Author") ::= (select("names", N("Name")))+;
N("Adress") ::= (select("value", N("String")));
N("Organisation") ::= ((select("names", N("Name")))+ select("adress", N("Adress")) select("heading", N("Heading")));
N("Phone") ::= (select("value", N("String")));
N("Fax") ::= (select("value", N("String")));
N("EMail") ::= (select("value", N("String")));
N("Heading") ::= ((select("organisations", N("Organisation")))+ select("phone", N("Phone")) select("fax", N("Fax")) select("email", N("EMail")));
N("Abstract") ::= (select("value", N("String")));
N("Keywords") ::= (select("value", N("String")));
N("SectionBody") ::= ((select("corps", N("Corps")))+ select("section", N("Section")));
N("Corps") ::= N("Figure");
N("Corps") ::= N("Items");
N("Corps") ::= N("Enumerate");
N("Corps") ::= N("Section");
