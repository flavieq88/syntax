@root N("document");

N("document") ::= (N("document-metadata") (N("part"))+);
N("document-metadata") ::= ([N("body")] [select("number", value("string"))] (select("author", N("person")))* select("topic", value("string")) N("status") N("version-or-edition") (select("previous", N("named-link")))* select("date", N("timestamp")));
N("body") ::= (select("ansi", epsilon) | select("ecma", epsilon) | select("ieee", epsilon) | select("iso", epsilon) | select("iso/iet", epsilon) | select("itu", epsilon) | select("iec", epsilon) | select("ietf", epsilon) | select("oasis", epsilon) | select("omg", epsilon) | select("wsa", epsilon) | select("w3c", epsilon));
N("person") ::= (select("name", value("string")) [select("affiliation", value("string"))] [select("email", value("string"))]);
N("status") ::= (select("unknown", epsilon) | select("draft", epsilon) | select("candidate", epsilon) | select("proposed", epsilon) | select("approved", epsilon) | select("revised", epsilon) | select("obsolete", epsilon) | select("withdrawn", epsilon) | select("collection", epsilon) | select("trial", epsilon) | select("errata", epsilon) | select("report", epsilon));
N("version-or-edition") ::= (select("version", value("string")) | select("edition", value("string")));
N("named-link") ::= (select("title", value("string")) [N("version-or-edition")] [select("uri", N("anyURI"))]);
N("part") ::= (N("part-metadata") (N("section"))+);
N("part-metadata") ::= ([select("id", N("ID"))] N("part-role") [select("title", value("string"))] (select("author", N("person")))*);
N("part-role") ::= (select("front-matter", epsilon) | select("core-part", epsilon) | select("back-matter", epsilon) | select("annex", epsilon));
N("section") ::= (N("section-metadata") N("section-structure"));
N("section-metadata") ::= ([select("id", N("ID"))] N("section-role") [N("type")] [select("title", value("string"))] (select("author", N("person")))*);
N("section-role") ::= (select("abstract", epsilon) | select("conformance", epsilon) | select("compatibility", epsilon) | select("design-goals", epsilon) | select("document-structure", epsilon) | select("foreword", epsilon) | select("references", epsilon) | select("notation", epsilon) | select("scope", epsilon) | select("what-is-new", epsilon) | select("index", epsilon) | select("full-grammar", epsilon) | select("list-of-tables", epsilon) | select("list-of-authors", epsilon) | select("list-of-contents", epsilon) | select("list-of-references", epsilon) | select("top-section", epsilon) | select("lexical-section", epsilon));
N("type") ::= (select("normative", epsilon) | select("informative", epsilon));
N("section-structure") ::= (select("content", (N("content-content"))+) | select("placeholder", any) | (N("subsection"))+);
N("content-content") ::= (select("para", N("mixed")) | select("list", N("list")) | N("production"));
N("mixed") ::= ((any | value("string")))*;
N("list") ::= (select("item", N("mixed")))+;
N("production") ::= ([select("label", N("label"))] select("nonterminal", N("nonterminal")) N("expression"));
N("label") ::= value("string");
N("nonterminal") ::= value("string");
N("expression") ::= (select("epsilon", epsilon) | select("empty", epsilon) | select("value", N("value")) | select("any", epsilon) | select("terminal", N("terminal")) | select("nonterminal", N("nonterminal")) | select("selectable", (select("selector", N("selector")) N("expression"))) | select("marked", N("expression")) | select("sequence", (N("expression"))+) | select("choice", (N("expression"))+) | select("allof", (N("expression"))+) | select("not", N("expression")) | select("optional", N("expression")) | select("plus", N("expression")) | select("star", N("expression")) | select("seplistplus", (N("expression") N("expression"))) | select("sepliststar", (N("expression") N("expression"))));
N("value") ::= (select("int", epsilon) | select("string", epsilon));
N("terminal") ::= value("string");
N("selector") ::= value("string");
N("subsection") ::= (N("subsection-metadata") N("section-structure"));
N("subsection-metadata") ::= ([select("id", N("ID"))] N("subsection-role") [N("type")] [select("title", value("string"))] (select("author", N("person")))*);
N("subsection-role") ::= (select("synopsis", epsilon) | select("description", epsilon) | select("syntax", epsilon) | select("constraints", epsilon) | select("relationship", epsilon) | select("semantics", epsilon) | select("default", epsilon) | select("rationale", epsilon) | select("example", epsilon) | select("update", epsilon) | select("subtopic", epsilon) | select("section", epsilon));
