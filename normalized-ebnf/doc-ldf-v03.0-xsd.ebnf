@root N("reference");
@root N("sample");
@root N("runnable");
@root N("tail");
@root N("document");

N("reference") ::= value("string");
N("sample") ::= N("sampleType");
N("runnable") ::= N("runnableType");
N("tail") ::= N("mixedType");
N("ListOfTerms") ::= (select("term", (select("name", value("string")) select("definition", N("SimpleText")))))+;
N("ListOfInternalLinks") ::= (select("link", (select("text", value("string")) select("reference", value("string")))))+;
N("SimpleList") ::= (select("item", value("string")))+;
N("SimpleText") ::= ((select("p", value("string")) | select("list", N("SimpleList"))))+;
N("SimpleSection") ::= ([select("id", value("string"))] [select("title", value("string"))] [(select("author", value("string")))+] select("content", N("SimpleText")));
N("TopSection") ::= (select("id", value("string")) select("title", value("string")) [(select("author", value("string")))+] ((select("placeholder", N("generated")) | N("normative") | N("informative") | N("production") | select("relationship", N("ListOfInternalLinks")) | select("subtopic", N("TopSection"))))+);
N("LexicalSection") ::= (select("id", value("string")) select("type", N("lexical")) select("title", value("string")) [(select("author", value("string")))+] ((select("placeholder", N("generated")) | N("normative") | N("informative") | N("production") | select("relationship", N("ListOfInternalLinks")) | select("subtopic", N("TopSection"))))+);
N("top-section") ::= (select("scope", N("SimpleSection")) | select("conformance", N("SimpleSection")) | select("compliance", N("SimpleSection")) | select("compatibility", N("SimpleSection")) | select("notation", N("SimpleSection")) | select("clause", N("SimpleSection")) | select("field", N("SimpleSection")) | select("core", N("SimpleSection")));
N("normative") ::= (select("purpose", N("SimpleSection")) | select("description", N("SimpleSection")) | select("location", N("SimpleSection")) | select("considerations", N("SimpleSection")) | select("defaults", N("SimpleSection")) | select("normative", N("SimpleSection")));
N("informative") ::= (select("note", N("SimpleSection")) | select("example", N("SimpleSection")) | select("informative", N("SimpleSection")));
N("status") ::= (select("draft", epsilon) | select("committee draft", epsilon) | select("recommendation", epsilon) | select("international standard", epsilon));
N("generated") ::= (select("index", epsilon) | select("fullgrammar", epsilon) | select("listoftables", epsilon) | select("listofauthors", epsilon) | select("listofcontents", epsilon) | select("listofreferences", epsilon));
N("lexical") ::= (select("lineContinuations", epsilon) | select("whitespace", epsilon) | select("tokens", epsilon) | select("preprocessor", epsilon) | select("literals", epsilon) | select("other", epsilon));
N("body") ::= (select("ansi", epsilon) | select("ecma", epsilon) | select("ieee", epsilon) | select("iso", epsilon) | select("iso/iet", epsilon) | select("itu", epsilon) | select("ietf", epsilon) | select("iec", epsilon) | select("oasis", epsilon) | select("wsa", epsilon) | select("w3c", epsilon));
N("document") ::= (select("title", N("title")) (select("placeholder", N("generated")))* select("frontMatter", N("frontMatter")) [select("languageOverview", N("ListOfTerms"))] (select("lexicalSection", N("LexicalSection")))+ (N("top-section"))+ (select("annex", N("TopSection")))*);
N("title") ::= (((select("body", N("body")) select("number", value("int"))) | (select("author", value("string")))+) select("topic", value("string")) (select("version", value("string")) | select("edition", value("string"))) select("status", N("status")) select("date", value("string")));
N("frontMatter") ::= (select("foreword", N("SimpleText")) select("designGoals", N("SimpleList")) (N("top-section"))+ select("normativeReferences", N("SimpleList")) [select("definitions", N("ListOfTerms"))] [select("abbreviations", N("ListOfTerms"))] select("documentStructure", N("TopSection")) select("whatsnew", N("SimpleList")));
N("runnableType") ::= (select("context", value("string")) select("main", value("string")) (select("argument", value("string")))* select("yields", value("string")) select("language", value("string")) [select("version", value("string"))] [select("id", value("string"))]);
N("mixedType") ::= ((any | value("string")))*;
