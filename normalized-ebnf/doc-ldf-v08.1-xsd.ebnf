@root N("reference");
@root N("sample");
@root N("runnable");
@root N("tail");
@root N("document");

N("reference") ::= value("string");
N("sample") ::= N("sampleType");
N("runnable") ::= N("runnableType");
N("tail") ::= N("mixedType");
N("ListOfTerms") ::= ([select("id", value("string"))] [select("title", value("string"))] [(select("author", value("string")))+] (select("term", (select("name", value("string")) select("definition", N("SimpleText")))))+);
N("ListOfInternalLinks") ::= (select("link", (select("text", value("string")) [select("linktext", value("string"))] select("reference", value("string")))))+;
N("SimpleList") ::= (select("item", value("string")))+;
N("SimpleText") ::= (N("insideSimpleText"))+;
N("insideSimpleText") ::= (select("p", value("string")) | select("list", N("SimpleList")) | select("formula", value("string")) | select("sample", value("string")) | N("production"));
N("SimpleSection") ::= ([select("id", value("string"))] [select("title", value("string"))] [(select("author", value("string")))+] select("content", N("SimpleText")));
N("StructuredSection") ::= ([select("id", value("string"))] select("title", value("string")) [(select("author", value("string")))+] ((select("placeholder", N("generated")) | N("normative") | N("informative") | N("production") | select("relationship", N("ListOfInternalLinks")) | select("subtopic", N("StructuredSection"))))+);
N("normative") ::= (select("purpose", N("SimpleSection")) | select("description", N("SimpleSection")) | select("location", N("SimpleSection")) | select("considerations", N("SimpleSection")) | select("defaults", N("SimpleSection")) | select("normative", N("SimpleSection")));
N("informative") ::= (select("note", N("SimpleSection")) | select("example", N("SimpleSection")) | select("informative", N("SimpleSection")));
N("lexical") ::= (select("lineContinuations", N("SimpleSection")) | select("whitespace", N("SimpleSection")) | select("tokens", N("SimpleSection")) | select("preprocessor", N("SimpleSection")) | select("literals", N("SimpleSection")) | select("lexical", N("SimpleSection")));
N("status") ::= (select("unknown", epsilon) | select("draft", epsilon) | select("committee draft", epsilon) | select("recommendation", epsilon) | select("international standard", epsilon));
N("generated") ::= (select("index", epsilon) | select("fullgrammar", epsilon) | select("listoftables", epsilon) | select("listofauthors", epsilon) | select("listofcontents", epsilon) | select("listofreferences", epsilon));
N("body") ::= (select("ansi", epsilon) | select("ecma", epsilon) | select("ieee", epsilon) | select("iso", epsilon) | select("iso/iet", epsilon) | select("itu", epsilon) | select("ietf", epsilon) | select("iec", epsilon) | select("oasis", epsilon) | select("wsa", epsilon) | select("w3c", epsilon));
N("document") ::= (select("titlePage", N("titlePage")) (select("placeholder", N("generated")))* select("frontMatter", (N("front-simple-section"))+) [select("lists", (N("front-list"))+)] [select("lexicalPart", (N("lexical"))+)] (select("core", N("StructuredSection")))+ (select("annex", N("StructuredSection")))*);
N("titlePage") ::= (((select("body", N("body")) select("number", value("int"))) | (select("author", value("string")))+) select("topic", value("string")) (select("version", value("string")) | select("edition", value("string"))) select("status", N("status")) select("date", value("string")));
N("front-simple-section") ::= (select("foreword", N("SimpleSection")) | select("designGoals", N("SimpleSection")) | select("scope", N("SimpleSection")) | select("conformance", N("SimpleSection")) | select("compliance", N("SimpleSection")) | select("compatibility", N("SimpleSection")) | select("notation", N("SimpleSection")) | select("normativeReferences", N("SimpleSection")) | select("documentStructure", N("SimpleSection")) | select("whatsnew", N("SimpleSection")) | select("clause", N("SimpleSection")) | select("field", N("SimpleSection")));
N("front-list") ::= (select("definitions", N("ListOfTerms")) | select("abbreviations", N("ListOfTerms")) | select("languageOverview", N("ListOfTerms")));
N("runnableType") ::= (select("context", value("string")) select("main", value("string")) (select("argument", value("string")))* select("yields", value("string")) select("language", value("string")) [select("version", value("string"))] [select("id", value("string"))]);
N("mixedType") ::= ((any | value("string")))*;
