@root N("reference");
@root N("sample");
@root N("runnable");
@root N("tail");
@root N("document");
@root N("formula");
@root N("keyword");
@root N("code");
@root N("link");
@root N("math");
@root N("mfenced");
@root N("mtext");
@root N("msub");
@root N("msup");
@root N("mrow");
@root N("mi");
@root N("mo");
@root N("varepsilon");

N("reference") ::= value("string");
N("sample") ::= N("sampleType");
N("runnable") ::= N("runnableType");
N("tail") ::= N("mixedType");
N("document") ::= (select("titlePage", N("titlePage")) (select("placeholder", N("generated")))* select("frontMatter", (N("frontSection"))+) [select("lists", (N("frontList"))+)] [select("lexicalPart", (N("lexicalSection"))+)] (select("core", N("structuredSection")))+ (select("annex", N("structuredSection")))*);
N("titlePage") ::= (((select("body", N("body")) select("number", value("int"))) | (select("author", value("string")))+) select("topic", value("string")) (select("version", value("string")) | select("edition", value("string"))) select("status", N("status")) select("date", value("string")));
N("body") ::= (select("ansi", epsilon) | select("ecma", epsilon) | select("ieee", epsilon) | select("iso", epsilon) | select("iso/iet", epsilon) | select("itu", epsilon) | select("ietf", epsilon) | select("iec", epsilon) | select("oasis", epsilon) | select("wsa", epsilon) | select("w3c", epsilon));
N("status") ::= (select("unknown", epsilon) | select("draft", epsilon) | select("candidate", epsilon) | select("proposed", epsilon) | select("approved", epsilon) | select("revised", epsilon) | select("obsolete", epsilon) | select("withdrawn", epsilon) | select("collection", epsilon) | select("trial", epsilon) | select("errata", epsilon) | select("report", epsilon));
N("generated") ::= (select("index", epsilon) | select("fullgrammar", epsilon) | select("listoftables", epsilon) | select("listofauthors", epsilon) | select("listofcontents", epsilon) | select("listofreferences", epsilon));
N("frontSection") ::= (select("foreword", N("simpleSection")) | select("designGoals", N("simpleSection")) | select("scope", N("simpleSection")) | select("conformance", N("simpleSection")) | select("compliance", N("simpleSection")) | select("compatibility", N("simpleSection")) | select("notation", N("simpleSection")) | select("normativeReferences", N("simpleSection")) | select("documentStructure", N("simpleSection")) | select("whatsnew", N("simpleSection")));
N("simpleSection") ::= ([select("title", value("string"))] (select("author", value("string")))* select("content", N("simpleText")) [select("id", value("string"))]);
N("simpleText") ::= (N("simpleTextElement"))+;
N("simpleTextElement") ::= (select("empty", epsilon) | select("text", N("mixedType")) | select("figure", N("simpleFigure")) | select("table", N("simpleTable")) | select("list", N("simpleList")) | select("formula", ((select("math", N("anyMath")) | select("mfenced", N("anyMath")) | select("mtext", N("anyMath")) | select("msub", N("anyMath")) | select("msup", N("anyMath")) | select("mrow", N("anyMath")) | select("mi", N("anyMath")) | select("mo", N("anyMath")) | select("varepsilon", any)))+) | select("sample", value("string")) | N("production"));
N("simpleFigure") ::= (select("caption", value("string")) select("type", value("string")) select("file", value("string")) [select("id", value("string"))]);
N("simpleTable") ::= ((select("header", N("tableRow")))* (select("row", N("tableRow")))+);
N("simpleList") ::= (select("item", N("mixedType")))+;
N("frontList") ::= (select("definitions", N("listOfTerms")) | select("abbreviations", N("listOfTerms")) | select("languageOverview", N("listOfTerms")));
N("lexicalSection") ::= (select("lineContinuations", N("simpleSection")) | select("whitespace", N("simpleSection")) | select("tokens", N("simpleSection")) | select("preprocessor", N("simpleSection")) | select("literals", N("simpleSection")) | select("lexical", N("simpleSection")));
N("structuredSection") ::= (select("title", value("string")) (select("author", value("string")))* (N("structuredSectionElement"))+ [select("id", value("string"))]);
N("listOfTerms") ::= ([select("title", value("string"))] (select("author", value("string")))* (select("term", (select("name", value("string")) select("definition", N("simpleText")))))+ [select("id", value("string"))]);
N("tableRow") ::= (select("cell", N("simpleText")))+;
N("structuredSectionElement") ::= (select("placeholder", N("generated")) | N("normative") | N("informative") | N("production") | select("references", N("simpleList")) | select("section", N("simpleSection")) | select("subtopic", N("structuredSection")) | select("value", (select("key", value("string")) select("data", value("string")))));
N("normative") ::= (select("synopsis", N("simpleSection")) | select("description", N("simpleSection")) | select("syntax", N("simpleSection")) | select("constraints", N("simpleSection")) | select("relationship", N("simpleSection")) | select("semantics", N("simpleSection")) | select("default", N("simpleSection")));
N("informative") ::= (select("rationale", N("simpleSection")) | select("example", N("simpleSection")) | select("update", N("simpleSection")));
N("runnableType") ::= (select("context", value("string")) select("main", value("string")) (select("argument", value("string")))* select("yields", value("string")) select("language", value("string")) [select("version", value("string"))] [select("id", value("string"))]);
N("mixedType") ::= ((any | value("string")))*;
N("formula") ::= (any)+;
N("keyword") ::= value("string");
N("code") ::= value("string");
N("link") ::= ([select("text", value("string"))] select("reference", value("string")));
N("math") ::= N("anyMath");
N("mfenced") ::= N("anyMath");
N("mtext") ::= N("anyMath");
N("msub") ::= N("anyMath");
N("msup") ::= N("anyMath");
N("mrow") ::= N("anyMath");
N("mi") ::= N("anyMath");
N("mo") ::= N("anyMath");
N("varepsilon") ::= epsilon;
N("anyMath") ::= ((any | value("string")))*;
