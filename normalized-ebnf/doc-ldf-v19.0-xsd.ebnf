@root N("document");
@root N("formula");
@root N("keyword");
@root N("code");
@root N("link");
@root N("math");
@root N("mfenced");
@root N("mtext");
@root N("msub");
@root N("msup");
@root N("mrow");
@root N("mi");
@root N("mo");
@root N("varepsilon");

N("document") ::= (select("document-metainfo", N("document-metainfo")) (select("part", N("part")))+);
N("document-metainfo") ::= (((select("body", N("body")) select("number", value("string"))) | (select("author", value("string")))+) select("topic", value("string")) select("status", N("status")) (select("version", value("string")) | select("edition", value("string"))) (select("previous", N("previous")))* select("date", value("string")));
N("body") ::= (select("ansi", epsilon) | select("ecma", epsilon) | select("ieee", epsilon) | select("iso", epsilon) | select("iso/iet", epsilon) | select("itu", epsilon) | select("iec", epsilon) | select("ietf", epsilon) | select("oasis", epsilon) | select("omg", epsilon) | select("wsa", epsilon) | select("w3c", epsilon));
N("status") ::= (select("unknown", epsilon) | select("draft", epsilon) | select("candidate", epsilon) | select("proposed", epsilon) | select("approved", epsilon) | select("revised", epsilon) | select("obsolete", epsilon) | select("withdrawn", epsilon) | select("collection", epsilon) | select("trial", epsilon) | select("errata", epsilon) | select("report", epsilon));
N("previous") ::= (select("title", value("string")) (select("version", value("string")) | select("edition", value("string"))) [select("uri", value("string"))]);
N("part") ::= (select("part-metainfo", N("part-metainfo")) (N("section"))+);
N("part-metainfo") ::= (select("part-role", N("part-role")) [select("title", value("string"))] (select("author", value("string")))* [select("id", value("string"))]);
N("part-role") ::= (select("front-matter", epsilon) | select("core-part", epsilon) | select("back-matter", epsilon) | select("annex", epsilon));
N("section") ::= (select("placeholder", N("placeholder")) | select("simple-section", N("simple-section")) | select("lexical-section", N("lexical-section")) | select("structured-section", N("structured-section")) | select("composite-section", N("composite-section")) | select("list-section", N("list-section")));
N("composite-section") ::= (N("section"))+;
N("placeholder") ::= (select("index", epsilon) | select("full-grammar", epsilon) | select("list-of-tables", epsilon) | select("list-of-authors", epsilon) | select("list-of-contents", epsilon) | select("list-of-references", epsilon));
N("simple-section") ::= (select("simple-section-metainfo", N("simple-section-metainfo")) select("simple-section-content", N("textual-content")));
N("simple-section-metainfo") ::= (select("simple-section-role", N("simple-section-role")) [select("title", value("string"))] (select("author", value("string")))* [select("id", value("string"))]);
N("simple-section-role") ::= (select("abstract", epsilon) | select("conformance", epsilon) | select("compatibility", epsilon) | select("design-goals", epsilon) | select("document-structure", epsilon) | select("foreword", epsilon) | select("normative-references", epsilon) | select("notation", epsilon) | select("scope", epsilon) | select("what-is-new", epsilon));
N("lexical-section") ::= (select("lexical-section-metainfo", N("lexical-section-metainfo")) select("lexical-section-content", N("textual-content")));
N("lexical-section-metainfo") ::= (select("lexical-section-role", N("lexical-section-role")) [select("title", value("string"))] (select("author", value("string")))* [select("id", value("string"))]);
N("lexical-section-role") ::= (select("lexical-issue", epsilon) | select("line-continuations", epsilon) | select("literals", epsilon) | select("preprocessor", epsilon) | select("tokens", epsilon) | select("whitespace", epsilon));
N("list-section") ::= (select("list-section-metainfo", N("list-section-metainfo")) select("list-section-content", (select("term", N("term")))+));
N("list-section-metainfo") ::= (select("list-section-role", N("list-section-role")) [select("title", value("string"))] (select("author", value("string")))* [select("id", value("string"))]);
N("list-section-role") ::= (select("abbreviations", epsilon) | select("definitions", epsilon) | select("language-overview", epsilon) | select("normative-references", epsilon));
N("term") ::= (select("name", value("string")) select("definition", N("textual-content")));
N("structured-section") ::= (select("structured-section-metainfo", N("structured-section-metainfo")) select("structured-section-content", (N("structured-section-element"))+));
N("structured-section-metainfo") ::= (select("title", value("string")) (select("author", value("string")))* [select("id", value("string"))]);
N("structured-section-element") ::= (select("subtopic", N("structured-section")) | select("references", N("list")) | select("placeholder", N("placeholder")) | select("value", (select("key", value("string")) select("data", value("string")))) | (N("element-role") select("simple-section", N("simple-section"))));
N("element-role") ::= (select("normative", N("normative-role")) | select("informative", N("informative-role")) | select("specific-section", N("simple-section")));
N("normative-role") ::= (select("synopsis", epsilon) | select("description", epsilon) | select("syntax", epsilon) | select("constraints", epsilon) | select("relationship", epsilon) | select("semantics", epsilon) | select("default", epsilon));
N("informative-role") ::= (select("example", epsilon) | select("rationale", epsilon) | select("update", epsilon));
N("textual-content") ::= (N("text-element"))+;
N("text-element") ::= (select("empty", epsilon) | select("code", value("string")) | select("text", N("mixed-type")) | select("figure", N("figure")) | select("table", N("table")) | select("list", N("list")) | select("formula", ((select("math", N("anyMath")) | select("mfenced", N("anyMath")) | select("mtext", N("anyMath")) | select("msub", N("anyMath")) | select("msup", N("anyMath")) | select("mrow", N("anyMath")) | select("mi", N("anyMath")) | select("mo", N("anyMath")) | select("varepsilon", any)))+) | select("sample", (((any | value("string")))* select("source", value("string")))) | N("production"));
N("figure") ::= (select("figure-metainfo", N("figure-metainfo")) (select("figure-source", N("figure-source")))+);
N("figure-metainfo") ::= ([select("short-caption", value("string"))] select("caption", value("string")) [select("id", value("string"))]);
N("figure-source") ::= (select("type", N("figure-type")) (select("local-file", value("string")) | select("uri", value("string"))));
N("figure-type") ::= (select("PDF", epsilon) | select("PostScript", epsilon) | select("SVG", epsilon) | select("PNG", epsilon) | select("GIF", epsilon) | select("JPEG", epsilon));
N("table") ::= ((select("header", N("table-row")))* (select("row", N("table-row")))+);
N("table-row") ::= (select("table-cell", N("textual-content")))+;
N("list") ::= (select("item", N("mixed-type")))+;
N("mixed-type") ::= ((any | value("string")))*;
N("formula") ::= (any)+;
N("keyword") ::= value("string");
N("code") ::= value("string");
N("link") ::= ([select("text", value("string"))] (select("reference", value("string")) | select("external", value("string"))));
N("math") ::= N("anyMath");
N("mfenced") ::= N("anyMath");
N("mtext") ::= N("anyMath");
N("msub") ::= N("anyMath");
N("msup") ::= N("anyMath");
N("mrow") ::= N("anyMath");
N("mi") ::= N("anyMath");
N("mo") ::= N("anyMath");
N("varepsilon") ::= epsilon;
N("anyMath") ::= ((any | value("string")))*;
