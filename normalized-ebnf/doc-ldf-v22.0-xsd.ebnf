@root N("document");
@root N("metainfo");
@root N("composite-section");
@root N("placeholder");
@root N("simple-section");
@root N("lexical-section");
@root N("list-section");
@root N("term");
@root N("structured-section");
@root N("normative-role");
@root N("informative-role");
@root N("anchor");
@root N("figure");
@root N("table");
@root N("formula");
@root N("keyword");
@root N("code");
@root N("link");
@root N("math");
@root N("mfenced");
@root N("mtext");
@root N("msub");
@root N("msup");
@root N("mrow");
@root N("mi");
@root N("mo");
@root N("varepsilon");

N("document") ::= (select("metadata", ([select("body", (select("ansi", epsilon) | select("ecma", epsilon) | select("ieee", epsilon) | select("iso", epsilon) | select("iso/iet", epsilon) | select("itu", epsilon) | select("iec", epsilon) | select("ietf", epsilon) | select("oasis", epsilon) | select("omg", epsilon) | select("wsa", epsilon) | select("w3c", epsilon)))] [select("number", value("string"))] (select("author", N("person")))* select("topic", value("string")) select("status", (select("unknown", epsilon) | select("draft", epsilon) | select("candidate", epsilon) | select("proposed", epsilon) | select("approved", epsilon) | select("revised", epsilon) | select("obsolete", epsilon) | select("withdrawn", epsilon) | select("collection", epsilon) | select("trial", epsilon) | select("errata", epsilon) | select("report", epsilon))) (select("version", value("string")) | select("edition", value("string"))) (select("previous", N("title-ve-uri")))* select("date", value("string")))) (select("part", N("part-type")))+);
N("title-ve-uri") ::= (select("title", value("string")) [(select("version", value("string")) | select("edition", value("string")))] [select("uri", value("string"))]);
N("part-type") ::= (select("metadata", ([select("id", value("string"))] select("role", (select("front-matter", epsilon) | select("core-part", epsilon) | select("back-matter", epsilon) | select("annex", epsilon))) [select("title", value("string"))] (select("author", N("person")))*)) (select("section", N("section-type")))+);
N("metainfo") ::= ([select("id", value("string"))] [select("title", value("string"))] (select("author", value("string")))*);
N("person") ::= (select("name", value("string")) [select("affiliation", value("string"))] [select("email", value("string"))]);
N("section-type") ::= (select("metadata", ([select("id", value("string"))] select("role", (select("abstract", epsilon) | select("conformance", epsilon) | select("compatibility", epsilon) | select("design-goals", epsilon) | select("document-structure", epsilon) | select("foreword", epsilon) | select("references", epsilon) | select("notation", epsilon) | select("scope", epsilon) | select("what-is-new", epsilon) | select("index", epsilon) | select("full-grammar", epsilon) | select("list-of-tables", epsilon) | select("list-of-authors", epsilon) | select("list-of-contents", epsilon) | select("list-of-references", epsilon) | select("top-section", epsilon) | select("lexical-section", epsilon) | select("description", epsilon) | select("syntax", epsilon) | select("example", epsilon) | select("subsection", epsilon))) [select("type", (select("normative", epsilon) | select("informative", epsilon)))] [select("title", value("string"))] (select("author", N("person")))*)) (select("content", (N("content-content"))+) | select("placeholder", any) | (select("subsection", N("subsection-type")))+));
N("subsection-type") ::= (select("metadata", ([select("id", value("string"))] select("role", (select("synopsis", epsilon) | select("description", epsilon) | select("syntax", epsilon) | select("constraints", epsilon) | select("relationship", epsilon) | select("semantics", epsilon) | select("default", epsilon) | select("rationale", epsilon) | select("example", epsilon) | select("update", epsilon) | select("subtopic", epsilon) | select("section", epsilon))) [select("type", (select("normative", epsilon) | select("informative", epsilon)))] [select("title", value("string"))] (select("author", N("person")))*)) (select("content", (N("content-content"))+) | select("placeholder", any) | (select("subsection", N("subsection-type")))+));
N("content-content") ::= (select("para", N("mixed-type")) | select("list", N("list-type")) | N("production"));
N("section") ::= (N("placeholder") | N("simple-section") | N("lexical-section") | N("structured-section") | N("composite-section") | N("list-section"));
N("composite-section") ::= (N("section"))+;
N("placeholder") ::= (select("index", epsilon) | select("full-grammar", epsilon) | select("list-of-tables", epsilon) | select("list-of-authors", epsilon) | select("list-of-contents", epsilon) | select("list-of-references", epsilon));
N("simple-section") ::= (N("metainfo") select("content", N("textual-content")));
N("lexical-section") ::= (select("role", N("lexical-section-role")) N("metainfo") select("content", N("textual-content")));
N("lexical-section-role") ::= (select("lexical-issue", epsilon) | select("line-continuations", epsilon) | select("literals", epsilon) | select("preprocessor", epsilon) | select("tokens", epsilon) | select("whitespace", epsilon));
N("list-section") ::= (select("role", N("list-section-role")) N("metainfo") select("content", (N("term"))+));
N("list-section-role") ::= (select("abbreviations", epsilon) | select("definitions", epsilon) | select("language-overview", epsilon) | select("normative-references", epsilon));
N("term") ::= (select("name", value("string")) select("definition", N("textual-content")));
N("structured-section") ::= (N("metainfo") select("content", (N("structured-section-element"))+));
N("structured-section-element") ::= (select("subtopic", N("structured-section")) | select("references", N("list-type")) | N("placeholder") | select("value", (select("key", value("string")) select("data", value("string")))) | ([(N("normative-role") | N("informative-role"))] N("simple-section")));
N("normative-role") ::= (select("synopsis", epsilon) | select("description", epsilon) | select("syntax", epsilon) | select("constraints", epsilon) | select("relationship", epsilon) | select("semantics", epsilon) | select("default", epsilon));
N("informative-role") ::= (select("example", epsilon) | select("rationale", epsilon) | select("update", epsilon));
N("anchor") ::= select("id", value("string"));
N("textual-content") ::= (N("text-element"))+;
N("text-element") ::= (select("empty", epsilon) | N("code") | select("text", N("mixed-type")) | N("figure") | N("table") | select("list", N("list-type")) | select("formula", ((select("math", N("anyMath")) | select("mfenced", N("anyMath")) | select("mtext", N("anyMath")) | select("msub", N("anyMath")) | select("msup", N("anyMath")) | select("mrow", N("anyMath")) | select("mi", N("anyMath")) | select("mo", N("anyMath")) | select("varepsilon", any)))+) | select("sample", (((any | value("string")))* select("source", value("string")))));
N("figure") ::= (N("metainfo") (select("source", N("figure-source")))+);
N("figure-source") ::= (select("type", N("figure-type")) (select("local-file", value("string")) | select("uri", value("string"))));
N("figure-type") ::= (select("PDF", epsilon) | select("PostScript", epsilon) | select("SVG", epsilon) | select("PNG", epsilon) | select("GIF", epsilon) | select("JPEG", epsilon));
N("table") ::= ((select("header", N("table-row")))* (select("row", N("table-row")))+);
N("table-row") ::= (select("table-cell", N("textual-content")))+;
N("list-type") ::= (select("item", N("mixed-type")))+;
N("mixed-type") ::= ((any | value("string")))*;
N("formula") ::= (any)+;
N("keyword") ::= value("string");
N("code") ::= value("string");
N("link") ::= ([select("text", value("string"))] (select("nonterminal", value("string")) | select("reference", value("string")) | select("external", value("string"))));
N("math") ::= N("anyMath");
N("mfenced") ::= N("anyMath");
N("mtext") ::= N("anyMath");
N("msub") ::= N("anyMath");
N("msup") ::= N("anyMath");
N("mrow") ::= N("anyMath");
N("mi") ::= N("anyMath");
N("mo") ::= N("anyMath");
N("varepsilon") ::= epsilon;
N("anyMath") ::= ((any | value("string")))*;
