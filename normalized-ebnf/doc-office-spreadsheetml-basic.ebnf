N("DateTimeType") ::= (select("year", N("Integer")) select("month", N("Integer")) select("day", N("Integer")) select("hour", N("Integer")) select("minute", N("Integer")) select("second", N("Integer")));
N("VersionType") ::= (select("n", N("Integer")) select("nn", N("Integer")));
N("ValueType") ::= N("StringValue");
N("ValueType") ::= N("NumberValue");
N("ValueType") ::= N("DateTimeTypeValue");
N("ValueType") ::= N("BooleanValue");
N("ValueType") ::= N("ErrorValue");
N("StringValue") ::= select("value", N("String"));
N("NumberValue") ::= select("value", N("Double"));
N("DateTimeTypeValue") ::= select("value", N("DateTimeType"));
N("BooleanValue") ::= select("value", N("Boolean"));
N("ErrorValue") ::= (select("vt_data", N("Data")));
N("DocumentPropertiesCollection") ::= (select("dp_workbook", N("Workbook")) select("title", N("String")) select("subject", N("String")) select("keywords", N("String")) select("description", N("String")) select("category", N("String")) select("author", N("String")) select("lastAuthor", N("String")) select("manager", N("String")) select("company", N("String")) select("hyperlinkBase", N("String")) select("revision", N("Integer")) select("presentationFormat", N("String")) select("guid", N("String")) select("appName", N("String")) select("version", N("VersionType")) select("totalTime", N("Integer")) select("lastPrinted", N("DateTimeType")) select("created", N("DateTimeType")) select("lastSaved", N("DateTimeType")) select("pages", N("Integer")) select("words", N("Integer")) select("characters", N("Integer")) select("charactersWithSpaces", N("Integer")) select("bytes", N("Integer")) select("lines", N("Integer")) select("paragraphs", N("Integer")));
N("CustomDocumentPropertiesCollection") ::= (select("cdp_workbook", N("Workbook")) (select("customDocumentProperties", N("CustomDocumentProperty")))+);
N("CustomDocumentProperty") ::= (select("customDocumentProperty_cdpe", N("CustomDocumentPropertiesCollection")) select("name", N("String")) select("value", N("ValueType")));
N("SmartTagType") ::= (select("smartTagType_ste", N("SmartTagsCollection")) select("namespaceuri", N("String")) select("name", N("String")) select("url", N("String")));
N("SmartTagsCollection") ::= (select("st_workbook", N("Workbook")) select("st_cell", N("Cell")) (select("smartTagTypes", N("SmartTagType")))+);
N("Workbook") ::= (select("wb_smartTags", N("SmartTagsCollection")) select("wb_docProperties", N("DocumentPropertiesCollection")) select("wb_customDocProperties", N("CustomDocumentPropertiesCollection")) (select("wb_worksheets", N("Worksheet")))+);
N("Worksheet") ::= (select("ws_workbook", N("Workbook")) select("ws_table", N("Table")) select("name", N("String")));
N("StyledElement") ::= N("Table");
N("StyledElement") ::= N("TableElement");
N("Table") ::= (select("t_worksheet", N("Worksheet")) (select("t_cols", N("Column")))+ (select("t_rows", N("Row")))+ select("defaultColumnWidth", N("Double")) select("defaultRowHeight", N("Double")) select("expandedColumnCount", N("Integer")) select("expandedRowCount", N("Integer")) select("leftCell", N("Integer")) select("topCell", N("Integer")) select("fullColumns", N("Boolean")) select("fullRows", N("Boolean")));
N("TableElement") ::= N("ColOrRowElement");
N("TableElement") ::= N("Cell");
N("ColOrRowElement") ::= N("Column");
N("ColOrRowElement") ::= N("Row");
N("Column") ::= (select("c_table", N("Table")) select("autoFitWidth", N("Boolean")) select("width", N("Double")));
N("Row") ::= (select("r_table", N("Table")) (select("r_cells", N("Cell")))+ select("autoFitHeight", N("Boolean")) select("height", N("Double")));
N("Cell") ::= (select("c_row", N("Row")) (select("c_smartTags", N("SmartTagsCollection")))+ select("arrayRange", N("String")) select("formula", N("String")) select("hRef", N("String")) select("mergeAcross", N("Double")) select("mergeDown", N("Double")) select("c_data", N("Data")) select("c_comment", N("Comment")));
N("Comment") ::= (select("c_cell", N("Cell")) select("com_data", N("Data")) select("author", N("String")) select("showAlways", N("Boolean")));
N("Data") ::= (select("d_cell", N("Cell")) select("d_comment", N("Comment")) select("value", N("ValueType")));
N("Integer") ::= value("int");
N("String") ::= value("string");
N("Boolean") ::= ("true" | "false");
