N("Integer") ::= value("int");
N("String") ::= value("string");
N("Boolean") ::= ("true" | "false");
N("StringProperty") ::= (select("val", N("String")));
N("StringType") ::= N("StringProperty");
N("StringType") ::= N("Text");
N("StringType") ::= N("DelText");
N("StringType") ::= N("InstrText");
N("StringType") ::= N("DelInstrText");
N("StringType") ::= select("val", N("String"));
N("BreakType") ::= (select("bt_page", epsilon) | select("bt_column", epsilon) | select("bt_text_wrapping", epsilon));
N("NoteValue") ::= (select("ftn_normal", epsilon) | select("ftn_separator", epsilon) | select("ftn_continuation_separator", epsilon) | select("ftn_continuation_notice", epsilon));
N("OnOffType") ::= (select("oot_on", epsilon) | select("oot_off", epsilon));
N("FldCharTypeProperty") ::= (select("fctp_begin", epsilon) | select("fctp_separate", epsilon) | select("fctp_end", epsilon));
N("WordDocument") ::= (select("ignoreSubtree", N("StringProperty")) select("ignoreElements", N("StringProperty")) select("body", N("BodyElt")));
N("BodyElt") ::= (select("be_wordDocument", N("WordDocument")) (select("blockLevelElts", N("BlockLevelElt")))+);
N("BlockLevelElt") ::= N("BlockLevelChunkElt");
N("BlockLevelChunkElt") ::= N("ParaElt");
N("ParaElt") ::= (select("pContentElts", N("ParaContentElt")))+;
N("ParaContentElt") ::= N("RunElt");
N("RunElt") ::= (select("rContentElts", N("RunContentElt")))+;
N("RunContentElt") ::= N("BreakElt");
N("RunContentElt") ::= N("NoBreakHyphen");
N("RunContentElt") ::= N("SoftHyphen");
N("RunContentElt") ::= N("AnnotationRef");
N("RunContentElt") ::= N("FootnoteRef");
N("RunContentElt") ::= N("EndnoteRef");
N("RunContentElt") ::= N("Separator");
N("RunContentElt") ::= N("ContinuationSeparator");
N("RunContentElt") ::= N("PgNum");
N("RunContentElt") ::= N("Cr");
N("RunContentElt") ::= N("Picture");
N("RunContentElt") ::= N("Tab");
N("RunContentElt") ::= N("Text");
N("RunContentElt") ::= N("DelText");
N("RunContentElt") ::= N("InstrText");
N("RunContentElt") ::= N("DelInstrText");
N("RunContentElt") ::= N("Footnote");
N("RunContentElt") ::= N("Endnote");
N("RunContentElt") ::= N("Symbol");
N("RunContentElt") ::= N("FldChar");
N("BreakElt") ::= select("type", N("BreakType"));
N("Text") ::= (select("rce_rElt", N("RunElt")) select("val", N("String")));
N("DelText") ::= (select("rce_rElt", N("RunElt")) select("val", N("String")));
N("InstrText") ::= (select("rce_rElt", N("RunElt")) select("val", N("String")));
N("DelInstrText") ::= (select("rce_rElt", N("RunElt")) select("val", N("String")));
N("NoBreakHyphen") ::= (select("rce_rElt", N("RunElt")));
N("SoftHyphen") ::= (select("rce_rElt", N("RunElt")));
N("AnnotationRef") ::= (select("rce_rElt", N("RunElt")));
N("FootnoteRef") ::= (select("rce_rElt", N("RunElt")));
N("EndnoteRef") ::= (select("rce_rElt", N("RunElt")));
N("Separator") ::= (select("rce_rElt", N("RunElt")));
N("ContinuationSeparator") ::= (select("rce_rElt", N("RunElt")));
N("PgNum") ::= (select("rce_rElt", N("RunElt")));
N("Cr") ::= (select("rce_rElt", N("RunElt")));
N("Footnote") ::= (select("rce_rElt", N("RunElt")) (select("n_blockLevelElts", N("BlockLevelElt")))+ select("type", N("NoteValue")) select("suppressRef", N("OnOffType")));
N("Endnote") ::= (select("rce_rElt", N("RunElt")) (select("n_blockLevelElts", N("BlockLevelElt")))+ select("type", N("NoteValue")) select("suppressRef", N("OnOffType")));
N("NoteElt") ::= N("Footnote");
N("NoteElt") ::= N("Endnote");
N("Picture") ::= (select("rce_rElt", N("RunElt")));
N("Symbol") ::= (select("rce_rElt", N("RunElt")) select("font", N("StringType")) select("char", N("StringType")));
N("SymElt") ::= N("Symbol");
N("SymElt") ::= (select("font", N("StringType")) select("char", N("StringType")));
N("Tab") ::= (select("rce_rElt", N("RunElt")));
N("FldChar") ::= (select("rce_rElt", N("RunElt")) select("fldData", N("StringType")) select("fldCharType", N("FldCharTypeProperty")) select("fldLock", N("OnOffType")));
N("FldCharElt") ::= N("FldChar");
N("FldCharElt") ::= (select("fldData", N("StringType")) select("fldCharType", N("FldCharTypeProperty")) select("fldLock", N("OnOffType")));
