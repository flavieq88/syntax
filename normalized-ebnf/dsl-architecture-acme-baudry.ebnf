N("ACMEFile") ::= (select("entries", N("ACMEEntry")))+;
N("ACMEEntry") ::= N("System");
N("ACMEEntry") ::= N("ComponentType");
N("Element") ::= N("Type");
N("Element") ::= N("Component");
N("Element") ::= N("Port");
N("Element") ::= N("Connector");
N("Element") ::= N("Role");
N("Element") ::= N("System");
N("Type") ::= (select("name", N("String")) (select("representations", N("Representation")))+ (select("property", N("Property")))+);
N("System") ::= ((select("componentDeclaration", N("ComponentInstance")))+ (select("connectorDeclaration", N("Connector")))+ (select("attachments", N("Link")))+ (select("bindings", N("Link")))+);
N("Representation") ::= (select("systems", N("System")))+;
N("Component") ::= N("ComponentInstance");
N("Component") ::= N("ComponentType");
N("ComponentInstance") ::= select("instanceOf", N("String"));
N("ComponentType") ::= select("extend", N("String"));
N("Port") ::= (select("name", N("String")) (select("representations", N("Representation")))+ (select("property", N("Property")))+);
N("Connector") ::= ((select("roles", N("Role")))+ select("system", N("System")));
N("Role") ::= (select("name", N("String")) (select("representations", N("Representation")))+ (select("property", N("Property")))+);
N("Property") ::= (select("name", N("String")) select("val", N("String")));
N("Link") ::= N("Attachment");
N("Link") ::= N("Binding");
N("Attachment") ::= (select("comp", N("String")) select("port", N("String")) select("con", N("String")) select("role", N("String")));
N("Binding") ::= (select("compSrc", N("String")) select("portSrc", N("String")) select("compDest", N("String")) select("portDest", N("String")));
N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
N("String") ::= value("string");
