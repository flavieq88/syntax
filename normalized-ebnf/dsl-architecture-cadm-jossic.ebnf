N("Element") ::= N("Architecture");
N("Element") ::= N("Organization");
N("Element") ::= N("Guidance");
N("Element") ::= N("Document");
N("Element") ::= N("Action");
N("Element") ::= N("Agreement");
N("Element") ::= N("Task");
N("Element") ::= N("InformationAsset");
N("Element") ::= N("Network");
N("Element") ::= N("MissionArea");
N("Element") ::= N("System");
N("Element") ::= N("Mission");
N("Element") ::= N("FunctionalArea");
N("Element") ::= N("Capability");
N("Element") ::= N("MaterielItem");
N("Element") ::= N("Facility");
N("Element") ::= (select("name", N("String")) select("content", N("String")));
N("Architecture") ::= ((select("isAssociatedWith", N("Architecture")))+ (select("missions", N("Mission")))+ (select("isFocusOf", N("FunctionalArea")))+ (select("uses", N("Organization")))+);
N("Organization") ::= ((select("isAssociatedWith", N("Organization")))+ (select("softwareItems", N("SoftwareItem")))+ (select("owns", N("InformationAsset")))+ (select("includes", N("Node")))+ (select("performsTo", N("Capability")))+ (select("hasRequirement", N("Requirement")))+ (select("hasMissionArea", N("MissionArea")))+ (select("associatedSystems", N("System")))+ (select("isProponentOf", N("FunctionalArea")))+);
N("Guidance") ::= N("Requirement");
N("Guidance") ::= ((select("isAssocitatedWith", N("Guidance")))+ (select("isImplementedBy", N("Architecture")))+ (select("isSpecifiedIn", N("Document")))+ (select("providesAuthorityFor", N("InformationAsset")))+ (select("defines", N("MissionArea")))+);
N("Document") ::= ((select("isAssociatedWith", N("Document")))+ select("describesArchitecture", N("Architecture")) (select("describesSystem", N("System")))+ (select("isSpecifiedUsing", N("Agreement")))+ (select("cites", N("InformationAsset")))+);
N("Action") ::= (select("mayBeA", N("Task")) (select("isAssociatedWith", N("Action")))+ (select("involvedIn", N("ActivityModel")))+);
N("Agreement") ::= N("Standard");
N("Agreement") ::= ((select("isAssociatedWith", N("Agreement")))+ (select("isCitedBy", N("Agreement")))+ (select("appliesTo", N("InformationAsset")))+ (select("implements", N("Guidance")))+);
N("Standard") ::= ((select("isAssociatedWith", N("Agreement")))+ (select("isCitedBy", N("Agreement")))+ (select("appliesTo", N("InformationAsset")))+ (select("implements", N("Guidance")))+);
N("Task") ::= ((select("isAssociatedWith", N("Task")))+ (select("isPerformedBy", N("Node")))+ (select("isPerformedUsing", N("System")))+ (select("specifies", N("Requirement")))+);
N("InformationAsset") ::= N("ConceptualDataModel");
N("InformationAsset") ::= N("ActivityModel");
N("InformationAsset") ::= (select("isAssociatedWith", N("InformationAsset")))+;
N("ConceptualDataModel") ::= ((select("isAssociatedWith", N("InformationAsset")))+);
N("ActivityModel") ::= ((select("isAssociatedWith", N("InformationAsset")))+);
N("Node") ::= ((select("isAssociatedWith", N("Node")))+ (select("describes", N("Architecture")))+ (select("hasServicesProvidedBy", N("Facility")))+ (select("involvedIn", N("ActivityModel")))+ (select("uses", N("InformationAsset")))+ (select("involves", N("InfoExchRequirement")))+ (select("isParticipedInBy", N("Network")))+ (select("supports", N("System")))+);
N("Network") ::= ((select("isAssociatedWith", N("Network")))+ (select("isDescribedIn", N("Document")))+ (select("compliesWith", N("Standard")))+ (select("has", N("Organization")))+ (select("performsTo", N("Capability")))+);
N("Requirement") ::= N("InfoExchRequirement");
N("Requirement") ::= N("ExchangeNeedLineReq");
N("Requirement") ::= ((select("mayBeSatifiedBy", N("Architecture")))+ (select("isSpecifiedUsing", N("InformationAsset")))+ (select("specifiesNeedFor", N("MaterielItem")))+ (select("cites", N("MissionArea")))+);
N("InfoExchRequirement") ::= ((select("isCitedIn", N("Document")))+ (select("isSpecifiedInInfos", N("InformationAsset")))+);
N("ExchangeNeedLineReq") ::= ((select("mayBeSatifiedBy", N("Architecture")))+ (select("isSpecifiedUsing", N("InformationAsset")))+ (select("specifiesNeedFor", N("MaterielItem")))+ (select("cites", N("MissionArea")))+);
N("MissionArea") ::= (select("supports", N("Task")))+;
N("System") ::= ((select("isAssociatedWith", N("System")))+ (select("citedIn", N("Architecture")))+ (select("compliesWith", N("Standard")))+ (select("isDescribedBy", N("InformationAsset")))+ (select("uses", N("MaterielItem")))+ (select("operatesUsing", N("Network")))+ (select("performsTo", N("Capability")))+ (select("associatedOrganization", N("Organization")))+ (select("appliesTo", N("Requirement")))+);
N("Mission") ::= (select("isCitedBy", N("Architecture")) (select("requires", N("Task")))+ (select("isAssigned", N("Organization")))+ (select("mayCite", N("FunctionalArea")))+);
N("FunctionalArea") ::= ((select("isPartOf", N("FunctionalArea")))+ (select("supports", N("System")))+ (select("cites", N("MissionArea")))+);
N("Capability") ::= (select("specifiesRequired", N("Requirement")))+;
N("MaterielItem") ::= N("EquipmentType");
N("MaterielItem") ::= N("SoftwareItem");
N("MaterielItem") ::= ((select("establishedAs", N("MaterielItem")))+ (select("conformsTo", N("Standard")))+ (select("performsTo", N("Capability")))+);
N("EquipmentType") ::= ((select("establishedAs", N("MaterielItem")))+ (select("conformsTo", N("Standard")))+ (select("performsTo", N("Capability")))+);
N("SoftwareItem") ::= ((select("uses", N("EquipmentType")))+ select("isSourceFor", N("Organization")));
N("Facility") ::= (select("name", N("String")) select("content", N("String")));
N("String") ::= value("string");
