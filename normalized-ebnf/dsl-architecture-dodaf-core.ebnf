N("SystemFunction") ::= N("Service");
N("SystemFunction") ::= ((select("decomposes", N("SystemFunction")))+ (select("consumes", N("Product")))+ (select("produces", N("Product")))+ select("terminatesAt", N("SystemProductFlow")) (select("mesuredBy", N("ConstraintOrRequirement")))+);
N("Service") ::= ((select("decomposes", N("SystemFunction")))+ (select("consumes", N("Product")))+ (select("produces", N("Product")))+ select("terminatesAt", N("SystemProductFlow")) (select("mesuredBy", N("ConstraintOrRequirement")))+);
