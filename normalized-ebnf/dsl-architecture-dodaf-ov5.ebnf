N("MechanismSystem") ::= (select("source", N("String")) select("destination", N("String")) select("resourceType", N("String")));
N("MechanismReference") ::= (select("source", N("String")) select("destination", N("String")) select("resourceType", N("String")));
N("MechanismFacility") ::= (select("source", N("String")) select("destination", N("String")) select("resourceType", N("String")));
N("InformationAssetDocument") ::= (select("name", N("String")) select("description", N("String")) select("view", N("String")));
N("AMPA") ::= ((select("isOrdinateOf", N("AMPA")))+ (select("isSubordinateOf", N("AMPA")))+ (select("defines", N("AMIERole")))+);
N("PACapability") ::= (select("name", N("String")) select("description", N("String")) select("view", N("String")));
N("PA") ::= ((select("isTheProducerFor", N("PAExchangeRequirement")))+ (select("isTheConsumerFor", N("PAExchangeRequirement")))+ (select("isParentFor", N("PA")))+ (select("isChildFor", N("PA")))+ (select("has", N("PACapability")))+ (select("isIncludedIn", N("AMPA")))+ (select("correspondsTo", N("PATask")))+);
N("AM") ::= (select("type", N("String")) (select("specifies", N("AMSpecification")))+ (select("includes", N("AMPA")))+ (select("paTask", N("PATask")))+);
N("InformationAsset") ::= N("AM");
N("Task") ::= N("PATask");
N("Task") ::= (select("levelIdentifier", N("String")) select("references", N("String")) select("cost", N("String")));
N("PATask") ::= select("isCitedBy", N("InformationAsset"));
N("Organization") ::= (select("type", N("OrganizationType")) (select("supplies", N("InformationAsset")))+ (select("providesStewardshipFor", N("InformationAsset")))+ (select("owns", N("InformationAsset")))+ (select("develops", N("IE")))+ (select("isCitedAs", N("MechanismReference")))+);
N("OrganizationType") ::= ((select("isTheTypeOf", N("Organization")))+ (select("isCitedAs", N("MechanismReference")))+);
N("OperationalRole") ::= (select("isCitedAs", N("MechanismReference")))+;
N("Occupation") ::= ((select("mayBeCitedForOR", N("OperationalRole")))+ (select("mayBeCitedForPT", N("PersonType")))+);
N("PersonType") ::= ((select("mayBeCitedFor", N("OperationalRole")))+ (select("can", N("Skill")))+);
N("Skill") ::= (select("mayBeCitedFor", N("OperationalRole")))+;
N("DOSCR") ::= (select("mayBeAn", N("Occupation")) (select("appliesTo", N("PersonType")))+ (select("mayBeCitedFor", N("OperationalRole")))+);
N("String") ::= value("string");
