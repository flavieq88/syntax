N("Element") ::= N("Skill");
N("Element") ::= N("DOSCR");
N("DoDAFModel") ::= ((select("document", N("Document")))+ (select("am", N("AM")))+ (select("task", N("Task")))+ (select("iaDocument", N("InformationAssetDocument")))+ (select("amSpecification", N("AMSpecification")))+ (select("doscr", N("DOSCR")))+ (select("organizationType", N("OrganizationType")))+);
N("Document") ::= N("AMSpecification");
N("Document") ::= (select("type", N("String")) (select("cites", N("InformationAssetDocument")))+ (select("records", N("ArchitectureDocument")))+ (select("isTheReferenceFor", N("IE")))+ (select("isThePrimaryReferenceFor", N("PA")))+);
N("AMSpecification") ::= (select("isSpecifiedUsing", N("AMSpecificationElement")))+;
N("AMSpecificationElement") ::= select("subject", N("PAExchangeRequirement"));
N("PAExchangeRequirement") ::= (select("isTheSubjectOf", N("AMSpecificationElement")))+;
N("ArchitectureDocument") ::= (select("name", N("String")) select("description", N("String")) select("view", N("String")));
N("IE") ::= ((select("isAssociatedWith", N("AMIERole")))+ (select("isOrdinateOf", N("IE")))+ (select("isSubordinateOf", N("IE")))+);
N("AMIERole") ::= N("Control");
N("AMIERole") ::= N("Input");
N("AMIERole") ::= N("Output");
N("AMIERole") ::= N("Mechanism");
N("AMIERole") ::= (select("defines", N("AMPA")))+;
N("Control") ::= (select("source", N("String")) select("destination", N("String")));
N("Input") ::= ((select("isTheInputThatIsDefinedBy", N("Output")))+ select("source", N("String")) select("destination", N("String")) select("information", N("String")));
N("Output") ::= (select("source", N("String")) select("destination", N("String")) select("information", N("String")));
N("Mechanism") ::= N("MechanismSystem");
N("Mechanism") ::= N("MechanismReference");
N("Mechanism") ::= N("MechanismFacility");
