N("SystemFunction") ::= (select("isCitedFor", N("SystemFunctionTraceabilityElement")))+;
N("SystemPA") ::= ((select("mayBeCitedFor", N("SystemFunctionTraceabilityElement")))+ (select("provides", N("SystemCapability")))+ (select("enables", N("SystemOperationalCapabilityTask")))+);
N("SoftwareApplicationProcedurePA") ::= (select("name", N("String")) select("description", N("String")) select("view", N("String")));
N("AM") ::= (select("type", N("String")) (select("isCitedBy", N("PATask")))+ (select("includes", N("AMPA")))+);
N("InformationAsset") ::= N("AM");
N("AMPA") ::= ((select("isOrdinateOf", N("AMPA")))+ (select("isSubordinateOf", N("AMPA")))+);
N("System") ::= ((select("isDesignedToProvide", N("SystemPA")))+ (select("isDescribedBy", N("SystemDocument")))+ (select("performs", N("SystemCapability")))+ (select("isUsedToAccomplish", N("SystemOperationalCapabilityTask")))+);
N("Task") ::= N("OperationalCapabilityTask");
N("Task") ::= N("SystemOperationalCapabilityTask");
N("Task") ::= N("PATask");
N("Task") ::= (select("levelIdentifier", N("String")) select("references", N("String")) select("cost", N("String")) (select("correspondsTo", N("PATask")))+ (select("isSupportedBy", N("ArchitectureTask")))+ (select("isTheSourceOfNeedFor", N("InformationExchangeRequirement")))+ (select("isTheDestinationOfNeedFor", N("InformationExchangeRequirement")))+ (select("isCitedFor", N("SystemFunctionTraceabilityElement")))+);
N("ArchitectureTask") ::= (select("name", N("String")) select("description", N("String")) select("view", N("String")));
N("OperationalCapabilityTask") ::= select("isAccomplishedA", N("SystemOperationalCapabilityTask"));
N("SystemOperationalCapabilityTask") ::= (select("levelIdentifier", N("String")) select("references", N("String")) select("cost", N("String")) (select("correspondsTo", N("PATask")))+ (select("isSupportedBy", N("ArchitectureTask")))+ (select("isTheSourceOfNeedFor", N("InformationExchangeRequirement")))+ (select("isTheDestinationOfNeedFor", N("InformationExchangeRequirement")))+ (select("isCitedFor", N("SystemFunctionTraceabilityElement")))+);
N("PATask") ::= (select("levelIdentifier", N("String")) select("references", N("String")) select("cost", N("String")) (select("correspondsTo", N("PATask")))+ (select("isSupportedBy", N("ArchitectureTask")))+ (select("isTheSourceOfNeedFor", N("InformationExchangeRequirement")))+ (select("isTheDestinationOfNeedFor", N("InformationExchangeRequirement")))+ (select("isCitedFor", N("SystemFunctionTraceabilityElement")))+);
