N("DoDAFModel") ::= ((select("document", N("Document")))+ (select("sftm", N("SystemFunctionTraceabilityMatrix")))+ (select("sd", N("SystemDocument")))+ (select("am", N("AM")))+ (select("system", N("System")))+ (select("task", N("Task")))+ (select("capability", N("Capability")))+ (select("capabilityDocument", N("CapabilityDocument")))+ (select("systemCapability", N("SystemCapability")))+);
N("Document") ::= N("SystemFunctionTraceabilityMatrix");
N("Document") ::= (select("type", N("String")) (select("cites", N("CapabilityDocument")))+ (select("describes", N("SystemDocument")))+ (select("records", N("ArchitectureDocument")))+ (select("isThePrimaryReferenceFor", N("PA")))+);
N("SystemFunctionTraceabilityMatrix") ::= (select("isDefinedBy", N("SystemFunctionTraceabilityElement")))+;
N("SystemFunctionTraceabilityElement") ::= (select("systemFunction", N("SystemFunction")) select("operationalActivity", N("Task")) select("systemProcessActivity", N("SystemPA")) select("system", N("System")) select("capability", N("Capability")) select("supportStatusCode", N("SupportStatusCode")));
N("SystemDocument") ::= (select("name", N("String")) select("description", N("String")) select("view", N("String")));
N("ArchitectureDocument") ::= (select("name", N("String")) select("description", N("String")) select("view", N("String")));
N("PA") ::= N("SystemFunction");
