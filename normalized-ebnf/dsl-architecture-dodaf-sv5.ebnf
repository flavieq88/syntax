N("SystemCapability") ::= (select("isCitedIn", N("Capability")))+;
N("NetworkCapability") ::= ((select("isPerformedBy", N("SystemCapability")))+ (select("isOrdinateFor", N("Capability")))+ (select("isSubordinateOf", N("Capability")))+ (select("isPerformedByNC", N("NetworkCapability")))+ (select("isPerformedByNLC", N("NodeLinkCapability")))+ (select("isPerformedBySC", N("SystemCapability")))+ (select("isCitedInCD", N("CapabilityDocument")))+ (select("isUsedInMICN", N("MaterielItemCapabilityNorm")))+ (select("isUsedInOTCN", N("OrganizationTypeCapabilityNorm")))+ (select("isAttainedFor", N("RequiredInformationTechnologyCapability")))+);
N("NodeLinkCapability") ::= ((select("isPerformedBy", N("SystemCapability")))+ (select("isOrdinateFor", N("Capability")))+ (select("isSubordinateOf", N("Capability")))+ (select("isPerformedByNC", N("NetworkCapability")))+ (select("isPerformedByNLC", N("NodeLinkCapability")))+ (select("isPerformedBySC", N("SystemCapability")))+ (select("isCitedInCD", N("CapabilityDocument")))+ (select("isUsedInMICN", N("MaterielItemCapabilityNorm")))+ (select("isUsedInOTCN", N("OrganizationTypeCapabilityNorm")))+ (select("isAttainedFor", N("RequiredInformationTechnologyCapability")))+);
