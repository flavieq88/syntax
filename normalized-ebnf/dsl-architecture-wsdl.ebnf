N("Port") ::= (select("name", N("String")) select("service", N("Service")) select("binding", N("Binding")));
N("Service") ::= (select("name", N("String")) (select("ports", N("Port")))+);
N("Param") ::= N("Input");
N("Param") ::= N("Output");
N("Param") ::= (select("name", N("String")) select("message", N("Message")));
N("Input") ::= select("operation", N("Operation"));
N("Output") ::= select("operation", N("Operation"));
N("PortType") ::= (select("name", N("String")) (select("operations", N("Operation")))+ (select("bindings", N("Binding")))+);
N("Operation") ::= (select("name", N("String")) select("input", N("Input")) select("output", N("Output")) select("type", N("PortType")) (select("faults", N("Fault")))+);
N("StartWithExtensions") ::= N("Binding");
N("StartWithExtensions") ::= N("BindingFault");
N("StartWithExtensions") ::= N("BindingOperation");
N("StartWithExtensions") ::= (N("Binding") | N("BindingFault") | N("BindingOperation"));
N("Binding") ::= (select("name", N("String")) (select("ports", N("Port")))+ select("type", N("PortType")) (select("operations", N("BindingOperation")))+);
N("BindingFault") ::= (select("operation", N("BindingOperation")) select("binding", N("Fault")));
N("BindingOperation") ::= (select("name", N("String")) select("bind", N("Binding")) select("binding", N("Operation")) select("input", N("StartWithExtensions")) select("output", N("StartWithExtensions")) (select("faults", N("BindingFault")))+);
N("Fault") ::= (select("name", N("String")) select("operation", N("Operation")) select("message", N("Message")));
N("Message") ::= (select("name", N("String")) (select("params", N("Param")))+ (select("faults", N("Fault")))+ (select("parts", N("Part")))+);
N("Part") ::= (select("name", N("String")) select("message", N("Message")));
N("String") ::= value("string");
