N("MultyPartyCollaboration") ::= (select("partners", N("BusinessPartnerRole")))+;
N("BusinessPartnerRole") ::= (select("collaboration", N("MultyPartyCollaboration")) select("transition", N("Transaction")) (select("performers", N("Performs")))+);
N("Performs") ::= (select("performedBy", N("BusinessPartnerRole")) select("collaboration", N("BinaryCollaboration")) select("role", N("AuthorizedRole")));
N("AuthorizedRole") ::= (select("isInitiator", N("Boolean")) (select("performers", N("Performs")))+);
N("Transaction") ::= (select("onInitiation", N("String")) select("conditionGuard", N("String")) select("conditionExpression", N("String")) select("from", N("BusinessState")) select("to", N("BusinessState")));
N("BinaryCollaboration") ::= (select("pattern", N("String")) select("timeToPerform", N("String")) select("preCondition", N("String")) select("postCondition", N("String")) select("beginsWhen", N("String")) select("endsWhen", N("String")) (select("roles", N("Performs")))+ (select("transitions", N("Transaction")))+ (select("states", N("BusinessState")))+);
N("BusinessState") ::= N("Start");
N("BusinessState") ::= N("Fork");
N("BusinessState") ::= N("Join");
N("BusinessState") ::= N("CompletionState");
N("BusinessState") ::= N("BusinessActivity");
N("Start") ::= (select("collaboration", N("BinaryCollaboration")) select("from", N("AuthorizedRole")) select("to", N("AuthorizedRole")));
N("Fork") ::= select("waitForAll", N("String"));
N("Join") ::= (select("collaboration", N("BinaryCollaboration")) select("from", N("AuthorizedRole")) select("to", N("AuthorizedRole")));
N("CompletionState") ::= N("Failure");
N("CompletionState") ::= N("Success");
N("CompletionState") ::= select("guardCondition", N("String"));
N("Failure") ::= (select("guardCondition", N("String")));
N("Success") ::= (select("guardCondition", N("String")));
N("BusinessActivity") ::= N("BusinessTransactionActivity");
N("BusinessActivity") ::= N("CollaborationActivity");
N("BusinessTransactionActivity") ::= (select("timeToPerform", N("String")) select("isConcurrent", N("Boolean")) select("isLegallyBinding", N("Boolean")) select("use", N("BusinessTransaction")));
N("CollaborationActivity") ::= select("use", N("BinaryCollaboration"));
N("BusinessTransaction") ::= (select("pattern", N("String")) select("isGuaranteedDeliveryRequired", N("Boolean")) select("preCondition", N("String")) select("postCondition", N("String")) select("beginsWhen", N("String")) select("endsWhen", N("String")) select("requester", N("RequestingBusinessActivity")) select("responder", N("RespondingBusinessActivity")));
N("BusinessAction") ::= N("RequestingBusinessActivity");
N("BusinessAction") ::= N("RespondingBusinessActivity");
N("RequestingBusinessActivity") ::= (select("timeToAcknowledgeAcceptance", N("String")) select("transaction", N("BusinessTransaction")) select("documentEnvelope", N("DocumentEnvelope")));
N("RespondingBusinessActivity") ::= (select("transaction", N("BusinessTransaction")) select("documentEnvelope", N("DocumentEnvelope")));
N("DocumentSecurity") ::= N("DocumentEnvelope");
N("DocumentSecurity") ::= N("Attachment");
N("DocumentEnvelope") ::= (select("isPositiveResponse", N("Boolean")) select("requesting", N("RequestingBusinessActivity")) select("responding", N("RespondingBusinessActivity")) (select("attachements", N("Attachment")))+ select("document", N("BusinessDocument")));
N("Attachment") ::= (select("mimeType", N("String")) select("specification", N("String")) select("version", N("String")) select("envelope", N("DocumentEnvelope")) select("document", N("BusinessDocument")));
N("BusinessDocument") ::= (select("specificationLocation", N("String")) select("specificationElement", N("String")) select("conditionExpression", N("String")) (select("envelopes", N("DocumentEnvelope")))+ (select("attachments", N("Attachment")))+);
N("Boolean") ::= ("true" | "false");
N("String") ::= value("string");
