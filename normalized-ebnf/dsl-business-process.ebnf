N("Namespace") ::= N("Task");
N("Namespace") ::= N("DataSet");
N("Task") ::= N("SimpleTask");
N("Task") ::= N("CoumpoundTask");
N("DataSet") ::= N("OutputSet");
N("DataSet") ::= N("InputSet");
N("Parameter") ::= N("DataElement");
N("DataElement") ::= N("Input");
N("DataElement") ::= N("Output");
N("ModelElement") ::= N("Flow");
N("ModelElement") ::= N("ControlPoint");
N("Flow") ::= N("DataFlow");
N("Flow") ::= N("ControlFlow");
N("Flow") ::= (N("DataFlow") | N("ControlFlow"));
N("DataFlow") ::= epsilon;
N("ControlFlow") ::= epsilon;
N("ControlPoint") ::= (select("sink", N("ControlFlow")))+;
N("Input") ::= (select("sink", N("DataFlow")) select("source", N("DataFlow")));
N("Output") ::= N("Exception");
N("OutputSet") ::= (select("containsOutput", N("Output")))+;
N("InputSet") ::= (select("containsInput", N("Input")))+;
N("Exception") ::= epsilon;
N("SimpleTask") ::= N("InvokerTask");
N("SimpleTask") ::= N("TerminatorTask");
N("SimpleTask") ::= N("ApplicationTask");
N("SimpleTask") ::= (N("InvokerTask") | N("TerminatorTask") | N("ApplicationTask"));
N("CoumpoundTask") ::= N("MutliTask");
N("CoumpoundTask") ::= ((select("containsTask", N("Task")))+ (select("containsFlow", N("Flow")))+ select("realizes", N("BusinessProcess")));
N("MutliTask") ::= ((select("containsTask", N("Task")))+ (select("containsFlow", N("Flow")))+ select("realizes", N("BusinessProcess")));
N("InvokerTask") ::= (select("invokes", N("Task")))+;
N("TerminatorTask") ::= (select("terminates", N("Task")))+;
N("ApplicationTask") ::= N("Decision");
N("ApplicationTask") ::= N("Clock");
N("ApplicationTask") ::= N("SendCommunication");
N("ApplicationTask") ::= N("ReceiveCommunication");
N("ApplicationTask") ::= N("BusinessProcess");
N("ApplicationTask") ::= (N("Decision") | N("Clock") | N("SendCommunication") | N("ReceiveCommunication") | N("BusinessProcess"));
N("Decision") ::= epsilon;
N("Clock") ::= epsilon;
N("SendCommunication") ::= epsilon;
N("ReceiveCommunication") ::= epsilon;
N("BusinessProcess") ::= epsilon;
N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
N("String") ::= value("string");
