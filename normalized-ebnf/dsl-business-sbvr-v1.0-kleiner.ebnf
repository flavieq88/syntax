N("Root") ::= (select("elements", N("Element")))+;
N("Element") ::= N("Representation");
N("Element") ::= N("Text");
N("Element") ::= N("Meaning");
N("Element") ::= N("Role");
N("Element") ::= N("BindableTarget");
N("Element") ::= N("RoleBinding");
N("Element") ::= select("objectName", N("String"));
N("Representation") ::= N("Designation");
N("Representation") ::= select("meaning", N("Meaning"));
N("Designation") ::= select("text", N("Text"));
N("Text") ::= select("value", N("String"));
N("Meaning") ::= N("Concept");
N("Meaning") ::= N("LogicalFormulation");
N("Meaning") ::= (select("representations", N("Representation")))+;
N("Concept") ::= N("NounConcept");
N("Concept") ::= N("FactType");
N("Concept") ::= (N("NounConcept") | N("FactType"));
N("NounConcept") ::= N("ObjectType");
N("NounConcept") ::= N("IndividualConcept");
N("NounConcept") ::= N("DataType");
N("NounConcept") ::= (N("ObjectType") | N("IndividualConcept") | N("DataType"));
N("ObjectType") ::= (select("specializes", N("ObjectType")) (select("generalizes", N("ObjectType")))+);
N("IndividualConcept") ::= select("instanceOf", N("ObjectType"));
N("DataType") ::= N("NonEmptyString");
N("DataType") ::= N("NonNegativeInteger");
N("DataType") ::= (N("NonEmptyString") | N("NonNegativeInteger"));
N("NonEmptyString") ::= select("value", N("String"));
N("NonNegativeInteger") ::= select("value", N("Integer"));
N("FactType") ::= N("BinaryFactType");
N("BinaryFactType") ::= N("IsPropertyOfFactType");
N("BinaryFactType") ::= N("AssociativeFactType");
N("BinaryFactType") ::= N("CategorizationFactType");
N("BinaryFactType") ::= N("ObjectificationFactType");
N("BinaryFactType") ::= (select("role1", N("FactTypeRole")) select("role2", N("FactTypeRole")));
N("IsPropertyOfFactType") ::= (select("role1", N("FactTypeRole")) select("role2", N("FactTypeRole")));
N("AssociativeFactType") ::= (select("role1", N("FactTypeRole")) select("role2", N("FactTypeRole")));
N("CategorizationFactType") ::= (select("role1", N("FactTypeRole")) select("role2", N("FactTypeRole")));
N("ObjectificationFactType") ::= (select("role1", N("FactTypeRole")) select("role2", N("FactTypeRole")));
N("Role") ::= N("FactTypeRole");
N("Role") ::= select("nounConcept", N("NounConcept"));
N("FactTypeRole") ::= select("nounConcept", N("NounConcept"));
N("LogicalFormulation") ::= N("AtomicFormulation");
N("LogicalFormulation") ::= N("NecessityFormulation");
N("LogicalFormulation") ::= N("Quantification");
N("LogicalFormulation") ::= (N("AtomicFormulation") | N("NecessityFormulation") | N("Quantification"));
N("AtomicFormulation") ::= N("BinaryAtomicFormulation");
N("AtomicFormulation") ::= select("isBasedOn", N("FactType"));
N("BinaryAtomicFormulation") ::= (select("roleBinding1", N("RoleBinding")) select("roleBinding2", N("RoleBinding")));
N("NecessityFormulation") ::= epsilon;
N("Quantification") ::= N("UniversalQuantification");
N("Quantification") ::= N("AtLeastNQuantification");
N("Quantification") ::= N("ExactlyNQuantification");
N("Quantification") ::= N("AtMostNQuantification");
N("Quantification") ::= (select("introducedVariable", N("Variable")) select("scopesOver", N("LogicalFormulation")));
N("UniversalQuantification") ::= (select("introducedVariable", N("Variable")) select("scopesOver", N("LogicalFormulation")));
N("AtLeastNQuantification") ::= select("minCardinality", N("NonNegativeInteger"));
N("ExactlyNQuantification") ::= select("cardinality", N("NonNegativeInteger"));
N("AtMostNQuantification") ::= select("maxCardinality", N("NonNegativeInteger"));
N("BindableTarget") ::= N("Variable");
N("Variable") ::= select("rangesOver", N("ObjectType"));
N("RoleBinding") ::= (select("occursIn", N("AtomicFormulation")) select("isOf", N("FactType")) select("bindsTo", N("BindableTarget")));
N("String") ::= value("string");
N("Integer") ::= value("int");
