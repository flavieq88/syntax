N("Project") ::= (select("name", N("String")) select("basedir", N("String")) select("description", N("String")) select("default", N("Target")) select("path", N("Path")) (select("properties", N("Property")))+ (select("taskdef", N("TaskDef")))+ (select("targets", N("Target")))+);
N("Property") ::= N("PropertyName");
N("Property") ::= N("PropertyFile");
N("Property") ::= N("PropertyEnv");
N("PropertyName") ::= N("PropertyValue");
N("PropertyName") ::= N("PropertyLocation");
N("PropertyValue") ::= select("value", N("String"));
N("PropertyLocation") ::= select("location", N("String"));
N("PropertyFile") ::= select("file", N("String"));
N("PropertyEnv") ::= select("environment", N("String"));
N("Target") ::= (select("name", N("String")) select("description", N("String")) select("unless", N("String")) select("ifCondition", N("String")) (select("depends", N("Target")))+ (select("tasks", N("Task")))+);
N("Pattern") ::= N("Basic");
N("Pattern") ::= N("Set");
N("Basic") ::= N("Mapper");
N("Basic") ::= N("InExcludes");
N("Basic") ::= N("FileList");
N("Basic") ::= N("Filter");
N("Basic") ::= N("FiltersFile");
N("Basic") ::= N("PathElement");
N("Mapper") ::= (select("type", N("String")) select("classname", N("String")) select("classpath", N("String")) select("classpathref", N("String")) select("from", N("String")) select("to", N("String")));
N("InExcludes") ::= N("Includes");
N("InExcludes") ::= N("Excludes");
N("InExcludes") ::= N("IncludesFile");
N("InExcludes") ::= N("ExcludesFile");
N("Includes") ::= (select("name", N("String")) select("ifCondition", N("String")) select("unless", N("String")));
N("Excludes") ::= (select("name", N("String")) select("ifCondition", N("String")) select("unless", N("String")));
N("IncludesFile") ::= (select("name", N("String")) select("ifCondition", N("String")) select("unless", N("String")));
N("ExcludesFile") ::= (select("name", N("String")) select("ifCondition", N("String")) select("unless", N("String")));
N("FileList") ::= (select("dir", N("String")) select("files", N("String")));
N("Filter") ::= (select("token", N("String")) select("value", N("String")));
N("FiltersFile") ::= select("file", N("String"));
N("PathElement") ::= (select("path", N("String")) select("location", N("String")));
N("Set") ::= N("PatternSet");
N("Set") ::= N("FileSet");
N("Set") ::= N("FilterSet");
N("Set") ::= N("Path");
N("Set") ::= N("ClassPath");
N("PatternSet") ::= (select("inexcludes", N("InExcludes")))+;
N("FileSet") ::= (select("dir", N("String")) (select("patternset", N("PatternSet")))+ (select("include", N("Includes")))+ (select("exclude", N("Excludes")))+);
N("FilterSet") ::= (select("starttoken", N("String")) select("endtoken", N("String")) (select("filter", N("Filter")))+ (select("filtersfile", N("FiltersFile")))+);
N("Path") ::= (select("id", N("String")) select("refid", N("String")) select("path", N("Path")) (select("pathElement", N("PathElement")))+ (select("fileset", N("FileSet")))+);
N("ClassPath") ::= (select("refid", N("String")) (select("pathElement", N("PathElement")))+ (select("fileset", N("FileSet")))+);
N("Task") ::= N("NewTask");
N("Task") ::= N("PreDefinedTask");
N("TaskDef") ::= (select("name", N("String")) select("classname", N("String")));
N("NewTask") ::= (select("taskName", N("TaskDef")) (select("attributes", N("Attribut")))+);
N("Attribut") ::= (select("name", N("String")) select("value", N("String")));
N("PreDefinedTask") ::= N("ExecutionTask");
N("PreDefinedTask") ::= N("MiscellaneousTask");
N("PreDefinedTask") ::= N("CompileTask");
N("PreDefinedTask") ::= N("DocumentationTask");
N("PreDefinedTask") ::= N("ArchiveTask");
N("PreDefinedTask") ::= N("FileTask");
N("ExecutionTask") ::= N("Exec");
N("ExecutionTask") ::= N("Java");
N("Exec") ::= (select("executable", N("String")) select("dir", N("String")));
N("Java") ::= (select("classname", N("String")) select("jar", N("String")) select("fork", N("String")) select("classPath", N("ClassPath")));
N("MiscellaneousTask") ::= N("Echo");
N("MiscellaneousTask") ::= N("Tstamp");
N("Echo") ::= (select("message", N("String")) select("file", N("String")) select("append", N("String")));
N("Tstamp") ::= (select("format", N("FormatTstamp")))+;
N("FormatTstamp") ::= (select("property", N("String")) select("pattern", N("String")) select("offset", N("String")) select("unit", N("String")) select("locale", N("String")));
N("CompileTask") ::= N("Javac");
N("Javac") ::= (select("srcdir", N("String")) select("destdir", N("String")) select("debug", N("String")) select("fork", N("String")) select("optimize", N("String")) select("deprecation", N("String")) (select("inExcludes", N("InExcludes")))+ select("classPath", N("ClassPath")));
N("DocumentationTask") ::= N("Javadoc");
N("Javadoc") ::= (select("sourcepath", N("String")) select("destdir", N("String")) select("packagenames", N("String")) select("defaultexcludes", N("String")) select("author", N("String")) select("version", N("String")) select("use", N("String")) select("windowtitle", N("String")));
N("ArchiveTask") ::= N("Jar");
N("Jar") ::= (select("jarfile", N("String")) select("basedir", N("String")) select("compress", N("String")) select("encoding", N("String")) select("manifest", N("String")));
N("FileTask") ::= N("Mkdir");
N("FileTask") ::= N("Copy");
N("FileTask") ::= N("Delete");
N("Mkdir") ::= select("dir", N("String"));
N("Copy") ::= (select("file", N("String")) select("presservelastmodified", N("String")) select("tofile", N("String")) select("todir", N("String")) select("overwrite", N("String")) select("filtering", N("String")) select("flatten", N("String")) select("includeEmptyDirs", N("String")) select("fileset", N("FileSet")) select("filterset", N("FilterSet")) select("mapper", N("Mapper")));
N("Delete") ::= (select("file", N("String")) select("dir", N("String")) select("verbose", N("String")) select("quiet", N("String")) select("failonerror", N("String")) select("includeEmptyDirs", N("String")) select("includes", N("String")) select("includesfile", N("String")) select("excludes", N("String")) select("excludesfile", N("String")) select("defaultexcludes", N("String")));
N("String") ::= value("string");
