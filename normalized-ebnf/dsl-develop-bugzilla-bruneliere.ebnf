N("Integer") ::= value("int");
N("String") ::= value("string");
N("Boolean") ::= ("true" | "false");
N("ErrorType") ::= (select("et_null", epsilon) | select("et_NotFound", epsilon) | select("et_NotPermitted", epsilon) | select("et_InvalidBugId", epsilon));
N("SeverityType") ::= (select("st_null", epsilon) | select("st_blocker", epsilon) | select("st_critical", epsilon) | select("st_major", epsilon) | select("st_normal", epsilon) | select("st_minor", epsilon) | select("st_trivial", epsilon) | select("st_enhancement", epsilon));
N("StatusType") ::= (select("st_null", epsilon) | select("st_UNCONFIRMED", epsilon) | select("st_NEW", epsilon) | select("st_ASSIGNED", epsilon) | select("st_REOPENED", epsilon) | select("st_RESOLVED", epsilon) | select("st_VERIFIED", epsilon) | select("st_CLOSED", epsilon));
N("OperatingSystemType") ::= (select("ost_null", epsilon) | select("ost_all", epsilon) | select("ost_Windows 3.1", epsilon) | select("ost_Windows 95", epsilon) | select("ost_Windows 98", epsilon) | select("ost_Windows ME", epsilon) | select("ost_Windows 2000", epsilon) | select("ost_Windows NT", epsilon) | select("ost_Windows XP", epsilon) | select("ost_Windows Vista", epsilon) | select("ost_Windows Server 2003", epsilon) | select("ost_MacSystem 7", epsilon) | select("ost_MacSystem 7.5", epsilon) | select("ost_MacSystem 7.6.1", epsilon) | select("ost_MacSystem 8.0", epsilon) | select("ost_MacSystem 8.5", epsilon) | select("ost_MacSystem 8.6", epsilon) | select("ost_MacSystem 9.x", epsilon) | select("ost_Mac OS X 10.0", epsilon) | select("ost_Mac OS X 10.1", epsilon) | select("ost_Mac OS X 10.2", epsilon) | select("ost_Mac OS X 10.3", epsilon) | select("ost_Linux", epsilon) | select("ost_BDS/OS", epsilon) | select("ost_FreeBSD", epsilon) | select("ost_NetBSD", epsilon) | select("ost_OpenBSD", epsilon) | select("ost_AIX", epsilon) | select("ost_BeOS", epsilon) | select("ost_HP-UX", epsilon) | select("ost_IRIX", epsilon) | select("ost_Neutrino", epsilon) | select("ost_OpenVMS", epsilon) | select("ost_OS/2", epsilon) | select("ost_OSF/1", epsilon) | select("ost_Solaris", epsilon) | select("ost_SunOS", epsilon) | select("ost_other", epsilon));
N("PriorityType") ::= (select("pt_null", epsilon) | select("pt_P1", epsilon) | select("pt_P2", epsilon) | select("pt_P3", epsilon) | select("pt_P4", epsilon) | select("pt_P5", epsilon));
N("ReportedPlatformType") ::= (select("rpt_null", epsilon) | select("rpt_all", epsilon) | select("rpt_DEC", epsilon) | select("rpt_HP", epsilon) | select("rpt_Macintosh", epsilon) | select("rpt_PC", epsilon) | select("rpt_SGI", epsilon) | select("rpt_Sun", epsilon) | select("rpt_other", epsilon));
N("ResolutionType") ::= (select("rt_null", epsilon) | select("rt_FIXED", epsilon) | select("rt_INVALID", epsilon) | select("rt_WONTFIX", epsilon) | select("rt_LATER", epsilon) | select("rt_REMIND", epsilon) | select("rt_DUPLICATE", epsilon) | select("rt_WORKSFORME", epsilon) | select("rt_MOVED", epsilon));
N("BugzillaRoot") ::= (select("version", N("String")) select("urlbase", N("String")) select("maintainer", N("String")) select("exporter", N("String")) (select("bugs", N("Bug")))+);
N("Bug") ::= (select("bug_bugzillaRoot", N("BugzillaRoot")) select("error", N("ErrorType")) select("bug_id", N("String")) select("exporter", N("String")) select("urlbase", N("String")) select("bug_status", N("StatusType")) select("resolution", N("ResolutionType")) select("product", N("String")) select("priority", N("PriorityType")) select("version", N("String")) select("rep_platform", N("ReportedPlatformType")) select("assigned_to", N("String")) select("delta_ts", N("String")) select("component", N("String")) select("reporter", N("String")) select("target_milestone", N("String")) select("bug_severity", N("SeverityType")) select("creation_ts", N("String")) select("qa_contact", N("String")) select("status_whiteboard", N("String")) select("op_sys", N("OperatingSystemType")) select("bug_file_loc", N("String")) select("short_desc", N("String")) (select("keywords", N("Keywords")))+ (select("dependson", N("Dependson")))+ (select("blocks", N("Blocks")))+ (select("cc", N("Cc")))+ (select("long_desc", N("LongDesc")))+ (select("attachment", N("Attachment")))+);
N("StringElt") ::= N("Keywords");
N("StringElt") ::= N("Dependson");
N("StringElt") ::= N("Blocks");
N("StringElt") ::= N("Cc");
N("Keywords") ::= (select("value", N("String")));
N("Dependson") ::= (select("value", N("String")));
N("Blocks") ::= (select("value", N("String")));
N("Cc") ::= (select("value", N("String")));
N("LongDesc") ::= (select("isPrivate", N("Boolean")) select("who", N("String")) select("bug_when", N("String")) select("thetext", N("String")));
N("Attachment") ::= (select("isObsolete", N("Boolean")) select("isPatch", N("Boolean")) select("isPrivate", N("Boolean")) select("id", N("String")) select("date", N("String")) select("desc", N("String")) select("type", N("String")) select("data", N("String")));
