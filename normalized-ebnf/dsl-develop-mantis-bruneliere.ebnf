N("RelationshipType") ::= (select("rt_related to", epsilon) | select("rt_parent of", epsilon) | select("rt_child of", epsilon) | select("rt_duplicate of", epsilon) | select("rt_has duplicate", epsilon));
N("MantisRoot") ::= (select("issues", N("Issue")))+;
N("IdentifiedElt") ::= N("ValueWithId");
N("IdentifiedElt") ::= N("Relationship");
N("IdentifiedElt") ::= N("Issue");
N("PrivateElt") ::= N("Issue");
N("PrivateElt") ::= N("Note");
N("Issue") ::= (select("i_mantisRoot", N("MantisRoot")) select("project", N("ValueWithId")) select("category", N("String")) select("priority", N("ValueWithId")) select("severity", N("ValueWithId")) select("status", N("ValueWithId")) select("reporter", N("Person")) select("summary", N("String")) select("description", N("String")) select("version", N("String")) select("build", N("String")) select("platform", N("String")) select("os", N("String")) select("osVersion", N("String")) select("reproducibility", N("ValueWithId")) select("stepsToReproduce", N("String")) select("additionalInfo", N("String")) select("dateSubmitted", N("Integer")) select("assignedTo", N("Person")) select("projection", N("ValueWithId")) select("eta", N("ValueWithId")) select("resolution", N("ValueWithId")) select("fixedInVersion", N("String")) (select("attachments", N("Attachment")))+ (select("relationships", N("Relationship")))+ (select("notes", N("Note")))+ select("lastUpdate", N("Integer")));
N("ValueWithId") ::= N("Person");
N("ValueWithId") ::= select("value", N("String"));
N("Person") ::= select("login", N("String"));
N("Relationship") ::= select("type", N("RelationshipType"));
N("TimeStampedElt") ::= N("Attachment");
N("TimeStampedElt") ::= N("Note");
N("Note") ::= (select("author", N("Person")) select("text", N("String")));
N("Attachment") ::= (select("filename", N("String")) select("size", N("Integer")) select("contentType", N("String")) select("downloadUrl", N("String")));
N("Integer") ::= value("int");
N("String") ::= value("string");
N("Boolean") ::= ("true" | "false");
