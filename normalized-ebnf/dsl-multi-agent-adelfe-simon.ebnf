N("Classifier") ::= N("Environnement");
N("Classifier") ::= N("Element");
N("Classifier") ::= (N("Environnement") | N("Element"));
N("Environnement") ::= select("element", N("Element"));
N("Element") ::= (select("environnement", N("Environnement")) select("action", N("CooperativeAgent")) select("perception", N("CooperativeAgent")));
N("CooperativeAgent") ::= (select("elementA", N("Element")) select("elementP", N("Element")) (select("representation", N("Representation")))+ (select("skill", N("Skill")))+ (select("aptitude", N("Aptitude")))+ (select("characteristic", N("Characteristic")))+ (select("communication", N("Communication")))+ (select("observes", N("CooperationRules")))+);
N("Representation") ::= (select("cooperativeAgentR", N("CooperativeAgent")) select("element", N("Element")));
N("Skill") ::= select("cooperativeAgentS", N("CooperativeAgent"));
N("Aptitude") ::= select("cooperativeAgentA", N("CooperativeAgent"));
N("Characteristic") ::= select("cooperativeAgentCha", N("CooperativeAgent"));
N("Communication") ::= (select("cooperativeAgentCom", N("CooperativeAgent")) (select("aip", N("AIP")))+);
N("AIP") ::= epsilon;
N("CooperationRules") ::= (select("detects", N("NCS")))+;
N("NCS") ::= N("Incomprehension");
N("NCS") ::= N("Ambiguity");
N("NCS") ::= N("Incompetence");
N("NCS") ::= N("Unproductiveness");
N("NCS") ::= N("Concurrency");
N("NCS") ::= N("Conflict");
N("NCS") ::= N("Uselessness");
N("NCS") ::= select("cooperationRules", N("CooperationRules"));
N("Incomprehension") ::= (select("cooperationRules", N("CooperationRules")));
N("Ambiguity") ::= (select("cooperationRules", N("CooperationRules")));
N("Incompetence") ::= (select("cooperationRules", N("CooperationRules")));
N("Unproductiveness") ::= (select("cooperationRules", N("CooperationRules")));
N("Concurrency") ::= (select("cooperationRules", N("CooperationRules")));
N("Conflict") ::= (select("cooperationRules", N("CooperationRules")));
N("Uselessness") ::= (select("cooperationRules", N("CooperationRules")));
