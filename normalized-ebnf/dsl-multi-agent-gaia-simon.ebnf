N("OrganizationalStructure") ::= (select("organization", N("Organization")))+;
N("Organization") ::= (select("collaborates", N("Organization")) select("interacts", N("Organization")) (select("member", N("AgentType")))+ (select("observes", N("OrganizationalRule")))+);
N("OrganizationalRule") ::= N("SafetyRule");
N("OrganizationalRule") ::= N("LivenessRule");
N("OrganizationalRule") ::= (N("SafetyRule") | N("LivenessRule"));
N("SafetyRule") ::= epsilon;
N("LivenessRule") ::= epsilon;
N("AgentType") ::= ((select("provides", N("Service")))+ select("collaborates", N("AgentType")) select("agentType", N("AgentType")) (select("plays", N("Role")))+);
N("Service") ::= (select("inputs", N("String")) select("outputs", N("String")) select("pre-conditions", N("String")) select("post-conditions", N("String")));
N("Role") ::= ((select("activity", N("Activity")))+ (select("communication", N("Communication")))+ (select("responsibility", N("Responsibility")))+ select("actsOn", N("AssociationConnector")));
N("Activity") ::= epsilon;
N("Responsibility") ::= N("LivenessProperty");
N("Responsibility") ::= N("SafetyProperty");
N("Responsibility") ::= (N("LivenessProperty") | N("SafetyProperty"));
N("LivenessProperty") ::= epsilon;
N("SafetyProperty") ::= epsilon;
N("AssociationConnector") ::= ((select("actsOn", N("Resource")))+ select("role", N("Role")) (select("permission", N("Permission")))+);
N("Permission") ::= select("association", N("AssociationConnector"));
N("Resource") ::= (select("name", N("String")) select("description", N("String")) (select("permitted_action", N("Action")))+ select("environnement", N("Environnement")));
N("Environnement") ::= (select("resource", N("Resource")))+;
N("Action") ::= select("type", N("String"));
N("Communication") ::= ((select("observes", N("OrganizationalRule")))+ select("protocol", N("Protocol")));
N("Protocol") ::= (select("name", N("String")) select("initiator", N("String")) select("partner", N("String")) select("inputs", N("String")) select("outputs", N("String")) select("description", N("String")));
N("String") ::= value("string");
