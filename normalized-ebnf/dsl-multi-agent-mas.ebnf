N("String") ::= value("string");
N("Agent") ::= ((select("service", N("Service")))+ (select("non_Functionnal_Requirement", N("Non Functionnal Requirement")))+ (select("requirement", N("Requirement")))+ select("belongs", N("Organization")) (select("cooperationRules", N("CooperationRules")))+ select("fipa_Platform_Agent", N("FIPA-Platform Agent")) select("role", N("Role")) select("representation", N("Representation")) select("characteristic", N("Characteristic")) select("skill", N("Skill")) select("aptitude", N("Aptitude")));
N("Service") ::= (select("inputs", N("String")) select("outputs", N("String")) select("pre-conditions", N("String")) select("post-conditions", N("String")));
N("Non Functionnal Requirement") ::= epsilon;
N("Requirement") ::= epsilon;
N("Organization") ::= ((select("observes", N("Organizational Structure")))+ select("organizational_Structure", N("Organizational Structure")));
N("Organizational Structure") ::= N("SafetyRule");
N("Organizational Structure") ::= N("LivenessRule");
N("Organizational Structure") ::= (select("organization", N("Organization")))+;
N("SafetyRule") ::= epsilon;
N("LivenessRule") ::= epsilon;
N("CooperationRules") ::= select("ncs", N("NCS"));
N("NCS") ::= select("cooperationRules", N("CooperationRules"));
N("FIPA-Platform Agent") ::= (select("agentF", N("Agent")) (select("fipa_Platform_Task", N("FIPA-Platform Task")))+);
N("FIPA-Platform Task") ::= (select("fipa_Platform_AgentF", N("FIPA-Platform Agent")) select("task", N("Task")));
N("Task") ::= (select("name", N("String")) select("fipa_Platform_TaskT", N("FIPA-Platform Task")));
N("Role") ::= (select("agentR", N("Agent")) (select("activity", N("Task")))+ (select("actsOn", N("Resource")))+ (select("scenario", N("Scenario")))+ (select("participant", N("Communication")))+ (select("has", N("Responsibility")))+);
N("Representation") ::= (select("agentRep", N("Agent")) select("ontology", N("Ontology")) select("environnement", N("Environnement")));
N("Characteristic") ::= select("agentC", N("Agent"));
N("Skill") ::= select("agentS", N("Agent"));
N("Aptitude") ::= select("agentA", N("Agent"));
N("Ontology") ::= N("Concept");
N("Ontology") ::= N("Predicat");
N("Ontology") ::= N("Action");
N("Ontology") ::= select("environnement", N("Environnement"));
N("Concept") ::= (select("environnement", N("Environnement")));
N("Predicat") ::= (select("environnement", N("Environnement")));
N("Action") ::= (select("environnement", N("Environnement")));
N("Environnement") ::= select("resource", N("Resource"));
N("Responsibility") ::= N("LivenessProperty");
N("Responsibility") ::= N("SafetyProperty");
N("Responsibility") ::= (N("LivenessProperty") | N("SafetyProperty"));
N("LivenessProperty") ::= epsilon;
N("SafetyProperty") ::= epsilon;
N("Resource") ::= (select("name", N("String")) select("environnement", N("Environnement")) select("action", N("Action")));
N("Communication") ::= (select("name", N("String")) select("Exchanged Knoledge", N("Ontology")) (select("scenario", N("Scenario")))+ select("aip", N("AIP")) (select("message", N("Message")))+);
N("AIP") ::= (select("name", N("String")) select("performative", N("Performative")));
N("Performative") ::= select("aip", N("AIP"));
N("Message") ::= (select("communication", N("Communication")) select("Comm_Act", N("Performative")));
N("Scenario") ::= epsilon;
