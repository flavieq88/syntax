N("FIPA-Platform Agent") ::= ((select("fipa_platform_Task", N("Solution Domain/FIPA-platform Task")))+ select("agent", N("Agency Domain/Agent")));
N("FIPA-platform Task") ::= (select("fipa_platform_Agent", N("Solution Domain/FIPA-Platform Agent")) select("task", N("Agency Domain/Task")));
N("Service") ::= epsilon;
N("Agent") ::= (select("Name", N("String")) select("Knowledge", N("Problem Domain/Ontology")) select("fipa_platform_AgentA", N("Solution Domain/FIPA-Platform Agent")) select("role", N("Agency Domain/Role")) (select("resource", N("Problem Domain/Ressource")))+ (select("non_functionnal_Requirement", N("Problem Domain/Non functionnal Requirement")))+ (select("requirement", N("Problem Domain/Requirement")))+);
N("Role") ::= (select("agentR", N("Agency Domain/Agent")) (select("service", N("Solution Domain/Service")))+ (select("task", N("Agency Domain/Task")))+ (select("scenario", N("Problem Domain/Scenario")))+ (select("communication", N("Agency Domain/Communication")))+);
N("Task") ::= (select("Name", N("String")) select("fipa_platform_TaskT", N("Solution Domain/FIPA-platform Task")));
N("Communication") ::= (select("Name", N("String")) select("Exchanged Knowledge", N("Problem Domain/Ontology")) select("message", N("Agency Domain/Message")) select("aip", N("Agency Domain/AIP")));
N("Message") ::= (select("communication", N("Agency Domain/Communication")) select("Comm_Act", N("Agency Domain/Performative")));
N("AIP") ::= (select("Name", N("String")) select("performative", N("Agency Domain/Performative")));
N("Performative") ::= select("aip", N("Agency Domain/AIP"));
N("Ressource") ::= select("Name", N("String"));
N("Non functionnal Requirement") ::= epsilon;
N("Requirement") ::= epsilon;
N("Scenario") ::= epsilon;
N("Ontology") ::= epsilon;
N("Concept") ::= epsilon;
N("Action") ::= epsilon;
N("Predicate") ::= epsilon;
N("String") ::= value("string");
