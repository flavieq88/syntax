N("String") ::= value("string");
N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
N("LQN") ::= (select("name", N("String")) select("comment", N("String")) select("author", N("String")) select("created_On", N("Date")) select("modified_On", N("Date")) (select("task", N("Task")))+ (select("processor", N("Processor")))+);
N("Task") ::= (select("name", N("String")) select("type", N("TaskType")) select("priority", N("Integer")) select("mutliplicity", N("Integer")) select("replicas", N("Integer")) (select("entry", N("Entry")))+ select("processor", N("Processor")) select("lqn", N("LQN")) (select("activity", N("Activity")))+);
N("Processor") ::= (select("name", N("String")) select("scheduling", N("SchedulingType")) select("mutliplicity", N("Integer")) select("replicas", N("Integer")) select("spped", N("Integer")) select("task", N("Task")) select("lqn", N("LQN")));
N("Entry") ::= (select("name", N("String")) select("num_Phase", N("Integer")) select("arrival_Rate", N("Integer")) select("contained_In", N("Task")) select("replay_To", N("Entry")) select("callreceives", N("Call")) select("callsends", N("Call")) (select("phase", N("Phase")))+ select("activity", N("Activity")) select("task", N("Task")));
N("Phase") ::= (select("number", N("Integer")) select("type", N("PhaseType")) select("think_Time", N("Integer")) select("execution_Demand", N("Integer")) select("COV", N("Integer")) select("entry", N("Entry")) select("activity", N("Activity")));
N("Activity") ::= (select("name", N("String")) select("arrival_Rate", N("Integer")) select("contained_In", N("Task")) select("replay_To", N("Entry")) (select("linkPrecedes", N("Link")))+ (select("linkfollows", N("Link")))+ (select("call", N("Call")))+ select("phase", N("Phase")) select("entry", N("Entry")) select("task", N("Task")));
N("Link") ::= (select("type", N("LinkType")) select("mean_Links", N("Integer")) select("fromActivity", N("Activity")) select("toActivity", N("Activity")) select("activityPrecedes", N("Activity")) select("activityfollows", N("Activity")));
N("CallPhase") ::= (select("mean_Calls", N("Integer")) select("refers_To", N("Phase")) (select("call", N("Call")))+);
N("Call") ::= N("EntryCall");
N("Call") ::= N("ActivityCall");
N("Call") ::= (select("toEntry", N("Entry")) select("num_Phases", N("Integer")) select("type", N("CallType")) (select("callPhase", N("CallPhase")))+ select("activity", N("Activity")) select("entryreceives", N("Entry")) select("entrysends", N("Entry")));
N("EntryCall") ::= select("from_Entry", N("Entry"));
N("ActivityCall") ::= select("fromActivity", N("Activity"));
N("Date") ::= (select("day", N("String")) select("month", N("String")) select("year", N("String")));
N("SchedulingType") ::= (select("FCFS", epsilon) | select("preemptive_Priority", epsilon) | select("head_of_line", epsilon) | select("random", epsilon));
N("PhaseType") ::= (select("stochastic", epsilon) | select("deterministic", epsilon));
N("CallType") ::= (select("synchronous", epsilon) | select("asynchronous", epsilon) | select("forwording", epsilon));
N("LinkType") ::= (select("and_Fork", epsilon) | select("and_join", epsilon) | select("basic", epsilon) | select("or_Fork", epsilon) | select("or_join", epsilon));
N("TaskType") ::= (select("a_reference", epsilon) | select("non_reference", epsilon));
