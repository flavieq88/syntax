N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
N("String") ::= value("string");
N("HAL") ::= (select("connexion", N("Connexion")) (select("contents", N("Entry")))+);
N("Connexion") ::= (select("login", N("String")) select("password", N("String")));
N("Entry") ::= N("Article");
N("Entry") ::= N("Notice");
N("Article") ::= N("ArticleRecent");
N("Article") ::= N("ArticleRetro");
N("ArticleRecent") ::= select("fichiers", N("DepotsType"));
N("ArticleRetro") ::= (select("dateRedaction", N("String")) select("fichiers", N("AbstractDepot")));
N("Notice") ::= select("metaArtNotice", N("MetaArtNoticeType"));
N("ReferenceBiblioType") ::= N("ArtRevueType");
N("ReferenceBiblioType") ::= N("WorkshopType");
N("ReferenceBiblioType") ::= N("ArtOuvrageType");
N("ReferenceBiblioType") ::= N("OuvrageType");
N("ReferenceBiblioType") ::= N("TheseType");
N("ReferenceBiblioType") ::= N("BrevetType");
N("ReferenceBiblioType") ::= N("AutreType");
N("ArtRevueType") ::= N("ArtRevue");
N("ArtRevueType") ::= N("ArtJournal");
N("WorkshopType") ::= N("Workshop");
N("WorkshopType") ::= N("Communication");
N("WorkshopType") ::= N("Conference");
N("ArtOuvrageType") ::= N("ArtOuvrage");
N("OuvrageType") ::= N("Ouvrage");
N("TheseType") ::= N("These");
N("BrevetType") ::= N("Brevet");
N("AutreType") ::= N("Autre");
N("ArtRevue") ::= (select("urldoi", N("String")) select("journal", N("String")) select("volume", N("String")) select("page", N("String")) select("annee", N("String")));
N("ArtJournal") ::= (select("urldoi", N("String")) select("journal", N("String")) select("volume", N("String")) select("page", N("String")) select("annee", N("String")));
N("Workshop") ::= (select("urldoi", N("String")) select("titconf", N("String")) select("ville", N("String")) select("pays", N("String")) select("edcom", N("String")) select("annee", N("String")) select("page", N("String")) select("edsci", N("String")) select("serie", N("String")));
N("Communication") ::= (select("urldoi", N("String")) select("titconf", N("String")) select("ville", N("String")) select("pays", N("String")) select("edcom", N("String")) select("annee", N("String")) select("page", N("String")) select("edsci", N("String")) select("serie", N("String")));
N("Conference") ::= (select("urldoi", N("String")) select("titconf", N("String")) select("ville", N("String")) select("pays", N("String")) select("edcom", N("String")) select("annee", N("String")) select("page", N("String")) select("edsci", N("String")) select("serie", N("String")));
N("ArtOuvrage") ::= (select("urldoi", N("String")) select("titouv", N("String")) select("edcom", N("String")) select("annee", N("String")) select("edsci", N("String")) select("serie", N("String")));
N("Ouvrage") ::= (select("urldoi", N("String")) select("edcom", N("String")) select("annee", N("String")) select("page", N("String")));
N("Brevet") ::= (select("datebrevet", N("String")) select("numbrevet", N("String")) select("page", N("String")) select("pays", N("String")));
N("Autre") ::= (select("urldoi", N("String")) select("annee", N("String")) select("description", N("String")));
N("These") ::= (select("orgthe", N("String")) select("niveau", N("String")) select("defencedate", N("String")) select("directeur", N("String")) select("codirecteur", N("String")));
N("MetaType") ::= N("MetaArtType");
N("MetaType") ::= N("MetaArtNoticeType");
N("MetaArtType") ::= (select("domain", N("String")) select("abstract", N("String")) select("referenceBiblio", N("ReferenceBiblioType")));
N("MetaArtNoticeType") ::= (select("domain", N("String")) select("abstract", N("String")) select("referenceBiblio", N("ReferenceBiblioType")));
N("AutLabType") ::= ((select("auteurs", N("Auteur")))+ (select("laboratoires", N("Laboratoire")))+);
N("Auteur") ::= (select("nom", N("String")) select("prenom", N("String")) select("autrePrenom", N("String")) select("email", N("String")) select("urlPerso", N("String")) select("lab", N("Laboratoire")));
N("Laboratoire") ::= (select("id", N("Integer")) select("metas", N("AbstractMetaLab")));
N("AbstractMetaLab") ::= N("MetaLab");
N("MetaLab") ::= select("id", N("String"));
N("AffiliationType") ::= ((select("institution", N("String")))+ (select("prive", N("String")))+ (select("ecole", N("String")))+ (select("universite", N("String")))+);
N("TamponType") ::= select("id", N("String"));
N("DateVisibleEnum") ::= (select("15J", epsilon) | select("1M", epsilon) | select("3M", epsilon) | select("1A", epsilon) | select("2A", epsilon) | select("JAMAIS", epsilon));
N("AbstractDepot") ::= N("Depot");
N("AbstractDepot") ::= N("DepotWeb");
N("Depot") ::= select("format", N("FormatEnum"));
N("FormatEnum") ::= (select("PDF", epsilon) | select("TEX", epsilon) | select("DOC", epsilon) | select("RTF", epsilon) | select("TXT", epsilon) | select("PS", epsilon) | select("ANNEX", epsilon));
N("DepotWeb") ::= select("format", N("FormatWebEnum"));
N("FormatWebEnum") ::= (select("XML", epsilon) | select("HTML", epsilon) | select("HTM", epsilon));
N("AbstractDepotType") ::= N("DepotsType");
N("AbstractDepotType") ::= N("WebLink");
N("DepotsType") ::= (select("depots", N("AbstractDepot")))+;
N("WebLink") ::= (select("identifiant", N("String")) select("server", N("Server")));
N("Server") ::= epsilon;
