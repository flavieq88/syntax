N("String") ::= value("string");
N("Integer") ::= value("int");
N("Boolean") ::= ("true" | "false");
N("LocatedElement") ::= N("Program");
N("LocatedElement") ::= N("Service");
N("LocatedElement") ::= N("Session");
N("LocatedElement") ::= N("MethodName");
N("LocatedElement") ::= N("Branch");
N("LocatedElement") ::= N("TypeExpression");
N("LocatedElement") ::= N("Declaration");
N("LocatedElement") ::= N("StructureProperty");
N("LocatedElement") ::= N("FunctionCall");
N("LocatedElement") ::= N("Statement");
N("LocatedElement") ::= N("SelectMember");
N("LocatedElement") ::= N("Expression");
N("LocatedElement") ::= N("MessageField");
N("LocatedElement") ::= N("Constant");
N("LocatedElement") ::= N("Response");
N("Program") ::= select("service", N("Service"));
N("Service") ::= (select("name", N("String")) (select("declarations", N("Declaration")))+ (select("sessions", N("Session")))+);
N("Session") ::= N("Registration");
N("Session") ::= N("Dialog");
N("Session") ::= N("Event");
N("Session") ::= N("Method");
N("Registration") ::= ((select("declarations", N("Declaration")))+ (select("sessions", N("Session")))+);
N("Dialog") ::= ((select("declarations", N("Declaration")))+ (select("methods", N("Method")))+);
N("Event") ::= (select("eventId", N("String")) (select("declarations", N("Declaration")))+ (select("methods", N("Method")))+);
N("Method") ::= (select("type", N("TypeExpression")) select("direction", N("Direction")) select("methodName", N("MethodName")) (select("arguments", N("Argument")))+ (select("statements", N("Statement")))+ (select("branches", N("Branch")))+);
N("Argument") ::= (select("type", N("TypeExpression")) select("initExp", N("Expression")));
N("MethodName") ::= N("SIPMethodName");
N("MethodName") ::= N("ControlMethodName");
N("SIPMethodName") ::= select("name", N("SIPMethod"));
N("ControlMethodName") ::= select("name", N("ControlMethod"));
N("Branch") ::= N("DefaultBranch");
N("Branch") ::= N("NamedBranch");
N("Branch") ::= (select("statements", N("Statement")))+;
N("DefaultBranch") ::= ((select("statements", N("Statement")))+);
N("NamedBranch") ::= (select("name", N("String")))+;
N("TypeExpression") ::= N("SimpleType");
N("TypeExpression") ::= N("SequenceType");
N("TypeExpression") ::= N("DefinedType");
N("SimpleType") ::= select("type", N("PrimitiveType"));
N("SequenceType") ::= (select("modifier", N("Modifier")) select("type", N("PrimitiveType")) select("size", N("Integer")));
N("DefinedType") ::= select("typeName", N("String"));
N("Declaration") ::= N("VariableDeclaration");
N("Declaration") ::= N("FunctionDeclaration");
N("Declaration") ::= N("StructureDeclaration");
N("VariableDeclaration") ::= N("Argument");
N("VariableDeclaration") ::= N("WhenHeader");
N("VariableDeclaration") ::= (select("type", N("TypeExpression")) select("initExp", N("Expression")));
N("FunctionDeclaration") ::= N("RemoteFunctionDeclaration");
N("FunctionDeclaration") ::= N("LocalFunctionDeclaration");
N("RemoteFunctionDeclaration") ::= select("functionLocation", N("FunctionLocation"));
N("LocalFunctionDeclaration") ::= (select("statements", N("Statement")))+;
N("StructureDeclaration") ::= (select("properties", N("Argument")))+;
N("StructureProperty") ::= (select("name", N("String")) select("type", N("TypeExpression")));
N("FunctionCall") ::= (select("function", N("FunctionDeclaration")) (select("parameters", N("Expression")))+);
N("Statement") ::= N("CompoundStat");
N("Statement") ::= N("SetStat");
N("Statement") ::= N("DeclarationStat");
N("Statement") ::= N("ReturnStat");
N("Statement") ::= N("IfStat");
N("Statement") ::= N("WhenStat");
N("Statement") ::= N("ForeachStat");
N("Statement") ::= N("SelectStat");
N("Statement") ::= N("FunctionCallStat");
N("Statement") ::= N("ContinueStat");
N("Statement") ::= N("BreakStat");
N("Statement") ::= N("PushStat");
N("CompoundStat") ::= (select("statements", N("Statement")))+;
N("SetStat") ::= (select("target", N("Place")) select("setValue", N("Expression")));
N("DeclarationStat") ::= select("declaration", N("Declaration"));
N("ReturnStat") ::= (select("returnedValue", N("Expression")) select("branch", N("NamedBranch")));
N("IfStat") ::= (select("condition", N("Expression")) (select("thenStatements", N("Statement")))+ (select("elseStatements", N("Statement")))+);
N("WhenStat") ::= (select("idExp", N("Variable")) (select("whenHeaders", N("WhenHeader")))+ (select("statements", N("Statement")))+ (select("elseStatements", N("Statement")))+);
N("ForeachStat") ::= (select("iteratorName", N("String")) select("sequenceExp", N("Expression")) (select("statements", N("Statement")))+);
N("SelectStat") ::= (select("matchedExp", N("Expression")) (select("selectCases", N("SelectCase")))+ select("selectDefault", N("SelectDefault")));
N("FunctionCallStat") ::= select("functionCall", N("FunctionCall"));
N("ContinueStat") ::= epsilon;
N("BreakStat") ::= epsilon;
N("PushStat") ::= (select("target", N("Place")) select("pushedValue", N("Expression")));
N("WhenHeader") ::= (select("headerId", N("String")) select("value", N("Constant")));
N("SelectMember") ::= N("SelectDefault");
N("SelectMember") ::= N("SelectCase");
N("SelectDefault") ::= ((select("statements", N("Statement")))+);
N("SelectCase") ::= (select("values", N("Constant")))+;
N("Expression") ::= N("ConstantExp");
N("Expression") ::= N("OperatorExp");
N("Expression") ::= N("ForwardExp");
N("Expression") ::= N("WithExp");
N("Expression") ::= N("BlockExp");
N("Expression") ::= N("ReasonExp");
N("Expression") ::= N("BODYExp");
N("Expression") ::= N("RequestURIExp");
N("Expression") ::= N("PopExp");
N("Expression") ::= N("FunctionCallExp");
N("Expression") ::= N("Place");
N("ConstantExp") ::= select("value", N("Constant"));
N("OperatorExp") ::= (select("opName", N("String")) select("leftExp", N("Expression")) select("rightExp", N("Expression")));
N("ForwardExp") ::= (select("isParallel", N("Boolean")) select("exp", N("Expression")));
N("WithExp") ::= (select("exp", N("Expression")) (select("msgFields", N("MessageField")))+);
N("BlockExp") ::= select("exp", N("Expression"));
N("ReasonExp") ::= epsilon;
N("BODYExp") ::= epsilon;
N("RequestURIExp") ::= epsilon;
N("PopExp") ::= select("source", N("Place"));
N("FunctionCallExp") ::= select("functionCall", N("FunctionCall"));
N("Place") ::= N("SIPHeaderPlace");
N("Place") ::= N("VariablePlace");
