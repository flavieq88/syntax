N("VariablePlace") ::= N("PropertyCallPlace");
N("VariablePlace") ::= N("Variable");
N("PropertyCallPlace") ::= (select("propName", N("String")) select("source", N("VariablePlace")));
N("Variable") ::= select("source", N("Declaration"));
N("MessageField") ::= N("ReasonMessageField");
N("MessageField") ::= N("HeadedMessageField");
N("ReasonMessageField") ::= (select("exp", N("Expression")));
N("HeadedMessageField") ::= select("headerId", N("String"));
N("Constant") ::= N("BooleanConstant");
N("Constant") ::= N("IntegerConstant");
N("Constant") ::= N("StringConstant");
N("Constant") ::= N("URIConstant");
N("Constant") ::= N("SequenceConstant");
N("Constant") ::= N("ResponseConstant");
N("BooleanConstant") ::= select("value", N("Boolean"));
N("IntegerConstant") ::= select("value", N("Integer"));
N("StringConstant") ::= select("value", N("String"));
N("URIConstant") ::= select("uri", N("String"));
N("SequenceConstant") ::= (select("values", N("Constant")))+;
N("ResponseConstant") ::= select("response", N("Response"));
N("Response") ::= N("SuccessResponse");
N("Response") ::= N("ErrorResponse");
N("SuccessResponse") ::= select("successKind", N("SuccessKind"));
N("ErrorResponse") ::= N("ClientErrorResponse");
N("ErrorResponse") ::= N("GlobalErrorResponse");
N("ErrorResponse") ::= N("RedirectionErrorResponse");
N("ErrorResponse") ::= N("ServerErrorResponse");
N("ErrorResponse") ::= (N("ClientErrorResponse") | N("GlobalErrorResponse") | N("RedirectionErrorResponse") | N("ServerErrorResponse"));
N("ClientErrorResponse") ::= select("errorKind", N("ClientErrorKind"));
N("GlobalErrorResponse") ::= select("errorKind", N("GlobalErrorKind"));
N("RedirectionErrorResponse") ::= select("errorKind", N("RedirectionErrorKind"));
N("ServerErrorResponse") ::= select("errorKind", N("ServerErrorKind"));
N("Direction") ::= (select("inout", epsilon) | select("in", epsilon) | select("out", epsilon));
N("SIPMethod") ::= (select("ACK", epsilon) | select("BYE", epsilon) | select("CANCEL", epsilon) | select("INVITE", epsilon) | select("NOTIFY", epsilon) | select("OPTIONS", epsilon) | select("REACK", epsilon) | select("REGISTER", epsilon) | select("REINVITE", epsilon) | select("REREGISTER", epsilon) | select("RESUBSCRIBE", epsilon) | select("SUBSCRIBE", epsilon));
N("ControlMethod") ::= (select("deploy", epsilon) | select("undeploy", epsilon) | select("uninvite", epsilon) | select("unregister", epsilon) | select("unsubscribe", epsilon));
N("PrimitiveType") ::= (select("void", epsilon) | select("bool", epsilon) | select("int", epsilon) | select("request", epsilon) | select("response", epsilon) | select("string", epsilon) | select("time", epsilon) | select("uri", epsilon));
N("Modifier") ::= (select("LIFO", epsilon) | select("FIFO", epsilon));
N("FunctionLocation") ::= (select("remote", epsilon) | select("local", epsilon));
N("SIPHeader") ::= (select("CALL_ID", epsilon) | select("CONTACT", epsilon) | select("CSEQ", epsilon) | select("EVENT", epsilon) | select("FROM", epsilon) | select("MAX_FORWARDS", epsilon) | select("SUBSCRIPTION_STATE", epsilon) | select("TO", epsilon) | select("VIA", epsilon));
N("SuccessKind") ::= (select("OK", epsilon) | select("ACCEPTED", epsilon));
N("ClientErrorKind") ::= (select("ADDRESS_INCOMPLETE", epsilon) | select("AMBIGUOUS", epsilon) | select("BAD_EXTENSION", epsilon) | select("BAD_REQUEST", epsilon) | select("BUSY_HERE", epsilon) | select("CALL_OR_TRANSACTION_DOES_NOT_EXIST", epsilon) | select("EXTENSION_REQUIRED", epsilon) | select("FORBIDDEN", epsilon) | select("GONE", epsilon) | select("INTERVAL_TOO_BRIEF", epsilon) | select("LOOP_DETECTED", epsilon) | select("METHOD_NOT_ALLOWED", epsilon) | select("NOT_ACCEPTABLE_HERE", epsilon) | select("NOT_ACCEPTABLE", epsilon) | select("NOT_FOUND", epsilon) | select("PAYMENT_REQUIRED", epsilon) | select("PROXY_AUTHENTICATION_REQUIRED", epsilon) | select("REQUESTURI_TOO_LONG", epsilon) | select("REQUEST_ENTITY_TOO_LARGE", epsilon) | select("REQUEST_PENDING", epsilon) | select("REQUEST_TERMINATED", epsilon) | select("REQUEST_TIMEOUT", epsilon) | select("TEMPORARILY_UNAVAILABLE", epsilon) | select("TOO_MANY_HOPS", epsilon) | select("UNAUTHORIZED", epsilon) | select("UNDECIPHERABLE", epsilon) | select("UNSUPPORTED_MEDIA_TYPE", epsilon) | select("UNSUPPORTED_URI_SCHEME", epsilon));
N("GlobalErrorKind") ::= (select("BUSY_EVERYWHERE", epsilon) | select("DECLINE", epsilon) | select("DOES_NOT_EXIST_ANYWHERE", epsilon) | select("NOT_ACCEPTABLE", epsilon));
N("RedirectionErrorKind") ::= (select("ALTERNATIVE_SERVICE", epsilon) | select("MOVED_PERMANENTLY", epsilon) | select("MOVED_TEMPORARILY", epsilon) | select("MULTIPLE_CHOICES", epsilon) | select("USE_PROXY", epsilon));
N("ServerErrorKind") ::= (select("BAD_GATEWAY", epsilon) | select("MESSAGE_TOO_LARGE", epsilon) | select("NOT_IMPLEMENTED", epsilon) | select("SERVER_INTERNAL_ERROR", epsilon) | select("SERVER_TIMEOUT", epsilon) | select("SERVICE_UNAVAILABLE", epsilon) | select("VERSION_NOT_SUPPORTED", epsilon));
