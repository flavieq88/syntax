N("UEMLObject") ::= N("UEMLModel");
N("UEMLObject") ::= N("Port");
N("UEMLObject") ::= N("Flow");
N("UEMLObject") ::= N("Object");
N("UEMLObject") ::= N("Activity");
N("UEMLObject") ::= (select("has", N("Geometry")) select("model", N("UEMLModel")));
N("UEMLModel") ::= (select("contains", N("UEMLObject")))+;
N("Geometry") ::= select("object", N("UEMLObject"));
N("Port") ::= N("ResourceRole");
N("Port") ::= N("Anchor");
N("Port") ::= (N("ResourceRole") | N("Anchor"));
N("Flow") ::= N("ResourceFlow");
N("Flow") ::= N("IOFlow");
N("Flow") ::= N("ControlFlow");
N("Flow") ::= select("associationConnector", N("AssociationConnector"));
N("Activity") ::= N("Process");
N("Activity") ::= N("Task");
N("Activity") ::= ((select("resourceRole", N("ResourceRole")))+ select("parent", N("Process")) (select("hasOutput", N("OutputPort")))+ (select("hasInput", N("InputPort")))+ select("activityType", N("ActivityType")));
N("Object") ::= N("InformationObject");
N("Object") ::= N("Resource");
N("Object") ::= select("ioFlow", N("IOFlow"));
N("InformationObject") ::= select("controlFlow", N("ControlFlow"));
N("Resource") ::= N("PassiveObject");
N("Resource") ::= N("Service");
N("Resource") ::= N("Agent");
N("Resource") ::= (select("carries", N("ResourceFlow")) (select("plays", N("ResourceRole")))+ select("resourceType", N("ResourceType")) (select("commitment", N("Commitment")))+);
N("MaterialResource") ::= epsilon;
N("HumanResource") ::= (select("obliger", N("Commitment")) select("claimer", N("Commitment")) select("has_parties", N("Contract")));
N("ResourceFlow") ::= (select("resourceCarries", N("Resource")))+;
N("IOFlow") ::= (select("carries", N("Object")))+;
N("ControlFlow") ::= N("TriggerFlow");
N("ControlFlow") ::= N("ConstraintFlow");
N("ControlFlow") ::= (select("carries", N("InformationObject")))+;
N("TriggerFlow") ::= ((select("carries", N("InformationObject")))+);
N("ConstraintFlow") ::= ((select("carries", N("InformationObject")))+);
N("ResourceRole") ::= ((select("resourcePlays", N("Resource")))+ select("roleQualifier", N("RoleType")) select("in", N("Activity")));
N("RoleType") ::= epsilon;
N("Anchor") ::= N("OutputPort");
N("Anchor") ::= N("InputPort");
N("Anchor") ::= N("ConnectionOperator");
N("Anchor") ::= (N("OutputPort") | N("InputPort"));
N("OutputPort") ::= select("activity", N("Activity"));
N("InputPort") ::= select("activity", N("Activity"));
N("ConnectionOperator") ::= (select("target", N("AssociationConnector")) select("origin", N("AssociationConnector")));
N("AssociationConnector") ::= ((select("origin", N("FlowObject")))+ (select("target", N("FlowObject")))+ select("classAssociation", N("Flow")));
N("FlowObject") ::= N("Event");
N("FlowObject") ::= N("Activity");
N("FlowObject") ::= N("ConnectionOperator");
N("FlowObject") ::= (select("target", N("AssociationConnector")) select("origin", N("AssociationConnector")));
N("Event") ::= (select("target", N("AssociationConnector")) select("origin", N("AssociationConnector")));
N("ResourceType") ::= (select("resource", N("Resource")))+;
N("ActivityType") ::= (select("activityT", N("Activity")))+;
N("PassiveObject") ::= N("MaterialResource");
N("PassiveObject") ::= N("Commitment");
N("PassiveObject") ::= N("Contract");
N("PassiveObject") ::= (N("MaterialResource") | N("Commitment") | N("Contract"));
N("Commitment") ::= ((select("resource", N("Resource")))+ select("task", N("Task")) select("agentO", N("Agent")) select("agentC", N("Agent")) select("contract", N("Contract")));
N("Software") ::= (select("obliger", N("Commitment")) select("claimer", N("Commitment")) select("has_parties", N("Contract")));
N("Organisation") ::= (select("obliger", N("Commitment")) select("claimer", N("Commitment")) select("has_parties", N("Contract")));
N("Process") ::= (select("child", N("Activity")) (select("fulfills", N("Contract")))+ select("realises", N("Service")));
N("Service") ::= select("process", N("Process"));
N("Agent") ::= N("HumanResource");
N("Agent") ::= N("Software");
N("Agent") ::= N("Organisation");
N("Agent") ::= (select("obliger", N("Commitment")) select("claimer", N("Commitment")) select("has_parties", N("Contract")));
N("Contract") ::= ((select("process", N("Process")))+ select("agent", N("Agent")) (select("collection_of", N("Commitment")))+);
N("Task") ::= (select("fulfills", N("Commitment")))+;
