N("Class_declaration") ::= ([N("Indexing")] N("Class_header") [N("Formal_generics")] [N("Obsolete")] [N("Inheritance")] [N("Creators")] [N("Features")] [N("Invariant")] "end" [("--" "class" N("Class_name"))]);
N("Indexing") ::= ("indexing" N("Index_list"));
N("Index_list") ::= ((N("Index_clause") ";"))*;
N("Index_clause") ::= ([N("Index")] N("Index_terms"));
N("Index") ::= (N("Identifier") ":");
N("Index_terms") ::= ((N("Index_value") ","))+;
N("Index_value") ::= (N("Identifier") | N("Manifest_constant"));
N("Class_header") ::= ([N("Header_mark")] "class" N("Class_name"));
N("Header_mark") ::= ("deferred" | "expanded" | "separate");
N("Class_name") ::= N("Identifier");
N("Formal_generics") ::= [N("Formal_generic_list")];
N("Formal_generic_list") ::= ((N("Formal_generic") ","))*;
N("Formal_generic") ::= (N("Formal_generic_name") [N("Constraint")]);
N("Formal_generic_name") ::= N("Identifier");
N("Constraint") ::= ("-" ">" N("Class_type"));
N("Obsolete") ::= ("obsolete" N("Message"));
N("Message") ::= N("Manifest_string");
N("Inheritance") ::= ("inherit" N("Parent_list"));
N("Parent_list") ::= ((N("Parent") ";"))*;
N("Parent") ::= (N("Class_type") [N("Feature_adaptation")]);
N("Feature_adaptation") ::= ([N("Rename")] [N("New_exports")] [N("Undefine")] [N("Redefine")] [N("Select")] "end");
N("Rename") ::= ("rename" N("Rename_list"));
N("Rename_list") ::= ((N("Rename_pair") ","))*;
N("Rename_pair") ::= (N("Feature_name") "as" N("Feature_name"));
N("New_exports") ::= ("export" N("New_export_list"));
N("New_export_list") ::= ((N("New_export_item") ";"))*;
N("New_export_item") ::= (N("Clients") N("Feature_set"));
N("Feature_set") ::= (N("Feature_list") | "all");
N("Feature_list") ::= ((N("Feature_name") ","))*;
N("Clients") ::= ("{" N("Class_list") "}");
N("Class_list") ::= ((N("Class_name") ","))*;
N("Redefine") ::= ("redefine" N("Feature_list"));
N("Undefine") ::= ("undefine" N("Feature_list"));
N("Select") ::= ("select" N("Feature_list"));
N("Creators") ::= ("creation" ((N("Creation_clause") "creation"))+);
N("Creation_clause") ::= ([N("Clients")] [N("Header_comment")] N("Procedure_list"));
N("Procedure_list") ::= ((N("Procedure_name") ","))*;
N("Procedure_name") ::= N("Identifier");
N("Features") ::= ("feature" ((N("Feature_clause") "feature"))+);
N("Feature_clause") ::= ([N("Clients")] [N("Header_comment")] N("Feature_declaration_list"));
N("Feature_declaration_list") ::= ((N("Feature_declaration") ";"))*;
N("Feature_declaration") ::= (N("New_feature_list") N("Declaration_body"));
N("Declaration_body") ::= ([N("Formal_arguments")] [N("Type_mark")] [N("Constant_or_routine")]);
N("Constant_or_routine") ::= ("is" N("Feature_value"));
N("Feature_value") ::= (N("Manifest_constant") | N("Unique") | N("Routine"));
N("Unique") ::= "Unique";
N("New_feature_list") ::= ((N("New_feature") ","))+;
N("New_feature") ::= (["frozen"] N("Feature_name"));
N("Feature_name") ::= (N("Identifier") | N("Prefix") | N("Infix"));
N("Prefix") ::= ("prefix" "\"" N("Prefix_operator") "\"");
N("Infix") ::= ("infix" "\"" N("Infix_operator") "\"");
N("Prefix_operator") ::= (N("Unary") | N("Free_operator"));
N("Infix_operator") ::= (N("Binary") | N("Free_operator"));
N("Unary") ::= ("not" | "+" | "-");
N("Binary") ::= ("+" | "-" | "*" | "/" | "<" | ">" | "<=" | ">=" | "//" | "\\\\" | "^" | "and" | "or" | "xor" | ("and" "then") | ("or" "else") | "implies");
N("Formal_arguments") ::= ("(" N("Entity_declaration_list") ")");
N("Entity_declaration_list") ::= ((N("Entity_declaration_group") ";"))*;
N("Entity_declaration_group") ::= (N("Identifier_list") N("Type_mark"));
N("Identifier_list") ::= ((N("Identifier") ","))+;
N("Type_mark") ::= (":" N("Type"));
N("Routine") ::= ([N("Obsolete")] [N("Header_comment")] [N("Precondition")] [N("Local_declarations")] N("Routine_body") [N("Postcondition")] [N("Rescue")] "end" [("--" N("Feature_name"))]);
N("Routine_body") ::= (N("Effective") | N("Deferred"));
N("Effective") ::= (N("Internal") | N("External"));
N("Internal") ::= (N("Routine_mark") N("Compound"));
N("Routine_mark") ::= ("do" | "once");
N("Deferred") ::= "deferred";
N("External") ::= ("external" N("Language_name") [N("External_name")]);
N("Language_name") ::= N("Manifest_string");
N("External_name") ::= ("alias" N("Manifest_string"));
N("Local_declarations") ::= ("local" N("Entity_declaration_list"));
N("Precondition") ::= ("require" ["else"] N("Assertion"));
N("Postcondition") ::= ("ensure" ["then"] N("Assertion"));
N("Invariant") ::= ("invariant" N("Assertion"));
N("Assertion") ::= ((N("Assertion_clause") ";"))*;
N("Assertion_clause") ::= ([N("Tag_mark")] N("Unlabeled_assertion_clause"));
N("Unlabeled_assertion_clause") ::= (N("Boolean_expression") | N("Comment"));
N("Tag_mark") ::= (N("Tag") ":");
N("Tag") ::= N("Identifier");
N("Rescue") ::= ("rescue" N("Compound"));
N("Type") ::= (N("Class_type") | N("Class_type_expanded") | N("Class_type_separate") | N("Anchored") | N("Bit_type"));
N("Class_type") ::= (N("Class_name") [N("Actual_generics")]);
N("Actual_generics") ::= [N("Type_list")];
N("Type_list") ::= ((N("Type") ","))*;
N("Class_type_expanded") ::= ("expanded" N("Class_type"));
N("Class_type_separate") ::= ("separate" N("Class_type"));
N("Bit_type") ::= ("BIT" N("Bit_length"));
N("Bit_length") ::= (N("Integer_constant") | N("Attribute"));
N("Anchored") ::= ("like" N("Anchor"));
N("Anchor") ::= (N("Identifier") | "Current");
N("Compound") ::= ((N("Instruction") ";"))*;
N("Instruction") ::= (N("Creation") | N("Call") | N("Assignment") | N("Assignment_attempt") | N("Conditional") | N("Multi_branch") | N("Loop") | N("Debug") | N("Check") | N("Retry") | N("Null_instruction"));
N("Creation") ::= ("!" [N("Type")] "!" N("Writable") [N("Creation_call")]);
N("Creation_call") ::= ("." N("Procedure_name") [N("Actuals")]);
N("Assignment") ::= (N("Writable") ":=" N("Expression"));
N("Assignment_attempt") ::= (N("Writable") "?=" N("Expression"));
N("Conditional") ::= ("if" N("Then_part_list") [N("Else_part")] "end");
N("Then_part_list") ::= ((N("Then_part") "elseif"))+;
N("Then_part") ::= (N("Boolean_expression") "then" N("Compound"));
N("Else_part") ::= ("else" N("Compound"));
N("Multi_branch") ::= ("inspect" N("Expression") [N("When_part_list")] [N("Else_part")] "end");
N("When_part_list") ::= ("when" ((N("When_part") "when"))+);
N("When_part") ::= (N("Choices") "then" N("Compound"));
N("Choices") ::= ((N("Choice") ","))*;
N("Choice") ::= (N("Choice_constant") | N("Interval"));
N("Interval") ::= (N("Choice_constant") ".." N("Choice_constant"));
N("Choice_constant") ::= (N("Integer_constant") | N("Character_constant") | N("Attribute"));
N("Loop") ::= (N("Initialization") [N("Invariant")] [N("Variant")] N("Loop_body") "end");
N("Initialization") ::= ("from" N("Compound"));
N("Variant") ::= ("variant" [N("Tag_mark")] N("Expression"));
N("Loop_body") ::= (N("Exit") "loop" N("Compound"));
N("Exit") ::= ("until" N("Boolean_expression"));
N("Debug") ::= ("debug" [N("Debug_keys")] N("Compound") "end");
N("Debug_keys") ::= ("(" N("Debug_key_list") ")");
N("Debug_key_list") ::= ((N("Debug_key") ","))*;
N("Debug_key") ::= N("Manifest_string");
N("Check") ::= ("check" N("Assertion") "end");
N("Retry") ::= "retry";
N("Null_instruction") ::= epsilon;
N("Call") ::= (N("Qualified_call") | N("Precursor"));
N("Qualified_call") ::= ([N("Call_qualifier")] N("Call_chain"));
N("Call_qualifier") ::= (N("Call_target") ".");
N("Call_target") ::= (N("Parenthesized") | "Result" | "Current" | N("Precursor"));
N("Call_chain") ::= ((N("Unqualified_call") "."))+;
N("Unqualified_call") ::= (N("Identifier") [N("Actuals")]);
N("Precursor") ::= ([N("Parent_qualification")] "Precursor" [N("Actuals")]);
N("Parent_qualification") ::= ("{" N("Class_name") "}");
N("Attribute") ::= N("Identifier");
N("Writable") ::= (N("Identifier") | "Result");
N("Actuals") ::= ("(" N("Actual_list") ")");
N("Actual_list") ::= ((N("Actual") ","))*;
N("Actual") ::= (N("Expression") | N("Address"));
N("Address") ::= ("$" N("Address_mark"));
N("Address_mark") ::= (N("Feature_name") | "Current" | "Result");
N("Expression") ::= ("Current" | "Result" | N("Call") | N("Operator_expression") | N("Equality") | N("Manifest_array") | N("Old") | N("Strip") | N("Boolean_constant") | N("Bit_constant") | N("Integer") | N("Real") | N("Manifest_string") | N("Character_constant") | N("Wide_character_constant") | N("Wide_manifest_string") | N("Hexadecimal_constant"));
N("Boolean_expression") ::= N("Expression");
N("Operator_expression") ::= (N("Parenthesized") | N("Unary_expression") | N("Binary_expression"));
N("Parenthesized") ::= ("(" N("Expression") ")");
N("Unary_expression") ::= (N("Prefix_operator") N("Expression"));
N("Binary_expression") ::= (N("Expression") N("Infix_operator") N("Expression"));
N("Equality") ::= (N("Expression") N("Comparison") N("Expression"));
N("Comparison") ::= ("=" | "/=");
N("Manifest_constant") ::= (N("Boolean_constant") | N("Character_constant") | N("Integer_constant") | N("Real_constant") | N("Manifest_string") | N("Bit_constant") | N("Wide_character_constant") | N("Wide_manifest_string") | N("Hexadecimal_constant"));
N("Boolean_constant") ::= ("True" | "False");
N("Integer_constant") ::= ([N("Sign")] N("Integer"));
N("Real_constant") ::= ([N("Sign")] N("Real"));
N("Sign") ::= ("+" | "-");
N("Wide_character_constant") ::= ("$" N("Character_constant"));
N("Wide_manifest_string") ::= ("$" N("Manifest_string"));
N("Manifest_array") ::= ("<<" N("Expression_list") ">>");
N("Expression_list") ::= ((N("Expression") ","))*;
N("Old") ::= ("old" N("Expression"));
N("Strip") ::= ("Strip" "(" N("Attribute_list") ")");
N("Attribute_list") ::= ((N("Attribute") ","))*;
