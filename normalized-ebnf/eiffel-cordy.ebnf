N("program") ::= (N("Class_declaration"))*;
N("Class_declaration") ::= ([N("Indexing")] N("NL") N("Class_header") [N("Formal_generics")] (N("NL") N("IN")) [N("Obsolete")] [N("Inheritance")] [N("Creators")] [N("Features")] [N("Invariant")] N("EX") "end");
N("Indexing") ::= (N("NL") "indexing" N("Index_list"));
N("Index_list") ::= ((N("NL") N("IN")) (N("Index_clause_Separator"))* N("EX"));
N("Index_clause_Separator") ::= (N("Index_clause") N("Separator"));
N("Index_clause") ::= ([N("Index")] N("Index_terms"));
N("Index") ::= (N("Identifier") ":");
N("Index_terms") ::= sep*(N("Index_value"), ",");
N("Index_value") ::= ((N("Identifier"))+ | N("Manifest_constant"));
N("Class_header") ::= ([N("Header_mark")] "class" N("Class_name"));
N("Header_mark") ::= ("deferred" | "expanded");
N("Class_name") ::= N("Identifier");
N("Formal_generics") ::= ("[" N("Formal_generic_list") "]");
N("Formal_generic_list") ::= sep*(N("Formal_generic"), ",");
N("Formal_generic") ::= (N("Formal_generic_name") [N("Constraint")]);
N("Formal_generic_name") ::= N("Identifier");
N("Constraint") ::= ("->" N("Restricted_type"));
N("Obsolete") ::= ("obsolete" N("Message") N("NL"));
N("Message") ::= N("Manifest_string");
N("Features") ::= (N("feature_Feature_clause"))+;
N("feature_Feature_clause") ::= (N("NL") "feature" [N("Clients")] N("Feature_clause"));
N("Feature_clause") ::= ([N("Header_comment")] N("Feature_declaration_list"));
N("Feature_declaration_list") ::= ((N("IN") N("NL")) (N("Feature_declaration_Separator"))* N("EX"));
N("Feature_declaration_Separator") ::= ((N("Feature_declaration") N("Separator")) | (N("Routine_feature_declaration") N("Separator")));
N("Header_comment") ::= N("Comment");
N("Feature_declaration") ::= (N("New_feature_list") N("Declaration_body"));
N("Declaration_body") ::= ([N("Formal_arguments")] [N("Type_mark")] [N("is_Constant")]);
N("is_Constant") ::= ("is" N("Feature_value"));
N("Feature_value") ::= (N("Manifest_constant") | N("Unique"));
N("Routine_feature_declaration") ::= (N("NL") N("New_feature_list") N("Routine_declaration_body"));
N("Routine_declaration_body") ::= ([N("Formal_arguments")] [N("Type_mark")] [N("is_Routine")]);
N("is_Routine") ::= ("is" N("NL") N("Routine"));
N("New_feature_list") ::= (N("New_feature"))+;
N("New_feature") ::= (["frozen"] N("Feature_name"));
N("Feature_name") ::= (N("Identifier") | N("Prefix") | N("Infix"));
N("Prefix") ::= ("prefix" N("Prefix_name"));
N("Infix") ::= ("infix" N("Infix_name"));
N("Prefix_name") ::= N("Manifest_string");
N("Infix_name") ::= N("Manifest_string");
N("Unary") ::= ("not" | "+" | "-");
N("Binary") ::= ("+" | "-" | "*" | "/" | "<" | ">" | "<=" | ">=" | "//" | "\\\\" | "^" | "and" | "or" | "xor" | ("and" "then") | ("or" "else") | "implies");
N("Inheritance") ::= ("inherit" (N("NL") N("IN")) N("Parent_list") N("EX"));
N("Parent_list") ::= (N("Parent_Separator"))*;
N("Parent_Separator") ::= (N("Parent") N("Separator"));
N("Parent") ::= (N("Restricted_class_type") [N("Feature_adaptation")]);
N("Feature_adaptation") ::= ((N("NL") N("IN")) [N("Rename")] [N("New_exports")] [N("Undefine")] [N("Redefine")] [N("Select")] N("EX") "end");
N("Rename") ::= ("rename" N("Rename_list") N("NL"));
N("Rename_list") ::= sep*(N("Rename_pair"), ",");
N("Rename_pair") ::= (N("Feature_name") "as" N("Feature_name"));
N("Clients") ::= ("{" N("Class_list") "}");
N("Class_list") ::= sep*(N("Class_name"), ",");
N("New_exports") ::= ("export" N("New_export_list") N("NL"));
N("New_export_list") ::= (N("New_export_item_Separator"))*;
N("New_export_item_Separator") ::= (N("New_export_item") N("Separator"));
N("New_export_item") ::= (N("Clients") N("Feature_set"));
N("Feature_set") ::= (N("Feature_list") | "all");
N("Feature_list") ::= ((N("IN") N("NL")) sep*(N("Feature_name"), ",") N("EX"));
N("Formal_arguments") ::= ("(" N("Formal_entity_declaration_list") ")");
N("Formal_entity_declaration_list") ::= (N("Formal_entity_declaration_group_Separator"))*;
N("Formal_entity_declaration_group_Separator") ::= (N("Entity_declaration_group") [";"]);
N("Entity_declaration_list") ::= ((N("IN") N("NL")) (N("Entity_declaration_group_Separator"))* N("EX"));
N("Entity_declaration_group_Separator") ::= (N("Entity_declaration_group") N("Separator"));
N("Entity_declaration_group") ::= (N("Identifier_list") N("Type_mark"));
N("Identifier_list") ::= (N("Identifier"))+;
N("Type_mark") ::= (":" N("Type"));
N("Routine") ::= ([N("Obsolete")] [N("Header_comment")] [N("Precondition")] [N("Local_declarations")] N("Routine_body") [N("Postcondition")] [N("Rescue")] "end");
N("Routine_body") ::= (N("Effective") | N("Deferred"));
N("Effective") ::= (N("Internal") | N("External"));
N("Internal") ::= (N("Routine_mark") N("Compound"));
N("Routine_mark") ::= ("do" | "once");
N("Deferred") ::= (N("IN") "deferred" (N("NL") N("EX")));
N("Local_declarations") ::= ("local" N("Entity_declaration_list"));
N("Instruction") ::= (N("Creation") | N("Call") | N("Assignment") | N("Assignment_attempt") | N("Conditional") | N("Multi_branch") | N("Loop") | N("Debug") | N("Check") | N("Retry") | N("Null"));
N("Precondition") ::= ("require" ["else"] N("Assertion"));
N("Postcondition") ::= ("ensure" ["then"] N("Assertion"));
N("Invariant") ::= ("invariant" N("Assertion"));
N("Assertion") ::= ((N("NL") N("IN")) (N("Assertion_clause_Separator"))* N("EX"));
N("Assertion_clause_Separator") ::= (N("Assertion_clause") N("Separator"));
N("Assertion_clause") ::= ([N("Tag_mark")] N("Unlabeled_assertion_clause"));
N("Unlabeled_assertion_clause") ::= (N("Boolean_expression") | N("Comment"));
N("Tag_mark") ::= (N("Tag") ":");
N("Tag") ::= N("Identifier");
N("Old") ::= ("old" N("Expression"));
N("Check") ::= ("check" N("Assertion") "end");
N("Variant") ::= ("variant" [N("Tag_mark")] N("Expression"));
N("Redefine") ::= ("redefine" N("Feature_list") N("NL"));
N("Undefine") ::= ("undefine" N("Feature_list") N("NL"));
N("Select") ::= ("select" N("Feature_list") N("NL"));
N("Type") ::= (N("Class_type") | N("Class_type_expanded") | N("Formal_generic_name") | N("Anchored") | N("Bit_type"));
N("Class_type") ::= (N("Class_name") [N("Actual_generics")]);
N("Actual_generics") ::= ("[" N("Type_list") "]");
N("Type_list") ::= sep*(N("Type"), ",");
N("Class_type_expanded") ::= ("expanded" N("Class_type"));
N("Bit_type") ::= ("BIT" N("Constant"));
N("Anchored") ::= ("like" N("Anchor"));
N("Anchor") ::= (N("Identifier") | "Current");
N("Restricted_type") ::= (N("Restricted_class_type") | N("Formal_generic_name"));
N("Restricted_class_type") ::= (N("Class_name") [N("Restricted_actual_generics")]);
N("Restricted_actual_generics") ::= ("[" N("Restricted_type_list") "]");
N("Restricted_type_list") ::= sep*(N("Restricted_type"), ",");
N("Compound") ::= ((N("IN") N("NL")) (N("Instruction_Separator"))* N("EX"));
N("Instruction_Separator") ::= (N("Instruction") N("Separator"));
N("Separator") ::= ([";"] N("NL"));
N("Null") ::= (";" N("NL"));
N("Conditional") ::= ("if" N("Then_part_list") [N("Else_part")] "end");
N("Then_part_list") ::= (N("Then_part") (N("elseif_Then_part"))*);
N("elseif_Then_part") ::= ("elseif" N("Then_part"));
N("Then_part") ::= (N("Boolean_expression") "then" N("Compound"));
N("Else_part") ::= ("else" N("Compound"));
N("Multi_branch") ::= ("inspect" N("Expression") [N("When_part_list")] [N("Else_part")] "end");
N("When_part_list") ::= (N("when_When_part"))+;
N("when_When_part") ::= ("when" N("When_part"));
N("When_part") ::= (N("Choices") "then" N("Compound"));
N("Choices") ::= sep*(N("Choice"), ",");
N("Choice") ::= (N("Constant") | N("Interval"));
N("Interval") ::= (N("Constant") ".." N("Constant"));
N("Loop") ::= (N("Initialization") [N("Invariant")] [N("Variant")] N("Loop_body") "end");
N("Initialization") ::= ("from" N("Compound"));
N("Loop_body") ::= (N("Exit") N("NL") "loop" N("Compound"));
N("Exit") ::= ("until" N("Boolean_expression"));
N("Debug") ::= ("debug" [N("Debug_keys")] N("Compound") "end");
N("Debug_keys") ::= ("(" N("Debug_key_list") ")");
N("Debug_key_list") ::= sep*(N("Debug_key"), ",");
N("Debug_key") ::= N("Manifest_string");
N("Rescue") ::= ("rescue" N("Compound"));
N("Retry") ::= "retry";
N("Unique") ::= "unique";
N("Entity") ::= (N("Writable") | N("Read_only"));
N("Writable") ::= (N("Attribute") | N("Local"));
N("Attribute") ::= N("Identifier");
N("Local") ::= (N("Identifier") | "Result");
N("Read_only") ::= (N("Formal") | "Current");
N("Formal") ::= N("Identifier");
N("Creators") ::= (N("creation_Creation_clause"))+;
N("creation_Creation_clause") ::= (N("NL") "creation" N("Creation_clause"));
N("Creation_clause") ::= ([N("Clients")] [N("Header_comment")] N("Feature_list") N("NL"));
N("Creation") ::= (("!!" N("Writable") [N("Creation_call")]) | ("!" [N("Type")] "!" N("Writable") [N("Creation_call")]));
N("Creation_call") ::= ("." N("Unqualified_call"));
N("Assignment") ::= (N("Writable") ":=" N("Expression"));
N("Assignment_attempt") ::= (N("Writable") "?=" N("Expression"));
N("Call") ::= ([N("Parenthesized_qualifier")] N("Call_chain"));
N("Parenthesized_qualifier") ::= (N("Parenthesized") ".");
N("Call_chain") ::= (N("Unqualified_call") (N("dot_Unqualified_call"))*);
N("dot_Unqualified_call") ::= ("." N("Unqualified_call"));
N("Unqualified_call") ::= (N("Entity") [N("Actuals")]);
N("Actuals") ::= ("(" N("Actual_list") ")");
N("Actual_list") ::= sep*(N("Actual"), ",");
N("Actual") ::= (N("Expression") | N("Address"));
N("Address") ::= ("$" N("Address_mark"));
N("Address_mark") ::= (N("Feature_name") | "Current" | "Result");
N("Expression") ::= N("Equality");
N("Primitive_expression") ::= (N("Call") | N("Manifest_constant") | N("Manifest_array") | N("Old") | N("Strip") | N("Parenthesized"));
N("Boolean_expression") ::= N("Expression");
N("Equality") ::= (N("Operator_expression") (N("Comparison_Operator_expression"))*);
N("Comparison_Operator_expression") ::= (N("Comparison") N("Operator_expression"));
N("Comparison") ::= ("=" | "/=");
N("Operator_expression") ::= (N("Parenthesized") | N("Binary_expression"));
N("Parenthesized") ::= ("(" N("Expression") ")");
N("Unary_expression") ::= ((N("Prefix_operator"))* N("Primitive_expression"));
N("Binary_expression") ::= (N("Unary_expression") (N("Infix_operator_Unary_expression"))*);
N("Infix_operator_Unary_expression") ::= (N("Infix_operator") N("Unary_expression"));
N("Prefix_operator") ::= (N("Unary") | N("Free_operator"));
N("Infix_operator") ::= (N("Binary") | N("Free_operator"));
N("Constant") ::= (N("Manifest_constant") | N("Constant_attribute"));
N("Constant_attribute") ::= N("Entity");
N("Manifest_constant") ::= (N("Boolean_constant") | N("Character_constant") | N("Integer_constant") | N("Real_constant") | N("Manifest_string") | N("Bit_constant"));
N("Sign") ::= ("+" | "-");
N("Integer_constant") ::= ([N("Sign")] N("Integer"));
N("Real_constant") ::= ([N("Sign")] N("Real"));
N("Boolean_constant") ::= ("true" | "false");
N("Bit_constant") ::= N("Bit_sequence");
N("Manifest_array") ::= ("<<" N("Expression_list") ">>");
N("Expression_list") ::= sep*(N("Expression"), ",");
N("Strip") ::= ("strip" "(" N("Attribute_list") ")");
N("Attribute_list") ::= sep*(N("Identifier"), ",");
N("External") ::= ("external" N("Language_name") [N("External_name")] N("NL"));
N("Language_name") ::= N("Manifest_string");
N("External_name") ::= ("alias" N("Manifest_string"));
N("Identifier") ::= N("id");
N("Manifest_string") ::= N("string");
N("Comment") ::= N("comment");
N("Character_constant") ::= N("character_constant");
N("Integer") ::= N("integer");
N("Real") ::= N("real_number");
N("Bit_sequence") ::= N("bit_sequence");
N("Free_operator") ::= N("free_operator");
