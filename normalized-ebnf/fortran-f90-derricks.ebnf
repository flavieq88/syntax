@root N("ExecutableProgram");

N("ExecutableProgram") ::= ([N("StartCommentBlock")] (N("ProgramUnit"))+);
N("ProgramUnit") ::= (N("MainProgram") | N("FunctionSubprogram") | N("SubroutineSubprogram") | N("Module") | N("BlockDataSubprogram"));
N("MainProgram") ::= ([N("ProgramStmt")] N("MainRange"));
N("ProgramStmt") ::= (N("LblDef") "program" N("ProgramName") N("EOS"));
N("LblDef") ::= [N("Label")];
N("ProgramName") ::= N("Ident");
N("MainRange") ::= (((N("BodyConstruct"))+ N("EndProgramStmt")) | (N("InternalSubProgPart") N("EndProgramStmt")) | N("EndProgramStmt"));
N("BodyConstruct") ::= (N("SpecificationPartConstruct") | N("ExecutableConstruct"));
N("SpecificationPartConstruct") ::= (N("ImplicitStmt") | N("ParameterStmt") | N("FormatStmt") | N("EntryStmt") | N("DeclarationConstruct") | N("UseStmt"));
N("ImplicitStmt") ::= ((N("LblDef") "implicit" "none" N("EOS")) | (N("LblDef") "implicit" N("ImplicitSpec") (("," N("ImplicitSpec")))* N("EOS")));
N("ImplicitSpec") ::= (N("TypeSpec") "(" N("LetterSpec") (("," N("LetterSpec")))* ")");
N("TypeSpec") ::= (("integer" N("KindSelector")) | ("real" N("KindSelector")) | ("double" "precision") | ("complex" N("KindSelector")) | ("character" N("CharSelector")) | ("logical" N("KindSelector")) | ("type" "(" N("TypeName") ")") | "integer" | "real" | "complex" | "logical" | "character" | ("character" N("LengthSelector")));
N("KindSelector") ::= (("(" [("kind" "=")] N("Expr") ")") | ("*" N("Icon")));
N("Expr") ::= ([(N("Expr") N("DefinedBinaryOp"))] N("Level5Expr"));
N("DefinedBinaryOp") ::= N("Dop");
N("Level5Expr") ::= ([(N("Level5Expr") N("EquivOp"))] N("EquivOperand"));
N("EquivOp") ::= (".eqv." | ".neqv.");
N("EquivOperand") ::= ([(N("EquivOperand") N("OrOp"))] N("OrOperand"));
N("OrOp") ::= ".or.";
N("OrOperand") ::= ([(N("OrOperand") N("AndOp"))] N("AndOperand"));
N("AndOp") ::= ".and.";
N("AndOperand") ::= ([N("NotOp")] N("Level4Expr"));
N("NotOp") ::= ".not.";
N("Level4Expr") ::= ([(N("Level3Expr") N("RelOp"))] N("Level3Expr"));
N("Level3Expr") ::= ([(N("Level3Expr") N("ConcatOp"))] N("Level2Expr"));
N("ConcatOp") ::= "//";
N("Level2Expr") ::= (([(N("Level2Expr") N("AddOp"))] N("AddOperand")) | (N("Sign") N("AddOperand")));
N("AddOp") ::= ("+" | "-");
N("AddOperand") ::= ([(N("AddOperand") N("MultOp"))] N("MultOperand"));
N("MultOp") ::= ("*" | "/");
N("MultOperand") ::= (N("Level1Expr") [(N("PowerOp") N("MultOperand"))]);
N("Level1Expr") ::= ([N("DefinedUnaryOp")] N("Primary"));
N("DefinedUnaryOp") ::= N("Dop");
N("Primary") ::= (N("ArrayConstructor") | N("UnsignedArithmeticConstant") | N("Name") | N("DataRef") | N("FunctionReference") | ("(" N("Expr") ")") | N("Scon") | N("LogicalConstant"));
N("ArrayConstructor") ::= ("(/" N("AcValueList") "/)");
N("AcValueList") ::= (N("AcValue") (("," N("AcValue")))*);
N("AcValue") ::= (N("Expr") | N("AcImpliedDo"));
N("AcImpliedDo") ::= (("(" N("Expr") "," N("ImpliedDoVariable") "=" N("Expr") "," N("Expr") ")") | ("(" N("Expr") "," N("ImpliedDoVariable") "=" N("Expr") "," N("Expr") "," N("Expr") ")") | ("(" N("AcImpliedDo") "," N("ImpliedDoVariable") "=" N("Expr") "," N("Expr") ")") | ("(" N("AcImpliedDo") "," N("ImpliedDoVariable") "=" N("Expr") "," N("Expr") "," N("Expr") ")"));
N("ImpliedDoVariable") ::= N("Ident");
N("UnsignedArithmeticConstant") ::= ((N("Icon") "_" N("KindParam")) | (N("Rcon") "_" N("KindParam")) | N("Icon") | N("Rcon") | N("ComplexConst"));
N("KindParam") ::= (N("Icon") | N("NamedConstantUse"));
N("NamedConstantUse") ::= N("Ident");
N("ComplexConst") ::= ("(" N("Expr") "," N("Expr") ")");
N("Name") ::= N("Ident");
N("DataRef") ::= ((N("Name") "%" N("Name")) | (N("DataRef") "%" N("Name")) | (N("Name") "(" N("SectionSubscriptList") ")") | (N("DataRef") "(" N("SectionSubscriptList") ")"));
N("SectionSubscriptList") ::= (N("SectionSubscript") (("," N("SectionSubscript")))*);
N("SectionSubscript") ::= (N("Expr") | N("SubscriptTriplet"));
N("SubscriptTriplet") ::= ([N("Expr")] ":" [N("Expr")] [(":" N("Expr"))]);
N("FunctionReference") ::= (N("Name") "(" [N("FunctionArgList")] ")");
N("FunctionArgList") ::= (N("FunctionArg") | (N("FunctionArgList") "," N("FunctionArg")) | (N("SectionSubscriptList") "," N("FunctionArg")));
N("FunctionArg") ::= (N("Name") "=" N("Expr"));
N("LogicalConstant") ::= ((".true." "_" N("KindParam")) | (".false." "_" N("KindParam")) | ".true." | ".false.");
N("PowerOp") ::= "**";
N("Sign") ::= ("+" | "-");
N("RelOp") ::= ("==" | "/=" | "<" | "<=" | ">" | ">=" | ".eq." | ".ne." | ".lt." | ".le." | ".gt." | ".ge.");
N("CharSelector") ::= (("(" "len" "=" N("TypeParamValue") "," "kind" "=" N("Expr") ")") | ("(" "len" "=" N("TypeParamValue") "," N("Expr") ")") | ("(" "len" "=" N("TypeParamValue") ")") | ("(" [("kind" "=")] N("Expr") ")"));
N("TypeParamValue") ::= (N("SpecificationExpr") | "*");
N("SpecificationExpr") ::= N("Expr");
N("TypeName") ::= N("Ident");
N("LengthSelector") ::= (("(" N("TypeParamValue") ")") | ("*" N("CharLength")));
N("CharLength") ::= (("(" N("TypeParamValue") ")") | N("ScalarIntLiteralConstant"));
N("LetterSpec") ::= (N("Letter") [("-" N("Letter"))]);
N("ParameterStmt") ::= (N("LblDef") "parameter" "(" N("NamedConstantDefList") ")" N("EOS"));
N("NamedConstantDefList") ::= (N("NamedConstantDef") (("," N("NamedConstantDef")))*);
N("NamedConstantDef") ::= (N("NamedConstant") "=" N("Expr"));
N("NamedConstant") ::= N("Ident");
N("FormatStmt") ::= (N("LblDef") "format" "(" [N("FormatItemList")] ")" N("EOS"));
N("FormatItemList") ::= (N("FormatItem") (("," N("FormatItem")))*);
N("FormatItem") ::= (([N("Icon")] N("DataEditDescr")) | N("ControlEditDescr") | N("CharStringEditDescr") | ([N("Icon")] "(" N("FormatItemList") ")") | (N("FormatItem") ":" N("FormatItem")));
N("DataEditDescr") ::= (("I" N("Icon") [("." N("Icon"))]) | ("O" N("Icon") [("." N("Icon"))]) | ("B" N("Icon") [("." N("Icon"))]) | ("Z" N("Icon") [("." N("Icon"))]) | ("F" N("Icon") "." N("Icon")) | ("E" N("Icon") "." N("Icon") [("E" N("Icon"))]) | ("EN" N("Icon") "." N("Icon") [("E" N("Icon"))]) | ("ES" N("Icon") "." N("Icon") [("E" N("Icon"))]) | ("G" N("Icon") "." N("Icon") [("E" N("Icon"))]) | ("L" N("Icon")) | ("A" [N("Icon")]) | ("D" N("Icon") "." N("Icon")));
N("ControlEditDescr") ::= (N("PositionEditDescr") | ([N("Icon")] "/") | ":" | N("SignEditDescr") | ([("-" | "+")] N("Icon") "P" [([N("Icon")] N("DataEditDescr"))]) | N("BlankInterpEditDescr"));
N("PositionEditDescr") ::= (("T" N("Icon")) | ("TL" N("Icon")) | ("TR" N("Icon")) | (N("Icon") "X"));
N("SignEditDescr") ::= ("S" | "SP" | "SS");
N("BlankInterpEditDescr") ::= ("BN" | "BZ");
N("CharStringEditDescr") ::= (N("Scon") | (N("Icon") "H" (N("Character"))+));
N("EntryStmt") ::= ((N("LblDef") "entry" N("EntryName") N("SubroutineParList") N("EOS")) | (N("LblDef") "entry" N("EntryName") N("SubroutineParList") "result" "(" N("Name") ")" N("EOS")));
N("EntryName") ::= N("Ident");
N("SubroutineParList") ::= ("(" [(N("SubroutinePar") (("," N("SubroutinePar")))*)] ")");
N("SubroutinePar") ::= (N("DummyArgName") | "*");
N("DummyArgName") ::= N("Ident");
N("DeclarationConstruct") ::= (N("TypeDeclarationStmt") | N("SpecificationStmt") | N("DerivedTypeDef") | N("InterfaceBlock"));
N("TypeDeclarationStmt") ::= ((N("LblDef") N("TypeSpec") (("," N("AttrSpec")))* ":" ":" N("EntityDecl") (("," N("EntityDecl")))* N("EOS")) | (N("LblDef") N("TypeSpec") N("EntityDecl") (("," N("EntityDecl")))* N("EOS")));
N("AttrSpec") ::= ("parameter" | N("AccessSpec") | "allocatable" | ("dimension" "(" N("ArraySpec") ")") | "external" | ("intent" "(" N("IntentSpec") ")") | "intrinsic" | "optional" | "pointer" | "save" | "target");
N("AccessSpec") ::= ("public" | "private");
N("ArraySpec") ::= (N("AssumedShapeSpecList") | N("DeferredShapeSpecList") | N("ExplicitShapeSpecList") | N("AssumedSizeSpec"));
N("AssumedShapeSpecList") ::= ((N("LowerBound") ":") | (N("DeferredShapeSpecList") "," N("LowerBound") ":") | (N("AssumedShapeSpecList") "," N("AssumedShapeSpec")));
N("LowerBound") ::= N("SpecificationExpr");
N("DeferredShapeSpecList") ::= (N("DeferredShapeSpec") (("," N("DeferredShapeSpec")))*);
N("DeferredShapeSpec") ::= ":";
N("AssumedShapeSpec") ::= ([N("LowerBound")] ":");
N("ExplicitShapeSpecList") ::= (N("ExplicitShapeSpec") (("," N("ExplicitShapeSpec")))*);
N("ExplicitShapeSpec") ::= ([(N("LowerBound") ":")] N("UpperBound"));
N("UpperBound") ::= N("SpecificationExpr");
N("AssumedSizeSpec") ::= (([(N("LowerBound") ":")] "*") | (N("ExplicitShapeSpecList") "," "*") | (N("ExplicitShapeSpecList") "," N("LowerBound") ":" "*"));
N("IntentSpec") ::= ("in" | "out" | ("in" "out"));
N("EntityDecl") ::= ((N("ObjectName") "=" N("Expr")) | (N("ObjectName") "(" N("ArraySpec") ")" "=" N("Expr")) | (N("ObjectName") "*" N("CharLength") "=" N("Expr")) | (N("ObjectName") "*" N("CharLength") "(" N("ArraySpec") ")" "=" N("Expr")) | N("ObjectName") | (N("ObjectName") "*" N("CharLength")) | (N("ObjectName") "(" N("ArraySpec") ")") | (N("ObjectName") "(" N("ArraySpec") ")" "*" N("CharLength")));
N("ObjectName") ::= N("Ident");
N("SpecificationStmt") ::= (N("AccessStmt") | N("AllocatableStmt") | N("CommonStmt") | N("DataStmt") | N("DimensionStmt") | N("EquivalenceStmt") | N("ExternalStmt") | N("IntrinsicStmt") | N("SaveStmt") | N("IntentStmt") | N("NamelistStmt") | N("OptionalStmt") | N("PointerStmt") | N("TargetStmt"));
N("AccessStmt") ::= ((N("LblDef") N("AccessSpec") ":" ":" N("AccessIdList") N("EOS")) | (N("LblDef") N("AccessSpec") [N("AccessIdList")] N("EOS")));
N("AccessIdList") ::= (N("AccessId") (("," N("AccessId")))*);
N("AccessId") ::= (N("GenericName") | N("GenericSpec"));
N("GenericName") ::= N("Ident");
N("GenericSpec") ::= (("operator" "(" N("DefinedOperator") ")") | ("assignment" "(" "=" ")"));
N("DefinedOperator") ::= (N("Dop") | N("PowerOp") | N("MultOp") | N("AddOp") | N("ConcatOp") | N("RelOp") | N("NotOp") | N("AndOp") | N("OrOp") | N("EquivOp"));
N("AllocatableStmt") ::= ((N("LblDef") "allocatable" ":" ":" N("ArrayAllocationList") N("EOS")) | (N("LblDef") "allocatable" N("ArrayAllocationList") N("EOS")));
N("ArrayAllocationList") ::= (N("ArrayAllocation") (("," N("ArrayAllocation")))*);
N("ArrayAllocation") ::= (N("ArrayName") [("(" N("DeferredShapeSpecList") ")")]);
N("ArrayName") ::= N("Ident");
N("CommonStmt") ::= (N("LblDef") "common" [N("Comblock")] N("CommonBlockObjectList") (([","] N("Comblock") N("CommonBlockObjectList")))* N("EOS"));
N("Comblock") ::= ("/" [N("CommonBlockName")] "/");
N("CommonBlockName") ::= N("Ident");
N("CommonBlockObjectList") ::= (N("CommonBlockObject") (("," N("CommonBlockObject")))*);
N("CommonBlockObject") ::= (N("VariableName") | N("ArrayDeclarator"));
N("VariableName") ::= N("Ident");
N("ArrayDeclarator") ::= (N("VariableName") "(" N("ArraySpec") ")");
N("DataStmt") ::= (N("LblDef") "data" N("Datalist") N("EOS"));
N("Datalist") ::= (N("DataStmtSet") (("," N("DataStmtSet")))*);
N("DataStmtSet") ::= (N("DataStmtObjectList") "/" N("DataStmtValueList") "/");
N("DataStmtObjectList") ::= (N("DataStmtObject") (("," N("DataStmtObject")))*);
N("DataStmtObject") ::= (N("Variable") | N("DataImpliedDo"));
N("Variable") ::= (N("VariableName") | (N("VariableName") "(" N("Subscript") (("," N("Subscript")))* ")") | (N("VariableName") N("SubstringRange")) | (N("VariableName") "(" N("Subscript") (("," N("Subscript")))* ")" N("SubstringRange")));
N("Subscript") ::= N("Expr");
N("SubstringRange") ::= ("(" N("SubscriptTriplet") ")");
N("DataImpliedDo") ::= ("(" N("DataIDoObjectList") "," N("ImpliedDoVariable") "=" N("Expr") "," N("Expr") [("," N("Expr"))] ")");
N("DataIDoObjectList") ::= (N("DataIDoObject") (("," N("DataIDoObject")))*);
N("DataIDoObject") ::= (N("ArrayElement") | N("DataImpliedDo") | N("StructureComponent"));
N("ArrayElement") ::= ((N("StructureComponent") "(" N("SectionSubscriptList") ")") | (N("VariableName") "(" N("SectionSubscriptList") ")"));
N("StructureComponent") ::= ((N("VariableName") N("FieldSelector")) | (N("StructureComponent") N("FieldSelector")));
N("FieldSelector") ::= (("(" N("SectionSubscriptList") ")" "%" N("Name")) | ("%" N("Name")));
N("DataStmtValueList") ::= (N("DataStmtValue") (("," N("DataStmtValue")))*);
N("DataStmtValue") ::= (N("Constant") | (N("NamedConstantUse") "*" N("Constant")));
N("Constant") ::= (N("NamedConstantUse") | N("UnsignedArithmeticConstant") | ("+" N("UnsignedArithmeticConstant")) | ("-" N("UnsignedArithmeticConstant")) | N("Scon") | N("LogicalConstant") | (N("Icon") "_" N("Scon")) | (N("NamedConstantUse") "_" N("Scon")) | N("StructureConstructor") | N("BozLiteralConstant"));
N("StructureConstructor") ::= (N("TypeName") "(" N("Expr") (("," N("Expr")))* ")");
N("BozLiteralConstant") ::= (N("BinaryConstant") | N("OctalConstant") | N("HexConstant"));
N("DimensionStmt") ::= ((N("LblDef") "dimension" ":" ":" N("ArrayDeclaratorList") N("EOS")) | (N("LblDef") "dimension" N("ArrayDeclaratorList") N("EOS")));
N("ArrayDeclaratorList") ::= (N("ArrayDeclarator") (("," N("ArrayDeclarator")))*);
N("EquivalenceStmt") ::= (N("LblDef") "equivalence" N("EquivalenceSetList") N("EOS"));
N("EquivalenceSetList") ::= (N("EquivalenceSet") (("," N("EquivalenceSet")))*);
N("EquivalenceSet") ::= ("(" N("EquivalenceObject") "," N("EquivalenceObject") (("," N("EquivalenceObject")))* ")");
N("EquivalenceObject") ::= (N("ArrayName") | N("Variable"));
N("ExternalStmt") ::= (N("LblDef") "external" N("ExternalName") (("," N("ExternalName")))* N("EOS"));
N("ExternalName") ::= N("Ident");
N("IntrinsicStmt") ::= (N("LblDef") "intrinsic" N("IntrinsicProcedureName") (("," N("IntrinsicProcedureName")))* N("EOS"));
N("IntrinsicProcedureName") ::= N("Ident");
N("SaveStmt") ::= ((N("LblDef") "save" ":" ":" N("SavedEntityList") N("EOS")) | (N("LblDef") "save" [N("SavedEntityList")] N("EOS")));
N("SavedEntityList") ::= (N("SavedEntity") (("," N("SavedEntity")))*);
N("SavedEntity") ::= (N("VariableName") | ("/" N("CommonBlockName") "/"));
N("IntentStmt") ::= ((N("LblDef") "intent" "(" N("IntentSpec") ")" ":" ":" N("IntentParList") N("EOS")) | (N("LblDef") "intent" "(" N("IntentSpec") ")" N("IntentParList") N("EOS")));
N("IntentParList") ::= (N("IntentPar") (("," N("IntentPar")))*);
N("IntentPar") ::= N("DummyArgName");
N("NamelistStmt") ::= (N("LblDef") "namelist" N("NamelistGroup") (([","] N("NamelistGroup")))* N("EOS"));
N("NamelistGroup") ::= ("/" N("NamelistGroupName") "/" N("NamelistGroupObject") (("," N("NamelistGroupObject")))*);
N("NamelistGroupName") ::= N("Ident");
N("NamelistGroupObject") ::= N("VariableName");
N("OptionalStmt") ::= ((N("LblDef") "optional" ":" ":" N("OptionalParList") N("EOS")) | (N("LblDef") "optional" N("OptionalParList") N("EOS")));
N("OptionalParList") ::= (N("OptionalPar") (("," N("OptionalPar")))*);
N("OptionalPar") ::= N("DummyArgName");
N("PointerStmt") ::= ((N("LblDef") "pointer" ":" ":" N("PointerStmtObjectList") N("EOS")) | (N("LblDef") "pointer" N("PointerStmtObjectList") N("EOS")));
N("PointerStmtObjectList") ::= (N("PointerStmtObject") (("," N("PointerStmtObject")))*);
N("PointerStmtObject") ::= (N("ObjectName") | (N("ObjectName") "(" N("DeferredShapeSpecList") ")"));
N("TargetStmt") ::= ((N("LblDef") "target" ":" ":" N("TargetObjectList") N("EOS")) | (N("LblDef") "target" N("TargetObjectList") N("EOS")));
N("TargetObjectList") ::= (N("TargetObject") (("," N("TargetObject")))*);
N("TargetObject") ::= (N("ObjectName") | (N("ObjectName") "(" N("ArraySpec") ")"));
N("DerivedTypeDef") ::= (N("DerivedTypeStmt") (N("DerivedTypeBody"))+ N("EndTypeStmt"));
N("DerivedTypeStmt") ::= ((N("LblDef") "type" N("TypeName") N("EOS")) | (N("LblDef") "type" ":" ":" N("TypeName") N("EOS")) | (N("LblDef") "type" "," N("AccessSpec") ":" ":" N("TypeName") N("EOS")));
N("DerivedTypeBody") ::= (N("PrivateSequenceStmt") | N("ComponentDefStmt"));
N("PrivateSequenceStmt") ::= ((N("LblDef") "private" N("EOS")) | (N("LblDef") "sequence" N("EOS")));
N("ComponentDefStmt") ::= ((N("LblDef") N("TypeSpec") [("," N("ComponentAttrSpecList"))] ":" ":" N("ComponentDeclList") N("EOS")) | (N("LblDef") N("TypeSpec") N("ComponentDeclList") N("EOS")));
N("ComponentAttrSpecList") ::= (N("ComponentAttrSpec") (("," N("ComponentAttrSpec")))*);
N("ComponentAttrSpec") ::= ("pointer" | ("dimension" "(" N("ComponentArraySpec") ")"));
N("ComponentArraySpec") ::= (N("ExplicitShapeSpecList") | N("DeferredShapeSpecList"));
N("ComponentDeclList") ::= (N("ComponentDecl") (("," N("ComponentDecl")))*);
N("ComponentDecl") ::= (N("ComponentName") [("(" N("ComponentArraySpec") ")")] [("*" N("CharLength"))]);
N("ComponentName") ::= N("Ident");
N("EndTypeStmt") ::= (N("LblDef") "end" "type" [N("TypeName")] N("EOS"));
N("InterfaceBlock") ::= (N("InterfaceStmt") (N("InterfaceBlockPart"))+ N("EndInterfaceStmt"));
N("InterfaceStmt") ::= ((N("LblDef") "interface" N("GenericName") N("EOS")) | (N("LblDef") "interface" N("GenericSpec") N("EOS")) | (N("LblDef") "interface" N("EOS")));
N("InterfaceBlockPart") ::= (N("InterfaceBody") | N("ModuleProcedureStmt"));
N("InterfaceBody") ::= ((N("LblDef") N("FunctionPrefix") N("FunctionName") N("FunctionInterfaceRange")) | (N("LblDef") "subroutine" N("SubroutineName") N("SubroutineInterfaceRange")));
N("FunctionPrefix") ::= (("recursive" "function") | ("recursive" N("TypeSpec") "function") | (N("TypeSpec") "recursive" "function") | ([N("TypeSpec")] "function"));
N("FunctionName") ::= N("Ident");
N("FunctionInterfaceRange") ::= ((N("FunctionParList") N("EOS") N("SubprogramInterfaceBody") N("EndFunctionStmt")) | (N("FunctionParList") N("EOS") N("EndFunctionStmt")));
N("FunctionParList") ::= ("(" [(N("FunctionPar") (("," N("FunctionPar")))*)] ")");
N("FunctionPar") ::= N("DummyArgName");
N("SubprogramInterfaceBody") ::= (N("SpecificationPartConstruct") | (N("SubprogramInterfaceBody") N("SpecificationPartConstruct")));
N("EndFunctionStmt") ::= ((N("LblDef") "end" N("EOS")) | (N("LblDef") "end" "function" [N("EndName")] N("EOS")));
N("EndName") ::= N("Ident");
N("SubroutineName") ::= N("Ident");
N("SubroutineInterfaceRange") ::= ((N("SubroutineParList") N("EOS") N("SubprogramInterfaceBody") N("EndSubroutineStmt")) | (N("SubroutineParList") N("EOS") N("EndSubroutineStmt")));
N("EndSubroutineStmt") ::= ((N("LblDef") "end" "subroutine" [N("EndName")] N("EOS")) | (N("LblDef") "end" N("EOS")));
N("ModuleProcedureStmt") ::= (N("LblDef") "module" "procedure" N("ProcedureNameList") N("EOS"));
N("ProcedureNameList") ::= (N("ProcedureName") (("," N("ProcedureName")))*);
N("ProcedureName") ::= N("Ident");
N("EndInterfaceStmt") ::= (N("LblDef") "end" "interface" N("EOS"));
N("UseStmt") ::= ((N("LblDef") "use" N("Name") [("," N("RenameList"))] N("EOS")) | (N("LblDef") "use" N("Name") "," "only" ":" [N("OnlyList")] N("EOS")));
N("RenameList") ::= (N("Rename") (("," N("Rename")))*);
N("Rename") ::= (N("Ident") "=>" N("UseName"));
N("UseName") ::= N("Ident");
N("OnlyList") ::= (N("Only") (("," N("Only")))*);
N("Only") ::= (N("GenericSpec") | ([(N("Ident") "=>")] N("UseName")));
N("ExecutableConstruct") ::= (N("ActionStmt") | N("DoConstruct") | N("IfConstruct") | N("CaseConstruct") | N("WhereConstruct") | N("EndDoStmt"));
N("ActionStmt") ::= (N("AllocateStmt") | N("CycleStmt") | N("DeallocateStmt") | N("ExitStmt") | N("NullifyStmt") | N("PointerAssignmentStmt") | N("WhereStmt") | N("ArithmeticIfStmt") | N("AssignmentStmt") | N("AssignStmt") | N("BackspaceStmt") | N("CallStmt") | N("CloseStmt") | N("ContinueStmt") | N("EndfileStmt") | N("GotoStmt") | N("ComputedGotoStmt") | N("AssignedGotoStmt") | N("IfStmt") | N("InquireStmt") | N("OpenStmt") | N("PauseStmt") | N("PrintStmt") | N("ReadStmt") | N("ReturnStmt") | N("RewindStmt") | N("StopStmt") | N("WriteStmt"));
N("AllocateStmt") ::= ((N("LblDef") "allocate" "(" N("AllocationList") "," "stat" "=" N("Variable") ")" N("EOS")) | (N("LblDef") "allocate" "(" N("AllocationList") ")" N("EOS")));
N("AllocationList") ::= (N("Allocation") (("," N("Allocation")))*);
N("Allocation") ::= (N("AllocateObject") [N("AllocatedShape")]);
N("AllocateObject") ::= (N("VariableName") | (N("AllocateObject") N("FieldSelector")));
N("AllocatedShape") ::= ("(" N("SectionSubscriptList") ")");
N("CycleStmt") ::= (N("LblDef") "cycle" [N("EndName")] N("EOS"));
N("DeallocateStmt") ::= ((N("LblDef") "deallocate" "(" N("AllocateObjectList") "," "stat" "=" N("Variable") ")" N("EOS")) | (N("LblDef") "deallocate" "(" N("AllocateObjectList") ")" N("EOS")));
N("AllocateObjectList") ::= (N("AllocateObject") (("," N("AllocateObject")))*);
N("ExitStmt") ::= (N("LblDef") "exit" [N("EndName")] N("EOS"));
N("NullifyStmt") ::= (N("LblDef") "nullify" "(" N("PointerObjectList") ")" N("EOS"));
N("PointerObjectList") ::= (N("PointerObject") (("," N("PointerObject")))*);
N("PointerObject") ::= (N("Name") | N("PointerField"));
N("PointerField") ::= ((N("Name") "(" N("SFExprList") ")" "%" N("Name")) | (N("Name") "(" N("SFDummyArgNameList") ")" "%" N("Name")) | (N("Name") "%" N("Name")) | (N("PointerField") N("FieldSelector")));
