@root N("html");

N("id.attrib") ::= [select("id", N("ID.datatype"))];
N("class.attrib") ::= [select("class", N("NMTOKENS.datatype"))];
N("title.attrib") ::= [select("title", N("Text.datatype"))];
N("Core.attrib") ::= (N("id.attrib") N("class.attrib") N("title.attrib"));
N("lang.attrib") ::= [select("xml:lang", N("LanguageCode.datatype"))];
N("I18n.attrib") ::= N("lang.attrib");
N("Common.attrib") ::= (N("Core.attrib") N("I18n.attrib"));
N("CommonIdRequired.attrib") ::= (select("id", N("ID.datatype")) N("class.attrib") N("title.attrib") N("I18n.attrib"));
N("base") ::= select("base", N("base.attlist"));
N("base.attlist") ::= select("href", N("URI.datatype"));
N("head.content") ::= [N("base")];
N("head.content") ::= (N("link"))*;
N("head.content") ::= (N("meta"))*;
N("head.content") ::= N("title");
N("Length.datatype") ::= value("string");
N("LinkTypes.datatype") ::= N("NMTOKENS.datatype");
N("MediaDesc.datatype") ::= value("string");
N("MultiLength.datatype") ::= value("string");
N("Number.datatype") ::= value("string");
N("Pixels.datatype") ::= value("string");
N("Script.datatype") ::= value("string");
N("Text.datatype") ::= value("string");
N("Character.datatype") ::= value("string");
N("Charset.datatype") ::= value("string");
N("Charsets.datatype") ::= value("string");
N("ContentType.datatype") ::= value("string");
N("ContentTypes.datatype") ::= value("string");
N("Datetime.datatype") ::= value("string");
N("FPI.datatype") ::= value("string");
N("LanguageCode.datatype") ::= value("string");
N("URI.datatype") ::= value("string");
N("URIs.datatype") ::= value("string");
N("NMTOKEN.datatype") ::= value("string");
N("NMTOKENS.datatype") ::= value("string");
N("ID.datatype") ::= value("string");
N("IDREF.datatype") ::= value("string");
N("IDREFS.datatype") ::= value("string");
N("form") ::= select("form", (N("form.attlist") (N("Block.class"))+));
N("form.attlist") ::= (N("Common.attrib") select("action", N("URI.datatype")) [select("method", ("get" | "post"))] [select("enctype", N("ContentType.datatype"))]);
N("label") ::= select("label", (N("label.attlist") N("Inline.model")));
N("label.attlist") ::= (N("Common.attrib") [select("for", N("IDREF.datatype"))] [select("accesskey", N("Character.datatype"))]);
N("input") ::= select("input", N("input.attlist"));
N("input.attlist") ::= (N("Common.attrib") [select("type", N("InputType.class"))] [select("name", value("string"))] [select("value", value("string"))] [select("checked", "checked")] [select("size", value("string"))] [select("maxlength", N("Number.datatype"))] [select("src", N("URI.datatype"))] [select("accesskey", N("Character.datatype"))]);
N("InputType.class") ::= ("text" | "password" | "checkbox" | "radio" | "submit" | "reset" | "hidden");
N("select") ::= select("select", (N("select.attlist") (N("option"))+));
N("select.attlist") ::= (N("Common.attrib") [select("name", value("string"))] [select("size", N("Number.datatype"))] [select("multiple", "multiple")]);
N("option") ::= select("option", (N("Common.attrib") [select("selected", "selected")] [select("value", value("string"))] value("string")));
N("textarea") ::= select("textarea", N("textarea.attlist"));
N("textarea.attlist") ::= (N("Common.attrib") [select("name", value("string"))] select("rows", N("Number.datatype")) select("cols", N("Number.datatype")) [select("accesskey", N("Character.datatype"))] value("string"));
N("Form.class") ::= N("form");
N("Formctrl.class") ::= (N("input") | N("label") | N("select") | N("textarea"));
N("Block.class") ::= N("Form.class");
N("Block.class") ::= N("List.class");
N("Block.class") ::= N("table");
N("Block.class") ::= (N("address") | N("blockquote") | N("div") | N("p") | N("pre") | N("Heading.class"));
N("Inline.class") ::= N("Formctrl.class");
N("Inline.class") ::= N("a");
N("Inline.class") ::= N("img");
N("Inline.class") ::= N("object");
N("Inline.class") ::= (N("abbr") | N("acronym") | N("br") | N("cite") | N("code") | N("dfn") | N("em") | N("kbd") | N("q") | N("samp") | N("span") | N("strong") | N("var"));
N("a") ::= select("a", (N("a.attlist") N("Inline.model")));
N("a.attlist") ::= (N("Common.attrib") [select("href", N("URI.datatype"))] [select("charset", N("Charset.datatype"))] [select("type", N("ContentType.datatype"))] [select("hreflang", N("LanguageCode.datatype"))] [select("rel", N("LinkTypes.datatype"))] [select("rev", N("LinkTypes.datatype"))] [select("accesskey", N("Character.datatype"))] [select("tabindex", N("Number.datatype"))]);
N("img") ::= select("img", N("img.attlist"));
N("img.attlist") ::= (N("Common.attrib") select("src", N("URI.datatype")) select("alt", N("Text.datatype")) [select("longdesc", N("URI.datatype"))] [select("height", N("Length.datatype"))] [select("width", N("Length.datatype"))]);
N("link") ::= select("link", N("link.attlist"));
N("link.attlist") ::= (N("Common.attrib") [select("charset", N("Charset.datatype"))] [select("href", N("URI.datatype"))] [select("hreflang", N("LanguageCode.datatype"))] [select("type", N("ContentType.datatype"))] [select("rel", N("LinkTypes.datatype"))] [select("rev", N("LinkTypes.datatype"))] [select("media", N("MediaDesc.datatype"))]);
N("dl") ::= select("dl", (N("dl.attlist") ((N("dt") | N("dd")))+));
N("dl.attlist") ::= N("Common.attrib");
N("dt") ::= select("dt", (N("dt.attlist") N("Inline.model")));
N("dt.attlist") ::= N("Common.attrib");
N("dd") ::= select("dd", (N("dd.attlist") N("Flow.model")));
N("dd.attlist") ::= N("Common.attrib");
N("ol") ::= select("ol", (N("ol.attlist") (N("li"))+));
N("ol.attlist") ::= N("Common.attrib");
N("ul") ::= select("ul", (N("ul.attlist") (N("li"))+));
N("ul.attlist") ::= N("Common.attrib");
N("li") ::= select("li", (N("li.attlist") N("Flow.model")));
N("li.attlist") ::= N("Common.attrib");
N("List.class") ::= (N("ul") | N("ol") | N("dl"));
N("meta") ::= select("meta", N("meta.attlist"));
N("meta.attlist") ::= (N("I18n.attrib") [select("http-equiv", N("NMTOKEN.datatype"))] [select("name", N("NMTOKEN.datatype"))] [select("content", value("string"))] [select("scheme", value("string"))]);
N("object") ::= select("object", (N("object.attlist") (N("param"))* N("Flow.model")));
N("object.attlist") ::= (N("Common.attrib") [select("declare", "declare")] [select("classid", N("URI.datatype"))] [select("codebase", N("URI.datatype"))] [select("data", N("URI.datatype"))] [select("type", N("ContentType.datatype"))] [select("codetype", N("ContentType.datatype"))] [select("archive", N("URIs.datatype"))] [select("standby", N("Text.datatype"))] [select("height", N("Length.datatype"))] [select("width", N("Length.datatype"))] [select("name", value("string"))] [select("tabindex", N("Number.datatype"))]);
N("param") ::= select("param", N("param.attlist"));
N("param.attlist") ::= (N("id.attrib") select("name", value("string")) [select("value", value("string"))] [select("valuetype", ("data" | "ref" | "object"))] [select("type", N("ContentType.datatype"))]);
N("title") ::= select("title", (N("title.attlist") value("string")));
N("title.attlist") ::= N("I18n.attrib");
N("head") ::= select("head", (N("head.attlist") N("head.content")));
N("head.attlist") ::= (N("I18n.attrib") N("profile.attlist"));
N("profile.attlist") ::= [select("profile", N("URI.datatype"))];
N("body") ::= select("body", (N("body.attlist") N("Block.model")));
N("body.attlist") ::= N("Common.attrib");
N("html") ::= select("html", (N("html.attlist") N("head") N("body")));
N("html.attlist") ::= (N("XHTML.version.attrib") N("I18n.attrib"));
N("XHTML.version.attrib") ::= [select("version", N("FPI.datatype"))];
N("table") ::= select("table", (N("table.attlist") [N("caption")] (N("tr"))+));
N("table.attlist") ::= (N("Common.attrib") [select("summary", N("Text.datatype"))]);
N("caption") ::= select("caption", (N("caption.attlist") N("Inline.model")));
N("caption.attlist") ::= N("Common.attrib");
N("tr") ::= select("tr", (N("tr.attlist") ((N("th") | N("td")))+));
N("tr.attlist") ::= (N("Common.attrib") N("CellHAlign.attrib") N("CellVAlign.attrib"));
N("th") ::= select("th", (N("th.attlist") N("Flow.model")));
N("th.attlist") ::= N("Cell.attrib");
N("td") ::= select("td", (N("td.attlist") N("Flow.model")));
N("td.attlist") ::= N("Cell.attrib");
N("Cell.attrib") ::= (N("Common.attrib") [select("abbr", N("Text.datatype"))] [select("axis", value("string"))] [select("headers", N("IDREFS.datatype"))] N("scope.attrib") [select("rowspan", N("Number.datatype"))] [select("colspan", N("Number.datatype"))] N("CellHAlign.attrib") N("CellVAlign.attrib"));
N("CellHAlign.attrib") ::= [select("align", ("left" | "center" | "right"))];
N("CellVAlign.attrib") ::= [select("valign", ("top" | "middle" | "bottom"))];
N("scope.attrib") ::= [select("scope", ("row" | "col"))];
N("br") ::= select("br", N("br.attlist"));
N("br.attlist") ::= N("Core.attrib");
N("span") ::= select("span", (N("span.attlist") N("Inline.model")));
N("span.attlist") ::= N("Common.attrib");
N("abbr") ::= select("abbr", (N("abbr.attlist") N("Inline.model")));
N("abbr.attlist") ::= N("Common.attrib");
N("acronym") ::= select("acronym", (N("acronym.attlist") N("Inline.model")));
N("acronym.attlist") ::= N("Common.attrib");
N("cite") ::= select("cite", (N("cite.attlist") N("Inline.model")));
N("cite.attlist") ::= N("Common.attrib");
N("code") ::= select("code", (N("code.attlist") N("Inline.model")));
N("code.attlist") ::= N("Common.attrib");
N("dfn") ::= select("dfn", (N("dfn.attlist") N("Inline.model")));
N("dfn.attlist") ::= N("Common.attrib");
N("em") ::= select("em", (N("em.attlist") N("Inline.model")));
N("em.attlist") ::= N("Common.attrib");
N("kbd") ::= select("kbd", (N("kbd.attlist") N("Inline.model")));
N("kbd.attlist") ::= N("Common.attrib");
N("q") ::= select("q", (N("q.attlist") N("Inline.model")));
N("q.attlist") ::= (N("Common.attrib") [select("cite", N("URI.datatype"))]);
N("samp") ::= select("samp", (N("samp.attlist") N("Inline.model")));
N("samp.attlist") ::= N("Common.attrib");
N("strong") ::= select("strong", (N("strong.attlist") N("Inline.model")));
N("strong.attlist") ::= N("Common.attrib");
N("var") ::= select("var", (N("var.attlist") N("Inline.model")));
N("var.attlist") ::= N("Common.attrib");
N("div") ::= select("div", (N("div.attlist") N("Flow.model")));
N("div.attlist") ::= N("Common.attrib");
N("p") ::= select("p", (N("p.attlist") N("Inline.model")));
N("p.attlist") ::= N("Common.attrib");
N("address") ::= select("address", (N("address.attlist") N("Inline.model")));
N("address.attlist") ::= N("Common.attrib");
N("blockquote") ::= select("blockquote", (N("blockquote.attlist") N("Block.model")));
N("blockquote.attlist") ::= (N("Common.attrib") [select("cite", N("URI.datatype"))]);
N("pre") ::= select("pre", (N("pre.attlist") N("Inline.model")));
N("pre.attlist") ::= (N("Common.attrib") [select("xml:space", "preserve")]);
N("h1") ::= select("h1", (N("Heading.attrib") N("Heading.content")));
N("h2") ::= select("h2", (N("Heading.attrib") N("Heading.content")));
N("h3") ::= select("h3", (N("Heading.attrib") N("Heading.content")));
N("h4") ::= select("h4", (N("Heading.attrib") N("Heading.content")));
N("h5") ::= select("h5", (N("Heading.attrib") N("Heading.content")));
N("h6") ::= select("h6", (N("Heading.attrib") N("Heading.content")));
N("Heading.attrib") ::= N("Common.attrib");
N("Heading.content") ::= N("Inline.model");
N("Heading.class") ::= (N("h1") | N("h2") | N("h3") | N("h4") | N("h5") | N("h6"));
N("Inline.model") ::= ((value("string") | N("Inline.class")))*;
N("Block.mix") ::= N("Block.class");
N("Block.model") ::= (N("Block.mix"))+;
N("Flow.model") ::= ((value("string") | N("Inline.class") | N("Block.class")))*;
