N("LocatedElement") ::= N("Eclipse");
N("LocatedElement") ::= N("Bundle");
N("LocatedElement") ::= N("RequireBundleAttribute");
N("LocatedElement") ::= N("Version");
N("LocatedElement") ::= N("RequiredBundle");
N("LocatedElement") ::= N("ImportedPackage");
N("LocatedElement") ::= N("ExportedPackage");
N("LocatedElement") ::= N("Package");
N("LocatedElement") ::= N("Xfriends");
N("Resolution") ::= (select("Mandatory", epsilon) | select("Optional", epsilon));
N("Visibility") ::= (select("Private", epsilon) | select("Reexport", epsilon));
N("Eclipse") ::= ((select("bundles", N("Bundle")))+ (select("packages", N("Package")))+);
N("Bundle") ::= (select("symbolicName", N("String")) select("singleton", N("Boolean")) select("manifestVersion", N("Integer")) (select("require", N("RequiredBundle")))+ select("version", N("Version")) (select("export", N("ExportedPackage")))+ (select("import", N("ImportedPackage")))+ (select("packages", N("Package")))+);
N("RequireBundleAttribute") ::= N("AttResolution");
N("RequireBundleAttribute") ::= N("AttVisibility");
N("RequireBundleAttribute") ::= N("Range");
N("AttResolution") ::= select("value", N("Resolution"));
N("AttVisibility") ::= select("value", N("Visibility"));
N("Range") ::= (select("isLeftInclusive", N("Boolean")) select("isRightInclusive", N("Boolean")) select("lowerBound", N("Version")) select("upperBound", N("Version")));
N("Version") ::= (select("major", N("Integer")) select("minor", N("Integer")) select("micro", N("Integer")) select("qualification", N("String")));
N("RequiredBundle") ::= ((select("requireBundleAttribute", N("RequireBundleAttribute")))+ select("bundle", N("Bundle")));
N("ImportedPackage") ::= (select("resolution", N("Resolution")) select("package", N("Package")) select("range", N("Range")));
N("ExportedPackage") ::= N("Xinternal");
N("ExportedPackage") ::= (select("package", N("Package")) select("version", N("Version")) select("xFriends", N("Xfriends")));
N("Package") ::= (select("fqn", N("String")) (select("importedBy", N("ImportedPackage")))+ select("exportedBy", N("ExportedPackage")));
N("Xfriends") ::= (select("bundles", N("Bundle")))+;
N("Xinternal") ::= select("value", N("Boolean"));
N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
N("String") ::= value("string");
