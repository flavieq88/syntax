N("JavaProject") ::= (select("ownedPackageFragment", N("PackageFragment")))+;
N("PackageFragment") ::= (select("ownedCompilationUnit", N("CompilationUnit")))+;
N("CompilationUnit") ::= ((select("importDeclaration", N("ImportDeclaration")))+ (select("ownedType", N("Type")))+ select("declaration", N("PackageDeclaration")));
N("ImportDeclaration") ::= (select("name", N("String")));
N("Type") ::= ((select("nestedType", N("Type")))+ (select("ownedSuperType", N("Type")))+ select("elementName", N("String")) select("member_kind", N("MEMBER_KIND")) (select("methods", N("Method")))+ (select("fields", N("Field")))+);
N("Field") ::= epsilon;
N("Method") ::= (select("returnType", N("String")) (select("parametersName", N("String")))+ (select("parametersType", N("String")))+);
N("JavaElement") ::= N("Type");
N("JavaElement") ::= N("Field");
N("JavaElement") ::= N("Method");
N("MEMBER_KIND") ::= (select("class", epsilon) | select("enum", epsilon) | select("interface", epsilon) | select("Annotation", epsilon));
N("NamedElement") ::= N("JavaProject");
N("NamedElement") ::= N("PackageFragment");
N("NamedElement") ::= N("CompilationUnit");
N("NamedElement") ::= N("ImportDeclaration");
N("NamedElement") ::= N("JavaElement");
N("NamedElement") ::= N("PackageDeclaration");
N("PackageDeclaration") ::= (select("name", N("String")));
N("String") ::= value("string");
