N("program") ::= N("package_declaration");
N("package_declaration") ::= ([N("package_header")] (N("import_declaration"))* (N("type_declaration"))*);
N("package_header") ::= ("package" N("package_name") ";" N("NL") N("NL"));
N("package_name") ::= N("qualified_name");
N("import_declaration") ::= ("import" N("imported_name") ";" N("NL") N("NL"));
N("imported_name") ::= (N("package_or_type_name") [N("dot_star")]);
N("package_or_type_name") ::= N("qualified_name");
N("dot_star") ::= ("." "*");
N("declared_name") ::= N("reference");
N("type_declaration") ::= ((N("class_declaration") N("NL") N("NL")) | (N("interface_declaration") N("NL") N("NL")));
N("class_declaration") ::= (N("class_header") N("class_body"));
N("class_header") ::= ((N("modifier"))* "class" N("class_name") [N("extends_clause")] [N("implements_clause")]);
N("class_body") ::= N("class_or_interface_body");
N("interface_declaration") ::= (N("interface_header") N("interface_body"));
N("interface_header") ::= ((N("modifier"))* "interface" N("interface_name") [N("extends_clause")] [N("implements_clause")]);
N("interface_body") ::= N("class_or_interface_body");
N("modifier") ::= ("abstract" | "final" | "public" | "protected" | "private" | "static" | "transient" | "volatile" | "native" | "synchronized" | "strictfp");
N("extends_clause") ::= ("extends" (N("type_name"))+);
N("implements_clause") ::= ("implements" (N("qualified_name"))+);
N("class_name") ::= N("declared_name");
N("interface_name") ::= N("declared_name");
N("class_or_interface_body") ::= ("{" N("NL") N("IN") (N("class_body_declaration"))* N("EX") "}" [";"] N("NL") N("NL"));
N("class_body_declaration") ::= (N("empty_declaration") | N("member_declaration") | N("instance_initializer") | N("static_initializer") | N("field_declaration"));
N("empty_declaration") ::= (";" N("NL"));
N("member_declaration") ::= (N("method_or_constructor_declaration") | N("type_declaration"));
N("method_or_constructor_declaration") ::= (N("method_declaration") | N("constructor_declaration"));
N("instance_initializer") ::= (N("NL") N("block") N("NL") N("NL"));
N("static_initializer") ::= (N("NL") "static" N("block") N("NL") N("NL"));
N("constructor_declaration") ::= (N("NL") (N("modifier"))* N("constructor_declarator") [N("throws")] N("constructor_body") N("NL") N("NL"));
N("constructor_declarator") ::= (N("class_name") "(" sep*(N("formal_parameter"), ",") ")");
N("constructor_body") ::= (N("block") N("NL"));
N("field_declaration") ::= N("variable_declaration");
N("variable_declaration") ::= ((N("modifier"))* N("type_specifier") N("variable_declarators") ";" N("NL"));
N("variable_declarators") ::= (N("variable_declarator"))+;
N("variable_declarator") ::= (N("variable_name") [N("equals_variable_initializer")]);
N("variable_name") ::= (N("declared_name") (N("dimension"))*);
N("equals_variable_initializer") ::= ("=" N("variable_initializer"));
N("variable_initializer") ::= (N("expression") | N("array_initializer"));
N("array_initializer") ::= ("{" sep*(N("variable_initializer"), ",") [","] "}");
N("method_declaration") ::= (N("NL") (N("modifier"))* N("type_specifier") N("method_declarator") [N("throws")] N("method_body"));
N("method_declarator") ::= (N("method_name") "(" sep*(N("formal_parameter"), ",") ")" (N("dimension"))*);
N("method_name") ::= N("declared_name");
N("formal_parameter") ::= (["final"] N("type_specifier") N("formal_parameter_name"));
N("formal_parameter_name") ::= N("variable_name");
N("throws") ::= ("throws" (N("qualified_name"))+);
N("method_body") ::= ((N("block") N("NL") N("NL")) | (";" N("NL") N("NL")));
N("type_specifier") ::= (N("type_name") | N("array_type_specifier"));
N("array_type_specifier") ::= (N("type_name") (N("dimension"))+);
N("type_name") ::= (N("primitive_type") | N("qualified_name"));
N("primitive_type") ::= ("boolean" | "char" | "byte" | "short" | "int" | "long" | "float" | "double" | "void");
N("block") ::= ("{" N("NL") N("IN") (N("declaration_or_statement"))* N("EX") "}");
N("declaration_or_statement") ::= (N("local_variable_declaration") | N("class_declaration") | N("statement"));
N("local_variable_declaration") ::= N("variable_declaration");
N("statement") ::= (N("label_statement") | N("empty_statement") | N("expression_statement") | N("if_statement") | N("switch_statement") | N("while_statement") | N("do_statement") | N("for_statement") | N("break_statement") | N("continue_statement") | N("return_statement") | N("throw_statement") | N("synchronized_statement") | N("try_statement") | N("block"));
N("empty_statement") ::= (";" N("NL"));
N("label_statement") ::= (N("label_name") ":" N("NL"));
N("label_name") ::= N("reference");
N("expression_statement") ::= (N("expression") ";" N("NL"));
N("if_statement") ::= ("if" "(" N("expression") ")" N("statement") [N("else_clause")] N("NL"));
N("else_clause") ::= ("else" N("statement"));
N("switch_statement") ::= ("switch" "(" N("expression") ")" N("switch_block") N("NL"));
N("switch_block") ::= ("{" N("IN") N("NL") (N("switch_alternative"))* N("EX") "}");
N("switch_alternative") ::= (N("switch_label") N("IN") N("NL") (N("declaration_or_statement"))* N("EX"));
N("switch_label") ::= (("case" N("constant_expression") ":") | ("default" ":"));
N("while_statement") ::= ("while" "(" N("expression") ")" N("statement") N("NL"));
N("do_statement") ::= ("do" N("statement") "while" "(" N("expression") ")" ";" N("NL"));
N("for_statement") ::= ("for" "(" N("for_init") N("for_expression") N("for_update") ")" N("statement") N("NL"));
N("for_init") ::= ((sep*(N("expression"), ",") ";") | N("local_variable_declaration"));
N("for_expression") ::= ([N("expression")] ";");
N("for_update") ::= sep*(N("expression"), ",");
N("break_statement") ::= ("break" [N("label_name")] ";" N("NL"));
N("continue_statement") ::= ("continue" [N("label_name")] ";" N("NL"));
N("return_statement") ::= ("return" [N("expression")] ";" N("NL"));
N("throw_statement") ::= ("throw" N("expression") ";" N("NL"));
N("synchronized_statement") ::= ("synchronized" "(" N("expression") ")" N("statement") N("NL"));
N("try_statement") ::= ("try" N("block") (N("catch_clause"))* [N("finally_clause")] N("NL"));
N("catch_clause") ::= ("catch" "(" N("type_specifier") N("variable_name") ")" N("block"));
N("finally_clause") ::= ("finally" N("block"));
N("constant_expression") ::= N("expression");
N("expression") ::= N("assignment_expression");
N("assignment_expression") ::= (N("conditional_expression") | (N("unary_expression") N("assignment_operator") N("assignment_expression")));
N("assignment_operator") ::= ("=" | "*=" | "/=" | "%=" | "+=" | "-=" | "<<=" | ">>=" | ">>>=" | "&=" | "^=" | "|=");
N("conditional_expression") ::= (N("conditional_or_expression") [N("conditional_choice")]);
N("conditional_choice") ::= ("?" N("expression") ":" N("conditional_expression"));
N("conditional_or_expression") ::= (N("conditional_and_expression") (N("or_conditional_and_expression"))*);
N("or_conditional_and_expression") ::= ("||" N("conditional_and_expression"));
N("conditional_and_expression") ::= (N("inclusive_or_expression") (N("and_inclusive_or_expression"))*);
N("and_inclusive_or_expression") ::= ("&&" N("inclusive_or_expression"));
N("inclusive_or_expression") ::= (N("exclusive_or_expression") (N("or_exclusive_or_expression"))*);
N("or_exclusive_or_expression") ::= ("|" N("exclusive_or_expression"));
N("exclusive_or_expression") ::= (N("and_expression") (N("or_and_expression"))*);
N("or_and_expression") ::= ("^" N("and_expression"));
N("and_expression") ::= (N("equality_expression") (N("and_equality_expression"))*);
N("and_equality_expression") ::= ("&" N("equality_expression"));
N("equality_expression") ::= (N("relational_expression") (N("equality_op_relational_expression"))*);
N("equality_op_relational_expression") ::= (N("equality_op") N("relational_expression"));
N("equality_op") ::= ("==" | "!=");
N("relational_expression") ::= (N("shift_expression") (N("relational_op_shift_expression"))*);
N("relational_op_shift_expression") ::= ((N("relational_op") N("shift_expression")) | ("instanceof" N("type_specifier")));
N("relational_op") ::= ("<" | ">" | "<=" | ">=");
N("shift_expression") ::= (N("additive_expression") (N("shift_additive_expression"))*);
N("shift_additive_expression") ::= (N("shift_op") N("additive_expression"));
N("shift_op") ::= ("<<" | ">>" | ">>>");
N("additive_expression") ::= (N("multiplicative_expression") (N("add_op_multiplicative_expression"))*);
N("add_op_multiplicative_expression") ::= (N("add_op") N("multiplicative_expression"));
N("add_op") ::= ("+" | "-");
N("multiplicative_expression") ::= (N("unary_expression") (N("mult_op_unary_expression"))*);
N("mult_op_unary_expression") ::= (N("mult_op") N("unary_expression"));
N("mult_op") ::= ("*" | "/" | "%");
N("unary_expression") ::= ((N("pre_inc_dec") N("unary_expression")) | (N("unary_op") N("unary_expression")) | N("postfix_expression") | N("cast_expression"));
N("pre_inc_dec") ::= ("++" | "--");
N("unary_op") ::= ("+" | "-" | "~" | "!");
N("cast_expression") ::= ("(" N("type_specifier") ")" N("unary_expression"));
N("postfix_expression") ::= (N("primary") (N("post_inc_dec"))*);
N("post_inc_dec") ::= ("++" | "--");
N("subscript") ::= ("[" N("expression") "]");
N("primary") ::= (N("literal") | N("reference") | ("(" N("expression") ")" (N("component"))*) | N("class_instance_creation_expression") | N("array_creation_expression"));
N("literal") ::= (N("numeric_literal") | N("character_literal") | N("string_literal") | N("boolean_literal") | N("null_literal"));
N("numeric_literal") ::= N("number");
N("character_literal") ::= N("charlit");
N("string_literal") ::= N("stringlit");
N("boolean_literal") ::= ("true" | "false");
N("null_literal") ::= "null";
N("class_instance_creation_expression") ::= ("new" N("class_or_interface_name") "(" sep*(N("argument"), ",") ")" [N("class_body")]);
N("class_or_interface_name") ::= N("qualified_name");
N("array_creation_expression") ::= ("new" N("array_type_specifier") [N("array_initializer")]);
N("dimension") ::= ("[" [N("expression")] "]");
N("argument") ::= N("expression");
N("qualified_name") ::= N("reference");
N("reference") ::= (N("id") (N("component"))*);
N("component") ::= (N("dot_id") | N("method_argument") | N("subscript"));
N("method_argument") ::= ("(" sep*(N("argument"), ",") ")");
N("dot_id") ::= ("." N("id"));
