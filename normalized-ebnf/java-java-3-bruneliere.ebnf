N("Modifier") ::= N("Class");
N("Modifier") ::= N("Interface");
N("Modifier") ::= N("Method");
N("Modifier") ::= N("Field");
N("Class") ::= (select("superClass", N("Class")) (select("implement", N("Interface")))+ (select("methods", N("Method")))+ (select("fields", N("Field")))+);
N("Interface") ::= ((select("superInterface", N("Interface")))+ (select("implementedBy", N("Class")))+ (select("abstractMethods", N("Method")))+ (select("constants", N("Field")))+);
N("Method") ::= (select("share", N("Boolean")) select("class", N("Class")) select("interface", N("Interface")) select("resultOf", N("Type")) (select("parameters", N("Parameter")))+);
N("Field") ::= (select("share", N("Boolean")) select("class", N("Class")) select("interface", N("Interface")) select("value", N("Value")) select("typeOf", N("Type")));
N("Value") ::= epsilon;
N("Parameter") ::= (select("name", N("String")) select("typeOf", N("Type")) select("owner", N("Method")));
N("Type") ::= N("ReferenceType");
N("Type") ::= N("PrimitiveType");
N("Type") ::= (N("ReferenceType") | N("PrimitiveType"));
N("ReferenceType") ::= select("reference", N("Class"));
N("PrimitiveType") ::= N("Int");
N("Int") ::= epsilon;
N("String") ::= value("string");
N("Boolean") ::= ("true" | "false");
