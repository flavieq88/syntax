N("FieldModifier") ::= "public";
N("FieldModifier") ::= "protected";
N("FieldModifier") ::= "private";
N("FieldModifier") ::= "static";
N("FieldModifier") ::= "final";
N("FieldModifier") ::= "transient";
N("FieldModifier") ::= "volatile";
N("AnnotationTypeElementDeclaration") ::= ([N("AbstractMethodModifiers")] N("Type") N("Identifier") "(" ")" [N("DefaultValue")] ";");
N("AnnotationTypeElementDeclaration") ::= N("ConstantDeclaration");
N("AnnotationTypeElementDeclaration") ::= N("ClassDeclaration");
N("AnnotationTypeElementDeclaration") ::= N("InterfaceDeclaration");
N("AnnotationTypeElementDeclaration") ::= N("EnumDeclaration");
N("AnnotationTypeElementDeclaration") ::= N("AnnotationTypeDeclaration");
N("AnnotationTypeElementDeclaration") ::= ";";
N("ElementValueArrayInitializer") ::= (([N("ElementValues")] [","]))*;
N("NormalInterfaceDeclaration") ::= ([N("InterfaceModifiers")] "interface" N("Identifier") [N("TypeParameters")] [N("ExtendsInterfaces")] N("InterfaceBody"));
N("DimExprs") ::= N("DimExpr");
N("DimExprs") ::= (N("DimExprs") N("DimExpr"));
N("SingleStaticImportDeclaration") ::= ("import" "static" N("TypeName") "." N("Identifier") ";");
