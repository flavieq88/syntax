N("MastersCollection") ::= (select("ms_visioDocument", N("VisioDocument")) (select("masters", N("Master")))+ (select("masterShortCuts", N("MasterShortCut")))+);
N("MasterShortCut") ::= (select("m_masterShortCuts", N("MastersCollection")) select("iconSize", N("Integer")) select("patternFlags", N("Integer")) select("prompt", N("String")) select("shortcutURL", N("String")) select("shortcutHelp", N("String")) select("alignName", N("Integer")) (select("icons", N("Icon")))+);
N("Icon") ::= (select("i_masterShortCut", N("MasterShortCut")) select("value", N("String")));
N("Master") ::= (select("m_masters", N("MastersCollection")) select("baseID", N("String")) select("matchByName", N("Boolean")) select("iconSize", N("Integer")) select("patternFlags", N("Integer")) select("prompt", N("String")) select("hidden", N("Boolean")) select("iconUpdate", N("Boolean")) select("alignName", N("Integer")) (select("masterElts", N("MasterElt")))+);
N("ShapesCollection") ::= (select("shapes", N("Shape")))+;
N("ConnectsCollection") ::= (select("connections", N("Connect")))+;
N("Connect") ::= (select("c_connects", N("ConnectsCollection")) select("fromSheet", N("Integer")) select("toSheet", N("Integer")) select("fromCell", N("String")) select("toCell", N("String")) select("fromPart", N("Integer")) select("toPart", N("Integer")));
