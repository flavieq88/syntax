N("CellType") ::= (select("unit", N("String")) select("formula", N("String")) select("err", N("String")) select("value", N("String")));
N("VisioDocument") ::= (select("docMasters", N("MastersCollection")) select("docPages", N("PagesCollection")));
N("PageSheet") ::= (select("ss_shapes", N("ShapesCollection")) select("lineStyle", N("Integer")) select("fillStyle", N("Integer")) select("textStyle", N("Integer")) (select("shapeElts", N("ShapeElt")))+);
