N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
N("String") ::= value("string");
N("Label") ::= N("SimpleLabel");
N("Label") ::= N("ComplexLabel");
N("SimpleLabel") ::= select("content", N("String"));
N("ComplexLabel") ::= (select("compartments", N("Compartment")))+;
N("Compartment") ::= N("VerticalCompartment");
N("Compartment") ::= N("HorizontalCompartment");
N("Compartment") ::= N("SimpleCompartment");
N("VerticalCompartment") ::= (select("complexLabel", N("ComplexLabel")) select("compartments", N("Compartment")) select("anchor", N("Anchor")));
N("HorizontalCompartment") ::= (select("complexLabel", N("ComplexLabel")) select("compartments", N("Compartment")) select("anchor", N("Anchor")));
N("SimpleCompartment") ::= select("content", N("String"));
N("Anchor") ::= (select("name", N("String")) select("source", N("Compartment")));
N("GraphElement") ::= N("Graph");
N("GraphElement") ::= N("Layer");
N("GraphElement") ::= N("Nodelike");
N("GraphElement") ::= N("Arc");
N("GraphElement") ::= N("Shape");
N("Graph") ::= (select("type", N("String")) select("rankDir", N("String")) select("labeljust", N("String")) select("labelloc", N("String")) select("concentrate", N("Boolean")) (select("nodes", N("Nodelike")))+ select("boundingBox", N("String")) select("compound", N("Boolean")) (select("layers", N("Layer")))+ select("nodeSeparation", N("Double")) select("ordering", N("String")) select("size", N("String")) select("ratio", N("String")) select("center", N("Boolean")));
N("Layer") ::= ((select("nodes", N("Nodelike")))+ (select("arcs", N("Arc")))+ select("graph", N("Graph")) select("layerSeparator", N("String")));
N("Nodelike") ::= N("SubGraph");
N("Nodelike") ::= N("Node");
N("SubGraph") ::= ((select("nodes", N("Nodelike")))+ select("labelloc", N("String")));
N("Node") ::= (select("fixedSize", N("Boolean")) select("fontname", N("String")) select("fontsize", N("Integer")) select("height", N("Integer")) select("width", N("Integer")) select("shape", N("NodeShape")));
N("Arc") ::= N("DirectedArc");
N("Arc") ::= N("UndirectedArc");
N("DirectedArc") ::= (select("arrowHead", N("ArrowShape")) select("headlabel", N("Label")) select("taillabel", N("Label")) select("arrowTail", N("ArrowShape")) select("tail_lp", N("Double")) select("head_lp", N("Double")));
N("UndirectedArc") ::= (select("fromNode", N("Nodelike")) select("toNode", N("Nodelike")) (select("layers", N("Layer")))+ select("constraint", N("Boolean")) select("group", N("String")) select("minlen", N("Integer")) select("sameHead", N("String")) select("sameTail", N("String")) select("lhead", N("Nodelike")) select("ltail", N("Nodelike")) select("decorate", N("Boolean")));
N("Shape") ::= N("NodeShape");
N("Shape") ::= N("ArrowShape");
N("NodeShape") ::= N("SimpleNodeShape");
N("NodeShape") ::= N("PointNodeShape");
N("NodeShape") ::= N("ComplexNodeShape");
N("SimpleNodeShape") ::= epsilon;
N("PointNodeShape") ::= epsilon;
N("ComplexNodeShape") ::= N("PolygonNodeShape");
N("ComplexNodeShape") ::= N("MNodeShape");
N("ComplexNodeShape") ::= N("RecordNodeShape");
N("PolygonNodeShape") ::= (select("sides", N("Integer")) select("skew", N("Integer")) select("distortion", N("Integer")) select("isRegular", N("Boolean")) select("orientation", N("Integer")));
N("MNodeShape") ::= (select("toplabel", N("Label")) select("bottomlabel", N("Label")));
N("RecordNodeShape") ::= epsilon;
N("ArrowShape") ::= (select("clipping", N("String")) select("isPlain", N("Boolean")) select("size", N("Integer")));
