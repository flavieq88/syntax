N("Id") ::= value("string");
N("DotGraph") ::= (select("graph", (select("id", N("Id")) select("stmts", N("Stms")))) | select("digraph", (select("id", N("Id")) select("stmts", N("Stms")))));
N("Stms") ::= (N("Stm"))*;
N("NodeId") ::= (N("Id") N("PortId"));
N("PortId") ::= (N("Id") N("CompassPt"));
N("CompassPt") ::= (select("N", epsilon) | select("NE", epsilon) | select("E", epsilon) | select("SE", epsilon) | select("S", epsilon) | select("SW", epsilon) | select("W", epsilon) | select("NW", epsilon) | select("C", epsilon) | select("_", epsilon));
N("Stm") ::= (select("N", (select("id", N("Id")) select("attrs", N("Attrs")))) | select("N", select("id", N("Id"))) | select("N", (select("nid", N("NodeId")) select("attrs", N("Attrs")))) | select("N", select("nid", N("NodeId"))) | select("E", (select("from", N("Id")) select("to", N("Id")) select("attrs", N("Attrs")))) | select("E", (select("from", N("Id")) select("to", N("Id")))) | select("E", (select("nfrom", N("NodeId")) select("to", N("Id")) select("attrs", N("Attrs")))) | select("E", (select("nfrom", N("NodeId")) select("to", N("Id")))) | select("E", (select("sfrom", N("Stm")) select("to", N("Id")) select("attrs", N("Attrs")))) | select("E", (select("sfrom", N("Stm")) select("to", N("Id")))) | select("E", (select("from", N("Id")) select("nto", N("NodeId")) select("attrs", N("Attrs")))) | select("E", (select("from", N("Id")) select("nto", N("NodeId")))) | select("E", (select("nfrom", N("NodeId")) select("nto", N("NodeId")) select("attrs", N("Attrs")))) | select("E", (select("nfrom", N("NodeId")) select("nto", N("NodeId")))) | select("E", (select("sfrom", N("Stm")) select("nto", N("NodeId")) select("attrs", N("Attrs")))) | select("E", (select("sfrom", N("Stm")) select("nto", N("NodeId")))) | select("E", (select("from", N("Id")) select("sto", N("Stm")) select("attrs", N("Attrs")))) | select("E", (select("from", N("Id")) select("sto", N("Stm")))) | select("E", (select("nfrom", N("NodeId")) select("sto", N("Stm")) select("attrs", N("Attrs")))) | select("E", (select("nfrom", N("NodeId")) select("sto", N("Stm")))) | select("E", (select("sfrom", N("Stm")) select("sto", N("Stm")) select("attrs", N("Attrs")))) | select("E", (select("sfrom", N("Stm")) select("sto", N("Stm")))) | select("S", (select("id", N("Id")) select("stms", N("Stms")))) | select("S", select("stms", N("Stms"))) | select("A", (select("prop", N("Id")) select("val", N("Id")))) | select("GRAPH", select("attrs", N("Attrs"))) | select("NODE", select("attrs", N("Attrs"))) | select("EDGE", select("attrs", N("Attrs"))));
N("Attr") ::= (select("prop", value("string")) select("val", N("Id")));
N("Attrs") ::= (N("Attr"))*;
N("Outline") ::= ((select("key", value("int")) select("args", (value("string"))*)))*;
N("Dotline") ::= (select("graph", N("DotGraph")) select("outline", N("Outline")));
