N("Nod") ::= N("Subgraph");
N("Nod") ::= N("NodeId");
N("EdgeRhs") ::= (N("Edg"))+;
N("Port") ::= (":" N("Id") [N("Id")]);
N("AttrList0") ::= ("[" (N("DotAttr"))* "]");
N("Subgraph") ::= ([("subgraph" [N("Id")])] "{" N("StatementList") "}");
N("Graph") ::= "digraph";
N("Graph") ::= N("AttrTag");
N("Graph") ::= "graph";
N("AttrList") ::= (N("AttrList0"))*;
N("Statement") ::= N("AttrStatement");
N("Statement") ::= N("EdgeStatement");
N("Statement") ::= N("NodeStatement");
N("Statement") ::= (N("Id") "=" N("Id"));
N("StatementOptional") ::= (N("Statement") [";"]);
N("NodeStatement") ::= (N("Nod") N("AttrList"));
N("StatementList") ::= (N("StatementOptional"))*;
N("Edg") ::= (N("EdgeOp") N("Nod"));
N("DOT") ::= ((N("LAYOUT"))* N("Graph") N("Id") "{" N("StatementList") "}" ["\\n"]);
N("AttrTag") ::= "node";
N("AttrTag") ::= "graph";
N("AttrTag") ::= "edge";
N("EdgeStatement") ::= (N("Nod") N("EdgeRhs") N("AttrList"));
N("AttrStatement") ::= (N("AttrTag") N("AttrList"));
N("EdgeOp") ::= "->";
N("EdgeOp") ::= "--";
N("NodeId") ::= (N("Id") N("Port"));
N("NodeId") ::= N("Id");
N("DotAttr") ::= (N("Id") "=" N("Id"));
N("DotAttr") ::= (N("Id") "=" N("Id") ",");
