N("LocatedElement") ::= N("Root");
N("LocatedElement") ::= N("Element");
N("LocatedElement") ::= N("Port");
N("LocatedElement") ::= N("EndPoint");
N("LocatedElement") ::= N("Data");
N("Root") ::= ((select("keys", N("Key")))+ (select("graphs", N("Graph")))+);
N("Element") ::= N("Key");
N("Element") ::= N("Graph");
N("Element") ::= N("Edge");
N("Element") ::= N("HyperEdge");
N("Element") ::= N("Node");
N("Element") ::= (select("id", N("String")) (select("datas", N("Data")))+);
N("Key") ::= (select("for", N("ElemType")) select("attrName", N("String")) select("type", N("AttrType")) select("defValue", N("String")));
N("Graph") ::= ((select("contents", N("Element")))+ select("edgeDefault", N("EdgeType")));
N("Edge") ::= (select("source", N("Node")) select("target", N("Node")) select("sourceport", N("Port")) select("targetport", N("Port")));
N("HyperEdge") ::= (select("endpoints", N("EndPoint")))+;
N("Node") ::= (select("subgraph", N("Graph")) (select("ports", N("Port")))+);
N("Port") ::= select("name", N("String"));
N("EndPoint") ::= (select("node", N("Node")) select("port", N("Port")));
N("Data") ::= (select("key", N("String")) select("value", N("String")));
N("ElemType") ::= (select("edge", epsilon) | select("node", epsilon) | select("graph", epsilon));
N("AttrType") ::= (select("double", epsilon) | select("string", epsilon) | select("integer", epsilon) | select("boolean", epsilon));
N("EdgeType") ::= (select("directed", epsilon) | select("undirected", epsilon));
N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
N("String") ::= value("string");
