N("Element") ::= N("StructuralElement");
N("Element") ::= N("GraphicalElement");
N("StructuralElement") ::= N("Image");
N("StructuralElement") ::= N("Svg");
N("StructuralElement") ::= N("GroupingElement");
N("StructuralElement") ::= N("Use");
N("Image") ::= (select("referee", N("ReferencedFile")))+;
N("Svg") ::= ((select("owner_SVG", N("SvgFile")))+ (select("children", N("Element")))+ select("namespace", N("String")) select("version", N("String")) select("baseProfile", N("String")));
N("GroupingElement") ::= N("G");
N("GroupingElement") ::= N("Defs");
N("GroupingElement") ::= N("Symbol");
N("G") ::= select("name", N("String"));
N("Defs") ::= ((select("groupContent", N("Element")))+);
N("Symbol") ::= ((select("groupContent", N("Element")))+);
N("Use") ::= (select("use", N("Element")))+;
N("GraphicalElement") ::= N("Shape");
N("GraphicalElement") ::= N("TextElement");
N("Shape") ::= N("Rect");
N("Shape") ::= N("Circle");
N("Shape") ::= N("Ellipse");
N("Shape") ::= N("Line");
N("Shape") ::= N("Polyline");
N("Shape") ::= N("Polygon");
N("Shape") ::= N("Path");
N("Shape") ::= N("Point");
N("Shape") ::= N("Marker");
N("TextElement") ::= N("Text");
N("TextElement") ::= N("Tspan");
N("TextElement") ::= N("Tref");
N("Rect") ::= (select("rx", N("Double")) select("ry", N("Double")));
N("Circle") ::= epsilon;
N("Ellipse") ::= epsilon;
N("Line") ::= (select("between", N("Point")) select("markerEnd", N("String")) select("markerStart", N("String")));
N("Polyline") ::= ((select("waypoints", N("Point")))+ select("strokeDashArray", N("String")) select("markerEnd", N("String")) select("markerStart", N("String")));
N("Polygon") ::= ((select("waypoints", N("Point")))+ select("markerEnd", N("String")) select("markerStart", N("String")));
N("Path") ::= (select("pathLength", N("Double")) select("d", N("String")) select("markerEnd", N("String")) select("markerStart", N("String")));
N("Point") ::= epsilon;
N("Marker") ::= (select("markerUnits", N("String")) select("refX", N("Double")) select("refY", N("Double")) select("markerWidth", N("Double")) select("markerHeight", N("Double")) select("orient", N("String")) (select("drawing", N("Element")))+);
N("Text") ::= (select("lengthAdjust", N("String")) select("content", N("String")));
N("Tspan") ::= select("content", N("String"));
N("Tref") ::= select("xlinkHref", N("TextElement"));
N("Attribute") ::= N("Transform");
N("Attribute") ::= N("Visibility");
N("Attribute") ::= N("FontWeight");
N("Attribute") ::= N("FontStyle");
N("Transform") ::= N("Scale");
N("Transform") ::= N("Translate");
N("Transform") ::= N("Rotate");
N("Scale") ::= (select("sx", N("Double")) select("sy", N("Double")));
N("Translate") ::= (select("tx", N("Double")) select("ty", N("Double")));
N("Rotate") ::= (select("angle", N("Double")) select("cx", N("Double")) select("cy", N("Double")));
N("Visibility") ::= select("visible", N("Boolean"));
N("FontWeight") ::= select("bold", N("Boolean"));
N("FontStyle") ::= select("italic", N("Boolean"));
N("Dimension") ::= (select("width", N("Double")) select("height", N("Double")));
N("Coordinates") ::= N("RelativeCoord");
N("Coordinates") ::= N("AbsoluteCoord");
N("RelativeCoord") ::= (select("x", N("Double")) select("y", N("Double")));
N("AbsoluteCoord") ::= (select("x", N("Double")) select("y", N("Double")));
N("ReferencedFile") ::= N("SvgFile");
N("SvgFile") ::= (select("tag", N("Svg")) (select("elements", N("Element")))+);
N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
N("String") ::= value("string");
