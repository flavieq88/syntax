N("LocatedElement") ::= N("Named");
N("LocatedElement") ::= N("Column");
N("Named") ::= N("GUI");
N("Named") ::= N("Tab");
N("Named") ::= N("Composant");
N("GUI") ::= (select("guiTabs", N("Tab")))+;
N("Tab") ::= (select("title", N("String")) select("gui", N("GUI")) select("group", N("Group")));
N("Composant") ::= N("Group");
N("Composant") ::= N("Label");
N("Composant") ::= N("TextArea");
N("Composant") ::= N("Table");
N("Composant") ::= N("ComboBox");
N("Composant") ::= N("Row");
N("Composant") ::= N("Item");
N("Composant") ::= N("Button");
N("Layout") ::= (select("default", epsilon) | select("horizontal", epsilon) | select("vertical", epsilon));
N("Group") ::= (select("title", N("String")) select("layout", N("Layout")) select("description", N("String")) select("tabGroup", N("Tab")) (select("composants", N("Composant")))+);
N("Label") ::= select("text", N("String"));
N("TextArea") ::= (select("text", N("String")) select("nbRows", N("Integer")));
N("Table") ::= (select("tabColumns", N("Column")))+;
N("Column") ::= (select("title", N("String")) select("columnTab", N("Table")));
N("ComboBox") ::= (select("listRows", N("Row")))+;
N("Row") ::= (select("rowList", N("ComboBox")) select("text", N("String")) (select("listItems", N("Item")))+);
N("Item") ::= (select("itemList", N("Row")) select("text", N("String")));
N("Button") ::= select("title", N("String"));
N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
N("String") ::= value("string");
