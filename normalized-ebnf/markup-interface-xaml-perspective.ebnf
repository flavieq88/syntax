N("Page") ::= ((select("xmlns", N("NameSpace")))+ select("title", N("String")) select("graphContainer", N("GraphicalContainer")) select("pageResources", N("PageResource")));
N("NameSpace") ::= (select("namespace", N("String")) select("identifier", N("String")));
N("PageResource") ::= (select("dictionaries", N("ResourceDictionary")))+;
N("GraphicalContainer") ::= N("Grid");
N("WinFXElement") ::= N("Name");
N("PerspectiveElement") ::= N("Workshop3D");
N("PerspectiveElement") ::= N("XyzAxis3D");
N("PerspectiveElement") ::= N("Box3D");
N("PerspectiveElement") ::= N("Square3D");
N("ResourceDictionary") ::= select("source", N("String"));
N("Grid") ::= (select("object3D", N("Object3D")))+;
N("Object3D") ::= N("Workshop3D");
N("Workshop3D") ::= (select("elements3D", N("Element3D")))+;
N("Element3D") ::= N("UI3Delement");
N("Element3D") ::= N("XyzAxis3D");
N("Element3D") ::= (N("UI3Delement"));
N("UI3Delement") ::= N("Box3D");
N("UI3Delement") ::= N("Square3D");
N("UI3Delement") ::= (select("transform", N("String")) select("material", N("String")) select("name", N("Name")));
N("XyzAxis3D") ::= select("length", N("Double"));
N("Box3D") ::= (select("transform", N("String")) select("material", N("String")) select("name", N("Name")) select("namespace", N("NameSpace")));
N("Square3D") ::= (select("transform", N("String")) select("material", N("String")) select("name", N("Name")) select("namespace", N("NameSpace")));
N("Name") ::= select("name", N("String"));
N("String") ::= value("string");
N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
