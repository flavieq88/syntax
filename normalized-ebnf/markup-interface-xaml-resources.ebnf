N("Transformation") ::= N("TranslateTransform3D");
N("Transformation") ::= N("ScaleTransform3D");
N("Transformation") ::= N("RotateTransform3D");
N("WinFXElement") ::= N("Key");
N("NameSpace") ::= (select("namespace", N("String")) select("identifier", N("String")));
N("ResourceGroup") ::= N("Transform3DGroup");
N("ResourceGroup") ::= N("MaterialGroup");
N("ResourceGroup") ::= select("key", N("Key"));
N("Material") ::= N("DiffuseMaterial");
N("Key") ::= select("name", N("String"));
N("ResourceDictionary") ::= ((select("resourcegroups", N("ResourceGroup")))+ (select("xmlns", N("NameSpace")))+);
N("Transform3DGroup") ::= (select("transformations", N("Transformation")))+;
N("MaterialGroup") ::= (select("materials", N("Material")))+;
N("DiffuseMaterial") ::= select("Brush", N("String"));
N("TranslateTransform3D") ::= (select("OffsetX", N("Double")) select("OffsetY", N("Double")) select("OffsetZ", N("Double")));
N("ScaleTransform3D") ::= (select("ScaleX", N("Double")) select("ScaleY", N("Double")) select("ScaleZ", N("Double")));
N("RotateTransform3D") ::= (select("CenterX", N("Double")) select("CenterY", N("Double")) select("rotation", N("RotateTransformat3DRotation")));
N("RotateTransformat3DRotation") ::= select("axisAngleRotation3D", N("AxisAngleRotation3D"));
N("AxisAngleRotation3D") ::= (select("angle", N("Integer")) select("axis", N("String")));
N("String") ::= value("string");
N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
