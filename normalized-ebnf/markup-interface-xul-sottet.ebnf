N("UIModel") ::= (select("windows", N("Windows")) (select("functions", N("Function")))+);
N("Windows") ::= (select("id", N("String")) select("title", N("String")) select("orient", N("Orients")) select("style", N("String")) (select("headers", N("HeaderCss")))+ (select("headersJScript", N("HeaderJScript")))+);
N("Button") ::= (select("tooltiptext", N("String")) select("image", N("String")));
N("Orients") ::= (select("horizontal", epsilon) | select("vertical", epsilon));
N("Image") ::= select("src", N("String"));
N("RadioGroup") ::= (select("radiobuttons", N("Radio")))+;
N("Radio") ::= (select("id", N("String")) select("label", N("String")) select("selected", N("Boolean")) select("disabled", N("Boolean")));
N("ListBox") ::= (select("rows", N("Integer")) (select("listitems", N("ListItem")))+);
N("ListItem") ::= (select("label", N("String")) select("value", N("String")));
N("MenuList") ::= (select("menuitems", N("MenuItem")))+;
N("MenuItem") ::= select("label", N("String"));
N("vbox") ::= ((select("xulInteractors", N("Interactor")))+);
N("hbox") ::= ((select("xulInteractors", N("Interactor")))+);
N("Containement") ::= N("Button");
N("Containement") ::= N("Image");
N("Containement") ::= N("RadioGroup");
N("Containement") ::= N("ListBox");
N("Containement") ::= N("MenuList");
N("Containement") ::= N("TabBox");
N("Containement") ::= N("TextBox");
N("Containement") ::= N("Spacer");
N("Containement") ::= N("Label");
N("Containement") ::= N("Grid");
N("Containement") ::= N("CheckBox");
N("Containement") ::= N("Caption");
N("Containement") ::= N("Description");
N("Containement") ::= (select("style", N("String")) select("accesskey", N("String")) select("class", N("String")) select("maxlength", N("Integer")) select("label", N("String")) select("orient", N("Orients")) select("minlength", N("String")) select("onclick", N("String")) select("disabled", N("String")));
N("GroupBox") ::= ((select("xulInteractors", N("Interactor")))+);
N("Container") ::= N("Windows");
N("Container") ::= N("vbox");
N("Container") ::= N("hbox");
N("Container") ::= N("GroupBox");
N("Container") ::= N("row");
N("Container") ::= N("column");
N("Container") ::= N("TabPanel");
N("Container") ::= (select("xulInteractors", N("Interactor")))+;
N("Interactor") ::= N("Radio");
N("Interactor") ::= N("ListItem");
N("Interactor") ::= N("MenuItem");
N("Interactor") ::= N("Containement");
N("Interactor") ::= N("Container");
N("Interactor") ::= (select("flex", N("Integer")) select("id", N("String")) select("stat", N("String")) select("style", N("String")) (select("events", N("Event")))+);
N("TabBox") ::= (select("tabPanels", N("Interactor")))+;
N("TextBox") ::= (select("multiline", N("Boolean")) select("value", N("String")));
N("Spacer") ::= (select("style", N("String")) select("accesskey", N("String")) select("class", N("String")) select("maxlength", N("Integer")) select("label", N("String")) select("orient", N("Orients")) select("minlength", N("String")) select("onclick", N("String")) select("disabled", N("String")));
N("Label") ::= (select("value", N("String")) select("control", N("String")));
N("Grid") ::= ((select("columns", N("column")))+ (select("rows", N("row")))+);
N("row") ::= ((select("xulInteractors", N("Interactor")))+);
N("column") ::= ((select("xulInteractors", N("Interactor")))+);
N("CheckBox") ::= select("checked", N("Boolean"));
N("Caption") ::= select("label", N("String"));
N("Description") ::= select("value", N("String"));
N("HeaderCss") ::= (select("ref", N("String")) select("type", N("String")));
N("HeaderJScript") ::= select("ref", N("String"));
N("TabPanel") ::= (select("id", N("String")) select("orient", N("Orients")));
N("Event") ::= N("onClick");
N("Event") ::= ((select("functionCallParameters", N("Parameter")))+ select("functionCalledName", N("String")) select("name", N("String")));
N("Parameter") ::= (select("value", N("String")) select("name", N("String")));
N("onClick") ::= ((select("functionCallParameters", N("Parameter")))+ select("functionCalledName", N("String")) select("name", N("String")));
N("Function") ::= (select("name", N("String")) select("functionUIModel", N("UIModel")) select("body", N("String")));
N("String") ::= value("string");
N("Integer") ::= value("int");
N("Boolean") ::= ("true" | "false");
