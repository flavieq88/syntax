N("String") ::= value("string");
N("Integer") ::= value("int");
N("Boolean") ::= ("true" | "false");
N("Any") ::= N("_String");
N("Any") ::= N("_Link");
N("Any") ::= N("_Float");
N("Any") ::= N("_Integer");
N("Any") ::= N("_StringArray");
N("Any") ::= N("_FloatArray");
