N("AngleUnits") ::= (select("degrees", epsilon) | select("radians", epsilon));
N("AtomRefs_Element") ::= N("_StringBuiltin");
N("StringBuiltin") ::= (select("id", epsilon) | select("elementType", epsilon) | select("atomId", epsilon) | select("residueType", epsilon) | select("residueId", epsilon) | select("atomRef", epsilon) | select("order", epsilon) | select("stereo", epsilon) | select("spaceground", epsilon));
N("_String") ::= epsilon;
N("_Link") ::= epsilon;
N("FloatBuiltin") ::= (select("x2", epsilon) | select("y2", epsilon) | select("x3", epsilon) | select("y3", epsilon) | select("z3", epsilon) | select("xFract", epsilon) | select("yFract", epsilon) | select("zFract", epsilon) | select("occupancy", epsilon) | select("isotope", epsilon) | select("formalCharge", epsilon) | select("hydrogenCount", epsilon) | select("nonHydrogenCount", epsilon) | select("atomParity", epsilon) | select("length", epsilon) | select("acell", epsilon) | select("bcell", epsilon) | select("ccell", epsilon) | select("alpha", epsilon) | select("beta", epsilon) | select("gamma", epsilon) | select("z", epsilon));
N("_Float") ::= epsilon;
N("IntegerBuiltin") ::= (select("isotope", epsilon) | select("formalCharge", epsilon) | select("hydrogenCount", epsilon) | select("nonHydrogenCount", epsilon) | select("atomParity", epsilon) | select("z", epsilon));
N("_Integer") ::= epsilon;
N("_StringArray") ::= select("delimiter", N("String"));
N("_FloatArray") ::= epsilon;
N("_IntegerArray") ::= epsilon;
N("_FloatMatrix") ::= epsilon;
N("Coordinate2Builtin") ::= select("xy2", epsilon);
N("_Coordinate2") ::= epsilon;
N("Coordinate3Builtin") ::= (select("xyz3", epsilon) | select("xyzFract", epsilon));
N("_Coordinate3") ::= epsilon;
N("_Angle") ::= epsilon;
N("_Torsion") ::= epsilon;
