N("Element") ::= N("NamedElement");
N("Element") ::= N("Extended");
N("Element") ::= N("Typed");
N("Element") ::= N("RuleSetDeclaration");
N("Element") ::= N("Binding");
N("Element") ::= N("RuleCondition");
N("Element") ::= N("RuleAction");
N("Element") ::= (select("location", N("String")) (select("commentsBefore", N("String")))+ (select("commentsAfter", N("String")))+);
N("NamedElement") ::= N("ExtendedIdentifier");
N("NamedElement") ::= N("RuleSet");
N("NamedElement") ::= N("Type");
N("NamedElement") ::= N("RulesetElementDefinition");
N("ExtendedIdentifier") ::= (select("parentIdentifier", N("ExtendedIdentifier")) select("extendedIdentifierOwner", N("Extended")));
N("Extended") ::= N("Definition");
N("Extended") ::= N("ClassInstancesDeclaration");
N("Definition") ::= N("ImportDefinition");
N("Definition") ::= N("PropertyDefinition");
N("RuleSet") ::= ((select("importDefinitions", N("ImportDefinition")))+ select("propertyDefinitions", N("IRLDeclarations/PropertyDefinition")) (select("rulesetElementDefinitions", N("IRLRules/RulesetElementDefinition")))+);
N("ImportDefinition") ::= (select("importDefinitionOwners", N("RuleSet")) select("dotStar", N("Boolean")));
N("IteratorExp") ::= select("name", N("String"));
N("LoopExpression") ::= (select("body", N("IRLExpressions/Expression")) (select("iterators", N("IRLExpressions/Iterator")))+);
N("OperatorCallExpression") ::= epsilon;
N("OperationCallExpression") ::= ((select("arguments", N("IRLExpressions/Expression")))+ select("operationName", N("String")) select("signature", N("String")));
N("Iterator") ::= select("loopExpression", N("IRLExpressions/LoopExpression"));
N("IntegerExpression") ::= select("integerSymbol", N("Integer"));
N("RealExpression") ::= select("realSymbol", N("Double"));
N("BooleanExpression") ::= select("booleanSymbol", N("Boolean"));
N("NavigationOrAttributeCallExpression") ::= select("name", N("String"));
N("VariableExpression") ::= (select("referredVariable", N("IRLDeclarations/VariableDeclaration")) select("name", N("String")));
N("StringExpression") ::= select("stringSymbol", N("String"));
N("StringType") ::= epsilon;
N("IntegerType") ::= epsilon;
N("RealType") ::= epsilon;
N("BooleanType") ::= epsilon;
N("ClassType") ::= epsilon;
N("PropertyDefinition") ::= (select("propertyDefinitionOwner", N("RuleSet")) (select("ruleSetDeclarations", N("IRLDeclarations/RuleSetDeclaration")))+ select("semicoloneOpt", N("Boolean")));
N("ClassInstancesDeclaration") ::= (select("extendedIdentifier", N("ExtendedIdentifier")));
N("PropertyDeclaration") ::= epsilon;
N("VariableDeclaration") ::= (select("varName", N("String")) (select("variableExp", N("IRLExpressions/VariableExpression")))+);
N("RuleDefinition") ::= (select("binding", N("IRLRules/Binding")) select("condition", N("IRLRules/RuleCondition")) (select("actions", N("IRLRules/RuleAction")))+);
N("Binding") ::= (select("bindingOwner", N("IRLRules/RuleDefinition")) (select("ruleVariable", N("IRLRules/RuleVariable")))+);
N("CollectionOperationRuleVariable") ::= (select("operationName", N("String")) select("collectWhere", N("IRLExpressions/Expression")));
N("SimpleRuleVariable") ::= epsilon;
N("RuleCondition") ::= (select("conditionExpression", N("IRLExpressions/Expression")) select("ruleDefinitionCondition", N("IRLRules/RuleDefinition")));
N("RuleAction") ::= select("actionOwner", N("IRLRules/RuleDefinition"));
N("DeleteAction") ::= select("objValue", N("IRLExpressions/Expression"));
N("CreateAction") ::= (select("insertArguments", N("IRLExpressions/Expression")))+;
N("ModifyAction") ::= (select("objValue", N("IRLExpressions/Expression")) (select("modifiedArguments", N("IRLExpressions/Expression")))+);
N("UpdateAction") ::= select("objValue", N("IRLExpressions/Expression"));
N("InvokeAction") ::= select("invocation", N("IRLExpressions/Expression"));
N("Integer") ::= value("int");
N("String") ::= value("string");
N("Boolean") ::= ("true" | "false");
