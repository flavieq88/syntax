@root N("configuration");

N("configuration") ::= ((select("shortcut", N("shortcutType")) | select("action", N("actionType")) | select("source", N("sourceType")) | select("target", N("targetType")) | select("comment", N("mixedType"))))*;
N("actionType") ::= ([select("comment", value("string"))] (select("name", value("string")))+ select("definition", (select("command", N("commandtype")))+));
N("shortcutType") ::= (select("name", value("string")) select("definition", ((N("expansion") | value("string")))*));
N("expansion") ::= (select("expand", value("string")) | select("expand-type", epsilon) | select("expand-arguments", epsilon) | select("expand-source", epsilon) | select("expand-action", epsilon) | select("expand-first", epsilon) | select("expand-second", epsilon) | select("expand-context", epsilon) | select("expand-sample", epsilon) | select("expand-parsed", epsilon) | select("expand-yields", epsilon));
N("commandtype") ::= (((N("expansion") | value("string")))* [select("err", value("string"))] [select("out", value("string"))]);
N("sourceType") ::= (select("name", value("string")) select("extractor", (select("name", value("string")) select("arguments", (select("argument", ((N("expansion") | value("string")))*))+))) [select("parser", select("command", N("commandtype")))] [select("evaluator", select("command", N("commandtype")))]);
N("targetType") ::= (select("name", value("string")) (select("branch", (select("input", value("string")) (select("perform", value("string")))*)))+);
