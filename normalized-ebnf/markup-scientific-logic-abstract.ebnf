N("Formula") ::= (select("true", epsilon) | select("false", epsilon) | select("not", select("arg", N("Formula"))) | select("and", (select("lhs", N("Formula")) select("rhs", N("Formula")))) | select("and", select("args", (N("Formula"))*)) | select("or", (select("lhs", N("Formula")) select("rhs", N("Formula")))) | select("or", select("args", (N("Formula"))*)) | select("if", (select("lhs", N("Formula")) select("rhs", N("Formula")))) | select("fi", (select("lhs", N("Formula")) select("rhs", N("Formula")))) | select("iff", (select("lhs", N("Formula")) select("rhs", N("Formula")))));
N("Formula") ::= select("id", select("x", value("string")));
