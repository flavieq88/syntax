N("Formula") @label("not") ::= ("!" select("arg", N("Formula")));
N("Formula") @label("true") ::= "true";
N("Formula") @label("false") ::= "false";
N("Formula") @label("and") ::= (select("lhs", N("Formula")) "&" select("rhs", N("Formula")));
N("Formula") @label("or") ::= (select("lhs", N("Formula")) "|" select("rhs", N("Formula")));
N("Formula") @label("fi") ::= (select("lhs", N("Formula")) "<=" select("rhs", N("Formula")));
N("Formula") @label("if") ::= (select("lhs", N("Formula")) "=>" select("rhs", N("Formula")));
N("Formula") @label("iff") ::= (select("lhs", N("Formula")) "<=>" select("rhs", N("Formula")));
N("Formula") @label("id") ::= epsilon;
N("False") ::= "false";
N("False") ::= ("not" select("t", N("True")));
N("False") ::= ("(" N("False") ")");
N("False") ::= (select("lf", N("False")) "and" select("rt", N("True")));
N("False") ::= (select("lf", N("False")) "and" select("rf", N("False")));
N("False") ::= (select("lt", N("True")) "and" select("rf", N("False")));
N("False") ::= (select("lf", N("False")) "or" select("rf", N("False")));
N("True") ::= ("(" N("True") ")");
N("True") ::= "true";
N("True") ::= ("not" select("f", N("False")));
N("True") ::= (select("lt", N("True")) "and" select("rt", N("True")));
N("True") ::= (select("lt", N("True")) "or" select("rt", N("True")));
N("True") ::= (select("lt", N("True")) "or" select("rf", N("False")));
N("True") ::= (select("lf", N("False")) "or" select("rt", N("True")));
