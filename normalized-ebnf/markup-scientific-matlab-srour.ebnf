N("String") ::= value("string");
N("Integer") ::= value("int");
N("Matlab") ::= (select("model", N("Model")))+;
N("BlockDefaults") ::= N("Block");
N("BlockDefaults") ::= (select("blockDefaults", N("String")) select("model", N("Model")));
N("Model") ::= (select("name", N("String")) select("matlab", N("Matlab")) (select("annotationDefaults", N("AnnotationDefaults")))+ (select("system", N("System")))+ (select("blockDefaults", N("BlockDefaults")))+ (select("lineDefaults", N("LineDefaults")))+ select("simulink", N("Simulink")));
N("AnnotationDefaults") ::= N("Annotation");
N("AnnotationDefaults") ::= (select("annotationDefaults", N("String")) select("model", N("Model")));
N("LineDefaults") ::= N("Line");
N("LineDefaults") ::= (select("lineDefaults", N("String")) select("model", N("Model")));
N("System") ::= (select("name", N("String")) (select("blocks", N("Block")))+ (select("lines", N("Line")))+ (select("annotations", N("Annotation")))+ select("model", N("Model")) select("parentSubsystem", N("Subsystem")));
N("Subsystem") ::= N("Masked");
N("Subsystem") ::= N("Normal");
N("Subsystem") ::= select("system", N("System"));
N("Block") ::= N("Subsystem");
N("Block") ::= N("Primitive");
N("Block") ::= N("Reference");
N("Block") ::= (select("name", N("String")) select("blockType", N("String")) select("description", N("String")) select("priority", N("String")) select("tag", N("String")) select("position", N("String")) select("mySystem", N("System")) (select("ports", N("Port")))+);
N("Annotation") ::= (select("position", N("String")) select("text", N("String")) select("system", N("System")));
N("Line") ::= N("DirectLine");
N("Line") ::= N("BranchedLine");
N("Line") ::= (select("points", N("String")) select("id", N("String")) select("srcPort", N("OutputPort")) select("system", N("System")));
N("DirectLine") ::= select("destPort1", N("InputPort"));
N("InputPort") ::= (select("owningDirectLine", N("DirectLine")) select("owningDirectBranch", N("DirectBranch")));
N("Branch") ::= N("DirectBranch");
N("Branch") ::= N("NestedBranch");
N("Branch") ::= (select("points", N("String")) select("branchedLine", N("BranchedLine")) select("nestedBranch", N("NestedBranch")));
N("BranchedLine") ::= (select("branchs", N("Branch")))+;
N("Primitive") ::= (select("id", N("String")) (select("parameters", N("Parameter")))+ select("refPort", N("Port")));
N("Port") ::= N("InputPort");
N("Port") ::= N("OutputPort");
N("Port") ::= (select("id", N("String")) select("number", N("String")) select("portBlock", N("Block")) select("primitive", N("Primitive")));
N("Reference") ::= (select("sourceType", N("String")) select("sourceBlock", N("String")) (select("parameters", N("Parameter")))+);
N("Masked") ::= (select("system", N("System")));
N("Normal") ::= (select("system", N("System")));
N("Parameter") ::= N("Type");
N("Parameter") ::= N("Double");
N("Parameter") ::= N("INteger");
N("Parameter") ::= N("Enumeration");
N("Parameter") ::= N("BOolean");
N("Parameter") ::= N("Text");
N("Parameter") ::= N("Vector");
N("Parameter") ::= (select("name", N("String")) select("le_reference", N("Reference")) select("primitive", N("Primitive")));
N("OutputPort") ::= select("owningLine", N("Line"));
N("Type") ::= select("value", N("String"));
N("Double") ::= select("value", N("String"));
N("INteger") ::= select("value", N("String"));
N("Enumeration") ::= select("value", N("String"));
N("BOolean") ::= select("value", N("TrueFalse"));
N("TrueFalse") ::= (select("True", epsilon) | select("False", epsilon));
N("Text") ::= select("value", N("String"));
N("Vector") ::= select("value", N("String"));
N("DirectBranch") ::= (select("id", N("String")) select("destPort", N("InputPort")));
N("NestedBranch") ::= (select("branchs", N("Branch")))+;
N("Machine") ::= (select("name", N("String")) select("id", N("String")) (select("events", N("Event")))+ (select("data", N("Data")))+ (select("instances", N("Instance")))+ (select("targets", N("Target")))+ select("stateFlow", N("StateFlow")));
N("Junction") ::= (select("_id", N("String")) select("id", N("String")) select("type", N("String")) select("position", N("String")) select("state", N("State")) select("chart", N("Chart")));
N("Transition") ::= (select("_id", N("String")) select("dataLimites", N("String")) select("id", N("String")) select("trigger", N("String")) select("condition", N("String")) select("conditionAction", N("String")) select("action", N("String")) select("chart", N("Chart")) select("state", N("State")));
N("Event") ::= (select("name", N("String")) select("id", N("String")) select("scope", N("String")) select("description", N("String")) select("trigger", N("String")) select("machine", N("Machine")) select("chart", N("Chart")) select("state", N("State")));
N("Data") ::= (select("name", N("String")) select("id", N("String")) select("scope", N("String")) select("description", N("String")) select("units", N("String")) select("dataType", N("String")) (select("props", N("Props")))+ select("state", N("State")) select("chart", N("Chart")) select("machine", N("Machine")));
N("Instance") ::= (select("_id", N("String")) select("id", N("String")) select("name", N("String")) select("machine", N("Machine")));
N("Target") ::= (select("name", N("String")) select("id", N("String")) select("codeCommand", N("String")) select("description", N("String")) select("makeCommand", N("String")) select("codeFlags", N("String")) select("checksumOld", N("String")) select("machine", N("Machine")));
N("Chart") ::= (select("name", N("String")) select("id", N("String")) select("_id", N("String")) select("decomposotion", N("String")) select("updateMethode", N("String")) select("sampleTime", N("String")) (select("junctions", N("Junction")))+ (select("events", N("Event")))+ (select("transitions", N("Transition")))+ (select("data", N("Data")))+ (select("states", N("State")))+);
N("State") ::= (select("name", N("String")) select("id", N("String")) select("_id", N("String")) select("type", N("String")) select("entryAction", N("String")) select("exitAction", N("String")) select("duringAction", N("String")) select("eventActions", N("String")) select("decomposition", N("String")) select("position", N("String")) (select("junctions", N("Junction")))+ (select("events", N("Event")))+ (select("transitions", N("Transition")))+ (select("data", N("Data")))+ select("chart", N("Chart")) (select("states", N("State")))+);
N("Props") ::= (select("initialValue", N("String")) (select("arrays", N("Array")))+ (select("ranges", N("Range")))+ select("data", N("Data")));
N("Range") ::= (select("maximum", N("String")) select("minimum", N("String")) select("props", N("Props")));
N("Array") ::= (select("firstIndex", N("String")) select("size", N("String")) select("props", N("Props")));
N("StateFlow") ::= (select("stateFlow", N("String")) (select("machines", N("Machine")))+ select("simulink", N("Simulink")));
N("TransitionTerminal") ::= select("_id", N("String"));
N("Simulink") ::= (select("simulink", N("String")) (select("stateFlows", N("StateFlow")))+ (select("models", N("Model")))+);
