@root N("atomFeed");
@root N("atomEntry");

N("atomCommonAttributes") ::= ([select("xml:base", N("atomUri"))] [select("xml:lang", N("atomLanguageTag"))] (N("undefinedAttribute"))*);
N("atomPlainTextConstruct") ::= (N("atomCommonAttributes") [select("type", ("text" | "html"))] value("string"));
N("atomXHTMLTextConstruct") ::= (N("atomCommonAttributes") select("type", "xhtml") N("xhtmlDiv"));
N("atomTextConstruct") ::= (N("atomPlainTextConstruct") | N("atomXHTMLTextConstruct"));
N("atomPersonConstruct") ::= (N("atomCommonAttributes") select("atom:name", value("string")) [select("atom:uri", N("atomUri"))] [select("atom:email", N("atomEmailAddress"))] (N("extensionElement"))*);
N("atomDateConstruct") ::= (N("atomCommonAttributes") value("string"));
N("atomFeed") ::= select("atom:feed", (N("atomCommonAttributes") (N("atomAuthor"))* (N("atomCategory"))* (N("atomContributor"))* [N("atomGenerator")] [N("atomIcon")] N("atomId") (N("atomLink"))* [N("atomLogo")] [N("atomRights")] [N("atomSubtitle")] N("atomTitle") N("atomUpdated") (N("extensionElement"))* (N("atomEntry"))*));
N("atomEntry") ::= select("atom:entry", (N("atomCommonAttributes") (N("atomAuthor"))* (N("atomCategory"))* [N("atomContent")] (N("atomContributor"))* N("atomId") (N("atomLink"))* [N("atomPublished")] [N("atomRights")] [N("atomSource")] [N("atomSummary")] N("atomTitle") N("atomUpdated") (N("extensionElement"))*));
N("atomInlineTextContent") ::= select("atom:content", (N("atomCommonAttributes") [select("type", ("text" | "html"))] (value("string"))*));
N("atomInlineXHTMLContent") ::= select("atom:content", (N("atomCommonAttributes") select("type", "xhtml") N("xhtmlDiv")));
N("atomInlineOtherContent") ::= select("atom:content", (N("atomCommonAttributes") [select("type", N("atomMediaType"))] ((value("string") | N("anyElement")))*));
N("atomOutOfLineContent") ::= select("atom:content", (N("atomCommonAttributes") [select("type", N("atomMediaType"))] select("src", N("atomUri"))));
N("atomContent") ::= (N("atomInlineTextContent") | N("atomInlineXHTMLContent") | N("atomInlineOtherContent") | N("atomOutOfLineContent"));
N("atomAuthor") ::= select("atom:author", N("atomPersonConstruct"));
N("atomCategory") ::= select("atom:category", (N("atomCommonAttributes") select("term", value("string")) [select("scheme", N("atomUri"))] [select("label", value("string"))] N("undefinedContent")));
N("atomContributor") ::= select("atom:contributor", N("atomPersonConstruct"));
N("atomGenerator") ::= select("atom:generator", (N("atomCommonAttributes") [select("uri", N("atomUri"))] [select("version", value("string"))] value("string")));
N("atomIcon") ::= select("atom:icon", (N("atomCommonAttributes") N("atomUri")));
N("atomId") ::= select("atom:id", (N("atomCommonAttributes") N("atomUri")));
N("atomLogo") ::= select("atom:logo", (N("atomCommonAttributes") N("atomUri")));
N("atomLink") ::= select("atom:link", (N("atomCommonAttributes") select("href", N("atomUri")) [select("rel", (N("atomNCName") | N("atomUri")))] [select("type", N("atomMediaType"))] [select("hreflang", N("atomLanguageTag"))] [select("title", value("string"))] [select("length", value("string"))] N("undefinedContent")));
N("atomPublished") ::= select("atom:published", N("atomDateConstruct"));
N("atomRights") ::= select("atom:rights", N("atomTextConstruct"));
N("atomSource") ::= select("atom:source", (N("atomCommonAttributes") (N("atomAuthor"))* (N("atomCategory"))* (N("atomContributor"))* [N("atomGenerator")] [N("atomIcon")] [N("atomId")] (N("atomLink"))* [N("atomLogo")] [N("atomRights")] [N("atomSubtitle")] [N("atomTitle")] [N("atomUpdated")] (N("extensionElement"))*));
N("atomSubtitle") ::= select("atom:subtitle", N("atomTextConstruct"));
N("atomSummary") ::= select("atom:summary", N("atomTextConstruct"));
N("atomTitle") ::= select("atom:title", N("atomTextConstruct"));
N("atomUpdated") ::= select("atom:updated", N("atomDateConstruct"));
N("atomNCName") ::= value("string");
N("atomMediaType") ::= value("string");
N("atomLanguageTag") ::= value("string");
N("atomUri") ::= value("string");
N("atomEmailAddress") ::= value("string");
N("simpleExtensionElement") ::= value("string");
N("structuredExtensionElement") ::= (((any)+ ((value("string") | N("anyElement")))*) | ((any)* [value("string")] (N("anyElement"))+ ((value("string") | N("anyElement")))*));
N("extensionElement") ::= (N("simpleExtensionElement") | N("structuredExtensionElement"));
N("undefinedAttribute") ::= any;
N("undefinedContent") ::= ((value("string") | N("anyForeignElement")))*;
N("anyElement") ::= ((any | value("string") | N("anyElement")))*;
N("anyForeignElement") ::= ((any | value("string") | N("anyElement")))*;
N("anyXHTML") ::= ((any | value("string") | N("anyXHTML")))*;
N("xhtmlDiv") ::= select("xhtml:div", ((any | value("string") | N("anyXHTML")))*);
