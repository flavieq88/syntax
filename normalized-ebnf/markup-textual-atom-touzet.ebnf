N("String") ::= value("string");
N("Integer") ::= value("int");
N("ATOM") ::= (select("title", N("String")) select("id", N("String")) select("subtitle", N("String")) select("rights", N("String")) select("icon", N("String")) select("logo", N("String")) (select("links", N("Link")))+ select("lastUpdate", N("Date")) select("generator", N("Generator")) (select("categories", N("Category")))+ (select("authors", N("Author")))+ (select("contibutors", N("Contributor")))+ (select("entries", N("Entry")))+);
N("Entry") ::= (select("title", N("String")) select("id", N("String")) select("rights", N("String")) select("summary", N("String")) (select("links", N("Link")))+ select("source", N("Source")) select("published", N("Date")) select("lastUpdate", N("Date")) select("content", N("Content")) (select("categories", N("Category")))+ (select("authors", N("Author")))+ (select("contibutors", N("Contributor")))+ select("atom", N("ATOM")));
N("Source") ::= (select("id", N("String")) select("icon", N("String")) select("logo", N("String")) select("rights", N("String")) select("title", N("String")) select("subtitle", N("String")) (select("links", N("Link")))+ select("lastUpdate", N("Date")) select("generator", N("Generator")) (select("contributors", N("Contributor")))+ (select("categories", N("Category")))+ select("author", N("Author")));
N("Content") ::= N("InLineXHTMLContent");
N("Content") ::= N("InLineOtherContent");
N("Content") ::= N("OutOfLineContent");
