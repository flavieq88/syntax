N("BibTeXFile") ::= (select("entries", N("BibTeXEntry")))+;
N("Author") ::= select("author", N("String"));
N("BibTeXEntry") ::= N("AuthoredEntry");
N("BibTeXEntry") ::= N("DatedEntry");
N("BibTeXEntry") ::= N("TitledEntry");
N("BibTeXEntry") ::= N("BookTitledEntry");
N("BibTeXEntry") ::= N("Misc");
N("AuthoredEntry") ::= N("Article");
N("AuthoredEntry") ::= N("TechReport");
N("AuthoredEntry") ::= N("Unpublished");
N("AuthoredEntry") ::= N("Book");
N("AuthoredEntry") ::= N("ThesisEntry");
N("DatedEntry") ::= N("Booklet");
N("DatedEntry") ::= N("Proceedings");
N("TitledEntry") ::= N("Manual");
N("TitledEntry") ::= N("Unpublished");
N("TitledEntry") ::= N("Proceedings");
N("BookTitledEntry") ::= N("InCollection");
N("Article") ::= select("journal", N("String"));
N("TechReport") ::= ((select("authors", N("Author")))+);
N("Unpublished") ::= select("note", N("String"));
N("Manual") ::= (select("title", N("String")));
N("Proceedings") ::= N("InProceedings");
N("Proceedings") ::= (select("year", N("String")) select("title", N("String")));
N("InProceedings") ::= epsilon;
N("Booklet") ::= (select("year", N("String")));
N("Book") ::= N("InBook");
N("Book") ::= N("InCollection");
N("Book") ::= select("publisher", N("String"));
N("InCollection") ::= (select("publisher", N("String")) select("booktitle", N("String")));
N("InBook") ::= select("chapter", N("Integer"));
N("Misc") ::= (select("id", N("String")));
N("ThesisEntry") ::= N("PhDThesis");
N("ThesisEntry") ::= N("MasterThesis");
N("PhDThesis") ::= (select("school", N("String")));
N("MasterThesis") ::= (select("school", N("String")));
N("String") ::= value("string");
N("Integer") ::= value("int");
