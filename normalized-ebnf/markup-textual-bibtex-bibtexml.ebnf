N("BibtexFile") ::= (select("entries", N("Entry")))+;
N("Author") ::= select("name", N("String"));
N("Entry") ::= N("AuthoredEntry");
N("Entry") ::= N("BookTitledEntry");
N("Entry") ::= N("InstitutionEntry");
N("Entry") ::= N("EditoredEntry");
N("Entry") ::= N("DatedEntry");
N("Entry") ::= N("JournalEntry");
N("Entry") ::= N("TitledEntry");
N("Entry") ::= N("NotedEntry");
N("Entry") ::= N("PublisheredEntry");
N("Entry") ::= N("SchoolEntry");
N("Entry") ::= N("Misc");
N("AuthoredEntry") ::= N("Article");
N("AuthoredEntry") ::= N("Book");
N("AuthoredEntry") ::= N("TechReport");
N("AuthoredEntry") ::= N("ThesisEntry");
N("AuthoredEntry") ::= N("InProceedings");
N("AuthoredEntry") ::= N("Unpublished");
N("BookTitledEntry") ::= N("InCollection");
N("DatedEntry") ::= N("Booklet");
N("DatedEntry") ::= N("Proceedings");
N("TitledEntry") ::= N("Manual");
N("TitledEntry") ::= N("Booklet");
N("TitledEntry") ::= N("Proceedings");
N("Article") ::= (select("volume", N("String")) select("number", N("String")) select("pages", N("String")) select("note", N("String")));
N("Book") ::= N("InBook");
N("Book") ::= N("InCollection");
N("Book") ::= (select("volume", N("String")) select("number", N("String")) select("series", N("String")) select("address", N("String")) select("edition", N("String")) select("note", N("String")));
N("Booklet") ::= ((select("authors", N("Author")))+ select("howpublished", N("String")) select("address", N("String")) select("note", N("String")));
N("InBook") ::= (select("chapter", N("String")) select("type", N("String")));
N("InCollection") ::= (select("chapter", N("String")) select("type", N("String")));
N("Manual") ::= (select("organization", N("String")) select("address", N("String")) select("edition", N("String")) select("note", N("String")));
N("TechReport") ::= (select("type", N("String")) select("number", N("String")) select("address", N("String")) select("note", N("String")));
N("ThesisEntry") ::= N("PhdThesis");
N("ThesisEntry") ::= N("MastersThesis");
N("PhdThesis") ::= (select("type", N("String")) select("address", N("String")) select("note", N("String")));
N("MastersThesis") ::= (select("type", N("String")) select("address", N("String")) select("note", N("String")));
N("Proceedings") ::= (select("editor", N("String")) select("volume", N("String")) select("number", N("String")) select("series", N("String")) select("address", N("String")) select("organization", N("String")) select("publisher", N("String")) select("note", N("String")));
N("InProceedings") ::= N("Conference");
N("InProceedings") ::= select("pages", N("String"));
N("Conference") ::= (select("pages", N("String")));
N("Unpublished") ::= ((select("authors", N("Author")))+);
N("Misc") ::= ((select("authors", N("Author")))+ select("title", N("String")) select("howpublished", N("String")) select("month", N("String")) select("year", N("String")) select("note", N("String")));
N("String") ::= value("string");
