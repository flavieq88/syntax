N("Value") ::= (select("null", epsilon) | select("object", select("members", ((select("memberName", value("string")) select("memberValue", N("Value"))))*)) | select("array", select("values", (N("Value"))*)) | select("integer", select("n", value("int"))) | select("float", select("r", value("int"))) | select("string", select("s", value("string"))) | select("boolean", select("b", ("true" | "false"))));
