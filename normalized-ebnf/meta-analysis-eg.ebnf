N("ExecutionGraph") ::= ((select("node", N("Node")))+ select("nodeNested", N("Node")));
N("Node") ::= N("Start");
N("Node") ::= N("End");
N("Node") ::= N("Control");
N("Node") ::= N("Basic");
N("Node") ::= ((select("predecessor", N("Node")))+ (select("successor", N("Node")))+ select("executionGraph", N("ExecutionGraph")) (select("nested", N("ExecutionGraph")))+);
N("Start") ::= ((select("predecessor", N("Node")))+ (select("successor", N("Node")))+ select("executionGraph", N("ExecutionGraph")) (select("nested", N("ExecutionGraph")))+);
N("End") ::= ((select("predecessor", N("Node")))+ (select("successor", N("Node")))+ select("executionGraph", N("ExecutionGraph")) (select("nested", N("ExecutionGraph")))+);
N("Control") ::= N("Branch");
N("Control") ::= N("Loop");
N("Control") ::= N("Fork");
N("Control") ::= N("Join");
N("Control") ::= N("Acquire");
N("Control") ::= N("Release");
N("Control") ::= N("Split");
N("Control") ::= (N("Branch") | N("Loop") | N("Fork") | N("Join") | N("Acquire") | N("Release") | N("Split"));
N("Basic") ::= ((select("predecessor", N("Node")))+ (select("successor", N("Node")))+ select("executionGraph", N("ExecutionGraph")) (select("nested", N("ExecutionGraph")))+);
N("Branch") ::= epsilon;
N("Loop") ::= epsilon;
N("Fork") ::= epsilon;
N("Join") ::= epsilon;
N("Acquire") ::= epsilon;
N("Release") ::= epsilon;
N("Split") ::= epsilon;
N("String") ::= value("string");
N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
