N("VisibilityKind") ::= (select("vk_public_vis", epsilon) | select("vk_private_vis", epsilon) | select("vk_protected_vis", epsilon));
N("BooleanExpression") ::= select("expresssion", N("String"));
N("ModelElement") ::= N("Dependency");
N("ModelElement") ::= N("Constraint");
N("ModelElement") ::= N("Feature");
N("ModelElement") ::= N("NameSpace");
N("ModelElement") ::= (select("name", N("String")) select("visibility", N("VisibilityKind")) (select("contraints", N("Constraint")))+ (select("clientDependencies", N("Dependency")))+ (select("supplierDependencies", N("Dependency")))+ select("namespace", N("NameSpace")) (select("importers", N("Package")))+);
N("Dependency") ::= (select("kind", N("String")) (select("clients", N("ModelElement")))+ (select("suppliers", N("ModelElement")))+);
N("Constraint") ::= (select("body", N("BooleanExpression")) (select("constrainedElements", N("ModelElement")))+);
N("Feature") ::= N("StructuralFeature");
N("Feature") ::= select("owner", N("Classifier"));
N("StructuralFeature") ::= N("Attribute");
N("StructuralFeature") ::= select("type", N("Classifier"));
N("Attribute") ::= (select("type", N("Classifier")));
N("NameSpace") ::= N("Classifier");
N("NameSpace") ::= N("Package");
N("NameSpace") ::= (select("ownedElements", N("ModelElement")))+;
N("Classifier") ::= N("Class");
N("Classifier") ::= N("Datatype");
N("Classifier") ::= N("Subsystem");
N("Classifier") ::= (select("features", N("Feature")))+;
N("Package") ::= N("Model");
N("Package") ::= N("Subsystem");
N("Package") ::= (select("importedElements", N("ModelElement")))+;
N("Class") ::= ((select("features", N("Feature")))+);
N("Datatype") ::= ((select("features", N("Feature")))+);
N("Subsystem") ::= ((select("features", N("Feature")))+ (select("importedElements", N("ModelElement")))+);
N("Model") ::= ((select("importedElements", N("ModelElement")))+);
N("Integer") ::= value("int");
N("String") ::= value("string");
N("Boolean") ::= ("true" | "false");
