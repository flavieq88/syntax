N("Integer") ::= value("int");
N("String") ::= value("string");
N("Boolean") ::= ("true" | "false");
N("QueryExpression") ::= select("expresssion", N("String"));
N("CheckConstraint") ::= ((select("constraintElements", N("Column")))+ (select("constrainedElements", N("Table")))+);
N("Column") ::= (select("precision", N("Integer")) select("scale", N("Integer")) select("isNullable", N("Boolean")) select("length", N("Integer")) select("collectionName", N("String")) select("characterSetName", N("String")) (select("column_constraints", N("CheckConstraint")))+ select("type", N("SQLDataType")) select("owner", N("ColumnSet")) select("optionScopeColumnSet", N("NamedColumnSet")));
N("ColumnSet") ::= N("NamedColumnSet");
N("ColumnSet") ::= N("QueryColumnSet");
N("ColumnSet") ::= (select("features", N("Column")))+;
N("NamedColumnSet") ::= N("Table");
N("NamedColumnSet") ::= N("View");
N("NamedColumnSet") ::= (select("optionScopeColumn", N("Column")) (select("triggers", N("Trigger")))+);
N("QueryColumnSet") ::= select("query", N("QueryExpression"));
N("Table") ::= (select("isTemporary", N("Boolean")) select("temporaryScope", N("String")) select("isSystem", N("Boolean")) (select("table_constraints", N("CheckConstraint")))+);
N("View") ::= (select("isReadOnly", N("Boolean")) select("checkOption", N("Boolean")) select("queryExpression", N("QueryExpression")));
N("Trigger") ::= select("namedColumnSet", N("NamedColumnSet"));
N("SQLDataType") ::= N("SQLDistinctType");
N("SQLDataType") ::= N("SQLSimpleType");
N("SQLDataType") ::= (select("typeNumber", N("Integer")) (select("structuralFeatures", N("Column")))+);
N("SQLDistinctType") ::= (select("length", N("Integer")) select("precision", N("Integer")) select("scale", N("Integer")) select("sqlSimpleType", N("SQLSimpleType")));
N("SQLSimpleType") ::= (select("characterMaximumLength", N("Integer")) select("characterOctetLength", N("Integer")) select("numericPrecision", N("Integer")) select("numericPrecisionRadix", N("Integer")) select("numericScale", N("Integer")) select("dateTimePrecision", N("Integer")) (select("sqlDistinctTypes", N("SQLDistinctType")))+);
