@root N("ANTLR4Grammar");

N("OptionsSpec") ::= ("options" "{" ((N("Option") ";"))* "}");
N("SetElement") ::= N("Range");
N("SetElement") ::= (N("STRING_LITERAL") [N("ElementOptions")]);
N("SetElement") ::= (N("Id") [N("ElementOptions")]);
N("LexerCommand") ::= ((N("Id") | "mode") [("(" (N("Id") | N("INT")) ")")]);
N("LexerCommands") ::= ("->" sep+(N("LexerCommand"), ","));
N("EbnfSuffix") ::= (("+" | "*" | "?") ["?"]);
N("LexerAlt") ::= ((N("LexerElement"))+ [N("LexerCommands")]);
N("LexerAtom") ::= N("Range");
N("LexerAtom") ::= N("LEXER_CHAR_SET");
N("LexerAtom") ::= ("." [N("ElementOptions")]);
N("LexerAtom") ::= ("~" (N("SetElement") | N("BlockSet")));
N("LexerAtom") ::= ((N("Id") | N("STRING_LITERAL")) [N("ElementOptions")]);
N("Range") ::= (N("STRING_LITERAL") ".." N("STRING_LITERAL"));
N("Element") ::= (N("LabeledElement") [N("EbnfSuffix")]);
N("Element") ::= (N("ACTION") ["?"]);
N("Element") ::= (N("Atom") [N("EbnfSuffix")]);
N("Element") ::= N("Ebnf");
N("OptionValue") ::= (N("Id") (("." N("Id")))*);
N("OptionValue") ::= N("INT");
N("OptionValue") ::= N("ACTION");
N("OptionValue") ::= N("STRING_LITERAL");
N("ModeSpec") ::= ("mode" N("Id") ";" (N("LexerRule"))*);
N("RuleBlock") ::= sep+(N("LabeledAlt"), "|");
N("Atom") ::= ("." [N("ElementOptions")]);
N("Atom") ::= (N("Id") [N("ARG_ACTION")] [N("ElementOptions")]);
N("Atom") ::= N("Range");
N("Atom") ::= ("~" (N("SetElement") | N("BlockSet")));
N("Atom") ::= ((N("Id") | N("STRING_LITERAL")) [N("ElementOptions")]);
N("DelegateGrammars") ::= ("import" sep+(N("DelegateGrammar"), ",") ";");
N("ElementOption") ::= (N("Id") [("=" (N("Id") | N("STRING_LITERAL")))]);
N("ExceptionGroup") ::= ((("catch" N("ARG_ACTION") N("ACTION")))* [("finally" N("ACTION"))]);
N("LexerElement") ::= (N("LabeledLexerElement") [N("EbnfSuffix")]);
N("LexerElement") ::= (N("LexerBlock") [N("EbnfSuffix")]);
N("LexerElement") ::= (N("LexerAtom") [N("EbnfSuffix")]);
N("LexerElement") ::= (N("ACTION") ["?"]);
N("RuleModifier") ::= "private";
N("RuleModifier") ::= "fragment";
N("RuleModifier") ::= "public";
N("RuleModifier") ::= "protected";
N("RuleAction") ::= ("@" N("Id") N("ACTION"));
N("RulePrequel") ::= N("RuleAction");
N("RulePrequel") ::= N("OptionsSpec");
N("Ebnf") ::= (N("Block") [N("EbnfSuffix")]);
N("BlockSet") ::= ("(" sep+(N("SetElement"), "|") ")");
N("Option") ::= (N("Id") "=" N("OptionValue"));
N("TokensSpec") ::= ("tokens" "{" sep+(N("Id"), ",") "}");
N("RuleSpec") ::= N("LexerRule");
N("RuleSpec") ::= N("ParserRuleSpec");
N("Action") ::= ("@" [(N("ActionScopeName") "::")] N("Id") N("ACTION"));
N("ParserRuleSpec") ::= ((N("RuleModifier"))* N("Id") [N("ARG_ACTION")] [N("RuleReturns")] [N("ThrowsSpec")] [N("LocalsSpec")] (N("RulePrequel"))* ":" N("RuleBlock") ";" N("ExceptionGroup"));
N("LabeledAlt") ::= (N("Alternative") [("#" N("Id"))]);
N("ActionScopeName") ::= "parser";
N("ActionScopeName") ::= "lexer";
N("ActionScopeName") ::= N("Id");
N("LabeledElement") ::= (N("Id") ("=" | "+=") (N("Atom") | N("Block")));
N("PrequelConstruct") ::= N("OptionsSpec");
N("PrequelConstruct") ::= N("Action");
N("PrequelConstruct") ::= N("DelegateGrammars");
N("PrequelConstruct") ::= N("TokensSpec");
N("ThrowsSpec") ::= ("throws" sep+(N("Id"), ","));
N("LexerRule") ::= (["fragment"] N("Id") ":" sep+(N("LexerAlt"), "|") ";");
N("Alternative") ::= ([N("ElementOptions")] (N("Element"))*);
N("Block") ::= ("(" [([N("OptionsSpec")] (N("RuleAction"))* ":")] N("AltList") ")");
N("GrammarType") ::= ([("lexer" | "parser")] "grammar");
N("LexerBlock") ::= ("(" sep+(N("LexerAlt"), "|") ")");
N("ANTLR4Grammar") ::= (N("GrammarType") N("Id") ";" (N("PrequelConstruct"))* (N("RuleSpec"))* (N("ModeSpec"))*);
N("LocalsSpec") ::= ("locals" N("ARG_ACTION"));
N("LabeledLexerElement") ::= (N("Id") ("=" | "+=") (N("LexerAtom") | N("Block")));
N("DelegateGrammar") ::= (N("Id") [("=" N("Id"))]);
N("ElementOptions") ::= ("<" sep+(N("ElementOption"), ",") ">");
N("RuleReturns") ::= ("returns" N("ARG_ACTION"));
N("AltList") ::= sep+(N("Alternative"), "|");
