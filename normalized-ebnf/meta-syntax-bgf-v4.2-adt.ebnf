N("BGFGrammar") ::= select("grammar", (select("roots", (value("string"))*) select("prods", (N("BGFProduction"))*)));
N("BGFProduction") ::= select("production", (select("label", value("string")) select("lhs", value("string")) select("rhs", N("BGFExpression"))));
N("BGFExpression") ::= (select("epsilon", epsilon) | select("empty", epsilon) | select("val", select("v", N("BGFValue"))) | select("anything", epsilon) | select("terminal", select("t", value("string"))) | select("nonterminal", select("t", value("string"))) | select("selectable", (select("selector", value("string")) select("expr", N("BGFExpression")))) | select("sequence", select("exprs", (N("BGFExpression"))*)) | select("choice", select("exprs", (N("BGFExpression"))*)) | select("marked", select("expr", N("BGFExpression"))) | select("optional", select("expr", N("BGFExpression"))) | select("plus", select("expr", N("BGFExpression"))) | select("star", select("expr", N("BGFExpression"))) | select("starsepplus", (select("expr", N("BGFExpression")) select("sep", N("BGFExpression")))) | select("starsepstar", (select("expr", N("BGFExpression")) select("sep", N("BGFExpression")))));
N("BGFValue") ::= (select("string", epsilon) | select("integer", epsilon));
