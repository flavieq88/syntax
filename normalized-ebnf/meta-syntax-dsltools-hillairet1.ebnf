N("NamedElement") ::= N("Namespace");
N("NamedElement") ::= N("Role");
N("NamedElement") ::= N("ValueProperty");
N("NamedElement") ::= N("EnumerationLiteral");
N("LoadedElement") ::= N("DomainModel");
N("LoadedElement") ::= N("Classifier");
N("Namespace") ::= N("LoadedElement");
N("Namespace") ::= N("Type");
N("DomainModel") ::= ((select("classifiers", N("Classifier")))+ (select("types", N("Type")))+);
N("Classifier") ::= N("Class");
N("Classifier") ::= N("Relationship");
N("Class") ::= select("isSerializationRoot", N("PrimitiveTypes/Boolean"));
N("Relationship") ::= (select("isEmbedding", N("PrimitiveTypes/Boolean")) select("roles", N("Role")));
N("Role") ::= (select("min", N("PrimitiveTypes/Integer")) select("max", N("PrimitiveTypes/Integer")) select("isUnbounded", N("PrimitiveTypes/Boolean")) select("accepts", N("PrimitiveTypes/String")) select("isOrdered", N("PrimitiveTypes/Boolean")) select("isNavigableFrom", N("PrimitiveTypes/Boolean")) select("isPropertyGenerator", N("PrimitiveTypes/Boolean")) select("source", N("Classifier")) select("type", N("Classifier")) select("relation", N("Relationship")));
N("ValueProperty") ::= (select("owner", N("Classifier")) select("type", N("Type")));
N("Type") ::= N("SimpleType");
N("Type") ::= N("Enumeration");
N("SimpleType") ::= epsilon;
N("EnumerationLiteral") ::= select("value", N("PrimitiveTypes/Integer"));
N("Enumeration") ::= (select("literals", N("EnumerationLiteral")))+;
N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
N("String") ::= value("string");
