N("Model") ::= (select("domainModel", N("PrimitiveTypes/String")) (select("contents", N("ModelElement")))+);
N("Element") ::= N("ModelElement");
N("Element") ::= N("ReferenceLink");
N("ModelElement") ::= N("ModelElementLink");
N("ModelElement") ::= (select("parentLink", N("EmbeddingLink")) (select("properties", N("Property")))+ (select("embeddinglinks", N("EmbeddingLink")))+ (select("referencelinks", N("ReferenceLink")))+);
N("ModelElementLink") ::= (select("links", N("ReferenceLink")))+;
N("EmbeddingLink") ::= (select("owner", N("ModelElement")) (select("elements", N("ModelElement")))+);
N("ReferenceLink") ::= (select("owner", N("ModelElement")) select("modelElement", N("ModelElementLink")) select("roles", N("Role")));
N("NamedElement") ::= N("EmbeddingLink");
N("NamedElement") ::= N("Property");
N("NamedElement") ::= N("Role");
N("Property") ::= (select("owner", N("ModelElement")) select("value", N("Value")));
N("Role") ::= (select("element", N("ModelElement")) select("owner", N("ReferenceLink")));
N("Value") ::= N("IntegerValue");
N("Value") ::= N("DoubleValue");
N("Value") ::= N("BooleanValue");
N("Value") ::= N("StringValue");
N("IntegerValue") ::= select("value", N("PrimitiveTypes/Integer"));
N("DoubleValue") ::= select("value", N("PrimitiveTypes/Double"));
N("BooleanValue") ::= select("value", N("PrimitiveTypes/Boolean"));
N("StringValue") ::= select("value", N("PrimitiveTypes/String"));
N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
N("String") ::= value("string");
