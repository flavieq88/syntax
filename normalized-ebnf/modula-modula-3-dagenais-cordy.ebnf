@root N("program");

N("program") ::= (N("Interface") | N("Module") | N("GInterface") | N("GModule") | N("IInterface") | N("IModule"));
N("Interface") ::= (["UNSAFE"] "INTERFACE" N("id") ";" (N("NL") N("NL")) (N("Import"))* (N("Decl"))* N("NL") "END" N("id") "." N("NL"));
N("IInterface") ::= (["UNSAFE"] "INTERFACE" N("id") "=" N("id") N("GenActls") "END" N("id") "." N("NL"));
N("Module") ::= (["UNSAFE"] "MODULE" N("id") [N("Exports")] ";" (N("NL") N("NL")) (N("Import"))* N("Block") N("id") "." N("NL"));
N("IModule") ::= (["UNSAFE"] "MODULE" N("id") [N("Exports")] "=" N("id") N("GenActls") "END" N("id") "." N("NL"));
N("GInterface") ::= ("GENERIC" "INTERFACE" N("id") N("GenFmls") ";" (N("Import"))* (N("Decl"))* N("NL") "END" N("id") "." N("NL"));
N("GModule") ::= ("GENERIC" "MODULE" N("id") N("GenFmls") ";" (N("NL") N("NL")) (N("Import"))* N("Block") N("id") "." N("NL"));
N("Exports") ::= ("EXPORTS" N("IdList"));
N("Import") ::= (N("AsImport") | (N("FromImport") (N("NL") N("NL"))));
N("AsImport") ::= ("IMPORT" N("ImportItem") (N("ComaImportItem"))* ";" (N("NL") N("NL")));
N("ComaImportItem") ::= ("," N("ImportItem"));
N("FromImport") ::= ("FROM" N("id") "IMPORT" N("IdList") ";" (N("NL") N("NL")));
N("Block") ::= ((N("Decl"))* "BEGIN" N("Stmts") "END");
N("Decl") ::= ((N("ProcedureHead") [N("EqualBlock")] ";" (N("NL") N("NL"))) | ("VAR" (N("IN") N("NL")) (N("VariableDecl"))* N("EX")) | ("TYPE" (N("IN") N("NL")) (N("TypeDecl"))* (N("EX") N("NL"))) | ("CONST" (N("IN") N("NL")) (N("ConstDecl"))* (N("EX") N("NL"))) | ("EXCEPTION" (N("IN") N("NL")) (N("ExceptionDecl"))* (N("EX") N("NL"))) | ("REVEAL" (N("IN") N("NL")) (N("RevealDecl"))* (N("EX") N("NL"))));
N("EqualBlock") ::= ("=" (N("IN") N("NL")) N("Block") N("id") N("EX"));
N("GenFmls") ::= ("(" [N("IdList")] ")");
N("GenActls") ::= ("(" [N("IdList")] ")");
N("ImportItem") ::= (N("id") [N("AsId")]);
N("AsId") ::= ("AS" N("id"));
N("ConstDecl") ::= (N("id") [N("ColonType")] "=" N("ConstExpr") ";" N("NL"));
N("ColonType") ::= (":" N("Type"));
N("TypeDecl") ::= ((N("id") "=" N("Type") ";" N("NL")) | (N("id") "<:" N("Type") ";" N("NL")));
N("RevealDecl") ::= ((N("QualId") "=" N("Type") ";" N("NL")) | (N("QualId") "<:" N("Type") ";" N("NL")));
N("ExceptionDecl") ::= (N("id") [N("ParenthesizedType")] ";" N("NL"));
N("ParenthesizedType") ::= ("(" N("Type") ")");
N("VariableDecl") ::= (N("IdList") [N("ColonType")] [N("EqualExpr")] ";" N("NL"));
N("EqualExpr") ::= (":=" N("Expr"));
N("ProcedureHead") ::= ("PROCEDURE" N("id") N("Signature"));
N("Signature") ::= ("(" [N("Formals")] ")" [N("ColonType")] [N("Raises")]);
N("Raises") ::= ("RAISES" N("RaisesList"));
N("Formals") ::= (N("Formal") (N("SemicolonFormal"))* [";"]);
N("SemicolonFormal") ::= (";" N("Formal"));
N("Formal") ::= ([N("Mode")] N("IdList") [N("ColonType")] [N("EqualConstExpr")]);
N("EqualConstExpr") ::= (":=" N("ConstExpr"));
N("Mode") ::= ("VALUE" | "VAR" | "READONLY");
N("RaisesList") ::= (("{" sep*(N("QualId"), ",") "}") | "ANY");
N("Stmts") ::= ((N("IN") N("NL")) [N("OptStmts")] N("EX"));
N("OptStmts") ::= (N("Stmt") (N("SemiColonStmt"))* [";"] N("NL"));
N("SemiColonStmt") ::= (";" N("NL") N("Stmt"));
N("Stmt") ::= (N("IfStmt") | N("ForStmt") | N("ReturnStmt") | N("WhileStmt") | N("AssignStmt") | N("CallStmt") | N("Block") | N("CaseStmt") | N("ExitStmt") | N("EvalStmt") | N("LockStmt") | N("LoopStmt") | N("RaiseStmt") | N("RepeatStmt") | N("TypecaseStmt") | N("TryStmt") | N("WithStmt"));
N("AssignStmt") ::= (N("Expr") ":=" N("Expr"));
N("CallStmt") ::= (N("Expr") "(" sep*(N("Actual"), ",") ")");
N("CaseStmt") ::= ("CASE" N("Expr") "OF" N("NL") [N("Case")] (N("VerticalCase"))* [N("ElseStmts")] "END");
N("VerticalCase") ::= ("|" N("Case"));
N("ElseStmts") ::= ("ELSE" N("Stmts"));
N("ExitStmt") ::= "EXIT";
N("EvalStmt") ::= ("EVAL" N("Expr"));
N("ForStmt") ::= ("FOR" N("id") ":=" N("Expr") "TO" N("Expr") [N("ByExpr")] "DO" N("Stmts") "END");
N("ByExpr") ::= ("BY" N("Expr"));
N("IfStmt") ::= ("IF" N("Expr") "THEN" N("Stmts") (N("Elsif"))* [N("ElseStmts")] "END");
N("Elsif") ::= ("ELSIF" N("Expr") "THEN" N("Stmts"));
N("LockStmt") ::= ("LOCK" N("Expr") "DO" N("Stmts") "END");
N("LoopStmt") ::= ("LOOP" N("Stmts") "END");
N("RaiseStmt") ::= ("RAISE" N("QualId") [N("ParenthesizedExpr")]);
N("ParenthesizedExpr") ::= ("(" N("Expr") ")");
N("RepeatStmt") ::= ("REPEAT" N("Stmts") "UNTIL" N("Expr"));
N("ReturnStmt") ::= ("RETURN" [N("Expr")]);
N("TypecaseStmt") ::= ("TYPECASE" N("Expr") "OF" N("NL") [N("TCase")] (N("VerticalTCase"))* [N("ElseStmts")] "END");
N("VerticalTCase") ::= ("|" N("TCase"));
N("TryStmt") ::= ("TRY" N("Stmts") N("ExceptOrFinally") "END");
N("ExceptOrFinally") ::= (("EXCEPT" N("NL") [N("Handler")] (N("VerticalHandler"))* [N("ElseStmts")]) | ("FINALLY" N("Stmts")));
N("VerticalHandler") ::= ("|" N("Handler"));
N("WhileStmt") ::= ("WHILE" N("Expr") "DO" N("Stmts") "END");
N("WithStmt") ::= ("WITH" (N("Binding"))+ "DO" N("Stmts") "END");
N("Case") ::= (sep*(N("Labels"), ",") "=>" N("Stmts"));
N("Labels") ::= (N("ConstExpr") [N("DotDotConstExpr")]);
N("DotDotConstExpr") ::= (".." N("ConstExpr"));
N("Handler") ::= (sep*(N("QualId"), ",") [N("ParenthesizedId")] "=>" N("Stmts"));
N("ParenthesizedId") ::= ("(" N("id") ")");
N("TCase") ::= (sep*(N("Type"), ",") [N("ParenthesizedId")] "=>" N("Stmts"));
N("Binding") ::= (N("id") "=" N("Expr"));
N("Actual") ::= (N("Type") | N("Expr") | (N("id") ":=" N("Expr")));
N("Type") ::= (N("TypeName") | N("ArrayType") | N("EnumerationType") | N("RecordType") | N("ObjectType") | N("ProcedureType") | N("RefType") | N("SetType") | N("SubrangeType") | N("PackedType") | ("(" N("Type") ")"));
N("ArrayType") ::= ("ARRAY" sep*(N("Type"), ",") "OF" N("Type"));
N("PackedType") ::= ("BITS" N("ConstExpr") "FOR" N("Type"));
N("EnumerationType") ::= ("{" [N("IdList")] "}");
N("ObjectType") ::= ([N("ObjectOrTypeName")] [N("Brand")] "OBJECT" (N("IN") N("NL")) N("Fields") [N("TheMethods")] [N("TheOverrides")] "END" N("EX"));
N("ObjectOrTypeName") ::= (N("TypeName") | N("ObjectType"));
N("TheMethods") ::= ("METHODS" N("NL") N("Methods"));
N("TheOverrides") ::= ("OVERRIDES" N("NL") N("Overrides"));
N("ProcedureType") ::= ("PROCEDURE" N("Signature"));
N("RecordType") ::= ("RECORD" (N("IN") N("NL")) N("Fields") "END" N("EX"));
N("RefType") ::= (["UNTRACED"] [N("Brand")] "REF" N("Type"));
N("SetType") ::= ("SET" "OF" N("Type"));
N("SubrangeType") ::= ("[" N("ConstExpr") ".." N("ConstExpr") "]");
N("Brand") ::= ("BRANDED" [N("ConstExpr")]);
N("Fields") ::= [N("FieldList")];
N("FieldList") ::= (N("IN") N("Field") (N("SemiColonField"))* [";"] (N("EX") N("NL")));
N("SemiColonField") ::= (";" N("NL") N("Field"));
N("Field") ::= (N("IdList") [N("ColonType")] [N("EqualConstExpr")]);
N("Methods") ::= [N("MethodList")];
N("MethodList") ::= (N("IN") N("Method") (N("SemiColonMethod"))* [";"] (N("EX") N("NL")));
N("SemiColonMethod") ::= (";" N("NL") N("Method"));
N("Method") ::= (N("id") N("Signature") [N("EqualConstExpr")]);
N("Overrides") ::= [N("OverrideList")];
N("OverrideList") ::= (N("IN") N("Override") (N("SemiColonOverride"))* [";"] (N("EX") N("NL")));
N("SemiColonOverride") ::= (";" N("NL") N("Override"));
N("Override") ::= (N("id") ":=" N("ConstExpr"));
N("ConstExpr") ::= N("Expr");
N("Expr") ::= (N("E1") (N("OrE1"))*);
N("OrE1") ::= ("OR" N("E1"));
N("E1") ::= (N("E2") (N("AndE2"))*);
N("AndE2") ::= ("AND" N("E2"));
N("E2") ::= (("NOT")* N("E3"));
N("E3") ::= (N("E4") (N("RelOpE4"))*);
N("RelOpE4") ::= (N("RelOp") N("E4"));
N("E4") ::= (N("E5") (N("AddOpE5"))*);
N("AddOpE5") ::= (N("AddOp") N("E5"));
N("E5") ::= (N("E6") (N("MulOpE6"))*);
N("MulOpE6") ::= (N("MulOp") N("E6"));
N("E6") ::= ((N("SignOp"))* N("E7"));
N("E7") ::= (N("E8") (N("Selector"))*);
N("E8") ::= (N("id") | N("Number") | N("charlit") | N("stringlit") | ("(" N("Expr") ")") | N("Constructor"));
N("SignOp") ::= ("+" | "-");
N("RelOp") ::= ("=" | "#" | "<" | "<=" | ">" | ">=" | "IN");
N("AddOp") ::= ("+" | "-" | "&");
N("MulOp") ::= ("*" | "/" | "DIV" | "MOD");
N("Selector") ::= (("." N("id")) | ("[" N("Expr") (N("ComaExpr"))* "]") | ("(" sep*(N("Actual"), ",") ")") | "^");
N("ComaExpr") ::= ("," N("Expr"));
N("Constructor") ::= (N("Type") "{" N("AnyCons") "}");
N("AnyCons") ::= (N("SetCons") | N("RecordCons") | N("ArrayCons"));
N("SetCons") ::= sep*(N("SetElt"), ",");
N("SetElt") ::= (N("Expr") [N("DotDotExpr")]);
N("DotDotExpr") ::= (".." N("Expr"));
N("RecordCons") ::= sep*(N("RecordElt"), ",");
N("RecordElt") ::= (N("Expr") [N("EqualExpr")]);
N("ArrayCons") ::= (sep*(N("Expr"), ",") [N("ComaDotDot")]);
N("ComaDotDot") ::= ("," "..");
N("IdList") ::= sep*(N("id"), ",");
N("QualId") ::= (N("id") [N("DotId")]);
N("DotId") ::= ("." N("id"));
N("TypeName") ::= (N("QualId") | "ROOT" | ("UNTRACED" "ROOT"));
