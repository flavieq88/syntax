N("Compilation") ::= (["UNSAFE"] (N("Interface") | (N("Module") | (N("GenInf") | N("GenMod")))));
N("Interface") ::= ("INTERFACE" N("Id") ";" (N("Import"))* (N("Decl"))* "END" N("Id") ".");
N("Interface") ::= ("INTERFACE" N("Id") "=" N("Id") N("GenActls") "END" N("Id") ".");
N("Module") ::= ("MODULE" N("Id") [("EXPORTS" N("IdList"))] ";" (N("Import"))* N("Block") N("Id") ".");
N("Module") ::= ("MODULE" N("Id") [("EXPORTS" N("IdList"))] "=" N("Id") N("GenActls") "END" N("Id") ".");
N("GenInf") ::= ("GENERIC" "INTERFACE" N("Id") N("GenFmls") ";" (N("Import"))* (N("Decl"))* "END" N("Id") ".");
N("GenMod") ::= ("GENERIC" "MODULE" N("Id") N("GenFmls") ";" (N("Import"))* N("Block") N("Id") ".");
N("Import") ::= N("AsImport");
N("Import") ::= N("FromImport");
N("AsImport") ::= ("IMPORT" (N("ImportItem") (("," N("ImportItem")))*) ";");
N("FromImport") ::= ("FROM" N("Id") "IMPORT" N("IdList") ";");
N("Block") ::= ((N("Decl"))* "BEGIN" N("Stmts") "END");
N("Decl") ::= ("CONST" ((N("ConstDecl") ";"))*);
N("Decl") ::= ("TYPE" ((N("TypeDecl") ";"))*);
N("Decl") ::= ("EXCEPTION" ((N("ExceptionDecl") ";"))*);
N("Decl") ::= ("VAR" ((N("VariableDecl") ";"))*);
N("Decl") ::= (N("ProcedureHead") [("=" (N("Block") N("Id")))] ";");
N("Decl") ::= ("REVEAL" ((N("QualId") (("=" | "<:") (N("Type") ";"))))*);
N("GenFmls") ::= ("(" [N("IdList")] ")");
N("GenActls") ::= ("(" [N("IdList")] ")");
N("ImportItem") ::= (N("Id") | (N("Id") ("AS" N("Id"))));
N("ConstDecl") ::= (N("Id") [(":" N("Type"))] "=" N("Expr"));
N("TypeDecl") ::= (N("Id") ("=" | "<:") N("Type"));
N("ExceptionDecl") ::= (N("Id") [("(" (N("Type") ")"))]);
N("VariableDecl") ::= (N("IdList") ":" N("Type") ":=" N("Expr"));
N("VariableDecl") ::= (N("IdList") ":" N("Type"));
N("VariableDecl") ::= (N("IdList") ":=" N("Expr"));
N("ProcedureHead") ::= ("PROCEDURE" N("Id") N("Signature"));
N("Signature") ::= ("(" N("Formals") ")" [(":" N("Type"))] [("RAISES" N("Raises"))]);
N("Formals") ::= [((N("Formal") ((";" N("Formal")))*) [";"])];
N("Formal") ::= ([N("Mode")] N("IdList") ":" N("Type") ":=" N("Expr"));
N("Formal") ::= ([N("Mode")] N("IdList") ":" N("Type"));
N("Formal") ::= ([N("Mode")] N("IdList") ":=" N("Expr"));
N("Mode") ::= ("VALUE" | ("VAR" | "READONLY"));
N("Raises") ::= (("{" ([(N("QualId") (("," N("QualId")))*)] "}")) | "ANY");
N("Expr") ::= (N("Expr") "OR" N("Expr"));
N("Expr") ::= (N("Expr") "AND" N("Expr"));
N("Expr") ::= ("NOT" N("Expr"));
N("Id") ::= "NOT";
N("Expr") ::= (N("Expr") N("Relop") N("Expr"));
N("Expr") ::= (N("Expr") N("Addop") N("Expr"));
N("Expr") ::= (N("Expr") N("Mulop") N("Expr"));
N("Expr") ::= ("+" N("Expr"));
N("Expr") ::= ("-" N("Expr"));
N("Expr") ::= (N("Expr") N("Selector"));
N("Expr") ::= (N("Id") | (N("Literal") | N("Constructor")));
N("Expr") ::= ("(" N("Expr") ")");
N("Relop") ::= ("=" | ("#" | ("<" | ("<=" | (">" | (">=" | "IN"))))));
N("Addop") ::= ("+" | ("-" | "&"));
N("Mulop") ::= ("*" | ("/" | ("DIV" | "MOD")));
N("Selector") ::= "^";
N("Selector") ::= ("." N("Id"));
N("Selector") ::= ("[" (N("Expr") (("," N("Expr")))*) "]");
N("Selector") ::= ("(" [(N("Actual") (("," N("Actual")))*)] ")");
N("Elt") ::= (N("Expr") ".." N("Expr"));
N("Elt") ::= N("Expr");
N("Elt") ::= (N("Id") ":=" N("Expr"));
N("AnyCons") ::= ((N("Elt") (("," N("Elt")))*) [("," "..")]);
N("Constructor") ::= (N("Type") "{" [N("AnyCons")] "}");
N("Expr") ::= ("+" N("Expr"));
N("Expr") ::= ("-" N("Expr"));
N("Ident") ::= "ABS";
N("Ident") ::= "ADDRESS";
N("Ident") ::= "ADR";
N("Ident") ::= "ADRSIZE";
N("Ident") ::= "BITSIZE";
N("Ident") ::= "BOOLEAN";
N("Ident") ::= "BYTESIZE";
N("Ident") ::= "CARDINAL";
N("Ident") ::= "CEILING";
N("Ident") ::= "CHAR";
N("Ident") ::= "DEC";
N("Ident") ::= "DISPOSE";
N("Ident") ::= "FALSE";
N("Ident") ::= "FIRST";
N("Ident") ::= "FLOAT";
N("Ident") ::= "FLOOR";
N("Ident") ::= "INC";
N("Ident") ::= "INTEGER";
N("Ident") ::= "ISTYPE";
N("Ident") ::= "LAST";
N("Ident") ::= "LONGFLOAT";
N("Ident") ::= "LONGREAL";
N("Ident") ::= "LOOPHOLE";
N("Ident") ::= "MAX";
N("Ident") ::= "MIN";
N("Ident") ::= "MUTEX";
N("Ident") ::= "NARROW";
N("Ident") ::= "NEW";
N("Ident") ::= "NIL";
N("Ident") ::= "NULL";
N("Ident") ::= "NUMBER";
N("Ident") ::= "ORD";
N("Ident") ::= "REAL";
N("Ident") ::= "REFANY";
N("Ident") ::= "ROUND";
N("Ident") ::= "SUBARRAY";
N("Ident") ::= "TEXT";
N("Ident") ::= "TRUE";
N("Ident") ::= "TRUNC";
N("Ident") ::= "TYPECODE";
N("Ident") ::= "VAL";
N("Stmt") ::= N("AssignStmt");
N("Stmt") ::= N("Block");
N("Stmt") ::= N("CallStmt");
N("Stmt") ::= N("CaseStmt");
N("Stmt") ::= N("ExitStmt");
N("Stmt") ::= N("EvalStmt");
N("Stmt") ::= N("ForStmt");
N("Stmt") ::= N("IfStmt");
N("Stmt") ::= N("LockStmt");
N("Stmt") ::= N("LoopStmt");
N("Stmt") ::= N("RaiseStmt");
N("Stmt") ::= N("RepeatStmt");
N("Stmt") ::= N("ReturnStmt");
N("Stmt") ::= N("TryFinStmt");
N("Stmt") ::= N("TryXptStmt");
N("Stmt") ::= N("TCaseStmt");
N("Stmt") ::= N("WhileStmt");
N("Stmt") ::= N("WithStmt");
N("Stmts") ::= [((N("Stmt") ((";" N("Stmt")))*) [";"])];
N("AssignStmt") ::= (N("Expr") ":=" N("Expr"));
N("CallStmt") ::= (N("Expr") "(" [(N("Actual") (("," N("Actual")))*)] ")");
N("CaseStmt") ::= ("CASE" N("Expr") "OF" ["|"] (N("Case") (("|" N("Case")))*) [("ELSE" N("Stmts"))] "END");
N("ExitStmt") ::= "EXIT";
N("EvalStmt") ::= ("EVAL" N("Expr"));
N("ForStmt") ::= ("FOR" N("Id") ":=" N("Expr") "TO" N("Expr") [("BY" N("Expr"))] "DO" N("Stmts") "END");
N("IfStmt") ::= ("IF" N("Expr") "THEN" N("Stmts") (("ELSIF" (N("Expr") ("THEN" N("Stmts")))))* [("ELSE" N("Stmts"))] "END");
N("LockStmt") ::= ("LOCK" N("Expr") "DO" N("Stmts") "END");
N("LoopStmt") ::= ("LOOP" N("Stmts") "END");
N("RaiseStmt") ::= ("RAISE" N("QualId") [("(" (N("Expr") ")"))]);
N("RepeatStmt") ::= ("REPEAT" N("Stmts") "UNTIL" N("Expr"));
N("ReturnStmt") ::= ("RETURN" [N("Expr")]);
N("TCaseStmt") ::= ("TYPECASE" N("Expr") "OF" ["|"] (N("TCase") (("|" N("TCase")))*) [("ELSE" N("Stmts"))] "END");
N("TryXptStmt") ::= ("TRY" N("Stmts") "EXCEPT" ["|"] (N("Handler") (("|" N("Handler")))*) [("ELSE" N("Stmts"))] "END");
N("TryFinStmt") ::= ("TRY" N("Stmts") "FINALLY" N("Stmts") "END");
N("WhileStmt") ::= ("WHILE" N("Expr") "DO" N("Stmts") "END");
N("WithStmt") ::= ("WITH" (N("Binding") (("," N("Binding")))*) "DO" N("Stmts") "END");
N("Case") ::= ((N("Label") (("," N("Label")))*) "=>" N("Stmts"));
N("Label") ::= (N("Expr") [(".." N("Expr"))]);
N("Handler") ::= ((N("QualId") (("," N("QualId")))*) [("(" (N("Id") ")"))] "=>" N("Stmts"));
N("TCase") ::= ((N("Type") (("," N("Type")))*) [("(" (N("Id") ")"))] "=>" N("Stmts"));
N("Binding") ::= (N("Id") "=" N("Expr"));
N("Actual") ::= (N("TypeLiteral") | ([(N("Id") ":=")] N("Expr")));
N("QualId") ::= (N("Id") [("." N("Id"))]);
N("IdList") ::= (N("Id") (("," N("Id")))*);
N("TypeName") ::= ("ROOT" | ("UNTRACED" "ROOT"));
N("Id") ::= "ROOT";
N("Type") ::= N("TypeLiteral");
N("Type") ::= N("QualId");
N("TypeLiteral") ::= N("ArrayType");
N("TypeLiteral") ::= N("PackedType");
N("TypeLiteral") ::= N("EnumType");
N("TypeLiteral") ::= N("ObjectType");
N("TypeLiteral") ::= N("ProcedureType");
N("TypeLiteral") ::= N("RecordType");
N("TypeLiteral") ::= N("RefType");
N("TypeLiteral") ::= N("SetType");
N("TypeLiteral") ::= N("SubrangeType");
N("TypeLiteral") ::= ("(" N("Type") ")");
N("TypeLiteral") ::= N("TypeName");
N("ArrayType") ::= ("ARRAY" [(N("Type") (("," N("Type")))*)] "OF" N("Type"));
N("PackedType") ::= ("BITS" N("Expr") "FOR" N("Type"));
N("EnumType") ::= ("{" [N("IdList")] "}");
N("Ancestor") ::= (N("TypeName") | (N("ObjectType") | N("QualId")));
N("ObjectType") ::= ([N("Ancestor")] [N("Brand")] "OBJECT" N("Fields") [("METHODS" N("Methods"))] [("OVERRIDES" N("Overrides"))] "END");
N("ProcedureType") ::= ("PROCEDURE" N("Signature"));
N("RecordType") ::= ("RECORD" N("Fields") "END");
N("RefType") ::= (["UNTRACED"] [N("Brand")] "REF" N("Type"));
N("SetType") ::= ("SET" "OF" N("Type"));
N("SubrangeType") ::= ("[" N("Expr") ".." N("Expr") "]");
N("Brand") ::= ("BRANDED" [N("TextLiteral")]);
N("Fields") ::= [((N("Field") ((";" N("Field")))*) [";"])];
N("Field") ::= (N("IdList") ":" N("Type") ":=" N("Expr"));
N("Field") ::= (N("IdList") ":" N("Type"));
N("Field") ::= (N("IdList") ":=" N("Expr"));
N("Methods") ::= [((N("Method") ((";" N("Method")))*) [";"])];
N("Method") ::= (N("Id") N("Signature") [(":=" N("Expr"))]);
N("Overrides") ::= [((N("Override") ((";" N("Override")))*) [";"])];
N("Override") ::= (N("Id") ":=" N("Expr"));
