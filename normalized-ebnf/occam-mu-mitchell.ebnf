N("translation-unit") ::= [N("declaration-seq")];
N("primary-expression") ::= (N("literal") "this" "(" N("expression") ")" N("id-expression"));
N("id-expression") ::= (N("unqualified-id") N("qualified-id"));
N("unqualified-id") ::= (N("identifier") N("operator-function-id") N("conversion-function-id") "~" N("class-name") N("template-id"));
N("qualified-id") ::= (["::"] N("nested-name-specifier") ["template"] N("unqualified-id") "::" N("identifier") "::" N("operator-function-id") "::" N("template-id"));
N("nested-name-specifier") ::= (N("class-or-namespace-name") "::" [N("nested-name-specifier")] N("class-or-namespace-name") "::" "template" N("nested-name-specifier"));
N("class-or-namespace-name") ::= (N("class-name") N("namespace-name"));
N("postfix-expression") ::= (N("primary-expression") N("postfix-expression") "[" N("expression") "]" N("postfix-expression") "(" [N("expression-list")] ")" N("simple-type-specifier") "(" [N("expression-list")] ")" "typename" ["::"] N("nested-name-specifier") N("identifier") "(" [N("expression-list")] ")" "typename" ["::"] N("nested-name-specifier") ["template"] N("template-id") "(" [N("expression-list")] ")" N("postfix-expression") "." ["template"] N("id-expression") N("postfix-expression") "->" ["template"] N("id-expression") N("postfix-expression") "." N("pseudo-destructor-name") N("postfix-expression") "->" N("pseudo-destructor-name") N("postfix-expression") "++" N("postfix-expression") "--" "dynamic_cast" "<" N("type-id") ">" "(" N("expression") ")" "static_cast" "<" N("type-id") ">" "(" N("expression") ")" "reinterpret_cast" "<" N("type-id") ">" "(" N("expression") ")" "const_cast" "<" N("type-id") ">" "(" N("expression") ")" "typeid" "(" N("expression") ")" "typeid" "(" N("type-id") ")");
N("expression-list") ::= (N("assignment-expression") N("expression-list") "," N("assignment-expression"));
N("pseudo-destructor-name") ::= (["::"] [N("nested-name-specifier")] N("type-name") "::" "~" N("type-name") ["::"] N("nested-name-specifier") "template" N("template-id") "::" "~" N("type-name") ["::"] [N("nested-name-specifier")] "~" N("type-name"));
N("unary-expression") ::= (N("postfix-expression") "++" N("cast-expression") "--" N("cast-expression") N("unary-operator") N("cast-expression") "sizeof" N("unary-expression") "sizeof" "(" N("type-id") ")" N("new-expression") N("delete-expression"));
N("unary-operator") ::= ("*" | "&" | "+" | "-" | "!" | "~");
N("new-expression") ::= (["::"] "new" [N("new-placement")] N("new-type-id") [N("new-initializer")] ["::"] "new" [N("new-placement")] "(" N("type-id") ")" [N("new-initializer")]);
N("new-placement") ::= ("(" N("expression-list") ")");
N("new-type-id") ::= (N("type-specifier-seq") [N("new-declarator")]);
N("new-declarator") ::= (N("ptr-operator") [N("new-declarator")] N("direct-new-declarator"));
N("direct-new-declarator") ::= ("[" N("expression") "]" N("direct-new-declarator") "[" N("constant-expression") "]");
N("new-initializer") ::= ("(" [N("expression-list")] ")");
N("delete-expression") ::= (["::"] "delete" N("cast-expression") ["::"] "delete" "[" "]" N("cast-expression"));
N("cast-expression") ::= (N("unary-expression") "(" N("type-id") ")" N("cast-expression"));
N("pm-expression") ::= (N("cast-expression") N("pm-expression") ".*" N("cast-expression") N("pm-expression") "->*" N("cast-expression"));
N("multiplicative-expression") ::= (N("pm-expression") N("multiplicative-expression") "*" N("pm-expression") N("multiplicative-expression") "/" N("pm-expression") N("multiplicative-expression") "%" N("pm-expression"));
N("additive-expression") ::= (N("multiplicative-expression") N("additive-expression") "+" N("multiplicative-expression") N("additive-expression") "-" N("multiplicative-expression"));
N("shift-expression") ::= (N("additive-expression") N("shift-expression") "<<" N("additive-expression") N("shift-expression") ">>" N("additive-expression"));
N("relational-expression") ::= (N("shift-expression") N("relational-expression") "<" N("shift-expression") N("relational-expression") ">" N("shift-expression") N("relational-expression") "<=" N("shift-expression") N("relational-expression") ">=" N("shift-expression"));
N("equality-expression") ::= (N("relational-expression") N("equality-expression") "==" N("relational-expression") N("equality-expression") "!=" N("relational-expression"));
N("and-expression") ::= (N("equality-expression") N("and-expression") "&" N("equality-expression"));
N("exclusive-or-expression") ::= (N("and-expression") N("exclusive-or-expression") "^" N("and-expression"));
N("inclusive-or-expression") ::= (N("exclusive-or-expression") N("inclusive-or-expression") "|" N("exclusive-or-expression"));
N("logical-and-expression") ::= (N("inclusive-or-expression") N("logical-and-expression") "&&" N("inclusive-or-expression"));
N("logical-or-expression") ::= (N("logical-and-expression") N("logical-or-expression") "||" N("logical-and-expression"));
N("conditional-expression") ::= (N("logical-or-expression") N("logical-or-expression") "?" N("expression") ":" N("assignment-expression"));
N("assignment-expression") ::= (N("conditional-expression") N("logical-or-expression") N("assignment-operator") N("assignment-expression") N("throw-expression"));
N("assignment-operator") ::= ("=" | "*=" | "/=" | "%=" | "+=" | "-=" | ">>=" | "<<=" | "&=" | "^=" | "|=");
N("expression") ::= (N("assignment-expression") N("expression") "," N("assignment-expression"));
N("constant-expression") ::= N("conditional-expression");
N("statement") ::= (N("labeled-statement") N("expression-statement") N("compound-statement") N("selection-statement") N("iteration-statement") N("jump-statement") N("declaration-statement") N("try-block"));
N("labeled-statement") ::= (N("identifier") ":" N("statement") "case" N("constant-expression") ":" N("statement") "default" ":" N("statement"));
N("expression-statement") ::= ([N("expression")] ";");
N("compound-statement") ::= ("{" [N("statement-seq")] "}");
N("statement-seq") ::= (N("statement") N("statement-seq") N("statement"));
N("selection-statement") ::= ("if" "(" N("condition") ")" N("statement") "if" "(" N("condition") ")" N("statement") "else" N("statement") "switch" "(" N("condition") ")" N("statement"));
N("condition") ::= (N("expression") N("type-specifier-seq") N("declarator") "=" N("assignment-expression"));
N("iteration-statement") ::= ("while" "(" N("condition") ")" N("statement") "do" N("statement") "while" "(" N("expression") ")" ";" "for" "(" N("for-init-statement") [N("condition")] ";" [N("expression")] ")" N("statement"));
N("for-init-statement") ::= (N("expression-statement") N("simple-declaration"));
N("jump-statement") ::= ("break" ";" "continue" ";" "return" [N("expression")] ";" "goto" N("identifier") ";");
N("declaration-statement") ::= N("block-declaration");
N("declaration-seq") ::= (N("declaration") N("declaration-seq") N("declaration"));
N("declaration") ::= (N("block-declaration") N("function-definition") N("template-declaration") N("explicit-instantiation") N("explicit-specialization") N("linkage-specification") N("namespace-definition"));
N("block-declaration") ::= (N("simple-declaration") N("asm-definition") N("namespace-alias-definition") N("using-declaration") N("using-directive"));
N("simple-declaration") ::= ([N("decl-specifier-seq")] [N("init-declarator-list")] ";");
N("decl-specifier") ::= (N("storage-class-specifier") N("type-specifier") N("function-specifier") "friend" "typedef");
N("decl-specifier-seq") ::= ([N("decl-specifier-seq")] N("decl-specifier"));
N("storage-class-specifier") ::= ("auto" "register" "static" "extern" "mutable");
N("function-specifier") ::= ("inline" "virtual" "explicit");
N("typedef-name") ::= N("identifier");
N("type-specifier") ::= (N("simple-type-specifier") N("class-specifier") N("enum-specifier") N("elaborated-type-specifier") N("cv-qualifier"));
N("simple-type-specifier") ::= (["::"] [N("nested-name-specifier")] N("type-name") ["::"] N("nested-name-specifier") "template" N("template-id") "char" "wchar_t" "bool" "short" "int" "long" "signed" "unsigned" "float" "double" "void");
N("type-name") ::= (N("class-name") N("enum-name") N("typedef-name"));
N("elaborated-type-specifier") ::= (N("class-key") ["::"] [N("nested-name-specifier")] N("identifier") "enum" ["::"] [N("nested-name-specifier")] N("identifier") "typename" ["::"] N("nested-name-specifier") N("identifier") "typename" ["::"] N("nested-name-specifier") ["template"] N("template-id"));
N("enum-name") ::= N("identifier");
N("enum-specifier") ::= ("enum" [N("identifier")] "{" [N("enumerator-list")] "}");
N("enumerator-list") ::= (N("enumerator-definition") N("enumerator-list") "," N("enumerator-definition"));
N("enumerator-definition") ::= (N("enumerator") N("enumerator") "=" N("constant-expression"));
N("enumerator") ::= N("identifier");
N("namespace-name") ::= (N("original-namespace-name") N("namespace-alias"));
N("original-namespace-name") ::= N("identifier");
N("namespace-definition") ::= (N("named-namespace-definition") N("unnamed-namespace-definition"));
N("named-namespace-definition") ::= (N("original-namespace-definition") N("extension-namespace-definition"));
N("original-namespace-definition") ::= ("namespace" N("identifier") "{" N("namespace-body") "}");
N("extension-namespace-definition") ::= ("namespace" N("original-namespace-name") "{" N("namespace-body") "}");
N("unnamed-namespace-definition") ::= ("namespace" "{" N("namespace-body") "}");
N("namespace-body") ::= [N("declaration-seq")];
N("namespace-alias") ::= N("identifier");
N("namespace-alias-definition") ::= ("namespace" N("identifier") "=" N("qualified-namespace-specifier") ";");
N("qualified-namespace-specifier") ::= (["::"] [N("nested-name-specifier")] N("namespace-name"));
N("using-declaration") ::= ("using" ["typename"] ["::"] N("nested-name-specifier") N("unqualified-id") ";" "using" "::" N("unqualified-id") ";");
N("using-directive") ::= ("using" "namespace" ["::"] [N("nested-name-specifier")] N("namespace-name") ";");
N("asm-definition") ::= ("asm" "(" N("string-literal") ")" ";");
N("linkage-specification") ::= ("extern" N("string-literal") "{" [N("declaration-seq")] "}" "extern" N("string-literal") N("declaration"));
N("init-declarator-list") ::= (N("init-declarator") N("init-declarator-list") "," N("init-declarator"));
N("init-declarator") ::= (N("declarator") [N("initializer")]);
N("declarator") ::= (N("direct-declarator") N("ptr-operator") N("declarator"));
N("direct-declarator") ::= (N("declarator-id") N("direct-declarator") "(" N("parameter-declaration-clause") ")" [N("cv-qualifier-seq")] [N("exception-specification")] N("direct-declarator") "[" [N("constant-expression")] "]" "(" N("declarator") ")");
N("ptr-operator") ::= ("*" [N("cv-qualifier-seq")] "&" ["::"] N("nested-name-specifier") "*" [N("cv-qualifier-seq")]);
N("cv-qualifier-seq") ::= (N("cv-qualifier") [N("cv-qualifier-seq")]);
N("cv-qualifier") ::= ("const" "volatile");
N("declarator-id") ::= (N("id-expression") ["::"] [N("nested-name-specifier")] N("type-name"));
N("type-id") ::= (N("type-specifier-seq") [N("abstract-declarator")]);
N("type-specifier-seq") ::= (N("type-specifier") [N("type-specifier-seq")]);
N("abstract-declarator") ::= (N("ptr-operator") [N("abstract-declarator")] N("direct-abstract-declarator"));
N("direct-abstract-declarator") ::= ([N("direct-abstract-declarator")] "(" N("parameter-declaration-clause") ")" [N("cv-qualifier-seq")] [N("exception-specification")] [N("direct-abstract-declarator")] "[" [N("constant-expression")] "]" "(" N("abstract-declarator") ")");
N("parameter-declaration-clause") ::= ([N("parameter-declaration-list")] ["..."] N("parameter-declaration-list") "," "...");
N("parameter-declaration-list") ::= (N("parameter-declaration") N("parameter-declaration-list") "," N("parameter-declaration"));
N("parameter-declaration") ::= (N("decl-specifier-seq") N("declarator") N("decl-specifier-seq") N("declarator") "=" N("assignment-expression") N("decl-specifier-seq") [N("abstract-declarator")] N("decl-specifier-seq") [N("abstract-declarator")] "=" N("assignment-expression"));
N("function-definition") ::= ([N("decl-specifier-seq")] N("declarator") [N("ctor-initializer")] N("function-body") [N("decl-specifier-seq")] N("declarator") N("function-try-block"));
N("function-body") ::= N("compound-statement");
N("initializer") ::= ("=" N("initializer-clause") "(" N("expression-list") ")");
N("initializer-clause") ::= (N("assignment-expression") "{" N("initializer-list") [","] "}" "{" "}");
N("initializer-list") ::= (N("initializer-clause") N("initializer-list") "," N("initializer-clause"));
N("class-name") ::= (N("identifier") N("template-id"));
N("class-specifier") ::= (N("class-head") "{" [N("member-specification")] "}");
N("class-head") ::= (N("class-key") [N("identifier")] [N("base-clause")] N("class-key") N("nested-name-specifier") N("identifier") [N("base-clause")] N("class-key") [N("nested-name-specifier")] N("template-id") [N("base-clause")]);
N("class-key") ::= ("class" "struct" "union");
N("member-specification") ::= (N("member-declaration") [N("member-specification")] N("access-specifier") ":" [N("member-specification")]);
N("member-declaration") ::= ([N("decl-specifier-seq")] [N("member-declarator-list")] ";" N("function-definition") [";"] ["::"] N("nested-name-specifier") ["template"] N("unqualified-id") ";" N("using-declaration") N("template-declaration"));
N("member-declarator-list") ::= (N("member-declarator") N("member-declarator-list") "," N("member-declarator"));
N("member-declarator") ::= (N("declarator") [N("pure-specifier")] N("declarator") [N("constant-initializer")] [N("identifier")] ":" N("constant-expression"));
N("pure-specifier") ::= ("=" "0");
N("constant-initializer") ::= ("=" N("constant-expression"));
N("base-clause") ::= (":" N("base-specifier-list"));
N("base-specifier-list") ::= (N("base-specifier") N("base-specifier-list") "," N("base-specifier"));
N("base-specifier") ::= (["::"] [N("nested-name-specifier")] N("class-name") "virtual" [N("access-specifier")] ["::"] [N("nested-name-specifier")] N("class-name") N("access-specifier") ["virtual"] ["::"] [N("nested-name-specifier")] N("class-name"));
N("access-specifier") ::= ("private" "protected" "public");
N("conversion-function-id") ::= ("operator" N("conversion-type-id"));
N("conversion-type-id") ::= (N("type-specifier-seq") [N("conversion-declarator")]);
N("conversion-declarator") ::= (N("ptr-operator") [N("conversion-declarator")]);
N("ctor-initializer") ::= (":" N("mem-initializer-list"));
N("mem-initializer-list") ::= (N("mem-initializer") N("mem-initializer") "," N("mem-initializer-list"));
N("mem-initializer") ::= (N("mem-initializer-id") "(" [N("expression-list")] ")");
N("mem-initializer-id") ::= (["::"] [N("nested-name-specifier")] N("class-name") N("identifier"));
N("operator-function-id") ::= ("operator" N("operator"));
N("operator") ::= ("new" | "delete" | ("new" "[]") | ("delete" "[]") | "+" | "-" | "*" | "/" | "%" | "^" | "&" | "|" | "~" | "!" | "=" | "<" | ">" | "+=" | "-=" | "*=" | "/=" | "%=" | "^=" | "&=" | "|=" | "<<" | ">>" | ">>=" | "<<=" | "==" | "!=" | "<=" | ">=" | "&&" | "||" | "++" | "--" | "," | "->*" | "->" | "()" | "[]");
N("template-declaration") ::= (["export"] "template" "<" N("template-parameter-list") ">" N("declaration"));
N("template-parameter-list") ::= (N("template-parameter") N("template-parameter-list") "," N("template-parameter"));
N("template-parameter") ::= (N("type-parameter") N("parameter-declaration"));
N("type-parameter") ::= ("class" [N("identifier")] "class" [N("identifier")] "=" N("type-id") "typename" [N("identifier")] "typename" [N("identifier")] "=" N("type-id") "template" "<" N("template-parameter-list") ">" "class" [N("identifier")] "template" "<" N("template-parameter-list") ">" "class" [N("identifier")] "=" N("id-expression"));
N("template-id") ::= (N("template-name") "<" [N("template-argument-list")] ">");
N("template-name") ::= N("identifier");
N("template-argument-list") ::= (N("template-argument") N("template-argument-list") "," N("template-argument"));
N("template-argument") ::= (N("assignment-expression") N("type-id") N("id-expression"));
N("explicit-instantiation") ::= ("template" N("declaration"));
N("explicit-specialization") ::= ("template" "<" ">" N("declaration"));
N("try-block") ::= ("try" N("compound-statement") N("handler-seq"));
N("function-try-block") ::= ("try" [N("ctor-initializer")] N("function-body") N("handler-seq"));
N("handler-seq") ::= (N("handler") [N("handler-seq")]);
N("handler") ::= ("catch" "(" N("exception-declaration") ")" N("compound-statement"));
N("exception-declaration") ::= (N("type-specifier-seq") N("declarator") N("type-specifier-seq") N("abstract-declarator") N("type-specifier-seq") "...");
N("throw-expression") ::= ("throw" [N("assignment-expression")]);
N("exception-specification") ::= ("throw" "(" [N("type-id-list")] ")");
N("type-id-list") ::= (N("type-id") N("type-id-list") "," N("type-id"));
