N("String") ::= value("string");
N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
N("Process") ::= N("StopProcess");
N("Process") ::= N("SkipProcess");
N("Process") ::= N("Action");
N("Process") ::= N("Construction");
N("Process") ::= N("Instance");
N("Process") ::= N("Specification");
N("StopProcess") ::= epsilon;
N("SkipProcess") ::= epsilon;
N("Action") ::= N("Assignment");
N("Action") ::= N("Input");
N("Action") ::= N("Output");
N("Construction") ::= N("Sequence");
N("Construction") ::= N("Conditional");
N("Construction") ::= N("Loop");
N("Construction") ::= N("Parallel");
N("Construction") ::= N("Alternation");
N("Construction") ::= (N("Sequence") | N("Conditional") | N("Loop") | N("Parallel") | N("Alternation"));
N("Instance") ::= select("name", N("String"));
N("Assignment") ::= (select("variable", N("Variable")) select("expression", N("Expression")));
N("Input") ::= (select("channel", N("Channel")) select("variable", N("Variable")));
N("Output") ::= (select("channel", N("Channel")) select("expression", N("Expression")));
N("Sequence") ::= N("NormalSequence");
N("Sequence") ::= N("ReplicatorSequence");
N("NormalSequence") ::= (select("process", N("Process")));
N("ReplicatorSequence") ::= select("replicator", N("Replicator"));
N("Conditional") ::= N("NormalConditional");
N("Conditional") ::= N("ReplicatorConditional");
N("NormalConditional") ::= (select("choice", N("Choice")));
N("ReplicatorConditional") ::= select("replicator", N("Replicator"));
N("Loop") ::= (select("boolean", N("BooleanRef")) select("process", N("Process")));
N("Parallel") ::= N("NormalParallel");
N("Parallel") ::= N("ReplicatorParallel");
N("Parallel") ::= N("NormalAlternation");
N("Parallel") ::= N("ReplicatorAlternation");
N("NormalParallel") ::= (select("process", N("Process")));
N("ReplicatorParallel") ::= select("replicator", N("Replicator"));
N("Alternation") ::= select("alternative", N("Alternative"));
N("NormalAlternation") ::= (select("process", N("Process")));
N("ReplicatorAlternation") ::= select("replicator", N("Replicator"));
N("Choice") ::= (select("boolean", N("BooleanRef")) select("process", N("Process")));
N("BooleanRef") ::= select("expression", N("Expression"));
N("Alternative") ::= (select("guard", N("Guard")) select("process", N("Process")));
N("Guard") ::= N("InputGuard");
N("Guard") ::= N("BooleanGuard");
N("InputGuard") ::= (select("input", N("Input")));
N("BooleanGuard") ::= select("boolean", N("BooleanRef"));
N("Replicator") ::= (select("name", N("String")) select("base", N("Base")) select("count", N("Count")));
N("Base") ::= select("expression", N("Expression"));
N("Count") ::= select("expression", N("Expression"));
N("Type") ::= (select("primitiveType", N("PrimitiveType")) select("expression", N("Expression")));
N("PrimitiveType") ::= (select("isInt", N("Boolean")) select("isChan", N("Boolean")));
N("Literal") ::= N("LiteralOperand");
N("Literal") ::= select("integer", N("Integer"));
N("Element") ::= (select("name", N("String")) select("subscript", N("Subscript")));
N("Subscript") ::= select("expression", N("Expression"));
N("Variable") ::= N("VariableOPerand");
N("Variable") ::= select("element", N("Element"));
N("Channel") ::= select("element", N("Element"));
N("VariableOPerand") ::= (select("element", N("Element")));
N("LiteralOperand") ::= (select("integer", N("Integer")));
N("ExpressionOperand") ::= (select("operand", N("Operand")));
N("Expression") ::= N("ExpressionOperand");
N("Expression") ::= N("MonadicExpression");
N("Expression") ::= N("DyadicExpression");
N("Expression") ::= N("SimpleExpression");
N("MonadicExpression") ::= select("monadicOperator", N("MonadicOperator"));
N("DyadicExpression") ::= (select("operandRight", N("Operand")) select("dyadicOperator", N("DyadicOperator")));
N("SimpleExpression") ::= (select("operand", N("Operand")));
N("Specification") ::= N("Declaration");
N("Specification") ::= N("Definition");
N("Declaration") ::= N("TypeDeclaration");
N("Declaration") ::= N("IntDeclaration");
N("Declaration") ::= N("ValDeclaration");
N("TypeDeclaration") ::= select("type", N("Type"));
N("IntDeclaration") ::= (select("name", N("String")) select("expression", N("Expression")));
N("ValDeclaration") ::= (select("name", N("String")) select("expression", N("Expression")));
N("Definition") ::= (select("name", N("String")) select("procedureBody", N("ProcedureBody")));
N("Formal") ::= (select("name", N("String")) select("primitiveType", N("PrimitiveType")));
N("ProcedureBody") ::= (select("name", N("String")) select("process", N("Process")));
N("Actual") ::= select("element", N("Element"));
N("MonadicOperator") ::= (select("minus", N("Boolean")) select("not", N("Boolean")));
N("DyadicOperator") ::= (select("plus", N("Boolean")) select("minus", N("Boolean")) select("star", N("Boolean")) select("slash", N("Boolean")) select("or", N("Boolean")) select("inverseSlash", N("Boolean")) select("and", N("Boolean")) select("eq", N("Boolean")) select("ne", N("Boolean")) select("lt", N("Boolean")) select("gt", N("Boolean")) select("le", N("Boolean")) select("ge", N("Boolean")));
