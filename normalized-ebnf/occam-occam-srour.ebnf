N("OCCAM_Program") ::= ((select("occam_Elements", N("OCCAM_Element")))+ (select("files", N("File")))+);
N("OCCAM_Element") ::= N("Process");
N("OCCAM_Element") ::= N("Action");
N("OCCAM_Element") ::= N("Constructor");
N("OCCAM_Element") ::= N("DataType");
N("OCCAM_Element") ::= select("name", N("String"));
N("Process") ::= (select("declaration", N("Declaration")) (select("constructors", N("Constructor")))+ (select("parameters", N("DataType")))+ (select("libraries", N("Library")))+ select("toChannel", N("Channel")));
N("Channel") ::= (select("name", N("String")) select("type", N("String")) select("toServer", N("Server")) select("toProcess", N("Process")));
N("Action") ::= N("Assignment");
N("Action") ::= N("Input");
N("Action") ::= N("Output");
N("Action") ::= (select("constructor", N("Constructor")) select("while", N("While")) select("if", N("If")));
N("Assignment") ::= (select("constructor", N("Constructor")) select("while", N("While")) select("if", N("If")));
N("Input") ::= (select("constructor", N("Constructor")) select("while", N("While")) select("if", N("If")));
N("Output") ::= (select("constructor", N("Constructor")) select("while", N("While")) select("if", N("If")));
N("Constructor") ::= N("Sequential");
N("Constructor") ::= N("Parallel");
N("Constructor") ::= N("Alternative");
N("Constructor") ::= (select("process", N("Process")) (select("actions", N("Action")))+ (select("buckels", N("Buckel")))+ (select("childrens", N("Constructor")))+);
N("Buckel") ::= N("If");
N("Buckel") ::= N("While");
N("Buckel") ::= select("constructor", N("Constructor"));
N("If") ::= ((select("conditions", N("Condition")))+ (select("actions", N("Action")))+);
N("While") ::= ((select("conditions", N("Condition")))+ (select("actions", N("Action")))+);
N("Condition") ::= (select("elementRight", N("String")) select("elementLeft", N("String")) select("typeCondition", N("String")) select("if", N("If")) select("while", N("While")));
N("Sequential") ::= (select("process", N("Process")) (select("actions", N("Action")))+ (select("buckels", N("Buckel")))+ (select("childrens", N("Constructor")))+);
N("Parallel") ::= (select("process", N("Process")) (select("actions", N("Action")))+ (select("buckels", N("Buckel")))+ (select("childrens", N("Constructor")))+);
N("Alternative") ::= (select("process", N("Process")) (select("actions", N("Action")))+ (select("buckels", N("Buckel")))+ (select("childrens", N("Constructor")))+);
N("DataType") ::= select("dataType", N("String"));
N("Library") ::= select("name", N("String"));
N("File") ::= select("name", N("String"));
N("Server") ::= (select("name", N("String")) select("toChannel", N("Channel")));
N("Declaration") ::= (select("name", N("String")) select("process", N("Process")) (select("elements", N("DataType")))+);
N("String") ::= value("string");
N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
