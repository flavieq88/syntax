N("Element") ::= N("ModelElement");
N("Element") ::= N("Annotation");
N("Element") ::= N("Attribute");
N("Element") ::= N("KDMExtensionFamily");
N("Element") ::= N("Stereotype");
N("Element") ::= N("TagDefinition");
N("Element") ::= N("TaggedValue");
N("Element") ::= N("KDMFramework");
N("ModelElement") ::= N("KDMEntity");
N("ModelElement") ::= N("KDMRelationship");
N("KDMEntity") ::= N("KDMContainer");
N("KDMEntity") ::= N("KDMGroup");
N("Annotation") ::= select("note", N("String"));
N("Attribute") ::= (select("tag", N("String")) select("value", N("String")));
N("KDMExtensionFamily") ::= (select("name", N("String")) (select("stereotype", N("Stereotype")))+);
N("Stereotype") ::= (select("baseClass", N("String")) select("name", N("String")) select("family", N("KDMExtensionFamily")) select("extendedElement", N("ModelElement")) (select("tag", N("TagDefinition")))+);
N("TagDefinition") ::= (select("tag", N("String")) select("type", N("String")));
N("TaggedValue") ::= (select("value", N("String")) select("tag", N("TagDefinition")));
N("KDMFramework") ::= N("KDMModel");
N("Integer") ::= value("int");
N("String") ::= value("string");
N("Boolean") ::= ("true" | "false");
