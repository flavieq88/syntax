N("Resource") ::= N("Graph");
N("Resource") ::= N("List");
N("Resource") ::= N("Container");
N("Resource") ::= N("Property");
N("Resource") ::= N("Statement");
N("Resource") ::= N("URIReferenceNode");
N("Resource") ::= N("BlankNode");
N("Resource") ::= N("Class");
N("Resource") ::= N("Literal");
N("Resource") ::= (select("graph", N("Graph")) (select("uriRef", N("URIReference")))+ (select("subjectStatement", N("Statement")))+ (select("objectStatement", N("Statement")))+ (select("label", N("PlainLiteral")))+ (select("type", N("Class")))+ (select("seeAlso", N("Resource")))+ (select("referringResource", N("Resource")))+ (select("member", N("Resource")))+ (select("container", N("Resource")))+ (select("list", N("List")))+);
N("Graph") ::= (select("graphName", N("URIReference")) (select("resources", N("Resource")))+);
N("List") ::= (select("first", N("Resource")) select("rest", N("List")) (select("originalList", N("List")))+);
N("Container") ::= N("Alt");
N("Container") ::= N("Bag");
N("Container") ::= N("Seq");
N("Container") ::= (N("Alt") | N("Bag") | N("Seq"));
N("Alt") ::= epsilon;
N("Bag") ::= epsilon;
N("Seq") ::= epsilon;
N("Property") ::= ((select("predicateStatement", N("Statement")))+ (select("subPropertyOf", N("Property")))+ (select("superProperty", N("Property")))+ (select("domain", N("Class")))+ (select("range", N("Class")))+);
N("ContainerMembershipProperty") ::= epsilon;
N("Statement") ::= (select("predicate", N("Property")) select("object", N("Resource")) select("subject", N("Resource")) select("isReifiedOnly", N("Boolean")) select("isReified", N("Boolean")) (select("nameForReification", N("URIReference")))+);
N("URIReferenceNode") ::= (select("graph", N("Graph")) (select("uriRef", N("URIReference")))+ (select("subjectStatement", N("Statement")))+ (select("objectStatement", N("Statement")))+ (select("label", N("PlainLiteral")))+ (select("type", N("Class")))+ (select("seeAlso", N("Resource")))+ (select("referringResource", N("Resource")))+ (select("member", N("Resource")))+ (select("container", N("Resource")))+ (select("list", N("List")))+);
N("BlankNode") ::= select("nodeId", N("String"));
N("Class") ::= N("Datatype");
N("Class") ::= ((select("subClassOf", N("Class")))+ (select("superClass", N("Class")))+ (select("typedResource", N("Resource")))+ (select("propertyForDomain", N("Property")))+ (select("propertyForRange", N("Property")))+);
N("Datatype") ::= ((select("subClassOf", N("Class")))+ (select("superClass", N("Class")))+ (select("typedResource", N("Resource")))+ (select("propertyForDomain", N("Property")))+ (select("propertyForRange", N("Property")))+);
N("Literal") ::= N("PlainLiteral");
N("Literal") ::= N("TypedLiteral");
N("Literal") ::= select("lexicalForm", N("String"));
N("PlainLiteral") ::= (select("language", N("String")) select("labeledResource", N("Resource")));
N("TypedLiteral") ::= N("RDFXMLLiteral");
N("TypedLiteral") ::= select("datatypeURI", N("URIReference"));
N("RDFXMLLiteral") ::= (select("datatypeURI", N("URIReference")));
N("URIReference") ::= N("UniformResourceIdentifier");
N("URIReference") ::= (select("uri", N("UniformResourceIdentifier")) select("resource", N("Resource")) select("literal", N("TypedLiteral")) select("namedGraph", N("Graph")) (select("reifiedStatement", N("Statement")))+);
N("UniformResourceIdentifier") ::= (select("name", N("String")) (select("uriRef", N("URIReference")))+);
N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
N("String") ::= value("string");
