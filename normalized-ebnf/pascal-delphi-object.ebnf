N("program") ::= (N("program_definition") | N("package_definition") | N("library_definition") | N("unit_definition"));
N("program_definition") ::= ("program" N("decl_name") [N("program_file_list")] ";" N("NL") N("program_block") ".");
N("program_file_list") ::= ("(" sep*(N("id"), ",") ")");
N("package_definition") ::= ("package" N("decl_name") ";" N("NL") [N("requires_clause")] [N("contains_clause")] "end" ".");
N("requires_clause") ::= (N("requires_idList_semicolon"))*;
N("contains_clause") ::= (N("contains_idList_semicolon"))*;
N("requires_idList_semicolon") ::= ("requires" (N("ref_name"))+ ";" N("NL"));
N("contains_idList_semicolon") ::= ("contains" (N("ref_name"))+ ";" N("NL"));
N("library_definition") ::= ("library" N("decl_name") ";" N("NL") N("program_block") ".");
N("unit_definition") ::= ("unit" N("decl_name") ";" N("NL") N("interface_section") N("NL") N("implementation_section") N("NL") N("init_section") ".");
N("interface_section") ::= ("interface" N("NL") N("NL") [N("uses_clause")] N("NL") (N("interface_declaration"))*);
N("implementation_section") ::= ("implementation" N("IN") N("NL") [N("uses_clause")] (N("declaration_section"))* N("EX") N("NL"));
N("init_section") ::= (("intitialization" N("IN") N("NL") N("statement_list") [N("fin_statement_list")] N("EX") N("NL") "end") | N("compound_statement") | "end");
N("interface_declaration") ::= (N("constant_section") | N("type_section") | N("var_section") | (N("exported_heading") [N("directive")]));
N("exported_heading") ::= ((N("procedure_heading") ";" N("NL")) | (N("function_heading") ";" N("NL")) | (N("constructor_heading") ";" N("NL")) | (N("destructor_heading") ";" N("NL")));
N("program_block") ::= ([N("uses_clause")] N("block"));
N("uses_clause") ::= ("uses" N("IN") N("NL") (N("uses_item"))+ ";" N("EX") N("NL"));
N("uses_item") ::= (N("ref_name") [N("in_clause")]);
N("in_clause") ::= ("in" N("charlit"));
N("block") ::= ((N("declaration_section"))* N("compound_statement"));
N("declaration_section") ::= (N("label_declaration_section") | N("constant_section") | N("type_section") | N("var_section") | N("procedure_section"));
N("label_declaration_section") ::= ("label" N("decl_name"));
N("constant_section") ::= ("const" N("IN") N("NL") (N("constant_declaration"))* N("EX") N("NL"));
N("constant_declaration") ::= ((N("decl_name") "=" N("expression") ";" N("NL")) | (N("decl_name") ":" N("typeId") "=" N("typed_constant") ";" N("NL")));
N("type_section") ::= ("type" N("IN") N("NL") (N("type_declaration"))+ N("EX") N("NL"));
N("type_declaration") ::= (N("decl_name") "=" N("type_or_restrictedType"));
N("type_or_restrictedType") ::= ((N("type") ";" N("NL")) | (N("restrictedType") ";" N("NL")));
N("typed_constant") ::= (N("expression") | N("array_constant") | N("record_constant"));
N("array_constant") ::= ("(" sep*(N("typed_constant"), ",") ")");
N("record_constant") ::= ("(" N("typed_constant") (N("semicolon_record_field_constant"))* ")");
N("semicolon_record_field_constant") ::= (";" N("decl_name") ":" N("typed_constant"));
N("type") ::= (N("typeId") | N("simpleType") | N("structType") | N("pointerType") | N("stringType") | N("procedureType") | N("variantType") | N("class_referenceType"));
N("restrictedType") ::= (N("objectType") | N("classType") | N("interfaceType"));
N("class_referenceType") ::= ("class" "of" N("typeId"));
N("simpleType") ::= (N("ordinalType") | N("realType"));
N("realType") ::= ("real48" | "real" | "single" | "double" | "extended" | "currency" | "comp");
N("ordinalType") ::= (N("subrangeType") | N("enumeratedType") | N("ordinal_identifier"));
N("enumeratedType") ::= ("(" sep*(N("decl_name"), ",") ")");
N("ordinal_identifier") ::= ("shortint" | "smallint" | "integer" | "byte" | "longint" | "int64" | "word" | "boolean" | "char" | "widechar" | "longchar" | "pchar");
N("variantType") ::= ("variant" | "olevariant");
N("subrangeType") ::= (N("expression") ".." N("expression"));
N("stringType") ::= ("string" | "ansistring" | "widestring" | ("string" "[" N("expression") "]"));
N("structType") ::= ((N("arrayType") ["packed"]) | (N("setType") ["packed"]) | (N("fileType") ["packed"]) | (N("recordType") ["packed"]));
N("arrayType") ::= (N("array_word") [N("square_ordinalType")] "of" N("type"));
N("array_word") ::= ("array" | "Array");
N("square_ordinalType") ::= ("[" sep*(N("ordinalType"), ",") "]");
N("recordType") ::= ("record" N("field_list") "end");
N("field_list") ::= ((N("field_declaration"))+ [N("variant_section")]);
N("field_declaration") ::= ((N("decl_name"))+ ":" N("type") ";" N("NL"));
N("variant_section") ::= ("case" [N("id_colon")] N("typeId") "of" (N("record_variant_semicolon"))+ [";"]);
N("id_colon") ::= (N("decl_name") ":");
N("record_variant_semicolon") ::= (N("record_variant") ";" N("NL"));
N("record_variant") ::= ((N("expression"))+ ":" "(" [N("field_list")] ")");
N("setType") ::= ("set" "of" N("ordinalType"));
N("fileType") ::= ("file" "of" N("typeId"));
N("pointerType") ::= ("^" N("typeId"));
N("procedureType") ::= (N("proc_or_func_heading") [N("of_object")]);
N("proc_or_func_heading") ::= (N("procedure_heading") | N("function_heading"));
N("of_object") ::= ("of" "object");
N("typeId") ::= (N("ref_name") | N("predefinedType"));
N("predefinedType") ::= ("integer" | "real" | "boolean" | "char" | "byte");
N("objectType") ::= ("object" [N("object_heritage")] [N("object_field_list")] [N("method_list")] "end");
N("object_heritage") ::= ("(" N("ref_name") ")");
N("method_list") ::= (N("virtual_method_heading") (N("semi_virtual_method_heading"))*);
N("semi_virtual_method_heading") ::= (";" N("NL") N("virtual_method_heading"));
N("virtual_method_heading") ::= (N("method_heading") [N("semi_directive")] [N("semicolon_virtual")]);
N("semicolon_virtual") ::= (";" "virtual");
N("method_heading") ::= (N("procedure_heading") | N("function_heading") | N("destructor_heading") | N("constructor_heading"));
N("semi_directive") ::= (";" N("directive"));
N("constructor_heading") ::= ("constructor" N("decl_name") [N("formal_parameters")]);
N("destructor_heading") ::= ("destructor" N("decl_name") [N("formal_parameters")]);
N("object_field_list") ::= (N("ident_list_colonType") (N("semi_ident_list_colonType"))*);
N("semi_ident_list_colonType") ::= (";" N("NL") N("ident_list_colonType"));
N("ident_list_colonType") ::= ((N("decl_name"))+ ":" N("type"));
N("fin_statement_list") ::= ("finalization" N("statement_list"));
N("classType") ::= ("class" [N("class_heritage")] N("IN") N("NL") [N("class_element_list")] (N("vis_spec_element_list"))* N("EX") N("NL") ["end"]);
N("class_heritage") ::= ("(" sep*(N("ref_name"), ",") ")");
N("class_visibility") ::= ("public" | "protected" | "Protected" | "private" | "published");
N("vis_spec_element_list") ::= (N("NL") N("class_visibility") [N("class_element_list")]);
N("class_element_list") ::= (N("class_element_semi"))+;
N("class_element_semi") ::= (N("NL") N("class_element") ";");
N("class_element") ::= (N("virtual_method_heading") | N("ident_list_colonType") | N("property_list") | epsilon);
N("class_method_list") ::= (N("class_visibility_method_list"))*;
N("class_visibility_method_list") ::= (N("class_visibility") N("method_list"));
N("class_property_list") ::= (N("class_visibility_property_list"))*;
N("class_visibility_property_list") ::= (N("class_visibility") N("property_list"));
N("property_list") ::= (N("property_word") N("decl_name") [N("property_interface")] (N("property_specifiers"))*);
N("property_word") ::= ("property" | "Property");
N("property_interface") ::= ([N("property_parameter_list")] ":" N("type"));
N("property_parameter_list") ::= ("[" (N("idList_colonTypeId_semicolon"))* "]");
N("idList_colonTypeId_semicolon") ::= ((N("decl_name"))+ ":" N("typeId") ";" N("NL"));
N("property_specifiers") ::= (N("index_expession") | N("read_id") | N("write_id") | N("stored_id_OR_stored_expression") | N("default_expression_OR_nodefault") | N("implementsTypeId"));
N("index_expession") ::= ("index" N("expression"));
N("read_id") ::= ("read" N("ref_name"));
N("write_id") ::= ("write" N("ref_name"));
N("stored_id_OR_stored_expression") ::= ("stored" N("id_or_expression"));
N("default_expression_OR_nodefault") ::= (("default" N("expression")) | "nodefault");
N("implementsTypeId") ::= ("implements" N("typeId"));
N("interfaceType") ::= ("interface" [N("interface_heritage")] [N("class_method_list")] [N("class_property_list")] "end");
N("interface_heritage") ::= ("(" sep*(N("ref_name"), ",") ")");
N("var_section") ::= (N("var") N("NL") N("IN") (N("var_declaration_semicolon"))* N("NL") N("EX"));
N("var") ::= ("var" | "Var");
N("var_declaration_semicolon") ::= (N("var_declaration") ";" N("NL"));
N("var_declaration") ::= ((N("decl_name"))+ ":" N("type") [N("var_assignment")]);
N("var_assignment") ::= (N("absolute_assignment") | N("constant_assignment"));
N("absolute_assignment") ::= ("absolute" N("id_or_expression"));
N("id_or_expression") ::= (N("ref_name") | N("expression"));
N("constant_assignment") ::= ("=" N("expression"));
N("procedure_section") ::= (N("procedure_declaration") | N("function_declaration") | N("constructor_declaration") | N("destructor_declaration"));
N("constructor_declaration") ::= (N("constructor_heading") ";" N("IN") N("NL") N("block") N("EX") N("NL") ";" N("NL"));
N("destructor_declaration") ::= (N("destructor_heading") ";" N("IN") N("NL") N("block") N("EX") N("NL") ";" N("NL"));
N("procedure_declaration") ::= (N("procedure_heading") ";" N("IN") N("NL") N("block") N("EX") N("NL") ";" N("NL"));
N("function_declaration") ::= (N("function_heading") [N("semi_directive")] ";" N("IN") N("NL") N("block") N("EX") N("NL") ";" N("NL"));
N("function_heading") ::= (N("function_word") N("decl_name") [N("formal_parameters")] ":" N("type_or_string"));
N("type_or_string") ::= (N("type") | N("charlit"));
N("function_word") ::= ("function" | "Function");
N("procedure_heading") ::= (N("procedure") N("decl_name") [N("formal_parameters")]);
N("procedure") ::= ("procedure" | "Procedure");
N("formal_parameters") ::= ("(" N("formal_parameter") (N("semi_formal_parameter"))* ")");
N("semi_formal_parameter") ::= (";" N("NL") N("formal_parameter"));
N("formal_parameter") ::= ([N("parm_qual")] N("parameter"));
N("parm_qual") ::= (N("var") | "const" | "out");
N("parameter") ::= (sep*(N("decl_name"), ",") [N("parameter_type")]);
N("parameter_type") ::= (":" [N("array_of")] N("type") [N("param_init")]);
N("param_init") ::= ("=" N("expression"));
N("array_of") ::= (N("array_word") [N("set_constructor")] "of");
N("statement_list") ::= (N("statement") (N("semi_statement"))*);
N("semi_statement") ::= (";" N("NL") N("statement"));
N("statement") ::= (([N("labelId_colon")] N("unlabeled_statement")) | epsilon);
N("labelId_colon") ::= (N("labelId") ":");
N("unlabeled_statement") ::= (N("simple_statement") | N("struct_statement"));
N("simple_statement") ::= ((N("ref_name") [N("assign_expression")]) | ("inherited" [N("ref_name")]) | ("goto" N("labelId")));
N("assign_expression") ::= (":=" N("expression"));
N("labelId") ::= ("label" (N("number"))+ ";" N("NL"));
N("struct_statement") ::= (N("compound_statement") | N("conditional_statement") | N("loop_statement") | N("with_statement") | N("try_finally_statement") | N("try_except_statement") | N("raise_statement"));
N("compound_statement") ::= (N("begin") N("IN") N("NL") N("statement_list") N("EX") N("NL") "end" N("NL"));
N("begin") ::= ("begin" | "Begin");
N("conditional_statement") ::= (N("if_statement") | N("case_statement"));
N("if_statement") ::= (N("if") N("expression") "then" [N("statement")] [N("else_statement")]);
N("else_statement") ::= ("else" [N("statement")]);
N("if") ::= ("if" | "If");
N("case_statement") ::= ("case" N("expression") "of" N("case_selector") N("IN") N("NL") (N("semi_case_selector"))* [";"] N("EX") N("NL") [N("else_statement")] [";"] N("NL") "end");
N("semi_case_selector") ::= (";" N("NL") N("case_selector"));
N("case_selector") ::= (N("case_label") (N("comma_case_label"))* ":" N("statement"));
N("comma_case_label") ::= ("," N("case_label"));
N("case_label") ::= (N("expression") [N("dotDot_expression")]);
N("loop_statement") ::= (N("repeating_statement") | N("while_statement") | N("for_statement"));
N("repeating_statement") ::= ("repeat" N("statement") [";"] "until" N("expression"));
N("while_statement") ::= ("while" N("expression") N("do") N("statement"));
N("for_statement") ::= (N("for") N("ref_name") ":=" N("expression") N("to_or_downto") N("expression") N("do") N("statement"));
N("to_or_downto") ::= ("to" | "downto");
N("for") ::= ("for" | "For");
N("do") ::= ("do" | "Do" | "DO");
N("with_statement") ::= ("with" (N("ref_name"))+ N("do") N("statement"));
N("try_finally_statement") ::= ("try" N("IN") N("NL") N("statement_list") N("EX") N("NL") "finally" N("IN") N("NL") N("statement_list") N("EX") N("NL") "end");
N("try_except_statement") ::= ("try" N("IN") N("NL") N("statement_list") N("EX") N("NL") N("except") [";"] N("IN") N("NL") N("exception_block") N("EX") N("NL") "end");
N("except") ::= ("except" | "Except");
N("exception_block") ::= (epsilon | N("statement_list") | N("exception_else"));
N("exception_else") ::= (N("exception_handler_list") N("NL") N("EX") [N("else_statement")]);
N("exception_handler_list") ::= (N("exception_handler") (N("semi_exception_handler"))* [";"]);
N("semi_exception_handler") ::= (";" N("exception_handler"));
N("exception_handler") ::= ("on" [N("exception_var")] N("type") N("do") N("IN") N("NL") N("statement") N("EX"));
N("exception_var") ::= (N("decl_name") ":");
N("raise_statement") ::= ("raise" [N("ref_name")] [N("at_address")]);
N("at_address") ::= ("at" N("ref_name"));
N("expression") ::= ((N("factor") (N("op_factor"))*) | (N("op_factor"))+);
N("op_factor") ::= (N("op") N("factor"));
N("op") ::= (">" | "<" | "<=" | ">=" | "<>" | "=" | "in" | "is" | "+" | "-" | "or" | "xor" | "*" | "/" | "div" | "mod" | "and" | "shl" | "shr" | "DIV" | "AND");
N("rel_op_simple_expression") ::= (N("rel_op") N("simple_expression"));
N("simple_expression") ::= ([N("term")] (N("add_op_term"))*);
N("add_op_term") ::= (N("add_op") N("term"));
N("term") ::= (N("factor") (N("mul_op_factor"))*);
N("mul_op_factor") ::= (N("mul_op") N("factor"));
N("factor") ::= (N("ref_name") | N("charlit") | (N("pond_number"))+ | ("@" ["@"] N("ref_name")) | "nil" | ("(" N("expression") ")") | (N("not_word") N("factor")) | N("set_constructor") | (N("predefinedType") "(" N("expression") ")") | N("bool_value") | (["-"] N("number")));
N("pond_number") ::= ("#" N("number"));
N("not_word") ::= ("not" | "Not" | "NOT");
N("bool_value") ::= ("true" | "false" | "True" | "False");
N("arguments") ::= ("(" sep*(N("expression"), ",") ")");
N("rel_op") ::= (">" | "<" | "<=" | ">=" | "<>" | "=" | "in" | "is");
N("add_op") ::= ("+" | "-" | "or" | "xor");
N("mul_op") ::= ("*" | "/" | "div" | "mod" | "and" | "shl" | "shr" | "DIV" | "AND");
N("set_constructor") ::= ("[" sep*(N("set_element"), ",") "]");
N("set_element") ::= (N("expression") [N("dotDot_expression")]);
N("dotDot_expression") ::= (".." N("expression"));
N("startNameTag") ::= (N("SPOFF") N("SP") "<" "UID" N("SP") "name" "=" N("stringlit") ">" N("SPON"));
N("endNameTag") ::= (N("SPOFF") N("SP") "</" "UID" ">" N("SPON"));
N("decl_name") ::= (N("id") (N("dot_id"))*);
N("ref_name") ::= N("object");
N("object") ::= ((N("id") (N("object_modifier"))*) | ("(" N("ref_name") ")" (N("object_modifier"))*));
N("object_modifier") ::= (("." N("id")) | N("array_subscript") | N("arguments") | "^" | N("as_type"));
N("dot_id") ::= ("." N("id"));
N("array_subscript") ::= ("[" sep*(N("expression"), ",") "]");
N("as_type") ::= (N("as") N("type"));
N("as") ::= ("As" | "as");
N("directive") ::= ("cdecl" | "register" | "dynamic" | "virtual" | "export" | "external" | "far" | "forward" | ("message" [N("ref_name")]) | "override" | "overload" | "pascal" | "reintroduce" | "safecall" | "stdcall" | "Override");
