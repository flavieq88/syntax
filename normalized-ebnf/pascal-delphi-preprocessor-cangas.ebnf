N("ident") ::= (N("id") | (N("key")));
N("namespace") ::= (N("id") ".");
N("nested_id") ::= (N("SPOFF") (N("namespace"))* N("ident") N("SPON"));
N("filenamelit") ::= (N("charlit") | N("stringlit") | N("nested_id"));
N("delphipp_file") ::= (N("pp_stmt_or_water"))*;
N("pp_stmt_or_water") ::= ((N("pp_stmt")) | (N("pp_comment")) | (N("pp_any")));
N("pp_comment") ::= (N("cmbracketblock") | N("cmstarblock") | N("cmline"));
N("cmbracketblock") ::= ("{" (N("bracketbody"))* "}");
N("cmstarblock") ::= ("(*" (N("starbody"))* "*)");
N("bracketbody") ::= (N("pp_any"));
N("starbody") ::= (N("pp_any"));
N("cmline") ::= ("//" (N("cmlinebody"))* N("EOL"));
N("cmlinebody") ::= (N("pp_any"));
N("pp_any") ::= ((N("id") (N("codetoken"))*) | N("key") | N("token"));
N("codetoken") ::= ("(" | ")" | "." | ";" | ":" | "," | "[" | "]" | "+" | "-" | "*" | "/" | "^" | "=" | "@" | ">" | "<" | "<>" | ">=" | "<=" | ":=" | "//" | N("id") | N("anynumber") | N("charlit") | N("space"));
N("pp_stmt") ::= (N("pp_ifstmt") | (N("pp_directivestmt")));
N("pp_directivestmt") ::= (("{$" [N("space")] sep*(N("pp_directive"), ",") (N("bracketbody"))* "}") | ("(*$" [N("space")] sep*(N("pp_directive"), ",") (N("starbody"))* "*)"));
N("pp_directive") ::= (("DEFINE" N("space") N("id")) | ("UNDEF" N("space") N("id")) | ("INCLUDE" [N("space")] N("filenamelit")) | ("I" [N("space")] N("filenamelit")) | ("LINK" [N("space")] N("filenamelit")) | ("L" [N("space")] N("filenamelit")) | ("RESOURCE" [N("space")] N("filenamelit") [N("space")] [N("filenamelit")]) | ("R" [N("space")] N("filenamelit") [N("space")] [N("filenamelit")]) | ("HPPEMIT" [N("space")] N("charlit")) | ("EXTERNALSYM" N("space") N("id")) | "NODEFINE" | "MINENUMSIZE" | "DENYPACKAGEUNIT" | "WEAKPACKAGEUNIT" | ("IMAGEBASE" [N("space")] N("anynumber")) | ("C" N("space") N("id")) | ("MINENUMSIZE" N("space") N("anynumber")) | N("pp_minenumsize") | ("ALIGN" [N("space")] N("anynumber")) | N("pp_align") | ("M" [N("space")] sep*(N("anynumber"), ",")) | ("MAXSTACKSIZE" N("space") N("anynumber")) | ("MINSTACKSIZE" N("space") N("anynumber")) | ("RESOURCERESERVE" N("space") N("anynumber")) | "NOINCLUDE" | "WARN" | "MESSAGE" | "APPTYPE" | ("LIBPREFIX" [N("space")] N("charlit")) | ("LIBSUFIX" [N("space")] N("charlit")) | ("LIBVERSION" [N("space")] N("charlit")) | ("DESCRIPTION" [N("space")] N("charlit")) | ("D" [N("space")] N("charlit")) | ("EXTENSION" N("space") N("id")) | ("E" N("space") N("id")) | (N("pp_switch") [N("space")]));
N("pp_align") ::= ("A1" | "A2" | "A4" | "A8");
N("pp_minenumsize") ::= ("Z1" | "Z2" | "Z4");
N("pp_switch") ::= (N("id") [N("space")] N("pp_switchopt"));
N("pp_switchopt") ::= ("+" | "-" | "ON" | "OFF");
N("pp_ifstmt") ::= (N("pp_ifblock") (N("pp_elseifblock"))* N("pp_endif"));
N("pp_ifblock") ::= (N("pp_ifexpr") (N("pp_content"))*);
N("pp_content") ::= (N("pp_stmt_or_water"));
N("pp_elseifblock") ::= (N("pp_elseifexpr") (N("pp_content"))*);
N("pp_ifexpr") ::= (("{$" [N("space")] N("if_alt") (N("bracketbody"))* "}") | ("(*$" [N("space")] N("if_alt") (N("starbody"))* "*)"));
N("pp_elseifexpr") ::= (("{$" [N("space")] N("else_alt") [N("space")] (N("bracketbody"))* "}") | ("(*$" [N("space")] N("else_alt") [N("space")] (N("starbody"))* "*)"));
N("pp_endif") ::= (("{$" [N("space")] N("endif_alt") (N("bracketbody"))* "}") | ("(*$" [N("space")] N("endif_alt") (N("starbody"))* "*)"));
N("if_alt") ::= (("IF" [N("space")] N("pp_boolexpr")) | ("IFDEF" [N("space")] N("id")) | ("IFNDEF" [N("space")] N("id")) | ("IFOPT" [N("space")] N("pp_switch")));
N("else_alt") ::= (("ELSEIF" [N("space")] N("pp_boolexpr")) | ("ELSE" [N("space")]));
N("endif_alt") ::= ("ENDIF" | "IFEND");
N("pp_boolexpr") ::= (N("booleanlit") | (N("boolfunc") [N("space")] "(" N("id") ")") | ("NOT" [N("space")] N("pp_boolexpr")) | N("id") | (N("pp_boolexpr") "pp_boolopr" N("pp_boolexpr")) | (N("pp_litexpr") "pp_compareopr" N("pp_litexpr")) | ("(" N("pp_boolexpr") ")"));
N("boolfunc") ::= ("DEFINED" | "DECLARED" | "OPTION");
N("booleanlit") ::= ("FALSE" | "TRUE");
N("pp_litexpr") ::= (N("id") | N("charlit") | N("anynumber"));
N("pp_boolopr") ::= ("AND" | "OR" | "XOR");
N("pp_compareopr") ::= (">" | "<" | "=" | ">=" | "<=" | "<>");
N("anynumber") ::= (N("number") | N("hexnumber"));
