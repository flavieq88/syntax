N("Program") ::= (select("name", N("String")) (select("variables", N("Variable")))+ (select("types", N("Type")))+ (select("procedures", N("Procedure")))+);
N("Variable") ::= N("Parameter");
N("Variable") ::= (select("name", N("String")) select("program", N("Program")) select("procedure", N("Procedure")) select("type", N("Type")));
N("Type") ::= (select("name", N("String")) select("program", N("Program")) (select("variables", N("Variable")))+);
N("Parameter") ::= select("procedure_parameter", N("Procedure"));
N("Instruction") ::= N("Calculation");
N("Instruction") ::= N("Control");
N("Instruction") ::= N("Assignment");
N("Instruction") ::= N("Block");
N("Instruction") ::= select("block", N("Block"));
N("Calculation") ::= (select("block", N("Block")));
N("Control") ::= N("Conditional");
N("Control") ::= N("Loop");
N("Control") ::= N("Procedure");
N("Control") ::= (N("Conditional") | N("Loop") | N("Procedure"));
N("Assignment") ::= (select("block", N("Block")));
N("Block") ::= ((select("instructions", N("Instruction")))+ select("procedure", N("Procedure")) select("loop", N("Loop")) select("conditional", N("Conditional")));
N("Conditional") ::= select("blocks", N("Block"));
N("Loop") ::= N("For");
N("Loop") ::= N("While");
N("Loop") ::= N("Repeat");
N("Loop") ::= select("block_loop", N("Block"));
N("Procedure") ::= N("Function");
N("Procedure") ::= (select("name", N("String")) select("program", N("Program")) (select("variables", N("Variable")))+ (select("parameters", N("Parameter")))+ select("block_procedure", N("Block")));
N("Function") ::= select("returnType", N("Type"));
N("For") ::= (select("block_loop", N("Block")));
N("While") ::= (select("block_loop", N("Block")));
N("Repeat") ::= (select("block_loop", N("Block")));
N("String") ::= value("string");
