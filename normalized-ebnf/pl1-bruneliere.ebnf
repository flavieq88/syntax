N("PLIClassifier") ::= N("PLISimpleType");
N("PLIClassifier") ::= N("PLINamedType");
N("PLIClassifier") ::= N("PLIComposedType");
N("PLIClassifier") ::= (select("name", N("String")) (select("typedElements", N("PLIElement")))+);
N("PLISimpleType") ::= N("PLIComputationalType");
N("PLISimpleType") ::= N("PLINonComputationalType");
N("PLISimpleType") ::= select("alias", N("PLIAlias"));
N("PLINamedType") ::= (select("name", N("String")) (select("typedElements", N("PLIElement")))+);
N("PLIComposedType") ::= (select("elements", N("PLIElement")))+;
N("PLIAlias") ::= (select("type", N("PLISimpleType")) (select("contains", N("PLIAttribute")))+);
N("PLIAttribute") ::= epsilon;
N("PLIComputationalType") ::= (select("alias", N("PLIAlias")));
N("PLINonComputationalType") ::= (select("alias", N("PLIAlias")));
N("PLIElement") ::= (select("level", N("String")) select("name", N("String")) select("sharedType", N("PLIClassifier")) select("group", N("PLIComposedType")) select("initial", N("PLIElementInitialValue")) select("source", N("PLISourceText")) select("array", N("PLIArray")));
N("PLIElementInitialValue") ::= select("initialValue", N("String"));
N("PLISourceText") ::= (select("source", N("String")) select("fileName", N("String")));
N("PLIArray") ::= N("PLIFixedBoundArray");
N("PLIArray") ::= N("PLIFixedLboundArray");
N("PLIArray") ::= N("PLIHBoundArray");
N("PLIArray") ::= N("PLIVariableBoundArray");
N("PLIArray") ::= select("arrayOf", N("PLIElement"));
N("PLIFixedBoundArray") ::= (select("IBound", N("Integer")) select("uBound", N("Integer")) select("referredTo", N("PLIElement")));
N("PLIFixedLboundArray") ::= (select("IBound", N("Integer")) select("uBoundToAllocate", N("String")) select("referredTo", N("PLIElement")));
N("PLIHBoundArray") ::= (select("uBound", N("Integer")) select("IBoundToAllocate", N("String")) select("referredTo", N("PLIElement")));
N("PLIVariableBoundArray") ::= (select("IBoundToAllocate", N("String")) select("hBoundToAllocate", N("String")) select("referredTo", N("PLIElement")));
N("String") ::= value("string");
N("Integer") ::= value("int");
