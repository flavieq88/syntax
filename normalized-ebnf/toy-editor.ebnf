N("LocatedElement") ::= N("Editor");
N("LocatedElement") ::= N("AbstractElement");
N("LocatedElement") ::= N("Element");
N("LocatedElement") ::= N("Format");
N("LocatedElement") ::= N("Color");
N("LocatedElement") ::= N("Font");
N("LocatedElement") ::= N("Indent");
N("Editor") ::= (select("extension", N("String")) (select("abstractElements", N("AbstractElement")))+);
N("AbstractElement") ::= N("Block");
N("AbstractElement") ::= N("GroupElement");
N("Block") ::= (select("blockbegin", N("String")) select("blockend", N("String")));
N("GroupElement") ::= (select("indent", N("Indent")) (select("element", N("Element")))+);
N("Element") ::= (select("element", N("String")) select("groupElement", N("GroupElement")));
N("Format") ::= (select("color", N("Color")) select("font", N("Font")));
N("Color") ::= (select("red", N("Integer")) select("green", N("Integer")) select("blue", N("Integer")));
N("Font") ::= (select("font", N("String")) select("bold", N("Boolean")) select("italic", N("Boolean")));
N("Indent") ::= (select("retrait", N("String")) select("groupElementIndent", N("GroupElement")));
N("String") ::= value("string");
N("Integer") ::= value("int");
N("Boolean") ::= ("true" | "false");
