N("String") ::= value("string");
N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
N("Case") ::= (select("name", N("String")) select("caseMode", N("Boolean")) select("caseInput", N("Parameter")) select("documentation", N("String")) (select("listOfStep", N("Step")))+);
N("Step") ::= N("LoopStep");
N("Step") ::= N("MultiStep");
N("Step") ::= (select("name", N("String")) select("description", N("String")) select("belongsToCase", N("Case")) select("embedsOperator", N("Operator")) (select("predecessors", N("Step")))+ (select("successors", N("Step")))+);
N("LoopStep") ::= (select("name", N("String")) select("description", N("String")) select("belongsToCase", N("Case")) select("embedsOperator", N("Operator")) (select("predecessors", N("Step")))+ (select("successors", N("Step")))+);
N("MultiStep") ::= select("iterationCondition", N("String"));
N("Operator") ::= N("FeatureConstruction");
N("Operator") ::= N("DataMinStep");
N("Operator") ::= N("TimeOperator");
N("Operator") ::= N("FeatureSelection");
N("Operator") ::= N("MultiRelFeatureConstr");
N("Operator") ::= N("RowSelection");
N("Parameter") ::= (select("name", N("String")) select("place", N("String")) select("parameterType", N("ParameterType")) select("belongsToOperator", N("Operator")));
N("ParameterType") ::= (select("Value", epsilon) | select("Concept", epsilon) | select("RelationShip", epsilon) | select("FeatureAttribute", epsilon));
N("FeatureConstruction") ::= N("Scaling");
N("FeatureConstruction") ::= N("Discretization");
N("FeatureConstruction") ::= select("scalingFactor", N("Integer"));
N("DataMinStep") ::= (select("loopable", N("Boolean")) select("numberOfInputParameters", N("Integer")) select("numberOfOutputParameters", N("Integer")) select("manual", N("Boolean")) select("tool", N("String")) (select("input", N("Parameter")))+ (select("output", N("Parameter")))+ select("realizes", N("ExecutionElement")));
N("TimeOperator") ::= (select("loopable", N("Boolean")) select("numberOfInputParameters", N("Integer")) select("numberOfOutputParameters", N("Integer")) select("manual", N("Boolean")) select("tool", N("String")) (select("input", N("Parameter")))+ (select("output", N("Parameter")))+ select("realizes", N("ExecutionElement")));
N("FeatureSelection") ::= (select("loopable", N("Boolean")) select("numberOfInputParameters", N("Integer")) select("numberOfOutputParameters", N("Integer")) select("manual", N("Boolean")) select("tool", N("String")) (select("input", N("Parameter")))+ (select("output", N("Parameter")))+ select("realizes", N("ExecutionElement")));
N("MultiRelFeatureConstr") ::= N("Agregation");
N("RowSelection") ::= N("Segmentation");
N("RowSelection") ::= N("Sampling");
N("RowSelection") ::= (N("Segmentation") | N("Sampling"));
N("Agregation") ::= epsilon;
N("Scaling") ::= select("scalingFactor", N("Integer"));
N("Discretization") ::= select("scalingFactor", N("Integer"));
N("Segmentation") ::= epsilon;
N("Sampling") ::= epsilon;
N("ExecutionElement") ::= N("MSL-Tool");
N("ExecutionElement") ::= N("TransformationGroup");
N("ExecutionElement") ::= N("Transformation");
N("ExecutionElement") ::= (select("source", N("DataObject")) select("target", N("DataObject")));
N("DataObject") ::= (select("source", N("ExecutionElement")) select("target", N("ExecutionElement")));
N("MSL-Tool") ::= (select("source", N("DataObject")) select("target", N("DataObject")));
N("TransformationGroup") ::= (select("transformation", N("Transformation")))+;
N("Transformation") ::= N("Function");
N("Transformation") ::= N("StoredProcedure");
N("Transformation") ::= N("SQLQuery");
N("Transformation") ::= select("transformationGroup", N("TransformationGroup"));
N("Function") ::= (select("nameOf", N("String")) select("signature", N("String")));
N("StoredProcedure") ::= (select("nameOf", N("String")) select("signature", N("String")));
N("SQLQuery") ::= select("transformationGroup", N("TransformationGroup"));
N("ModelElement") ::= N("Case");
N("ModelElement") ::= N("Step");
N("ModelElement") ::= N("Operator");
N("ModelElement") ::= N("Classifier");
N("ModelElement") ::= N("StructuralFeature");
N("ModelElement") ::= (N("Case") | N("Step") | N("Operator") | N("Classifier") | N("StructuralFeature"));
N("Classifier") ::= N("Class");
N("Classifier") ::= N("DataType");
N("Classifier") ::= (N("Class") | N("DataType"));
N("StructuralFeature") ::= N("Attribute");
N("Class") ::= (select("name", N("String")) (select("attributes", N("Attribute")))+);
N("DataType") ::= select("attribute", N("Attribute"));
N("Attribute") ::= (select("class", N("Class")) select("has", N("DataType")));
