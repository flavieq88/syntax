N("Table") ::= (select("number", N("Integer")) select("file", N("String")) select("dbConnectString", N("String")) select("user", N("String")) (select("hasColumn", N("Column")))+ (select("hasKey", N("Key")))+ select("correspondsToConcept", N("Concept")) select("correspondsToRelationShip", N("RelationShip")));
N("View") ::= (select("number", N("Integer")) select("file", N("String")) select("dbConnectString", N("String")) select("user", N("String")) (select("hasColumn", N("Column")))+ (select("hasKey", N("Key")))+ select("correspondsToConcept", N("Concept")) select("correspondsToRelationShip", N("RelationShip")));
