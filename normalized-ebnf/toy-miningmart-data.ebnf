N("ColumnStatistics") ::= (select("unique", N("Integer")) select("missing", N("Integer")) select("min", N("Integer")) select("max", N("Integer")) select("average", N("Integer")) select("standarDeviation", N("Integer")) select("distributionValue", N("String")) select("distributionCount", N("Integer")) select("distributionMin", N("Integer")) select("distributionMax", N("Integer")) select("forColumn", N("Column")));
