N("ModelElement") ::= N("Classifier");
N("ModelElement") ::= N("StructuralFeature");
N("ModelElement") ::= (N("Classifier") | N("StructuralFeature"));
N("Classifier") ::= N("Class");
N("Classifier") ::= N("DataType");
N("Classifier") ::= (N("Class") | N("DataType"));
N("StructuralFeature") ::= N("Attribute");
N("Class") ::= N("Concept");
N("Class") ::= N("ColumnSet");
N("Class") ::= (select("name", N("String")) (select("attributes", N("Attribute")))+);
N("DataType") ::= N("Integer");
N("DataType") ::= N("String");
N("DataType") ::= N("DomainDataType");
N("DataType") ::= select("attribute", N("Attribute"));
N("Attribute") ::= N("Column");
N("Attribute") ::= N("FeatureAttribute");
N("Attribute") ::= N("Value");
N("Attribute") ::= N("RoleRestriction");
N("Attribute") ::= (select("class", N("Class")) select("has", N("DataType")));
N("Concept") ::= (select("name", N("String")) (select("attributes", N("Attribute")))+);
N("ColumnSet") ::= (select("name", N("String")) (select("attributes", N("Attribute")))+);
N("Column") ::= (select("class", N("Class")) select("has", N("DataType")));
N("FeatureAttribute") ::= (select("class", N("Class")) select("has", N("DataType")));
N("Value") ::= (select("class", N("Class")) select("has", N("DataType")));
N("RoleRestriction") ::= (select("class", N("Class")) select("has", N("DataType")));
N("Integer") ::= select("attribute", N("Attribute"));
N("String") ::= select("attribute", N("Attribute"));
N("DomainDataType") ::= select("attribute", N("Attribute"));
