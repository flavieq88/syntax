N("QoSCharacteristic") ::= (select("invariant", N("BooleanExpression")) select("parallel_and_composition", N("MappingExpression")) select("parallel_or_composition", N("MappingExpression")) select("sequential_composition", N("MappingExpression")) select("values", N("MappingExpression")) (select("statisticalAttribute", N("StatisticalAttributekindKind")))+ select("parameter", N("Parameter")) select("domain", N("Domain")));
N("BooleanExpression") ::= select("value", N("String"));
N("MappingExpression") ::= select("value", N("String"));
