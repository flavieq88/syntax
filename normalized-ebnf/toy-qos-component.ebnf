N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
N("String") ::= value("string");
N("QoSComponent") ::= ((select("profile", N("QoSProfile")))+ select("operations", N("Operation")));
N("QoSProfile") ::= N("CompoundProfile");
N("QoSProfile") ::= N("SimpleProfile");
N("QoSContraints") ::= (select("invariant", N("BooleanExpression")) select("parallel_and_composition", N("MappingExpression")) select("parallel_or_composition", N("MappingExpression")) select("sequential_composition", N("MappingExpression")) select("values", N("MappingExpression")) (select("statisticalAttribute", N("StatisticalAttributekindKind")))+ select("parameter", N("Parameter")) select("domain", N("Domain")));
N("Operation") ::= epsilon;
N("CompoundProfile") ::= ((select("profileTransition", N("ProfileTransition")))+ (select("simpleProfile", N("SimpleProfile")))+);
N("SimpleProfile") ::= (select("compoundProfile", N("CompoundProfile")) select("use", N("QoSStatement")) select("provides", N("QoSStatement")));
N("ProfileTransition") ::= ((select("operations", N("Operation")))+ select("from", N("SimpleProfile")) select("to", N("SimpleProfile")) select("compoundProfile", N("CompoundProfile")));
N("QoSStatement") ::= N("SingleQoSStatement");
N("QoSStatement") ::= N("CoumpoundQoSStatement");
N("QoSStatement") ::= ((select("contraints", N("QoSContraints")))+ select("relation", N("CoumpoundQoSStatement")) (select("parameter", N("Parameter")))+);
N("SingleQoSStatement") ::= select("contraint", N("QoSContraint"));
N("CoumpoundQoSStatement") ::= select("statement", N("QoSStatement"));
N("QoSContraint") ::= select("qualification", N("QualificationKind"));
N("QualificationKind") ::= select("value", N("String"));
N("QoSCharacteristic") ::= N("QoSContraints");
N("QoSCharacteristic") ::= N("QualificationKind");
N("QoSCharacteristic") ::= (select("invariant", N("BooleanExpression")) select("parallel_and_composition", N("MappingExpression")) select("parallel_or_composition", N("MappingExpression")) select("sequential_composition", N("MappingExpression")) select("values", N("MappingExpression")) (select("statisticalAttribute", N("StatisticalAttributekindKind")))+ select("parameter", N("Parameter")) select("domain", N("Domain")));
N("BooleanExpression") ::= select("value", N("String"));
N("MappingExpression") ::= select("value", N("String"));
N("StatisticalAttributekindKind") ::= epsilon;
N("Parameter") ::= epsilon;
N("DataType") ::= N("Domain");
N("Domain") ::= N("Numeric");
N("Domain") ::= N("Set");
N("Domain") ::= N("Enumeration");
N("Domain") ::= select("direction", N("DirectionKind"));
N("DirectionKind") ::= select("value", N("String"));
N("Numeric") ::= select("direction", N("DirectionKind"));
N("Set") ::= (select("stringSet", N("StringSet")))+;
N("Enumeration") ::= select("direction", N("DirectionKind"));
N("StringSet") ::= (select("string", N("String")))+;
