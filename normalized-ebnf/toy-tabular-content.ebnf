N("NamedElement") ::= N("DataBase");
N("NamedElement") ::= N("Table");
N("DataBase") ::= (select("SGBDname", N("String")) (select("tables", N("Table")))+);
N("Table") ::= (select("database", N("DataBase")) (select("tuples", N("Tuple")))+);
N("Tuple") ::= (select("owner", N("Table")) (select("elements", N("TupleElement")))+);
N("TupleElement") ::= (select("tuple", N("Tuple")) select("value", N("String")));
N("Integer") ::= value("int");
N("String") ::= value("string");
N("Boolean") ::= ("true" | "false");
