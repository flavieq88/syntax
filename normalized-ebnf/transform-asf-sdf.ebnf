N("ASF-Condition") ::= (select("lhs", N("Tree")) select("unequal", "!=") select("rhs", N("Tree")));
N("ASF-Condition") ::= (select("lhs", N("Tree")) select("equality", "==") select("rhs", N("Tree")));
N("ASF-Condition") ::= (select("lhs", N("Tree")) select("match", ":=") select("rhs", N("Tree")));
N("ASF-Condition") ::= (select("lhs", N("Tree")) select("match", "!:=") select("rhs", N("Tree")));
N("ASF-Conditions") ::= select("list", (N("ASF-Condition") (("," N("ASF-Condition")))*));
N("Tree") ::= ("amb" "(" select("ambs", [(N("Tree") (("," N("Tree")))*)]) ")");
N("Tree") ::= (select("name", N("Tree")) "(" select("list", (N("CHAR"))*) ")");
N("ASF-ConditionalEquation") ::= (N("ASF-Tag") N("ASF-Equation"));
N("ASF-ConditionalEquation") ::= (N("ASF-Tag") N("ASF-Conditions") N("ASF-Implies") N("ASF-Equation"));
N("ASF-ConditionalEquation") ::= (N("ASF-Tag") N("ASF-Equation") "when" N("ASF-Conditions"));
N("ASF-Equation") ::= (select("lhs", N("Tree")) "=" select("rhs", N("Tree")));
N("ASF-Module") ::= select("list", (N("ASF-Section"))*);
N("ASF-Section") ::= ("equations" select("list", (N("ASF-ConditionalEquation"))*));
N("ASF-Section") ::= ("tests" select("test-list", (N("ASF-TestEquation"))*));
N("ASF-Tag") ::= ("[" "]");
N("ASF-Tag") ::= ("[" N("ASF-TagId") "]");
N("ASF-TestEquation") ::= (N("ASF-Tag") N("ASF-Condition"));
N("ASF-TestEquation") ::= (N("ASF-Tag") N("ASF-Conditions") N("ASF-Implies") N("ASF-Condition"));
N("ASF-TestEquation") ::= (N("ASF-Tag") N("ASF-Condition") "when" N("ASF-Conditions"));
