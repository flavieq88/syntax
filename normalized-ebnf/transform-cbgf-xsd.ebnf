N("decreasing-transformation") ::= (N("remove") | N("disappear") | N("narrow") | N("downgrade") | N("split"));
N("remove") ::= (select("vertical", N("production")) | select("horizontal", N("production")));
N("disappear") ::= N("production");
N("narrow") ::= (N("expression") N("expression") [select("in", N("scope"))]);
