@root N("sequence");

N("sequence") ::= ((N("transformation") | N("atomic")))*;
N("transformation") ::= (N("folding-unfolding-transformation") | N("refactoring-transformation") | N("increasing-decreasing-transformation") | N("concrete-revising-transformation") | N("abstract-revising-transformation") | N("decorative-transformation") | N("rename-rename") | N("reroot-reroot"));
