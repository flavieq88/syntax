N("expression") ::= (select("epsilon", epsilon) | select("empty", epsilon) | select("value", N("value")) | select("any", epsilon) | select("terminal", N("terminal")) | select("nonterminal", N("nonterminal")) | select("selectable", (select("selector", N("selector")) N("expression"))) | select("marked", N("expression")) | select("sequence", (N("expression"))+) | select("choice", (N("expression"))+) | select("allof", (N("expression"))+) | select("not", N("expression")) | select("optional", N("expression")) | select("plus", N("expression")) | select("star", N("expression")) | select("seplistplus", (N("expression") N("expression"))) | select("sepliststar", (N("expression") N("expression"))));
