N("roots") ::= (select("root", N("nonterminal")))*;
N("increasing-transformation") ::= (N("add") | N("appear") | N("widen") | N("upgrade") | N("unite"));
N("add") ::= (select("vertical", N("production")) | select("horizontal", N("production")));
N("appear") ::= N("production");
N("widen") ::= (N("expression") N("expression") [select("in", N("scope"))]);
N("upgrade") ::= (N("production") N("production"));
