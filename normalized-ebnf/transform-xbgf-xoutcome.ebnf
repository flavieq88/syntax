N("XBGFOutcome") ::= (select("ok", epsilon) | select("problem", select("msg", value("string"))) | select("problemXBGF", (select("msg", value("string")) select("xbgf", N("XBGFCommand")))) | select("problemProd", (select("msg", value("string")) select("p", N("BGFProduction")))) | select("problemProd2", (select("msg", value("string")) select("p1", N("BGFProduction")) select("p2", N("BGFProduction")))) | select("problemPinProds", (select("msg", value("string")) select("p", N("BGFProduction")) select("ps", (N("BGFProduction"))*))) | select("problemProds", (select("msg", value("string")) select("ps", (N("BGFProduction"))*))) | select("problemProds2", (select("msg", value("string")) select("ps1", (N("BGFProduction"))*) select("ps2", (N("BGFProduction"))*))) | select("problemExpr", (select("msg", value("string")) select("e", N("BGFExpression")))) | select("problemExpr2", (select("msg", value("string")) select("e1", N("BGFExpression")) select("e2", N("BGFExpression")))) | select("problemStr", (select("msg", value("string")) select("x", value("string")))) | select("problemStr2", (select("msg", value("string")) select("x", value("string")) select("y", value("string")))) | select("problemStrs", (select("msg", value("string")) select("xs", (value("string"))*))) | select("problemScope", (select("msg", value("string")) select("w", N("XBGFScope")))));
N("XBGFResult") ::= (select("r", N("XBGFOutcome")) select("g", N("BGFGrammar")));
