N("Package") ::= (select("ownedEltColl", N("CollaborationPackage")) (select("ownedEltInt", N("InteractionPackage")))+);
N("ProviderClause") ::= N("Package");
N("ProviderClause") ::= (select("ownedEltColl", N("CollaborationPackage")) (select("ownedEltInt", N("InteractionPackage")))+);
N("CollaborationPackage") ::= select("ownedElt", N("Collaboration"));
N("Collaboration") ::= ((select("interaction", N("Interaction")))+ select("ownedEltAss", N("AssociationRole")) select("ownedEltClass", N("ClassifierRole")));
N("InteractionPackage") ::= (select("providerClause", N("ProviderClause")) select("ownedElt", N("Interaction")));
N("Interaction") ::= (select("context", N("Collaboration")) (select("message", N("Message")))+);
N("AssociationRole") ::= select("connection", N("AssociationEndRole"));
N("ClassifierRole") ::= ((select("associationEndRole", N("AssociationEndRole")))+ select("receiverMess", N("Message")) select("senderMess", N("Message")) (select("availableFeature", N("Operation")))+ select("base", N("Interface")));
N("AssociationEndRole") ::= (select("associationRole", N("AssociationRole")) select("type", N("ClassifierRole")));
N("Message") ::= ((select("message", N("Message")))+ select("activator", N("Message")) (select("interaction", N("Interaction")))+ select("receiver", N("ClassifierRole")) select("sender", N("ClassifierRole")) select("specification", N("Request")));
N("Request") ::= N("Operation");
N("Request") ::= (select("message", N("Message")))+;
N("Operation") ::= ((select("classifierRole", N("ClassifierRole")))+ select("owner", N("Interface")));
N("Interface") ::= ((select("classifierRole", N("ClassifierRole")))+ (select("feature", N("Operation")))+);
N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
N("String") ::= value("string");
