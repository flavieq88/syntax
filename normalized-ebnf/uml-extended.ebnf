N("ModelElement") ::= N("AssociationEnd");
N("ModelElement") ::= N("Namespace");
N("ModelElement") ::= N("Key");
N("ModelElement") ::= N("Feature");
N("ModelElement") ::= select("name", N("Name"));
N("Name") ::= epsilon;
N("AssociationEnd") ::= (select("isNavigable", N("Boolean")) select("isOrdered", N("Boolean")) select("aggregation", N("AggregationKind")) select("multiplicity", N("Multiplicity")) select("changeable", N("ChangeableKind")) select("TargetScope", N("ScopeKind")) select("rfIntegrety", N("RlIntegretyKind")) select("rlIntegrety", N("RlIntegretyKind")));
N("AggregationKind") ::= epsilon;
N("Multiplicity") ::= epsilon;
N("ChangeableKind") ::= epsilon;
N("ScopeKind") ::= epsilon;
N("RfIntegretyKind") ::= epsilon;
N("RlIntegretyKind") ::= epsilon;
N("Namespace") ::= N("GeneralizableElement");
N("GeneralizableElement") ::= N("Classifier");
N("Classifier") ::= N("Class");
N("Class") ::= (select("isActive", N("Boolean")) select("mutliplicity", N("Multiplicity")) (select("key", N("Key")))+);
N("Feature") ::= N("StructureFeature");
N("Feature") ::= N("Constraint");
N("Feature") ::= (N("StructureFeature") | N("Constraint"));
N("StructureFeature") ::= N("Attribute");
N("Attribute") ::= (select("initialValue", N("Expression")) select("isKey", N("Boolean")) select("isUnique", N("Boolean")));
N("Expression") ::= epsilon;
N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
N("String") ::= value("string");
