N("Class") ::= (select("parent", N("Generalization")) select("child", N("Generalization")) select("dependency", N("Dependency")));
N("Generalization") ::= epsilon;
N("Dependency") ::= (select("supplier", N("StateMachine")) select("client", N("Class")) select("stereotype", N("Stereotype")));
N("Stereotype") ::= (select("baseClass", N("String")) select("extendedElement", N("Dependency")));
N("StateMachine") ::= (select("context", N("Class")) select("top", N("State")));
N("State") ::= N("CompositeState");
N("State") ::= N("SimpleState");
N("State") ::= N("FinalState");
N("State") ::= (select("stateMachine", N("StateMachine")) select("internal", N("Transition")));
N("CompositeState") ::= select("subvertex", N("StateVertex"));
N("SimpleState") ::= (select("stateMachine", N("StateMachine")) select("internal", N("Transition")));
N("FinalState") ::= (select("stateMachine", N("StateMachine")) select("internal", N("Transition")));
N("StateVertex") ::= N("State");
N("StateVertex") ::= N("PseudoState");
N("StateVertex") ::= select("compositeState", N("CompositeState"));
N("PseudoState") ::= (select("compositeState", N("CompositeState")));
N("Transition") ::= (select("trigger", N("Event")) select("source", N("StateVertex")) select("target", N("StateVertex")));
N("Event") ::= epsilon;
N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
N("String") ::= value("string");
