N("VisibilityKind") ::= (select("vk_public_vis", epsilon) | select("vk_private_vis", epsilon) | select("vk_protected_vis", epsilon));
N("ScopeKind") ::= (select("sk_instance_level", epsilon) | select("sk_classifier_level", epsilon));
N("MultiplicityType") ::= (select("lower", N("Integer")) select("upper", N("Integer")) select("isOrdered", N("Boolean")) select("isUnique", N("Boolean")));
N("ModelElement") ::= N("Feature");
N("ModelElement") ::= N("NameSpace");
N("ModelElement") ::= N("GeneralizableElement");
N("ModelElement") ::= select("name", N("String"));
N("Feature") ::= N("StructuralFeature");
N("Feature") ::= N("BehavioralFeature");
N("Feature") ::= (select("ownerScope", N("ScopeKind")) select("visibility", N("VisibilityKind")) select("owner", N("Classifier")));
N("NameSpace") ::= N("Classifier");
N("NameSpace") ::= (select("name", N("String")));
N("GeneralizableElement") ::= N("Classifier");
N("GeneralizableElement") ::= (select("isRoot", N("Boolean")) select("isLeaf", N("Boolean")) select("isAbstract", N("Boolean")));
N("Classifier") ::= N("Class");
N("Classifier") ::= (select("feature", N("Feature")))+;
N("Class") ::= select("isActive", N("Boolean"));
N("StructuralFeature") ::= N("Attribute");
N("StructuralFeature") ::= (select("multiplicity", N("MultiplicityType")) select("isChangeable", N("Boolean")) select("targetScope", N("ScopeKind")));
N("Attribute") ::= select("initialValue", N("String"));
N("BehavioralFeature") ::= N("Operation");
N("BehavioralFeature") ::= select("isQuery", N("Boolean"));
N("Operation") ::= (select("isRoot", N("Boolean")) select("isLeaf", N("Boolean")) select("isAbstract", N("Boolean")) select("specification", N("String")));
N("Integer") ::= value("int");
N("String") ::= value("string");
N("Boolean") ::= ("true" | "false");
