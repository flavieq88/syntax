N("ReuseContract") ::= (select("supplier", N("ProviderClause")) select("client", N("ReuserClause")));
N("Dependency") ::= N("ReuseContract");
N("Dependency") ::= (select("owningDependency", N("Dependency")) (select("subDependency", N("Dependency")))+);
N("ProviderClause") ::= N("CompositeProvider");
N("ProviderClause") ::= N("BasicProvider");
N("ProviderClause") ::= (N("CompositeProvider") | N("BasicProvider"));
N("Package") ::= N("ProviderClause");
N("Package") ::= N("ReuserClause");
N("Package") ::= (N("ProviderClause") | N("ReuserClause"));
N("ReuserClause") ::= N("CompositeReuser");
N("ReuserClause") ::= N("BasicReuser");
N("ReuserClause") ::= (N("CompositeReuser") | N("BasicReuser"));
N("CompositeProvider") ::= select("subcontract", N("ReuseContract"));
N("BasicProvider") ::= epsilon;
N("CompositeReuser") ::= (select("subreuser", N("ReuserClause")))+;
N("BasicReuser") ::= epsilon;
N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
N("String") ::= value("string");
