N("Element") ::= N("ModelElement");
N("ModelElement") ::= N("GeneralizableElement");
N("ModelElement") ::= N("Namespace");
N("ModelElement") ::= N("Feature");
N("ModelElement") ::= N("Relationship");
N("GeneralizableElement") ::= N("Classifier");
N("GeneralizableElement") ::= N("Package");
N("Namespace") ::= N("Classifier");
N("Namespace") ::= N("Package");
N("Classifier") ::= N("Subsystem");
N("Relationship") ::= N("Generalization");
N("Generalization") ::= (select("parent", N("GeneralizableElement")) select("powertype", N("Classifier")) select("child", N("GeneralizableElement")) select("discriminator", N("String")));
N("Package") ::= N("Model");
N("Package") ::= N("Subsystem");
N("Package") ::= (select("elementImport", N("ElementImport")))+;
N("Model") ::= ((select("elementImport", N("ElementImport")))+);
N("Subsystem") ::= select("isInstantiable", N("Boolean"));
N("ElementImport") ::= (select("package", N("Package")) select("importedElement", N("ModelElement")) select("visibility", N("VisibilityKind")) select("alias", N("String")) select("isSpecification", N("Boolean")));
N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
N("String") ::= value("string");
N("ScopeKind") ::= (select("sk_instance", epsilon) | select("sk_classifier", epsilon));
N("VisibilityKind") ::= (select("vk_public", epsilon) | select("vk_protected", epsilon) | select("vk_private", epsilon) | select("vk_package", epsilon));
