N("Classifier") ::= N("Actor");
N("Classifier") ::= N("UseCase");
N("Classifier") ::= (select("instance", N("Instance")))+;
N("Instance") ::= N("UseCaseInstance");
N("Instance") ::= (select("classifier", N("Classifier")))+;
N("Actor") ::= ((select("instance", N("Instance")))+);
N("UseCase") ::= ((select("extensionPoint", N("String")))+ select("includeAddition", N("Include")) select("includeBase", N("Include")) select("extendExtension", N("Extend")) select("extendBase", N("Extend")) (select("extensionPoints", N("ExtensionPoint")))+);
N("UseCaseInstance") ::= ((select("classifier", N("Classifier")))+);
N("RelationShip") ::= N("Include");
N("RelationShip") ::= N("Extend");
N("Include") ::= (select("addition", N("UseCase")) select("base", N("UseCase")));
N("Extend") ::= (select("condition", N("BooleanExpression")) select("extension", N("UseCase")) select("base", N("UseCase")) (select("extensionPoint", N("ExtensionPoint")))+);
N("BooleanExpression") ::= select("value", N("String"));
N("ModelElement") ::= N("ExtensionPoint");
N("ExtensionPoint") ::= (select("location", N("LocationReference")) (select("extend", N("Extend")))+ (select("useCase", N("UseCase")))+);
N("LocationReference") ::= select("value", N("String"));
N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
N("String") ::= value("string");
