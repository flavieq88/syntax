N("LocatedElement") ::= N("Model");
N("LocatedElement") ::= N("Class");
N("LocatedElement") ::= N("ModelElement");
N("LocatedElement") ::= N("ClassDefinition");
N("LocatedElement") ::= N("Cardinality");
N("LocatedElement") ::= N("ClassMember");
N("Model") ::= ((select("classes", N("Class")))+ (select("elements", N("ModelElement")))+);
N("Class") ::= select("name", N("String"));
N("ModelElement") ::= N("ColorableElement");
N("ModelElement") ::= N("Relationship");
N("ColorableElement") ::= N("ClassReference");
N("ColorableElement") ::= N("Note");
N("ClassReference") ::= (select("class", N("Class")) select("stereotype", N("String")) select("definition", N("ClassDefinition")));
N("AssociationType") ::= (select("simpleAssociation", epsilon) | select("aggregation", epsilon) | select("composition", epsilon));
N("Relationship") ::= N("Association");
N("Relationship") ::= N("Inheritance");
N("Relationship") ::= N("NoteAssociation");
N("ClassDefinition") ::= ((select("attributes", N("Attribute")))+ (select("methods", N("Method")))+);
N("Association") ::= (select("type", N("AssociationType")) select("sourceCardinality", N("Cardinality")) select("sourceLabel", N("String")) select("navigableSource", N("Boolean")) select("sourceVisibility", N("Visibility")) select("targetCardinality", N("Cardinality")) select("targetLabel", N("String")) select("navigableTarget", N("Boolean")) select("targetVisibility", N("Visibility")));
N("Inheritance") ::= (select("source", N("ClassReference")) select("target", N("ClassReference")));
N("Cardinality") ::= (select("lowerBound", N("Integer")) select("upperBound", N("Integer")));
N("Visibility") ::= (select("unspecified", epsilon) | select("public", epsilon) | select("private", epsilon) | select("protected", epsilon) | select("package", epsilon));
N("ClassMember") ::= N("Attribute");
N("ClassMember") ::= N("Method");
N("Attribute") ::= select("type", N("String"));
N("Method") ::= (select("arguments", N("String")))+;
N("Note") ::= (select("text", N("String")))+;
N("NoteAssociation") ::= select("note", N("Note"));
N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
N("String") ::= value("string");
