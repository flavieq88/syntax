N("InterfaceDef") ::= N("ComponentDef");
N("InterfaceDef") ::= N("HomeDef");
N("InterfaceDef") ::= (N("ComponentDef") | N("HomeDef"));
N("OperationDef") ::= N("FactoryDef");
N("OperationDef") ::= N("FinderDef");
N("OperationDef") ::= (N("FactoryDef") | N("FinderDef"));
N("ValueDef") ::= epsilon;
N("ComponentDef") ::= (select("isBasic", N("Boolean")) (select("facets", N("ProvidesDef")))+ (select("receptacles", N("UsesDef")))+ (select("supports", N("InterfaceDef")))+ (select("emits", N("EmitsDef")))+ (select("publishes", N("PublishesDef")))+ (select("consumes", N("ConsumesDef")))+);
N("ProvidesDef") ::= (select("provides", N("InterfaceDef")) select("prd_home", N("ComponentDef")));
N("UsesDef") ::= (select("multiple", N("Boolean")) select("uses", N("InterfaceDef")) select("ud_home", N("ComponentDef")));
N("EventDef") ::= N("EmitsDef");
N("EventDef") ::= N("PublishesDef");
N("EventDef") ::= N("ConsumesDef");
N("EventDef") ::= select("type", N("ValueDef"));
N("EmitsDef") ::= select("ed_home", N("ComponentDef"));
N("PublishesDef") ::= select("pud_home", N("ComponentDef"));
N("ConsumesDef") ::= select("cd_home", N("ComponentDef"));
N("HomeDef") ::= (select("manages", N("ComponentDef")) (select("factories", N("FactoryDef")))+ (select("finders", N("FinderDef")))+ select("key", N("PrimaryKeyDef")));
N("FactoryDef") ::= select("fa_home", N("HomeDef"));
N("FinderDef") ::= select("fi_home", N("HomeDef"));
N("PrimaryKeyDef") ::= (select("pkd_home", N("HomeDef")) select("type", N("ValueDef")));
N("Integer") ::= value("int");
N("String") ::= value("string");
N("Boolean") ::= ("true" | "false");
