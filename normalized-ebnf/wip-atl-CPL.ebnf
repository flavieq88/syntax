N("SignallingAction") ::= N("Proxy");
N("SignallingAction") ::= N("Redirect");
N("SignallingAction") ::= N("Reject");
N("Proxy") ::= (select("timeout", N("String")) select("recurse", N("String")) select("ordering", N("String")) select("busy", N("Busy")) select("noAnswer", N("NoAnswer")) select("redirection", N("Redirection")) select("failure", N("Failure")) select("default", N("Default")));
N("Redirect") ::= select("permanent", N("String"));
N("Reject") ::= (select("status", N("String")) select("reason", N("String")));
