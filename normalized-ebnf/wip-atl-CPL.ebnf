N("NodeContainer") ::= N("Redirection");
N("NodeContainer") ::= N("Failure");
N("NodeContainer") ::= N("Default");
N("NodeContainer") ::= N("Location");
N("SubAction") ::= select("id", N("String"));
N("Outgoing") ::= (select("contents", N("Node")));
N("Incoming") ::= (select("contents", N("Node")));
N("NotPresent") ::= (select("contents", N("Node")));
N("Otherwise") ::= (select("contents", N("Node")));
N("SwitchedAddress") ::= (select("is", N("String")) select("contains", N("String")) select("subDomainOf", N("String")));
N("SwitchedString") ::= (select("is", N("String")) select("contains", N("String")));
N("SwitchedLanguage") ::= select("matches", N("String"));
N("SwitchedTime") ::= (select("dtstart", N("String")) select("dtend", N("String")) select("duration", N("String")) select("freq", N("String")) select("until", N("String")) select("count", N("String")) select("interval", N("String")) select("bySecond", N("String")) select("byMinute", N("String")) select("byHour", N("String")) select("byDay", N("String")) select("byMonthDay", N("String")) select("byYearDay", N("String")) select("byWeekNo", N("String")) select("byMonth", N("String")) select("wkst", N("String")) select("bySetPos", N("String")));
N("SwitchedPriority") ::= (select("less", N("String")) select("greater", N("String")) select("equal", N("String")));
N("Busy") ::= (select("contents", N("Node")));
N("NoAnswer") ::= (select("contents", N("Node")));
N("Redirection") ::= (select("contents", N("Node")));
N("Failure") ::= (select("contents", N("Node")));
