N("Element") ::= N("CPL");
N("Element") ::= N("NodeContainer");
N("Element") ::= N("Node");
N("CPL") ::= ((select("subActions", N("SubAction")))+ select("outgoing", N("Outgoing")) select("incoming", N("Incoming")));
N("NodeContainer") ::= N("SubAction");
N("NodeContainer") ::= N("Outgoing");
N("NodeContainer") ::= N("Incoming");
N("NodeContainer") ::= N("NotPresent");
