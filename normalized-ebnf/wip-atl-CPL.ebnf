N("Switch") ::= N("TimeSwitch");
N("Switch") ::= N("PrioritySwitch");
N("AddressSwitch") ::= (select("field", N("String")) select("subField", N("String")) (select("addresses", N("SwitchedAddress")))+);
N("StringSwitch") ::= (select("field", N("String")) (select("strings", N("SwitchedString")))+);
N("LanguageSwitch") ::= (select("languages", N("SwitchedLanguage")))+;
N("TimeSwitch") ::= (select("tzid", N("String")) select("tzurl", N("String")) (select("times", N("SwitchedTime")))+);
N("PrioritySwitch") ::= (select("priorities", N("SwitchedPriority")))+;
