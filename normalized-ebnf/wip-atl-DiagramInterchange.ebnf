N("Dimension") ::= (select("width", N("Double")) select("heigth", N("Double")));
N("Point") ::= N("BezierPoint");
N("Point") ::= (select("x", N("Double")) select("y", N("Double")));
N("BezierPoint") ::= select("controls", N("Point"));
N("Property") ::= (select("key", N("String")) select("value", N("String")));
N("DiagramElement") ::= N("Reference");
N("DiagramElement") ::= N("GraphElement");
N("DiagramElement") ::= N("LeafElement");
N("Reference") ::= (select("isIndividualRepresentation", N("Boolean")) select("referenced", N("DiagramElement")));
N("GraphElement") ::= N("GraphEdge");
N("GraphElement") ::= N("GraphNode");
N("GraphEdge") ::= (select("waypoints", N("Point")) select("anchors", N("GraphConnector")));
N("GraphNode") ::= N("Diagram");
N("GraphNode") ::= select("size", N("Dimension"));
N("GraphConnector") ::= (select("position", N("Point")) select("gc_graphElement", N("GraphElement")) (select("graphEdges", N("GraphEdge")))+);
N("DiagramLink") ::= (select("zoom", N("Double")) select("viewPort", N("Point")) select("dl_graphElement", N("GraphElement")) select("dl_diagram", N("Diagram")));
N("SemanticModelBridge") ::= N("SimpleSemanticModelElement");
N("SemanticModelBridge") ::= N("UML1SemanticModelBridge");
N("SemanticModelBridge") ::= N("CoreSemanticModelBridge");
N("Diagram") ::= (select("name", N("String")) select("zoom", N("Double")) select("viewPort", N("Point")) (select("diagramLinks", N("DiagramLink")))+ select("namespace", N("SemanticModelBridge")));
N("SimpleSemanticModelElement") ::= select("typeInfo", N("String"));
N("UML1SemanticModelBridge") ::= select("element", N("CoreElement"));
N("CoreSemanticModelBridge") ::= select("element", N("ElementsElement"));
N("CoreElement") ::= epsilon;
N("ElementsElement") ::= epsilon;
N("LeafElement") ::= N("TextElement");
N("LeafElement") ::= N("Image");
N("LeafElement") ::= N("GraphicPrimitive");
N("TextElement") ::= select("text", N("String"));
N("Image") ::= (select("uri", N("String")) select("mimeType", N("String")));
N("GraphicPrimitive") ::= N("Polyline");
N("GraphicPrimitive") ::= N("Ellipse");
N("Polyline") ::= (select("waypoints", N("Point")) select("closed", N("Boolean")));
N("Ellipse") ::= (select("center", N("Point")) select("radiusX", N("Double")) select("radiusY", N("Double")) select("rotation", N("Double")) select("startAngle", N("Double")) select("endAngle", N("Double")));
N("Integer") ::= value("int");
N("String") ::= value("string");
N("Boolean") ::= ("true" | "false");
