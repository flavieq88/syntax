N("Integer") ::= value("int");
N("String") ::= value("string");
N("Boolean") ::= ("true" | "false");
N("NamedElement") ::= N("Assembly");
N("NamedElement") ::= N("Module");
N("NamedElement") ::= N("MemberInfo");
N("NamedElement") ::= N("ParameterInfo");
N("Assembly") ::= (select("location", N("String")) select("imageRuntimeVersion", N("String")) select("evidence", N("String")) select("codeBase", N("String")) select("entryPoint", N("MethodInfo")) (select("modules", N("Module")))+ select("manifestModule", N("Module")) (select("referencedAssembly", N("Assembly")))+ select("manifest", N("ManifestResource")));
N("ManifestResource") ::= (select("content", N("String")) select("assembly", N("Assembly")));
N("Module") ::= (select("qualifiedName", N("String")) select("scopeName", N("String")) select("assembly", N("Assembly")) (select("types", N("Type")))+);
N("MemberInfo") ::= N("PropertyInfo");
N("MemberInfo") ::= N("FieldInfo");
N("MemberInfo") ::= N("EventInfo");
N("MemberInfo") ::= N("MethodBase");
N("MemberInfo") ::= N("Type");
N("PropertyInfo") ::= (select("propertyType", N("Type")) (select("attributes", N("PropertyAttributes")))+);
N("FieldInfo") ::= (select("fieldType", N("Type")) (select("attributes", N("FieldAttributes")))+);
N("EventInfo") ::= (select("isMulticast", N("Boolean")) select("attributes", N("EventAttributes")) select("eventHandlerType", N("Type")));
N("ParameterInfo") ::= (select("defaultValue", N("String")) select("position", N("Integer")) (select("attributes", N("ParameterAttributes")))+ select("parameterType", N("Type")) select("member", N("MethodBase")));
N("MethodBase") ::= N("MethodInfo");
N("MethodBase") ::= N("ConstructorInfo");
N("MethodInfo") ::= select("returnType", N("Type"));
N("ConstructorInfo") ::= ((select("attributes", N("MethodAttributes")))+ (select("parameters", N("ParameterInfo")))+);
N("Type") ::= (select("namespace", N("String")) (select("genericParameterAttributes", N("GenericParameterAttributes")))+ (select("typeAttributes", N("TypeAttributes")))+ select("baseType", N("Type")) select("module", N("Module")) (select("interfaces", N("Type")))+ (select("members", N("MemberInfo")))+);
N("EventAttributes") ::= (select("None", epsilon) | select("ReservedMask", epsilon) | select("RTSpecialName", epsilon) | select("SpecialName", epsilon));
N("FieldAttributes") ::= (select("FieldAccessMask", epsilon) | select("PrivateScope", epsilon) | select("Private", epsilon) | select("Assembly", epsilon) | select("Family", epsilon) | select("FamANDAssem", epsilon) | select("FamORAssem", epsilon) | select("Public", epsilon) | select("Shared", epsilon) | select("InitOnly", epsilon) | select("Literal", epsilon) | select("NotSerialized", epsilon) | select("SpecialName", epsilon) | select("PinvokeImpl", epsilon) | select("ReservedMask", epsilon) | select("RTSpecialName", epsilon) | select("HasFieldMarshal", epsilon) | select("HasDefault", epsilon) | select("HasFieldRVA", epsilon) | select("Static", epsilon));
N("GenericParameterAttributes") ::= (select("HasElementType", epsilon) | select("Abstract", epsilon) | select("AnsiClass", epsilon) | select("AutoClass", epsilon) | select("AutoLayout", epsilon) | select("ByRef", epsilon) | select("Class", epsilon) | select("COMObject", epsilon) | select("Contextful", epsilon) | select("Enum", epsilon) | select("ExplicitLayout", epsilon) | select("Import", epsilon) | select("Interface", epsilon) | select("LayoutSequential", epsilon) | select("MarshalByRef", epsilon) | select("NestedAssembly", epsilon) | select("NestedFamADNAssem", epsilon) | select("NestedFamily", epsilon) | select("NestedFamORAssem", epsilon) | select("NestedPrivate", epsilon) | select("NestedPublic", epsilon) | select("NotPublic", epsilon) | select("Pointer", epsilon) | select("Primitive", epsilon) | select("Public", epsilon) | select("Sealed", epsilon) | select("Serializable", epsilon) | select("SpecialName", epsilon) | select("UnicodeClass", epsilon) | select("ValueType", epsilon));
N("MemberTypes") ::= (select("Constructor", epsilon) | select("Event", epsilon) | select("Field", epsilon) | select("Method", epsilon) | select("Property", epsilon) | select("TypeInfo", epsilon) | select("Custom", epsilon) | select("NestedType", epsilon) | select("All", epsilon));
N("MethodAttributes") ::= (select("Abstract", epsilon) | select("Assembly", epsilon) | select("ChekedAccessOnOverride", epsilon) | select("FamADNAssem", epsilon) | select("Family", epsilon) | select("FamORAssem", epsilon) | select("Final", epsilon) | select("HasSecurity", epsilon) | select("HideBySig", epsilon) | select("MemberAccessMask", epsilon) | select("NewSlot", epsilon) | select("PInvokeImpl", epsilon) | select("Private", epsilon) | select("PrivateScope", epsilon) | select("Public", epsilon) | select("RequiredSecObject", epsilon) | select("ReservedMask", epsilon) | select("ReuseSlot", epsilon) | select("RTSpecialName", epsilon) | select("SpecialName", epsilon) | select("Static", epsilon) | select("UnmanagedExport", epsilon) | select("Virtual", epsilon) | select("VtableLayoutMask", epsilon));
N("ParameterAttributes") ::= (select("HasDefault", epsilon) | select("HasDefaultMArshal", epsilon) | select("In", epsilon) | select("Lcid", epsilon) | select("None", epsilon) | select("Optional", epsilon) | select("Out", epsilon) | select("Reserved3", epsilon) | select("Reserved4", epsilon) | select("ReservedMask", epsilon) | select("RetVal", epsilon));
N("PropertyAttributes") ::= (select("NotSupported", epsilon) | select("Optional", epsilon) | select("Read", epsilon) | select("Required", epsilon) | select("Write", epsilon));
N("TypeAttributes") ::= (select("Abstract", epsilon) | select("AnsiClass", epsilon) | select("AutoClass", epsilon) | select("AutoLayout", epsilon) | select("BeforFieldInit", epsilon) | select("Class", epsilon) | select("ClassSemanticsMask", epsilon) | select("ExplicitLayout", epsilon) | select("HasSecutity", epsilon) | select("Import", epsilon) | select("Interface", epsilon) | select("LayoutMask", epsilon) | select("NestedAssembly", epsilon) | select("NestedFamADNAssem", epsilon) | select("NestedFamily", epsilon) | select("NestedFamORAssem", epsilon) | select("NestedPrivate", epsilon) | select("NestedPublic", epsilon) | select("NotPublic", epsilon) | select("Public", epsilon) | select("ReservedMask", epsilon) | select("RTSpecialName", epsilon) | select("Sealed", epsilon) | select("SequentialLayout", epsilon) | select("Serializable", epsilon) | select("SpecialName", epsilon) | select("StringFormatMask", epsilon) | select("UnicodeClass", epsilon) | select("VisibilityMask", epsilon));
