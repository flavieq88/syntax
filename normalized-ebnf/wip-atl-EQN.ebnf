N("RoutingChain") ::= (select("queuingNetwork", N("QueuingNetwork")))+;
N("QueuingNetwork") ::= ((select("center", N("Center")))+ select("workLoad", N("RoutingChain")));
N("ExecutionGraph") ::= (select("nodeNested", N("Node")) (select("node", N("Node")))+);
N("Center") ::= N("Special");
N("Center") ::= N("ActiveCenter");
N("Center") ::= N("PassiveCenter");
N("Center") ::= (select("node", N("Node")) select("queuingNetwork", N("QueuingNetwork")));
N("Node") ::= (select("nested", N("ExecutionGraph")) select("executionGraph", N("ExecutionGraph")) (select("demand", N("Center")))+);
N("Special") ::= N("Source");
N("Special") ::= N("Sink");
N("Special") ::= N("Fork");
N("Special") ::= N("Join");
N("Special") ::= N("Split");
N("Special") ::= N("Allocate");
N("Special") ::= N("Release");
N("Special") ::= (N("Source") | N("Sink") | N("Fork") | N("Join") | N("Split") | N("Allocate") | N("Release"));
N("ActiveCenter") ::= (select("node", N("Node")) select("queuingNetwork", N("QueuingNetwork")));
N("PassiveCenter") ::= (select("node", N("Node")) select("queuingNetwork", N("QueuingNetwork")));
N("Source") ::= epsilon;
N("Sink") ::= epsilon;
N("Fork") ::= epsilon;
N("Join") ::= epsilon;
N("Split") ::= epsilon;
N("Allocate") ::= epsilon;
N("Release") ::= epsilon;
N("String") ::= value("string");
N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
