N("LocatedElement") ::= N("Profile");
N("LocatedElement") ::= N("Method");
N("LocatedElement") ::= N("ThreadAction");
N("LocatedElement") ::= N("Trace");
N("LocatedElement") ::= N("StackTraceElement");
N("LocatedElement") ::= N("Times");
N("LocatedElement") ::= N("Time");
N("LocatedElement") ::= N("Date");
N("Profile") ::= (select("header", N("String")) (select("threadActions", N("ThreadAction")))+ (select("traces", N("Trace")))+ select("times", N("Times")) (select("methods", N("Method")))+);
N("Method") ::= (select("fullyQualifiedName", N("String")) (select("stackTraceElements", N("StackTraceElement")))+);
N("ThreadAction") ::= N("ThreadStart");
N("ThreadAction") ::= N("ThreadEnd");
N("ThreadStart") ::= (select("obj", N("Integer")) select("name", N("String")) select("group", N("String")));
N("ThreadEnd") ::= (select("id", N("Integer")));
N("Trace") ::= (select("id", N("Integer")) select("threadId", N("Integer")) (select("elements", N("StackTraceElement")))+ (select("times", N("Time")))+);
N("StackTraceElement") ::= (select("method", N("Method")) select("fileName", N("String")) select("line", N("Integer")) select("trace", N("Trace")));
N("Times") ::= (select("unit", N("String")) select("total", N("Integer")) select("date", N("Date")) (select("elements", N("Time")))+);
N("Time") ::= (select("rank", N("Integer")) select("self", N("Double")) select("accum", N("Double")) select("count", N("Integer")) select("trace", N("Trace")) select("method", N("Method")));
N("Date") ::= (select("day", N("Day")) select("month", N("Month")) select("dayOfMonth", N("Integer")) select("hour", N("Integer")) select("minutes", N("Integer")) select("seconds", N("Integer")) select("year", N("Integer")));
N("Day") ::= (select("Monday", epsilon) | select("Tuesday", epsilon) | select("Wednesday", epsilon) | select("Thursday", epsilon) | select("Friday", epsilon) | select("Saturday", epsilon) | select("Sunday", epsilon));
N("Month") ::= (select("January", epsilon) | select("February", epsilon) | select("March", epsilon) | select("April", epsilon) | select("May", epsilon) | select("June", epsilon) | select("July", epsilon) | select("August", epsilon) | select("September", epsilon) | select("October", epsilon) | select("November", epsilon) | select("December", epsilon));
N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
N("String") ::= value("string");
