N("String") ::= value("string");
N("Element") ::= N("IEEE1471Model");
N("Element") ::= N("System");
N("Element") ::= N("Mission");
N("Element") ::= N("Environment");
N("Element") ::= N("Architecture");
N("Element") ::= N("Rationale");
N("Element") ::= N("ArchitecturalDescription");
N("Element") ::= N("View");
N("Element") ::= N("Model");
N("Element") ::= N("Stakeholder");
N("Element") ::= N("Concern");
N("Element") ::= N("Viewpoint");
N("Element") ::= N("LibraryViewpoint");
N("IEEE1471Model") ::= (select("system", N("System")) select("environment", N("Environment")) (select("missions", N("Mission")))+ select("architecture", N("Architecture")) (select("stakeholders", N("Stakeholder")))+ (select("concerns", N("Concern")))+ (select("viewpoints", N("Viewpoint")))+ (select("libraryViewpoints", N("LibraryViewpoint")))+ select("architecturalDescription", N("ArchitecturalDescription")) select("rationale", N("Rationale")));
N("System") ::= ((select("fulfils", N("Mission")))+ select("inhabits", N("Environment")) select("hasAn", N("Architecture")) (select("has", N("Stakeholder")))+);
N("Mission") ::= (select("name", N("String")) select("content", N("String")));
N("Environment") ::= select("influences", N("System"));
N("Architecture") ::= select("describedBy", N("ArchitecturalDescription"));
N("Rationale") ::= select("provides", N("ArchitecturalDescription"));
N("ArchitecturalDescription") ::= ((select("identifiesS", N("Stakeholder")))+ (select("identifiesC", N("Concern")))+ (select("selects", N("Viewpoint")))+ (select("organizedBy", N("View")))+ (select("aggregates", N("Model")))+);
N("View") ::= (select("conformsTo", N("Viewpoint")) (select("consitsOf", N("Model")))+);
N("Model") ::= ((select("participatesInV", N("View")))+ select("participatesInAD", N("ArchitecturalDescription")));
N("Stakeholder") ::= (select("has", N("Concern")))+;
N("Concern") ::= (select("isImportantTo", N("Stakeholder")))+;
N("Viewpoint") ::= (select("hasSource", N("LibraryViewpoint")) (select("usedToCover", N("Concern")))+ (select("establishesMethodsFor", N("Model")))+);
N("LibraryViewpoint") ::= (select("name", N("String")) select("content", N("String")));
