N("Viewpoint") ::= ((select("source", N("ViewpointImport")))+ (select("covers", N("Concern")))+ (select("supplierDependency", N("ViewpointDependency")))+ (select("clientDependency", N("ViewpointDependency")))+ select("isImportTo", N("Stakeholder")) (select("architecturalConstruct", N("ArchitecturalConstruct")))+ select("process", N("Process")));
N("Concern") ::= epsilon;
N("Stakeholder") ::= select("concerns", N("Concern"));
N("ViewpointImport") ::= epsilon;
N("ViewpointDependency") ::= (select("supplier", N("Viewpoint")) select("client", N("Viewpoint")));
N("Process") ::= (select("methodology", N("Technique")))+;
N("Technique") ::= ((select("methods", N("AnalysisMethod")))+ (select("applies", N("Rule")))+);
N("AnalysisMethod") ::= select("analysis", N("Language"));
N("ArchitecturalConstruct") ::= N("Rule");
N("ArchitecturalConstruct") ::= N("Language");
N("ArchitecturalConstruct") ::= N("Mapping");
N("ArchitecturalConstruct") ::= N("Pattern");
N("ArchitecturalConstruct") ::= (N("Rule") | N("Language") | N("Mapping") | N("Pattern"));
N("Rule") ::= N("ModelOrganization");
N("Rule") ::= ((select("techniques", N("Technique")))+ select("guidance", N("Language")));
N("ModelOrganization") ::= ((select("techniques", N("Technique")))+ select("guidance", N("Language")));
N("ModellingRule") ::= epsilon;
