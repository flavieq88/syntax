N("LocatedElement") ::= N("DeclareBloc");
N("LocatedElement") ::= N("ASlotDef");
N("LocatedElement") ::= N("SlotOptions");
N("LocatedElement") ::= N("ConditionAction");
N("LocatedElement") ::= N("ElifConditionAction");
N("Root") ::= (select("expressions", N("Expression")))+;
N("Expression") ::= N("Integ");
N("Expression") ::= N("Floa");
N("Expression") ::= N("Str");
N("Expression") ::= N("Ident");
N("Expression") ::= N("TemplateExpression");
N("Expression") ::= N("DefinitionExp");
N("Expression") ::= N("UseFuncExp");
N("Integ") ::= select("val", N("Integer"));
N("Floa") ::= select("val", N("Double"));
N("Str") ::= select("val", N("String"));
N("Ident") ::= N("ValidIdentifier");
N("Ident") ::= N("SlotName");
N("Ident") ::= N("JessVariable");
N("ValidIdentifier") ::= select("val", N("String"));
N("SlotName") ::= select("val", N("String"));
N("JessVariable") ::= select("val", N("String"));
N("TemplateExpression") ::= (select("templateName", N("ValidIdentifier")) select("firstSlot", N("SlotOp")) (select("slotOp", N("SlotOp")))+);
N("SlotOp") ::= (select("slotIdent", N("SlotName")) select("operator", N("ValidIdentifier")) select("exp", N("Expression")));
N("DefinitionExp") ::= N("GlobalDefinition");
N("DefinitionExp") ::= N("FunctionDefinition");
N("DefinitionExp") ::= N("AdviceDefinition");
N("DefinitionExp") ::= N("UnDefAdvice");
N("DefinitionExp") ::= N("FactDefinition");
N("DefinitionExp") ::= N("RuleDefinition");
N("DefinitionExp") ::= N("ModuleDefinition");
N("DefinitionExp") ::= N("QueryDefinition");
N("DefinitionExp") ::= N("TemplateDefinition");
N("GlobalDefinition") ::= (select("varDef", N("VarDefinition")))+;
N("VarDefinition") ::= (select("jessVar", N("JessVariable")) select("eq", N("ValidIdentifier")) select("expression", N("Expression")));
N("FunctionDefinition") ::= (select("funcName", N("ValidIdentifier")) (select("parameters", N("JessVariable")))+ (select("expressions", N("Expression")))+);
N("AdviceDefinition") ::= (select("direction", N("Advice")) select("op", N("Ident")) (select("advice", N("Expression")))+);
N("UnDefAdvice") ::= select("op", N("Expression"));
N("FactDefinition") ::= (select("factName", N("ValidIdentifier")) select("documentation", N("Str")) (select("fact", N("Expression")))+);
N("RuleDefinition") ::= (select("ruleName", N("ValidIdentifier")) select("documentation", N("Str")) select("declare", N("DeclareRule")) (select("conditions", N("Expression")))+ (select("functionCall", N("UseFuncExp")))+);
N("DeclareRule") ::= (select("salience", N("Expression")) select("nodeIndexHash", N("Expression")) select("autoFocus", N("ValidIdentifier")) select("noLoop", N("ValidIdentifier")));
N("ModuleDefinition") ::= (select("moduleName", N("ValidIdentifier")) select("documentation", N("Str")));
N("QueryDefinition") ::= (select("queryName", N("ValidIdentifier")) select("documentation", N("Str")) select("declare", N("DeclareVar")) (select("expressions", N("Expression")))+);
N("DeclareVar") ::= ((select("var", N("JessVariable")))+ select("node", N("Expression")) select("max", N("Expression")));
N("TemplateDefinition") ::= (select("templateName", N("ValidIdentifier")) (select("inherits", N("ValidIdentifier")))+ select("documentation", N("Str")) select("declareBloc", N("DeclareBloc")) (select("slotDef", N("ASlotDef")))+);
N("DeclareBloc") ::= (select("slotSpecific", N("ValidIdentifier")) select("backchainReaction", N("ValidIdentifier")) select("fromClass", N("ValidIdentifier")) select("includeVariable", N("ValidIdentifier")) select("order", N("ValidIdentifier")));
N("ASlotDef") ::= N("SlotDef");
N("ASlotDef") ::= N("MultiSlotDef");
N("ASlotDef") ::= (select("slotName", N("SlotName")) (select("optionals", N("SlotOptions")))+);
N("SlotDef") ::= (select("slotName", N("SlotName")) (select("optionals", N("SlotOptions")))+);
N("MultiSlotDef") ::= (select("slotName", N("SlotName")) (select("optionals", N("SlotOptions")))+);
N("SlotOptions") ::= (select("type", N("ValidIdentifier")) select("def", N("Expression")) select("defaultDyn", N("Expression")) (select("allowedValues", N("Expression")))+);
N("UseFuncExp") ::= N("WhileExp");
N("UseFuncExp") ::= N("ForExp");
N("UseFuncExp") ::= N("ForeachExp");
N("UseFuncExp") ::= N("FuncCall");
