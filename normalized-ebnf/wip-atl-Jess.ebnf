N("UseFuncExp") ::= N("ExitExp");
N("UseFuncExp") ::= N("IfExpression");
N("WhileExp") ::= (select("hasDo", N("Boolean")) select("boolExp", N("Expression")) (select("actions", N("Expression")))+);
N("ForExp") ::= (select("initializer", N("Expression")) select("condition", N("Expression")) select("increment", N("Expression")) (select("expressions", N("Expression")))+);
N("ForeachExp") ::= (select("var", N("JessVariable")) select("list", N("Expression")) (select("expressions", N("Expression")))+);
N("FuncCall") ::= (select("funcName", N("ValidIdentifier")) (select("funcParam", N("Expression")))+);
N("EngineExp") ::= epsilon;
N("ExitExp") ::= epsilon;
N("IfExpression") ::= (select("ifthen", N("ConditionAction")) (select("elifthen", N("ElifConditionAction")))+ (select("else", N("Expression")))+);
N("ConditionAction") ::= (select("condition", N("Expression")) (select("actions", N("Expression")))+);
N("ElifConditionAction") ::= select("condAct", N("ConditionAction"));
N("Advice") ::= (select("before", epsilon) | select("after", epsilon));
