N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
N("String") ::= value("string");
N("LocatedElement") ::= N("ModelElement");
N("LocatedElement") ::= N("Metamodel");
N("ModelElement") ::= N("Classifier");
N("ModelElement") ::= N("EnumLiteral");
N("ModelElement") ::= N("StructuralFeature");
N("ModelElement") ::= N("Package");
N("Classifier") ::= N("DataType");
N("Classifier") ::= N("Enumeration");
N("Classifier") ::= N("Class");
N("Classifier") ::= (N("DataType") | N("Enumeration") | N("Class"));
N("DataType") ::= epsilon;
N("Enumeration") ::= (select("literals", N("EnumLiteral")))+;
N("EnumLiteral") ::= (select("name", N("String")) select("package", N("Package")));
N("Class") ::= (select("isAbstract", N("Boolean")) (select("supertypes", N("Class")))+ (select("structuralFeatures", N("StructuralFeature")))+);
N("StructuralFeature") ::= N("Attribute");
N("StructuralFeature") ::= N("Reference");
N("StructuralFeature") ::= (select("lower", N("Integer")) select("upper", N("Integer")) select("isOrdered", N("Boolean")) select("isUnique", N("Boolean")) select("owner", N("Class")) select("type", N("Classifier")));
N("Attribute") ::= (select("lower", N("Integer")) select("upper", N("Integer")) select("isOrdered", N("Boolean")) select("isUnique", N("Boolean")) select("owner", N("Class")) select("type", N("Classifier")));
N("Reference") ::= (select("isContainer", N("Boolean")) select("opposite", N("Reference")));
N("Package") ::= ((select("contents", N("ModelElement")))+ select("metamodel", N("Metamodel")));
N("Metamodel") ::= (select("contents", N("Package")))+;
