N("Resource") ::= (select("name", N("String")) select("type", N("String")) select("capacity", N("Integer")) select("schedulingPolicy", N("String")) select("description", N("String")) select("acquire", N("Acquire")) select("release", N("Release")));
N("Service") ::= (select("name", N("String")) select("formalParams", N("String")) select("speedAttr", N("String")) select("failAttr", N("String")) select("description", N("String")) (select("behavior", N("Behavior")))+ (select("behaviorUsed", N("Behavior")))+ (select("serviceCall", N("ServiceCall")))+);
N("Behavior") ::= N("Step");
N("Behavior") ::= (select("stepn", N("Step")) (select("stepb", N("Step")))+ select("service", N("Service")) (select("usedService", N("Service")))+ select("workLoad", N("WorkLoad")));
N("WorkLoad") ::= (select("workLoadType", N("String")) select("arrivalProcess", N("String")) select("population", N("String")) select("initialResource", N("String")) select("behavior", N("Behavior")));
N("Step") ::= N("Start");
N("Step") ::= N("End");
N("Step") ::= N("Control");
N("Step") ::= N("InternalActivity");
N("Step") ::= N("ServiceCall");
N("Step") ::= (select("name", N("String")) select("repetition", N("String")) select("internalExecTime", N("String")) select("internalFailProb", N("String")) select("completionModel", N("String")) (select("serviceCall", N("ServiceCall")))+ (select("predecessor", N("Step")))+ (select("successor", N("Step")))+ select("behavior", N("Behavior")) select("nestedBehavior", N("Behavior")));
N("Start") ::= (select("name", N("String")) select("repetition", N("String")) select("internalExecTime", N("String")) select("internalFailProb", N("String")) select("completionModel", N("String")) (select("serviceCall", N("ServiceCall")))+ (select("predecessor", N("Step")))+ (select("successor", N("Step")))+ select("behavior", N("Behavior")) select("nestedBehavior", N("Behavior")));
N("End") ::= (select("name", N("String")) select("repetition", N("String")) select("internalExecTime", N("String")) select("internalFailProb", N("String")) select("completionModel", N("String")) (select("serviceCall", N("ServiceCall")))+ (select("predecessor", N("Step")))+ (select("successor", N("Step")))+ select("behavior", N("Behavior")) select("nestedBehavior", N("Behavior")));
N("Control") ::= N("Branch");
N("Control") ::= N("Fork");
N("Control") ::= N("Join");
N("Control") ::= N("Acquire");
N("Control") ::= N("Release");
N("Control") ::= (N("Branch") | N("Fork") | N("Join") | N("Acquire") | N("Release"));
N("InternalActivity") ::= (select("name", N("String")) select("repetition", N("String")) select("internalExecTime", N("String")) select("internalFailProb", N("String")) select("completionModel", N("String")) (select("serviceCall", N("ServiceCall")))+ (select("predecessor", N("Step")))+ (select("successor", N("Step")))+ select("behavior", N("Behavior")) select("nestedBehavior", N("Behavior")));
N("ServiceCall") ::= (select("resourceType", N("String")) select("serviceName", N("String")) select("isSynch", N("Boolean")) (select("actualParam", N("ActualParam")))+ select("step", N("Step")) select("calledService", N("Service")));
N("ActualParam") ::= (select("value", N("String")) select("serviceCall", N("ServiceCall")));
N("Branch") ::= select("branchProbs", N("String"));
N("Fork") ::= epsilon;
N("Join") ::= epsilon;
N("Acquire") ::= (select("resourceUnits", N("String")) select("resource", N("Resource")));
N("Release") ::= (select("resourceUnits", N("String")) select("resource", N("Resource")));
N("String") ::= value("string");
N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
