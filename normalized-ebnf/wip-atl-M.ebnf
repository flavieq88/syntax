N("IdentifiedElement") ::= N("MElement");
N("IdentifiedElement") ::= N("Field");
N("IdentifiedElement") ::= N("Collection");
N("IdentifiedElement") ::= N("ComputedValue");
N("MElement") ::= N("Module");
N("MElement") ::= N("ModuleMember");
N("MElementReference") ::= (select("alias", N("String")) select("referencedElement", N("MElement")));
N("Module") ::= ((select("imports", N("ImportDirective")))+ (select("exports", N("ExportDirective")))+ (select("moduleMembers", N("ModuleMember")))+);
N("ModuleMember") ::= N("DerivedType");
N("ModuleMember") ::= N("Language");
N("ModuleMember") ::= N("Entity");
N("ImportDirective") ::= (select("module", N("Module")) (select("importedElements", N("MElementReference")))+);
N("ExportDirective") ::= (select("module", N("Module")) (select("exportedElements", N("ModuleMember")))+);
N("Value") ::= N("NumericalValue");
N("Value") ::= N("StringValue");
N("Value") ::= N("BooleanValue");
N("NumericalValue") ::= N("IntegerValue");
N("NumericalValue") ::= N("DecimalValue");
N("StringValue") ::= select("value", N("String"));
N("IntegerValue") ::= select("value", N("Integer"));
N("DecimalValue") ::= select("value", N("Double"));
N("BooleanValue") ::= select("value", N("Boolean"));
N("DerivedType") ::= ((select("supertypes", N("Types/TypeReference")))+ (select("fields", N("Types/Field")))+ select("initializationExpression", N("Expressions/InitializationExpression")) select("whereExpression", N("Expressions/WhereExpression")) select("expression", N("Expressions/Expression")));
N("TypeReference") ::= (select("subtype", N("Types/DerivedType")) select("field", N("Types/Field")) select("lowerBound", N("Integer")) select("upperBound", N("Integer")));
N("IntrinsicTypeReference") ::= select("typeIdentifier", N("String"));
N("DerivedTypeReference") ::= select("type", N("Types/DerivedType"));
N("Field") ::= (select("owner", N("Types/DerivedType")) select("type", N("Types/TypeReference")));
N("Collection") ::= ((select("qualifiers", N("String")))+ select("identifier", N("String")));
N("ComputedValue") ::= ((select("qualifiers", N("String")))+ select("identifier", N("String")));
N("InitializationExpression") ::= (select("type", N("Types/DerivedType")) (select("values", N("Value")))+);
N("WhereExpression") ::= (select("type", N("Types/DerivedType")) (select("queryExpressions", N("Expressions/QueryExpression")))+);
N("IdentityExpression") ::= select("identity", N("Types/Field"));
N("EqualExpression") ::= (select("leftValue", N("Expressions/ValueExpression")) select("rightValue", N("Expressions/ValueExpression")));
N("InExpression") ::= (select("value", N("Expressions/ValueExpression")) select("collection", N("Expressions/CollectionExpression")));
N("CollectionExpression") ::= (select("inExpression", N("Expressions/InExpression")) select("collectionValue", N("Expressions/ValueExpression")));
N("DefaultValueExpression") ::= epsilon;
N("StandardValueExpression") ::= (select("context", N("Expressions/ValueExpression")) select("value", N("String")));
N("Language") ::= (select("module", N("Module")));
N("Entity") ::= (select("module", N("Module")));
N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
N("String") ::= value("string");
