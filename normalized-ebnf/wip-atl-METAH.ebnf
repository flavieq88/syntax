N("METAHFile") ::= (select("entries", N("METAHEntry")))+;
N("METAHEntry") ::= N("Package");
N("METAHEntry") ::= N("PackageImplementation");
N("METAHEntry") ::= N("ProcessDeclaration");
N("METAHEntry") ::= N("ProcessImplementation");
N("METAHEntry") ::= N("Connection");
N("METAHEntry") ::= N("MacroDeclaration");
N("METAHEntry") ::= N("MacroImplementation");
N("Package") ::= (select("packName", N("String")) (select("data", N("Data")))+);
N("PackageImplementation") ::= (select("implementationName", N("String")) select("implements", N("String")) (select("attributes", N("Attribute")))+);
N("Data") ::= select("dataName", N("String"));
N("Attribute") ::= (select("attName", N("String")) select("attValue", N("Integer")) select("attValueType", N("String")) select("attType", N("String")));
N("ProcessDeclaration") ::= (select("procDecName", N("String")) (select("ports", N("Port")))+);
N("ProcessImplementation") ::= (select("procImpName", N("String")) select("declaration", N("String")) (select("processAttributes", N("ProcessAttribute")))+);
N("ProcessAttribute") ::= (select("attName", N("String")) select("attValue", N("Integer")) select("attValueType", N("String")));
N("Process") ::= (select("procName", N("String")) select("periodic", N("String")) select("declaration", N("String")) select("implementation", N("String")));
N("Port") ::= (select("portName", N("String")) select("portCom", N("String")) select("portPackage", N("String")) select("portType", N("String")));
N("Connection") ::= (select("compSrc", N("String")) select("portSrc", N("String")) select("compDest", N("String")) select("portDest", N("String")));
N("MacroDeclaration") ::= (select("name", N("String")) (select("ports", N("Port")))+);
N("MacroImplementation") ::= (select("macroImpName", N("String")) select("declaration", N("String")) (select("process", N("Process")))+ (select("connections", N("Connection")))+);
N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
N("String") ::= value("string");
