N("MaudeSpec") ::= ((select("els", N("MaudeTopEl")))+ (select("printableEls", N("MaudeTopEl")))+);
N("MaudeTopEl") ::= N("Theory");
N("MaudeTopEl") ::= N("Module");
N("MaudeTopEl") ::= N("View");
N("ModExpression") ::= N("InstModExp");
N("ModExpression") ::= N("RenModExp");
N("ModExpression") ::= N("CompModExp");
N("ModExpression") ::= N("ModuleIdModExp");
N("ModExpression") ::= N("TheoryIdModExp");
N("ModExpression") ::= N("Parameter");
N("InstModExp") ::= (select("modExp", N("ModExpression")) (select("views", N("View")))+);
N("RenModExp") ::= (select("modExp", N("ModExpression")) (select("renamings", N("RenMapping")))+);
N("CompModExp") ::= select("modExps", N("ModExpression"));
N("ModuleIdModExp") ::= select("module", N("Module"));
N("TheoryIdModExp") ::= select("theory", N("Theory"));
N("Parameter") ::= (select("label", N("String")) select("modExp", N("ModExpression")));
N("Theory") ::= N("FTheory");
N("Theory") ::= N("STheory");
N("FTheory") ::= ((select("els", N("ModElement")))+);
N("STheory") ::= ((select("els", N("ModElement")))+);
N("Module") ::= N("FModule");
N("Module") ::= N("SModule");
N("FModule") ::= ((select("els", N("ModElement")))+ (select("params", N("Parameter")))+);
N("SModule") ::= ((select("els", N("ModElement")))+ (select("params", N("Parameter")))+);
N("ModElement") ::= N("ModImportation");
N("ModElement") ::= N("SubsortRel");
N("ModElement") ::= N("Operation");
N("ModElement") ::= N("Statement");
N("ModElement") ::= N("Sort");
N("ModImportation") ::= (select("imports", N("ModExpression")) select("mode", N("ImportationMode")));
N("ImportationMode") ::= (select("protecting", epsilon) | select("including", epsilon) | select("extending", epsilon));
N("Type") ::= N("Kind");
N("Type") ::= N("Sort");
N("Sort") ::= ((select("subsortRels", N("SubsortRel")))+ (select("supersortRels", N("SubsortRel")))+ select("kind", N("Kind")));
N("Kind") ::= (select("sorts", N("Sort")))+;
N("SubsortRel") ::= ((select("subsorts", N("Sort")))+ (select("supersorts", N("Sort")))+);
N("Operation") ::= (select("name", N("String")) select("coarity", N("Type")) (select("arity", N("Type")))+ (select("atts", N("String")))+);
N("Statement") ::= N("Membership");
N("Statement") ::= N("Equation");
N("Statement") ::= N("Rule");
N("Membership") ::= (select("term", N("Term")) select("sort", N("Sort")));
N("Equation") ::= (select("lhs", N("Term")) select("rhs", N("Term")));
N("Rule") ::= (select("lhs", N("Term")) select("rhs", N("Term")));
N("Condition") ::= N("EquationalCond");
N("Condition") ::= N("RewriteCond");
N("EquationalCond") ::= N("MembershipCond");
N("EquationalCond") ::= N("BooleanCond");
N("EquationalCond") ::= N("MatchingCond");
N("EquationalCond") ::= N("EqualCond");
N("RewriteCond") ::= select("rhs", N("Term"));
N("MembershipCond") ::= select("rhs", N("Sort"));
N("BooleanCond") ::= epsilon;
N("MatchingCond") ::= select("rhs", N("Term"));
N("EqualCond") ::= select("rhs", N("Term"));
N("Term") ::= N("Constant");
N("Term") ::= N("RecTerm");
N("Term") ::= N("Variable");
N("Constant") ::= select("op", N("String"));
N("RecTerm") ::= (select("op", N("String")) (select("args", N("Term")))+);
N("Variable") ::= select("name", N("String"));
N("View") ::= (select("from", N("ModExpression")) select("to", N("ModExpression")) (select("els", N("ViewMapping")))+);
N("ViewMapping") ::= N("RenMapping");
N("ViewMapping") ::= N("TermMapping");
N("RenMapping") ::= N("SortMapping");
N("RenMapping") ::= N("OpTypedMapping");
N("RenMapping") ::= N("OpMapping");
N("RenMapping") ::= N("LabelMapping");
N("TermMapping") ::= (select("from", N("Term")) select("to", N("Term")));
N("SortMapping") ::= (select("from", N("Sort")) select("to", N("String")));
N("OpTypedMapping") ::= (select("from", N("Operation")) select("to", N("String")) (select("atts", N("String")))+);
N("OpMapping") ::= (select("from", N("Operation")) select("to", N("String")));
N("LabelMapping") ::= (select("from", N("String")) select("to", N("String")));
N("String") ::= value("string");
