N("LocatedElement") ::= N("NamedElement");
N("LocatedElement") ::= N("Expression");
N("LocatedElement") ::= N("Statement");
N("NamedElement") ::= N("Structure");
N("NamedElement") ::= N("VariableDeclaration");
N("NamedElement") ::= N("Type");
N("Structure") ::= N("ProcContainerElement");
N("Structure") ::= N("Procedure");
N("ProcContainerElement") ::= N("Program");
N("ProcContainerElement") ::= N("Monitor");
N("Program") ::= (select("monitors", N("Monitor")))+;
N("Monitor") ::= select("program", N("Program"));
N("Procedure") ::= (select("container", N("ProcContainerElement")) (select("parameters", N("Parameter")))+ (select("statements", N("Statement")))+);
N("VariableDeclaration") ::= N("Parameter");
N("VariableDeclaration") ::= (select("type", N("Type")) select("initialValue", N("Expression")) select("structure", N("Structure")));
N("Parameter") ::= (select("direction", N("Direction")) select("procedure", N("Procedure")));
N("Direction") ::= (select("in", epsilon) | select("out", epsilon));
N("Type") ::= (select("name", N("String")));
N("Expression") ::= N("VariableExp");
N("Expression") ::= N("PropertyCallExp");
N("Expression") ::= N("LiteralExp");
N("VariableExp") ::= select("declaration", N("VariableDeclaration"));
N("PropertyCallExp") ::= N("OperatorCallExp");
N("PropertyCallExp") ::= N("AttributeCallExp");
N("PropertyCallExp") ::= N("ProcedureCallExp");
N("OperatorCallExp") ::= select("right", N("Expression"));
N("AttributeCallExp") ::= (select("source", N("Expression")) select("name", N("String")));
N("ProcedureCallExp") ::= (select("arguments", N("Expression")))+;
N("LiteralExp") ::= N("BooleanExp");
N("LiteralExp") ::= N("IntegerExp");
N("BooleanExp") ::= select("symbol", N("Boolean"));
N("IntegerExp") ::= select("symbol", N("Integer"));
N("Statement") ::= N("AssignmentStat");
N("Statement") ::= N("ConditionalStat");
N("Statement") ::= N("WhileStat");
N("Statement") ::= N("ExpressionStat");
N("AssignmentStat") ::= (select("target", N("VariableExp")) select("value", N("Expression")));
N("ConditionalStat") ::= (select("condition", N("Expression")) (select("thenStats", N("Statement")))+ (select("elseStats", N("Statement")))+);
N("WhileStat") ::= (select("condition", N("Expression")) (select("doStats", N("Statement")))+);
N("ExpressionStat") ::= select("expression", N("Expression"));
N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
N("String") ::= value("string");
