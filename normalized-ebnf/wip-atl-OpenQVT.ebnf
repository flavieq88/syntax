N("Variable") ::= (select("name", N("String")) select("type", N("String")) select("value", N("String")) select("visibility", N("String")) select("context", N("Context")));
N("Context") ::= ((select("variables", N("Variable")))+ select("rule", N("Rule")));
N("Rule") ::= N("RootRule");
N("Rule") ::= N("RuleSetCall");
N("Rule") ::= N("QARule");
N("Rule") ::= (select("context", N("Context")) select("subRule", N("Rule")) select("superRule", N("Rule")) (select("services", N("Service")))+);
N("RootRule") ::= select("ruleSet", N("RuleSet"));
N("RuleSetCall") ::= select("ruleSet", N("RuleSet"));
N("QARule") ::= (select("query", N("Query")) select("action", N("Action")));
N("RuleSet") ::= select("rootRule", N("RootRule"));
N("Service") ::= N("OCLService");
N("Service") ::= N("RTransService");
N("Service") ::= N("JavaService");
N("Service") ::= (select("visibility", N("String")) select("signature", N("String")) select("rule", N("Rule")));
N("OCLService") ::= (select("visibility", N("String")) select("signature", N("String")) select("rule", N("Rule")));
N("RTransService") ::= (select("visibility", N("String")) select("signature", N("String")) select("rule", N("Rule")));
N("JavaService") ::= (select("visibility", N("String")) select("signature", N("String")) select("rule", N("Rule")));
N("RulePart") ::= N("Action");
N("RulePart") ::= N("Query");
N("Action") ::= N("RTransAction");
N("Action") ::= N("JavaAction");
N("Action") ::= select("qARule", N("QARule"));
N("RTransAction") ::= (select("qARule", N("QARule")));
N("JavaAction") ::= (select("qARule", N("QARule")));
N("Query") ::= N("OCLFilter");
N("Query") ::= N("RTransQuery");
N("Query") ::= N("JavaQuery");
N("Query") ::= N("JavaFilter");
N("Query") ::= select("qARule", N("QARule"));
N("OCLFilter") ::= (select("qARule", N("QARule")));
N("RTransQuery") ::= (select("qARule", N("QARule")));
N("JavaQuery") ::= (select("qARule", N("QARule")));
N("JavaFilter") ::= (select("qARule", N("QARule")));
N("String") ::= value("string");
