N("Element") ::= N("NamedElement");
N("Element") ::= N("RuleSet");
N("Element") ::= N("RuleAction");
N("Element") ::= N("RuleCondition");
N("Element") ::= N("Binding");
N("Element") ::= N("OclExpression");
N("Element") ::= N("VariableDeclaration");
N("Element") ::= (select("location", N("String")) (select("commentsBefore", N("String")))+ (select("commentsAfter", N("String")))+);
N("NamedElement") ::= N("Rule");
N("NamedElement") ::= N("OclType");
N("RuleSet") ::= (select("rules", N("Rule")))+;
N("Rule") ::= (select("binding", N("Binding")) select("condition", N("RuleCondition")) (select("actions", N("RuleAction")))+ select("ruleOwner", N("RuleSet")));
N("RuleAction") ::= N("DeleteAction");
N("RuleAction") ::= N("AssignAction");
N("RuleAction") ::= N("InvokeAction");
N("RuleAction") ::= N("CreateAction");
N("RuleAction") ::= select("actionOwner", N("Rule"));
N("RuleCondition") ::= (select("ruleConditionOwner", N("Rule")) select("conditionExp", N("PRRExpressions/OclExpression")));
N("Binding") ::= (select("bindingOwner", N("Rule")) (select("ruleVariable", N("RuleVariable")))+);
N("RuleVariable") ::= (select("ruleVariableOwner", N("Binding")) select("filter", N("PRRExpressions/OclExpression")));
N("DeleteAction") ::= select("objValue", N("PRRExpressions/OclExpression"));
N("CreateAction") ::= (select("insertArguments", N("PRRExpressions/OclExpression")))+;
N("AssignAction") ::= (select("objValue", N("PRRExpressions/OclExpression")) select("aValue", N("PRRExpressions/OclExpression")));
N("InvokeAction") ::= select("invocation", N("PRRExpressions/OclExpression"));
N("IteratorExp") ::= select("name", N("String"));
N("LoopExp") ::= (select("body", N("PRRExpressions/OclExpression")) (select("iterators", N("PRRExpressions/Iterator")))+);
N("OperatorCallExp") ::= epsilon;
N("OperationCallExp") ::= ((select("arguments", N("PRRExpressions/OclExpression")))+ select("operationName", N("String")) select("signature", N("String")));
N("CollectionOperationCallExp") ::= epsilon;
N("StringExp") ::= select("stringSymbol", N("String"));
N("BooleanExp") ::= select("booleanSymbol", N("Boolean"));
N("IntegerExp") ::= select("integerSymbol", N("Integer"));
N("RealExp") ::= select("realSymbol", N("Double"));
N("NavigationOrAttributeCallExp") ::= select("name", N("String"));
N("Iterator") ::= select("loopExpr", N("PRRExpressions/LoopExp"));
N("VariableDeclaration") ::= (select("type", N("PRRTypes/OclType")) select("varName", N("String")) (select("variableExp", N("PRRExpressions/VariableExp")))+);
N("VariableExp") ::= select("referredVariable", N("PRRExpressions/VariableDeclaration"));
N("TypeExp") ::= select("referredType", N("PRRTypes/OclType"));
N("AllInstanceExp") ::= select("sourceType", N("PRRTypes/OclType"));
N("OclType") ::= ((select("variableDeclaration", N("PRRExpressions/VariableDeclaration")))+ (select("oclExpression", N("PRRExpressions/OclExpression")))+ select("appliedAllInstance", N("PRRExpressions/AllInstanceExp")) (select("typeExp", N("PRRExpressions/TypeExp")))+);
N("StringType") ::= epsilon;
N("RealType") ::= epsilon;
N("BooleanType") ::= epsilon;
N("IntegerType") ::= epsilon;
N("Integer") ::= value("int");
N("String") ::= value("string");
N("Boolean") ::= ("true" | "false");
