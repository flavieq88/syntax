N("String") ::= value("string");
N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
N("Strong") ::= epsilon;
N("Start") ::= epsilon;
N("End") ::= epsilon;
N("FeedBack") ::= epsilon;
N("Weak") ::= ((select("precs", N("Precedence")))+ (select("auxTasks", N("MetaTaskOccurence")))+);
N("Grouping") ::= ((select("precs", N("Precedence")))+ (select("auxTasks", N("MetaTaskOccurence")))+);
N("Precedence") ::= N("DynPrecedence");
N("Precedence") ::= N("DerPrecedence");
N("Precedence") ::= N("BasPrecedence");
N("Precedence") ::= ((select("deprecs", N("DerPrecedence")))+ (select("parbind", N("ParBinding")))+);
