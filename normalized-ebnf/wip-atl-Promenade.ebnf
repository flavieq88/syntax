N("MetaTaskOccurence") ::= ((select("dprecs", N("DerPrecedence")))+ (select("taskCl", N("MetaTask")))+);
N("ParBinding") ::= (select("inclusion", N("Boolean")) (select("precs", N("Precedence")))+ select("targetPar", N("ParameterPrec")) select("sourcePar", N("ParameterPrec")));
N("ParameterPrec") ::= ((select("parbindsTar", N("ParBinding")))+ (select("parbindsSour", N("ParBinding")))+ (select("dstParams", N("ParameterPrec")))+ (select("orParams", N("ParameterPrec")))+);
