N("Integer") ::= value("int");
N("String") ::= value("string");
N("Boolean") ::= ("true" | "false");
N("EDataType") ::= select("value", N("String"));
N("NamedObject") ::= N("Attribute");
N("NamedObject") ::= N("Entity");
N("NamedObject") ::= N("Port");
N("NamedObject") ::= N("Relation");
N("NamedObject") ::= N("Director");
N("NamedObject") ::= select("name", N("String"));
N("Attribute") ::= N("Parameter");
N("Attribute") ::= N("ComponentEntity");
N("Attribute") ::= (select("att_container", N("Entity")) select("value", N("String")));
N("Entity") ::= ((select("attributes", N("Attribute")))+ (select("parameters", N("Parameter")))+ (select("ports", N("Port")))+);
N("Port") ::= N("ComponentPort");
N("Port") ::= (select("po_container", N("Entity")) (select("links", N("Relation")))+);
N("Relation") ::= N("ComponentRelation");
N("Relation") ::= (select("ports", N("Port")))+;
N("Director") ::= select("ca_container", N("CompositeActor"));
N("Parameter") ::= (select("pa_container", N("Entity")) select("dataType", N("EDataType")));
N("ComponentPort") ::= (select("po_container", N("Entity")) (select("links", N("Relation")))+);
N("ComponentRelation") ::= select("re_container", N("CompositeEntity"));
N("ComponentEntity") ::= N("AtomicActor");
N("ComponentEntity") ::= N("CompositeEntity");
N("ComponentEntity") ::= select("ce_container", N("CompositeEntity"));
N("AtomicActor") ::= (select("ce_container", N("CompositeEntity")));
N("CompositeEntity") ::= N("WorkSpace");
N("CompositeEntity") ::= N("CompositeActor");
N("CompositeEntity") ::= ((select("containees", N("ComponentEntity")))+ (select("relations", N("ComponentRelation")))+);
N("WorkSpace") ::= ((select("containees", N("ComponentEntity")))+ (select("relations", N("ComponentRelation")))+);
N("CompositeActor") ::= select("directors", N("Director"));
