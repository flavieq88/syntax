N("LogFile") ::= (select("file", N("String")) select("instance", N("LogFile")) select("logger", N("Logger")));
N("Logger") ::= (select("instance", N("Logger")) select("expression", N("Expression")) select("logFile", N("LogFile")));
N("Expression") ::= N("Literal");
N("Expression") ::= N("UnaryOperator");
N("Expression") ::= N("BinaryOperator");
N("Expression") ::= (select("loggingOn", N("Boolean")) select("logger", N("Logger")));
N("Literal") ::= N("VariableExpression");
N("Literal") ::= N("NumberExpression");
N("Literal") ::= select("value", N("Integer"));
N("VariableExpression") ::= select("name", N("String"));
N("NumberExpression") ::= (select("value", N("Integer")));
N("UnaryOperator") ::= N("UnaryPlusOp");
N("UnaryOperator") ::= N("UnaryMinusOp");
N("UnaryOperator") ::= select("operand", N("Expression"));
N("UnaryPlusOp") ::= (select("operand", N("Expression")));
N("UnaryMinusOp") ::= (select("operand", N("Expression")));
N("BinaryOperator") ::= N("PlusOperator");
N("BinaryOperator") ::= N("MinusOperator");
N("BinaryOperator") ::= (select("operand1", N("Expression")) select("operand2", N("Expression")));
N("PlusOperator") ::= (select("operand1", N("Expression")) select("operand2", N("Expression")));
N("MinusOperator") ::= (select("operand1", N("Expression")) select("operand2", N("Expression")));
N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
N("String") ::= value("string");
