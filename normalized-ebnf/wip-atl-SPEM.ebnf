N("Boolean") ::= ("true" | "false");
N("ArtifactUsageName") ::= (select("isInput", N("Boolean")) select("isOutput", N("Boolean")) select("hasWorkPerArtifact", N("Boolean")) select("artifactKind", N("ArtifactKind")) select("workDefinition", N("WorkDefinition")));
N("ProcessDefinitionElement") ::= N("Guidance");
N("ProcessDefinitionElement") ::= N("ArtifactKind");
N("ProcessDefinitionElement") ::= N("WorkItem");
N("ProcessDefinitionElement") ::= N("RoleKind");
N("ProcessDefinitionElement") ::= N("Condition");
N("ProcessDefinitionElement") ::= N("ProcessComponent");
N("ProcessDefinitionElement") ::= ((select("guidances", N("Guidance")))+ (select("processComponents", N("ProcessComponent")))+);
N("Guidance") ::= (select("processDefinitionElements", N("ProcessDefinitionElement")))+;
N("ArtifactKind") ::= ((select("artifactUsageNames", N("ArtifactUsageName")))+ select("responsible", N("RoleKind")));
N("WorkItem") ::= N("WorkDefinition");
N("RoleKind") ::= (select("artifactKinds", N("ArtifactKind")))+;
N("Condition") ::= N("Goal");
N("Condition") ::= N("Precondition");
N("Condition") ::= (N("Goal") | N("Precondition"));
N("ProcessComponent") ::= (select("processDefinitionElements", N("ProcessDefinitionElement")))+;
N("Goal") ::= select("workDefinition", N("WorkDefinition"));
N("Precondition") ::= select("workDefinition", N("WorkDefinition"));
N("WorkDefinition") ::= N("ActivityKind");
N("WorkDefinition") ::= N("Iteration");
N("WorkDefinition") ::= N("Phase");
N("WorkDefinition") ::= N("Lifecycle");
N("WorkDefinition") ::= ((select("artifactUsageNames", N("ArtifactUsageName")))+ select("goal", N("Goal")) select("precondition", N("Precondition")));
N("ActivityKind") ::= ((select("performer", N("RoleKind")))+ (select("assistant", N("RoleKind")))+);
N("Iteration") ::= ((select("artifactUsageNames", N("ArtifactUsageName")))+ select("goal", N("Goal")) select("precondition", N("Precondition")));
N("Phase") ::= ((select("artifactUsageNames", N("ArtifactUsageName")))+ select("goal", N("Goal")) select("precondition", N("Precondition")));
N("Lifecycle") ::= ((select("artifactUsageNames", N("ArtifactUsageName")))+ select("goal", N("Goal")) select("precondition", N("Precondition")));
