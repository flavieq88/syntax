N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
N("String") ::= value("string");
N("LocatedElement") ::= N("NamedElement");
N("LocatedElement") ::= N("TableElement");
N("LocatedElement") ::= N("Value");
N("NamedElement") ::= N("Database");
N("NamedElement") ::= N("Table");
N("NamedElement") ::= N("Type");
N("NamedElement") ::= N("Parameter");
N("Database") ::= (select("tables", N("Table")))+;
N("Table") ::= (select("database", N("Database")) (select("referencedBy", N("ForeignKey")))+ (select("elements", N("TableElement")))+ (select("parameters", N("Parameter")))+);
N("TableElement") ::= N("Column");
N("TableElement") ::= N("Key");
N("Column") ::= ((select("referencedBy", N("ForeignKey")))+ select("name", N("String")) select("type", N("Type")) select("canBeNull", N("Boolean")) select("default", N("Value")) (select("keys", N("Key")))+);
N("Key") ::= N("SimpleKey");
N("Key") ::= N("PrimaryKey");
N("Key") ::= N("ForeignKey");
N("SimpleKey") ::= (select("isUnique", N("Boolean")) select("name", N("String")) (select("columns", N("Column")))+);
N("PrimaryKey") ::= (select("isUnique", N("Boolean")) select("name", N("String")) (select("columns", N("Column")))+);
N("ForeignKey") ::= (select("referencedTable", N("Table")) (select("referencedColumns", N("Column")))+);
N("Type") ::= (select("length", N("Integer")) select("isUnsigned", N("Boolean")));
N("Parameter") ::= (select("table", N("Table")) select("value", N("Value")));
N("Value") ::= N("IntegerVal");
N("Value") ::= N("NullVal");
N("Value") ::= N("StringVal");
N("IntegerVal") ::= select("value", N("Integer"));
N("NullVal") ::= epsilon;
N("StringVal") ::= select("value", N("String"));
