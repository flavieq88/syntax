N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
N("String") ::= value("string");
N("LocatedElement") ::= N("SQLRoot");
N("LocatedElement") ::= N("Statement");
N("LocatedElement") ::= N("NamedElement");
N("LocatedElement") ::= N("WhereClause");
N("LocatedElement") ::= N("Expression");
N("SQLRoot") ::= (select("statements", N("Statement")))+;
N("Statement") ::= N("ViewStatement");
N("Statement") ::= N("InsertStmt");
N("Statement") ::= N("QueryStmt");
N("ViewStatement") ::= (select("name", N("String")) (select("columns", N("ColumnExp")))+ select("query", N("QueryStmt")));
N("InsertStmt") ::= (select("tableName", N("String")) (select("values", N("Expression")))+);
N("QueryStmt") ::= N("QueryStmtCol");
N("QueryStmt") ::= N("QueryStmtAllCol");
N("QueryStmtCol") ::= (select("columns", N("Expression")))+;
N("QueryStmtAllCol") ::= ((select("tables", N("Table")))+ select("condition", N("WhereClause")));
N("NamedElement") ::= N("Table");
N("NamedElement") ::= N("DataType");
N("NamedElement") ::= N("ColumnExp");
N("Table") ::= select("alias", N("String"));
N("WhereClause") ::= select("expression", N("Expression"));
N("Expression") ::= N("BinaryExp");
N("Expression") ::= N("NotExp");
N("Expression") ::= N("LikeExp");
N("Expression") ::= N("InExp");
N("Expression") ::= N("Predicate");
N("Expression") ::= N("QueryPredicate");
N("BinaryExp") ::= N("OrExp");
N("BinaryExp") ::= N("AndExp");
N("BinaryExp") ::= N("OperationExp");
N("OrExp") ::= (select("opName", N("String")) select("leftExp", N("Expression")) select("rightExp", N("Expression")));
N("AndExp") ::= (select("opName", N("String")) select("leftExp", N("Expression")) select("rightExp", N("Expression")));
N("NotExp") ::= (select("opName", N("String")) select("valueExp", N("Expression")) select("unused", N("Expression")));
N("LikeExp") ::= (select("columnName", N("String")) select("expression", N("StringValueExp")));
N("InExp") ::= (select("columnName", N("String")) (select("elements", N("Predicate")))+);
N("OperationExp") ::= select("optName", N("String"));
N("Predicate") ::= N("ValueExp");
N("Predicate") ::= N("ListExp");
N("Predicate") ::= N("FunctionExp");
N("Predicate") ::= N("ColumnExp");
N("QueryPredicate") ::= select("query", N("QueryStmt"));
N("ColumnExp") ::= (select("alias", N("String")) select("type", N("DataType")));
N("ValueExp") ::= N("StringValueExp");
N("ValueExp") ::= N("IntegerValueExp");
N("StringValueExp") ::= select("aValue", N("String"));
N("IntegerValueExp") ::= select("aValue", N("Integer"));
N("ListExp") ::= (select("elements", N("Expression")))+;
N("FunctionExp") ::= ((select("arguments", N("Expression")))+ select("name", N("String")));
N("DataType") ::= (select("name", N("String")));
