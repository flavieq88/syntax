N("String") ::= value("string");
N("Integer") ::= value("int");
N("Man") ::= (select("language", N("String")) select("title", N("String")) select("type", N("String")) select("date", N("String")) select("name", N("String")) select("keyword", N("String")) select("exemple", N("String")) (select("meta", N("Meta")))+);
N("Meta") ::= (select("meta", N("String")) select("path", N("String")) select("category", N("String")) select("version_CSI", N("String")) select("version_DOC", N("String")) select("author", N("String")) select("man", N("Man")));
N("Short_Description") ::= (select("name", N("String")) (select("verb", N("String")))+);
N("Calling_Sequence") ::= (select("calling_Sequence_Item", N("Calling_Sequence_Item")))+;
N("Calling_Sequence_Item") ::= ((select("calling_Sequence_Item", N("String")))+ select("calling_Sequence", N("Calling_Sequence")));
N("Param") ::= (select("target", N("InOut")) (select("param_Indent", N("Param_Indent")))+);
N("Param_Indent") ::= (select("param", N("Param")) select("param_Description", N("Param_Description")) (select("param_Item", N("Param_Item")))+);
N("Param_Item") ::= (select("label", N("String")) select("param_Indent", N("Param_Indent")) select("param_Name", N("Param_Name")) select("param_Description", N("Param_Description")));
N("Param_Name") ::= ((select("verb", N("String")))+ select("param_Item", N("Param_Item")));
N("Param_Description") ::= ((select("param_Indent", N("Param_Indent")))+ select("param_Item", N("Param_Item")));
N("Description") ::= ((select("itemize", N("Itemize")))+ (select("description_Indent", N("Description_Indent")))+);
N("Description_Indent") ::= (select("description", N("Description")) (select("description_Item", N("Description_Item")))+);
N("Description_Item") ::= (select("label", N("String")) select("description_Indent", N("Description_Indent")));
N("AIMG") ::= N("A");
N("AIMG") ::= N("Img");
N("AIMG") ::= (select("verb", N("String")))+;
N("See_Also") ::= (select("see_Also_Item", N("See_Also_Item")))+;
N("Exemple") ::= (select("exemple", N("String")) select("xml_space", N("PreDef")));
N("See_Also_Item") ::= (select("see_Also", N("See_Also")) (select("link", N("Link")))+);
N("A") ::= (select("href", N("String")) select("psppp", N("PSPPP")) select("authors_Item", N("Authors_Item")));
N("Img") ::= (select("src", N("String")) select("psppp", N("PSPPP")));
N("Biblio") ::= N("Short_Description");
N("Biblio") ::= N("Used_Functions");
N("Biblio") ::= N("Authors_Item");
N("Biblio") ::= ((select("p", N("P")))+ (select("sp", N("SP")))+ (select("pp", N("PP")))+);
N("Used_Functions") ::= N("Param_Description");
N("Used_Functions") ::= N("Description");
N("Used_Functions") ::= N("Itemize");
N("Used_Functions") ::= N("Item");
N("Used_Functions") ::= N("Section");
N("Used_Functions") ::= ((select("verbatim", N("String")))+ (select("table", N("Table")))+);
N("PSPPP") ::= N("P");
N("PSPPP") ::= N("SP");
N("PSPPP") ::= N("PP");
N("PSPPP") ::= ((select("verb", N("String")))+ (select("em", N("String")))+ (select("bd", N("String")))+ (select("tt", N("String")))+ (select("a", N("A")))+ (select("link", N("Link")))+ (select("img", N("Img")))+);
N("P") ::= select("biblio", N("Biblio"));
N("SP") ::= select("biblio", N("Biblio"));
N("PP") ::= select("biblio", N("Biblio"));
N("Itemize") ::= N("Item");
N("Itemize") ::= N("Section");
N("Itemize") ::= (select("label", N("String")) select("item", N("Item")) select("section", N("Section")) select("authors_Item", N("Authors_Item")) select("description", N("Description")));
N("Item") ::= (select("itemize", N("Itemize")))+;
N("Table") ::= ((select("table_New_Row", N("Table_New_Row")))+ select("used_Functions", N("Used_Functions")));
N("Table_New_Row") ::= ((select("table_New_Column", N("Table_New_Column")))+ select("table", N("Table")));
N("Table_New_Column") ::= ((select("Verb", N("String")))+ (select("em", N("String")))+ (select("bd", N("String")))+ (select("tt", N("String")))+ select("table_New_Row", N("Table_New_Row")));
N("Link") ::= (select("link", N("String")) select("psppp", N("PSPPP")) select("see_Also_Item", N("See_Also_Item")) select("authors_Item", N("Authors_Item")));
N("Authors") ::= (select("authors_Item", N("Authors_Item")))+;
N("Authors_Item") ::= ((select("Verb", N("String")))+ (select("em", N("String")))+ (select("bd", N("String")))+ (select("tt", N("String")))+ (select("verbatim", N("String")))+ select("label", N("String")) (select("a", N("A")))+ (select("link", N("Link")))+ select("authors", N("Authors")) (select("itemize", N("Itemize")))+);
N("Section") ::= (select("itemize", N("Itemize")))+;
N("InOut") ::= (select("in", epsilon) | select("out", epsilon));
N("PreDef") ::= (select("Preserve", epsilon) | select("Default", epsilon));
