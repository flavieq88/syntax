N("Simulink") ::= (select("subSystem", N("System")))+;
N("System") ::= (select("name", N("String")) select("simulink", N("Simulink")) select("blocks", N("Block")) select("lines", N("Line")) (select("subSystem", N("System")))+);
N("Connector") ::= N("BranchPoint");
N("Connector") ::= N("Port");
N("Connector") ::= (N("BranchPoint") | N("Port"));
N("Line") ::= (select("name", N("String")) select("block", N("Block")) select("system", N("System")));
N("BranchPoint") ::= epsilon;
N("Port") ::= N("OutPut");
N("Port") ::= N("TriggerPort");
N("Port") ::= N("EnablePort");
N("Port") ::= select("units", N("Units"));
N("Block") ::= N("Primitive");
N("Block") ::= N("Reference");
N("Block") ::= (select("description", N("String")) select("name", N("String")) select("priority", N("String")) select("natagme", N("String")) select("blockType", N("String")) (select("lines", N("Line")))+ (select("parameters", N("Parameter")))+ (select("annotations", N("Annotation")))+ (select("blockRefs", N("BlockRef")))+ select("system", N("System")));
N("BlockRef") ::= epsilon;
N("Primitive") ::= (select("deadLine", N("String")) select("period", N("String")) select("executionTime", N("String")));
N("OutPut") ::= select("number", N("Integer"));
N("TriggerPort") ::= select("triggerType", N("TriggerEnum"));
N("EnablePort") ::= select("statesWhenEnabling", N("EnableEnum"));
N("Reference") ::= (select("sourceBlock", N("String")) select("sourceType", N("String")));
N("Annotation") ::= (select("text", N("String")) select("block", N("Block")));
N("Parameter") ::= (select("value", N("String")) select("block", N("Block")));
N("Units") ::= (select("alpha", epsilon) | select("beta", epsilon));
N("TriggerEnum") ::= (select("alpha", epsilon) | select("beta", epsilon));
N("EnableEnum") ::= (select("alpha", epsilon) | select("beta", epsilon));
N("String") ::= value("string");
N("Integer") ::= value("int");
