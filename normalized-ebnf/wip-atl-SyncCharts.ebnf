N("ModelElement") ::= N("Arc");
N("ModelElement") ::= N("Vertex");
N("SyncChart") ::= (select("context", N("ModelElement")) (select("referenceState", N("ReferenceState")))+);
N("ReferenceState") ::= N("CompositeState");
N("ReferenceState") ::= (select("subSyncChart", N("SyncChart")) select("containers", N("Stg")));
N("Arc") ::= N("Transition");
N("Arc") ::= N("PseudoTransition");
N("Vertex") ::= N("PseudoState");
N("Vertex") ::= N("State");
N("PseudoState") ::= select("kind", N("PseudoStateKind"));
N("PseudoStateKind") ::= epsilon;
N("State") ::= N("SimpleState");
N("State") ::= N("CompositeState");
N("State") ::= select("isFinal", N("Boolean"));
N("SimpleState") ::= (select("isFinal", N("Boolean")));
N("CompositeState") ::= (select("canTerminate", N("Boolean")) select("isSuspendable", N("Boolean")) (select("stg", N("Stg")))+);
N("Stg") ::= (select("withFinal", N("Boolean")) select("compositeState", N("CompositeState")) (select("arc", N("Arc")))+ (select("referenceState", N("ReferenceState")))+);
N("Transition") ::= select("kind", N("TransitionKind"));
N("TransitionKind") ::= epsilon;
N("PseudoTransition") ::= select("kind", N("PseudoTransitionKind"));
N("PseudoTransitionKind") ::= epsilon;
N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
N("String") ::= value("string");
