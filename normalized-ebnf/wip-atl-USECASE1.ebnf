N("Task") ::= (select("service", N("Service")))+;
N("User") ::= ((select("useCase", N("UseCase")))+ (select("actor", N("Actor")))+);
N("Actor") ::= ((select("useCase", N("UseCase")))+ (select("goal", N("Goal")))+ (select("user", N("User")))+);
N("Goal") ::= ((select("service", N("Service")))+ (select("actor", N("Actor")))+);
N("UseCase") ::= (select("context", N("Context")) (select("service", N("Service")))+ (select("user", N("User")))+ (select("actor", N("Actor")))+);
N("Service") ::= ((select("useCase", N("UseCase")))+ (select("goal", N("Goal")))+ (select("task", N("Task")))+);
N("Scenario") ::= epsilon;
N("Context") ::= ((select("preCondition", N("PreCondition")))+ (select("postCondition", N("PostCondition")))+ (select("useCase", N("UseCase")))+);
N("PreCondition") ::= (select("context", N("Context")))+;
N("PostCondition") ::= (select("context", N("Context")))+;
N("Episode") ::= (select("event", N("Event")))+;
N("Event") ::= N("Action");
N("Event") ::= N("Responce");
N("Event") ::= N("Stimilus");
N("Event") ::= (select("episode", N("Episode")))+;
N("Action") ::= ((select("episode", N("Episode")))+);
N("Responce") ::= (select("parameter", N("Parameter")))+;
N("Stimilus") ::= (select("parameter", N("Parameter")))+;
N("Parameter") ::= ((select("stimilus", N("Stimilus")))+ (select("responce", N("Responce")))+);
N("String") ::= value("string");
N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
