N("String") ::= value("string");
N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
N("Requirement") ::= N("NonFunctionnelRequirement");
N("Requirement") ::= N("FunctionnelRequirement");
N("Requirement") ::= (N("NonFunctionnelRequirement") | N("FunctionnelRequirement"));
N("NonFunctionnelRequirement") ::= (select("scopes", N("UseCase")))+;
N("FunctionnelRequirement") ::= (select("specifies", N("UseCase")))+;
N("UseCase") ::= N("Manage");
N("UseCase") ::= ((select("scenario", N("ScenarioDescription")))+ (select("condition", N("Condition")))+ (select("interacter", N("Role")))+ (select("specified_by", N("FunctionnelRequirement")))+ (select("scoped_by", N("NonFunctionnelRequirement")))+ (select("meet_by", N("Goal")))+);
N("Goal") ::= (select("to_meet", N("UseCase")))+;
N("Role") ::= N("HumanRole");
N("Role") ::= N("SystemRole");
N("Role") ::= N("EventRole");
N("Role") ::= (select("interacted_with", N("UseCase")))+;
N("HumanRole") ::= ((select("interacted_with", N("UseCase")))+);
N("SystemRole") ::= ((select("interacted_with", N("UseCase")))+);
N("EventRole") ::= ((select("interacted_with", N("UseCase")))+);
N("Manage") ::= (select("managed_Resource", N("Resource")))+;
N("Resource") ::= epsilon;
N("ScenarioDescription") ::= select("useCase", N("UseCase"));
N("Condition") ::= N("Pre");
N("Condition") ::= N("Post");
N("Condition") ::= (select("constrained_with", N("UseCase")))+;
N("Pre") ::= ((select("constrained_with", N("UseCase")))+);
N("Post") ::= ((select("constrained_with", N("UseCase")))+);
