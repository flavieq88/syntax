N("HyperLink") ::= (select("server", N("Server/ServerPage")))+;
N("ClientPage") ::= select("hyperlink", N("HyperLink"));
N("ClientPageModule") ::= (select("consistsOf", N("Client/ClientPage")) select("representsSMP", N("Server/ServerPageModule")));
N("LogicInterface") ::= (select("represents", N("Server/LogicModule")) select("generatedBy", N("Server/Renderer")));
N("DesignElement") ::= select("represents", N("Server/DesignModule"));
N("ServerPage") ::= ((select("link", N("HyperLink")))+ (select("generates", N("Client/ClientPage")))+ (select("module", N("Server/ServerPageModule")))+);
N("ServerPageModule") ::= ((select("contains", N("Server/ServerPage")))+ select("link", N("Server/Link")) select("containsModule", N("Server/DesignModule")));
N("DesignModule") ::= epsilon;
N("LogicModule") ::= ((select("useCase", N("Server/UseCase")))+ (select("logicElement", N("Server/LogicElement")))+);
N("Link") ::= (select("page", N("Server/ServerPage")) select("posts", N("Server/Data")));
N("BeginUseCase") ::= select("useCase", N("Server/UseCase"));
N("UseCase") ::= (select("logicElem", N("Server/LogicElement")))+;
N("LogicElement") ::= ((select("uses", N("Server/UseCase")))+ select("generatedBy", N("Server/LogicElement")) select("next", N("Server/LogicElement")));
N("Alternative") ::= epsilon;
N("UserDecision") ::= (select("allows", N("Server/Alternative")))+;
N("ServerDecision") ::= select("evaluatesResultOf", N("Server/Processor"));
N("Processor") ::= ((select("persistentData", N("Server/Data")))+ (select("inputData", N("Server/Data")))+ (select("outputData", N("Server/Data")))+);
N("Renderer") ::= (select("renders", N("Server/Data")))+;
N("Data") ::= ((select("renderer", N("Server/Renderer")))+ (select("persist", N("Server/Processor")))+ (select("uses", N("Server/Processor")))+ (select("computes", N("Server/Processor")))+);
N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
N("String") ::= value("string");
