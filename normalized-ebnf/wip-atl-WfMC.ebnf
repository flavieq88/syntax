N("WorkflowProcessDefinition") ::= ((select("participantSpecificatons", N("WorkflowParticipantSpecification")))+ (select("revelantDatas", N("WorkflowRelevantData")))+ (select("applicationDeclarations", N("WorkflowApplicationDeclaration")))+ (select("processActivities", N("WorkflowProcessActivity")))+ (select("transitionInformations", N("TransitionInformation")))+);
N("WorkflowApplicationDeclaration") ::= (select("processDefinition", N("WorkflowProcessDefinition")) (select("processActivities", N("WorkflowProcessActivity")))+ (select("revelantDatas", N("WorkflowRelevantData")))+);
N("WorkflowRelevantData") ::= (select("processDefinition", N("WorkflowProcessDefinition")) (select("applicationDeclarations", N("WorkflowApplicationDeclaration")))+ (select("processActivities", N("WorkflowProcessActivity")))+ (select("participantSpecifications", N("WorkflowParticipantSpecification")))+ (select("transitionInformations", N("TransitionInformation")))+);
N("WorkflowParticipantSpecification") ::= (select("processDefinition", N("WorkflowProcessDefinition")) (select("revelantDatas", N("WorkflowRelevantData")))+ (select("processActivities", N("WorkflowProcessActivity")))+);
N("WorkflowProcessActivity") ::= (select("processDefinition", N("WorkflowProcessDefinition")) (select("applicationDeclarations", N("WorkflowApplicationDeclaration")))+ (select("revelantDatas", N("WorkflowRelevantData")))+ (select("participantSpecifications", N("WorkflowParticipantSpecification")))+ select("to_transitionInformation", N("TransitionInformation")) select("from_transitionInformation", N("TransitionInformation")));
N("TransitionInformation") ::= (select("processDefinition", N("WorkflowProcessDefinition")) (select("revelantDatas", N("WorkflowRelevantData")))+ select("to_processActivity", N("WorkflowProcessActivity")) select("from_processActivity", N("WorkflowProcessActivity")));
N("String") ::= value("string");
