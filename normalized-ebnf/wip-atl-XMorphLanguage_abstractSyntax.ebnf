N("String") ::= value("string");
N("Boolean") ::= ("true" | "false");
N("VarScope") ::= N("PatternScope");
N("VarScope") ::= N("PatternDefn");
N("VarScope") ::= N("TRule");
N("AbstractVar") ::= N("TRuleVar");
N("AbstractVar") ::= N("PatternVar");
N("AbstractVar") ::= N("ExtentVar");
N("VarUse") ::= select("var", N("AbstractVar"));
N("MOF::Property") ::= select("part", N("Key"));
N("Key") ::= ((select("property", N("MOF::Property")))+ select("transformation", N("Transformation")));
N("PatternScope") ::= N("Transformation");
N("PatternScope") ::= N("Query");
N("PatternDefn") ::= (select("scope", N("PatternScope")) (select("parameter", N("PatternVar")))+ select("body", N("Term")));
N("TRule") ::= ((select("superseded", N("TRule")))+ (select("superseder", N("TRule")))+ select("transformation", N("Transformation")) (select("extended", N("TRule")))+ (select("extender", N("TRule")))+ select("term", N("Term")) (select("tgt", N("SimpleTerm")))+);
N("Transformation") ::= ((select("keys", N("Key")))+ (select("tRule", N("TRule")))+);
N("Query") ::= (select("term", N("Term")) (select("parameter", N("PatternVar")))+);
N("Term") ::= N("CompoundTerm");
N("Term") ::= N("SimpleTerm");
N("TRuleVar") ::= ((select("superseder", N("TRuleVar")))+ (select("superseded", N("TRuleVar")))+ (select("extended", N("TRuleVar")))+ (select("extender", N("TRuleVar")))+);
N("PatternVar") ::= (select("query", N("Query")) select("patternDefn", N("PatternDefn")));
N("ExtentVar") ::= select("src", N("Term"));
N("CompoundTerm") ::= N("AndTerm");
N("CompoundTerm") ::= N("OrTerm");
N("CompoundTerm") ::= N("NotTerm");
N("CompoundTerm") ::= N("IfTerm");
N("AndTerm") ::= ((select("term", N("Term")))+);
N("OrTerm") ::= ((select("term", N("Term")))+);
N("NotTerm") ::= ((select("term", N("Term")))+);
N("IfTerm") ::= ((select("term", N("Term")))+);
N("SimpleTerm") ::= N("TrackingUse");
N("SimpleTerm") ::= N("PatternUse");
N("SimpleTerm") ::= N("MofTerm");
N("SimpleTerm") ::= N("Condition");
N("TrackingUse") ::= (select("featureNames", N("String")) select("tracking", N("MOF::Class")));
N("MOF::Class") ::= (select("tracking", N("TrackingUse")))+;
N("PatternUse") ::= (select("tRuleST", N("TRule")) (select("arg", N("Expression")))+);
N("MofTerm") ::= N("MofInstance");
N("MofTerm") ::= N("MofOrder");
N("Condition") ::= select("reason", N("String"));
N("MofInstance") ::= (select("isExactly", N("Boolean")) select("typeName", N("Expression")) select("instance", N("Expression")));
N("MofOrder") ::= (select("lesser", N("Expression")) select("instance", N("Expression")) select("greater", N("Expression")));
N("Expression") ::= N("VarUse");
N("Expression") ::= N("CoumpoundExpr");
N("Expression") ::= N("InstanceRef");
N("Expression") ::= N("MOF::Object");
N("Expression") ::= N("SimpleExpr");
N("CoumpoundExpr") ::= N("CollectionExpr");
N("CoumpoundExpr") ::= N("FunctionExpr");
N("CoumpoundExpr") ::= N("FeatureExpr");
N("CollectionExpr") ::= (select("unique", N("Boolean")) select("ordered", N("Boolean")));
N("FunctionExpr") ::= select("function", N("String"));
N("FeatureExpr") ::= (select("collect", N("String")) select("featureName", N("String")));
N("InstanceRef") ::= select("obj", N("MOF::Object"));
N("MOF::Object") ::= select("obj", N("InstanceRef"));
N("SimpleExpr") ::= N("StringConstant");
N("SimpleExpr") ::= N("IntConstant");
N("SimpleExpr") ::= N("BooleanConstant");
N("SimpleExpr") ::= N("EnumConstant");
N("StringConstant") ::= (select("representation", N("String")));
N("IntConstant") ::= (select("representation", N("String")));
N("BooleanConstant") ::= (select("representation", N("String")));
N("EnumConstant") ::= (select("representation", N("String")));
