N("Node") ::= (select("document", select("root", N("Node"))) | select("attribute", (select("namespace", N("Namespace")) select("name", value("string")) select("text", value("string")))) | select("element", (select("namespace", N("Namespace")) select("name", value("string")) select("children", (N("Node"))*))) | select("charData", select("text", value("string"))) | select("cdata", select("text", value("string"))) | select("comment", select("text", value("string"))) | select("pi", (select("target", value("string")) select("text", value("string")))) | select("entityRef", select("name", value("string"))) | select("charRef", select("code", value("int"))));
N("Namespace") ::= (select("namespace", (select("prefix", value("string")) select("uri", value("string")))) | select("none", epsilon));
