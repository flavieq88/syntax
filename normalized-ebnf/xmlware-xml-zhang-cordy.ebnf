@root N("program");

N("program") ::= (N("prolog") N("element"));
N("prolog") ::= N("dtd_body");
N("dtd_body") ::= ((N("misc"))* [N("doctypedecl")]);
N("misc") ::= (N("comment") | N("pi") | N("space") | N("newline"));
N("doctypedecl") ::= ("<!DOCTYPE" N("spaces") N("name") N("spaces") [N("sp_external_id")] N("spaces") [N("declbody")] N("spaces") ">" N("spaces"));
N("declbody") ::= ("[" (N("decl"))* "]");
N("literal") ::= (N("charlit") | N("stringlit"));
N("pi") ::= ("<?" N("pitarget") [N("sub1_pi")] "?>");
N("pitarget") ::= N("name");
N("sub1_pi") ::= (N("spaces") N("token"));
N("sub2_pi") ::= (N("token") "?>" N("token"));
N("sp_external_id") ::= (N("spaces") N("external_id"));
N("external_id") ::= (N("exid_sys") | N("exid_pub"));
N("exid_sys") ::= ("SYSTEM" N("spaces") N("literal"));
N("exid_pub") ::= ("PUBLIC" N("spaces") N("literal") N("spaces") N("literal"));
N("decl") ::= (N("markupdecl") | ("%" N("name") ";") | N("spaces"));
N("markupdecl") ::= (N("elementdecl") | N("attlistdecl") | N("entitydecl") | N("notationdecl") | N("pi") | N("comment"));
N("elementdecl") ::= ("<!ELEMENT" N("spaces") N("name") N("spaces") N("contentspec") N("spaces") ">" N("spaces"));
N("contentspec") ::= ("EMPTY" | "ANY" | N("mixed") | N("children"));
N("children") ::= (N("children_body") [N("repetition")]);
N("repetition") ::= ("?" | "*" | "+");
N("children_body") ::= (N("choice") | N("seq"));
N("choice") ::= ("(" N("spaces") N("cp") N("choice_item") (N("choice_item"))* N("spaces") ")");
N("choice_item") ::= (N("spaces") "|" N("spaces") N("cp"));
N("cp") ::= (N("cp_body") [N("repetition")]);
N("cp_body") ::= (N("name") | N("choice") | N("seq"));
N("seq") ::= ("(" N("spaces") N("cp") (N("more_cps"))* N("spaces") ")");
N("more_cps") ::= (N("spaces") "," N("spaces") N("cp"));
N("mixed") ::= (N("pcdata_or_name") | N("pcdata"));
N("pcdata_or_name") ::= ("(" N("spaces") "#PCDATA" (N("more_names"))* N("spaces") ")*");
N("more_names") ::= (N("spaces") "|" N("spaces") N("name"));
N("pcdata") ::= ("(" N("spaces") "#PCDATA" N("spaces") ")");
N("attlistdecl") ::= ("<!ATTLIST" N("spaces") N("name") (N("attdef"))* N("spaces") ">" N("spaces"));
N("attdef") ::= (N("spaces") N("name") N("spaces") N("atttype") N("spaces") N("defaultdecl"));
N("atttype") ::= (N("stringtype") | N("tokenizedtype") | N("enumeratedtype"));
N("stringtype") ::= "CDATA";
N("tokenizedtype") ::= ("ID" | "IDREF" | "IDREFS" | "ENTITY" | "ENTITIES" | "NMTOKEN" | "NMTOKENS");
N("enumeratedtype") ::= (N("notationtype") | N("enumeration"));
N("notationtype") ::= ("NOTATION" N("spaces") "(" N("spaces") N("name") (N("more_names"))* N("spaces") ")");
N("enumeration") ::= ("(" N("spaces") N("nmtoken") (N("more_nmtokens"))* N("spaces") ")");
N("nmtoken") ::= (N("name") | N("dname"));
N("more_nmtokens") ::= (N("spaces") "|" N("spaces") N("nmtoken"));
N("defaultdecl") ::= ("#REQUIRED" | "#IMPLIED" | ([N("fixed")] N("attvalue")));
N("fixed") ::= ("#FIXED" N("spaces"));
N("attvalue") ::= (N("stringlit") | N("charlit") | N("longstringlit") | N("longcharlit"));
N("longstringlit") ::= ("\"" (N("not_dquote"))* "\"");
N("not_dquote") ::= N("token");
N("longcharlit") ::= ("'" (N("not_quote"))* "'");
N("not_quote") ::= N("token");
N("entitydecl") ::= (N("gedecl") | N("pedecl"));
N("gedecl") ::= ("<!ENTITY" N("spaces") N("name") N("spaces") N("entitydef") N("spaces") ">" N("spaces"));
N("pedecl") ::= ("<!ENTITY" N("spaces") "%" N("spaces") N("name") N("spaces") N("pedef") N("spaces") ">" N("spaces"));
N("entitydef") ::= (N("entityvalue") | (N("external_id") [N("ndatadecl")]));
N("pedef") ::= (N("entityvalue") | N("external_id"));
N("ndatadecl") ::= (N("spaces") "NDATA" N("spaces") N("name"));
N("entityvalue") ::= (N("charlit") | N("stringlit") | N("longstringlit") | N("longcharlit"));
N("notationdecl") ::= ("<!NOTATION" N("spaces") N("name") N("spaces") N("exid_or_pubid") N("spaces") ">" N("spaces"));
N("exid_or_pubid") ::= (N("external_id") | ("PUBLIC" N("spaces") N("literal")));
N("spaces") ::= (N("space_or_newline"))*;
N("space_or_newline") ::= (N("space") | N("newline"));
N("element") ::= ((N("empty_elem_tag") N("spaces")) | (N("tag_content") N("spaces")));
N("tag_content") ::= (N("stag") N("IN") N("content") N("EX") N("etag"));
N("empty_elem_tag") ::= ("<" N("name") N("spaces") (N("attribute"))* "/>");
N("attribute") ::= (N("spaces") N("name") "=" N("attvalue") N("spaces"));
N("stag") ::= ("<" N("name") N("spaces") (N("attribute"))* ">");
N("content") ::= (N("spaces") (N("chardata"))* N("spaces") (N("sub1_content"))* N("spaces"));
N("sub1_content") ::= (N("spaces") N("sub2_content") N("spaces") (N("chardata"))* N("spaces"));
N("sub2_content") ::= (N("element") | N("reference") | N("cdsect") | N("pi") | N("comment") | N("regexp"));
N("chardata") ::= N("token");
N("etag") ::= ("</" N("name") N("spaces") ">");
N("cdata") ::= (N("token") | N("comment"));
N("cdend") ::= "]]>";
N("reference") ::= (("&" N("name") ";") | N("charref"));
N("cdsect") ::= ("<![CDATA[" (N("cdata"))* N("cdend"));
