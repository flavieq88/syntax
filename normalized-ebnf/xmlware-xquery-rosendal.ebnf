N("XQueryProgram") ::= (select("expressions", N("ExecutableExpression")))+;
N("Expression") ::= N("ExecutableExpression");
N("Expression") ::= N("Node");
N("Expression") ::= N("ReturnXPath");
N("Expression") ::= (select("parentNode", N("ElementNode")) select("returnEx", N("Return")));
N("ExecutableExpression") ::= N("FLWOR");
N("ExecutableExpression") ::= N("FunctionCall");
N("ExecutableExpression") ::= N("FunctionDeclaration");
N("ExecutableExpression") ::= (select("xQueryProgram", N("XQueryProgram")) select("functionDeclaration", N("FunctionDeclaration")));
N("Node") ::= N("ElementNode");
N("Node") ::= N("AttributeNode");
N("Node") ::= select("name", N("String"));
N("FLWOR") ::= (select("for", N("For")) select("let", N("Let")) select("where", N("Where")) select("orderBy", N("OrderBy")) select("return", N("Return")));
N("FunctionCall") ::= (select("name", N("String")) (select("parameters", N("XPath")))+);
N("FunctionDeclaration") ::= (select("name", N("String")) (select("expression", N("ExecutableExpression")))+);
N("ElementNode") ::= N("TextNode");
N("ElementNode") ::= (select("nodes", N("Expression")))+;
N("AttributeNode") ::= select("value", N("String"));
N("TextNode") ::= ((select("nodes", N("Expression")))+);
N("ReturnXPath") ::= N("XPath");
N("ReturnXPath") ::= select("value", N("String"));
N("XPath") ::= N("BooleanExp");
N("XPath") ::= (select("functionCall", N("FunctionCall")) select("for", N("For")) select("let", N("Let")));
N("BooleanExp") ::= select("where", N("Where"));
N("For") ::= (select("var", N("String")) select("flwor", N("FLWOR")) select("expression", N("XPath")));
N("Let") ::= (select("var", N("String")) select("flwor", N("FLWOR")) select("expression", N("XPath")));
N("Where") ::= (select("flwor", N("FLWOR")) select("expression", N("BooleanExp")));
N("OrderBy") ::= select("flwor", N("FLWOR"));
N("Return") ::= (select("flwor", N("FLWOR")) (select("expressions", N("Expression")))+);
N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
N("String") ::= value("string");
