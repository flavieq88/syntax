N("String") ::= value("string");
N("Integer") ::= value("int");
N("Boolean") ::= ("true" | "false");
N("AttributeUseType") ::= (select("null", epsilon) | select("optional", epsilon) | select("prohibited", epsilon) | select("required", epsilon));
N("AnnotedElement") ::= N("NamedElement");
N("AnnotedElement") ::= N("XSchema");
N("Annotation") ::= ((select("documentations", N("Documentation")))+ (select("applicationInfos", N("ApplicationInfo")))+ select("annotedElement", N("AnnotedElement")));
N("Documentation") ::= select("text", N("String"));
N("ApplicationInfo") ::= select("text", N("String"));
N("NamedElement") ::= N("XSchemaContentElement");
N("XSchema") ::= (select("namespace", N("String")) (select("contents", N("XSchemaContentElement")))+);
N("XSchemaContentElement") ::= N("Parameters");
N("XSchemaContentElement") ::= N("AbstractType");
N("XSchemaContentElement") ::= N("Group");
N("XSchemaContentElement") ::= N("AttributeGroup");
N("Parameters") ::= N("Element");
N("Parameters") ::= N("Attribute");
N("Element") ::= (select("references", N("ElementRef")))+;
N("Occurable") ::= N("AbstractContent");
N("Occurable") ::= N("AbstractAttributeGroupContent");
N("AbstractContent") ::= N("Container");
N("AbstractContent") ::= N("AtomicContent");
N("Container") ::= N("All");
N("Container") ::= N("Choice");
N("Container") ::= N("Sequence");
N("Container") ::= N("Group");
N("AtomicContent") ::= N("ElementRef");
N("AtomicContent") ::= N("GroupRef");
N("AtomicContent") ::= N("Element");
N("ElementRef") ::= select("referencedElement", N("Element"));
N("GroupRef") ::= select("referencedGroup", N("Group"));
N("All") ::= ((select("contents", N("AbstractContent")))+);
N("Group") ::= (select("references", N("GroupRef")))+;
N("Choice") ::= ((select("contents", N("AbstractContent")))+);
N("Sequence") ::= ((select("contents", N("AbstractContent")))+);
N("AbstractAttributeGroupContent") ::= N("AtomicAttributeGroupContent");
N("AbstractAttributeGroupContent") ::= N("AttributeGroup");
N("AttributeGroup") ::= ((select("contents", N("AbstractAttributeGroupContent")))+ (select("references", N("AttributeGroupRef")))+);
N("AttributeGroupRef") ::= select("referencedAttributeGroup", N("AttributeGroup"));
N("AtomicAttributeGroupContent") ::= N("AttributeGroupRef");
N("AtomicAttributeGroupContent") ::= N("AttributeRef");
N("AtomicAttributeGroupContent") ::= N("Attribute");
N("Attribute") ::= (select("use", N("AttributeUseType")) (select("references", N("AttributeRef")))+);
N("AttributeRef") ::= select("referencedAttribute", N("Attribute"));
N("AbstractType") ::= N("SimpleType");
N("AbstractType") ::= N("ComplexType");
N("SimpleType") ::= (select("extensions", N("ComplexTypeSimpleContent")))+;
N("ComplexType") ::= N("ComplexTypeSimpleContent");
N("ComplexType") ::= N("ComplexTypeComplexContent");
N("ComplexType") ::= ((select("extensions", N("ComplexTypeComplexContent")))+ select("content", N("AbstractContent")) (select("attributes", N("AbstractAttributeGroupContent")))+);
N("ComplexTypeSimpleContent") ::= select("base", N("SimpleType"));
N("ComplexTypeComplexContent") ::= select("base", N("ComplexType"));
