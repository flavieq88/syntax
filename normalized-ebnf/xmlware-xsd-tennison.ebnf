N("list") ::= select("list", (N("annotated") (N("localSimpleType") | select("itemType", value("string")))));
N("union") ::= select("union", (N("annotated") ((select("memberTypes", (value("string"))+) (N("localSimpleType"))*) | ([select("memberTypes", epsilon)] (N("localSimpleType"))+))));
