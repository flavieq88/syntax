@root N("stylesheet.element");
@root N("transform.element");
@root N("literal-result-element-as-stylesheet");

N("version") ::= "1.0";
N("top-level-elements.model") ::= ((N("top-level-element.category") | N("top-level-extension")))*;
N("any") ::= ((any | value("string") | N("any")))*;
N("top-level-extension") ::= N("any");
N("template.model") ::= ((N("instruction.category") | N("literal-result-element") | value("string")))*;
N("literal-result-element-as-stylesheet") ::= (select("version", N("version")) N("literal-result-element-no-version.atts") N("template.model"));
N("literal-result-element") ::= (N("literal-result-element.atts") N("template.model"));
N("literal-result-element.atts") ::= (N("literal-result-element-no-version.atts") [select("version", N("version"))]);
N("literal-result-element-no-version.atts") ::= ((N("avt.datatype") | select("extension-element-prefixes", N("prefixes.datatype")) | select("exclude-result-prefixes", N("prefixes.datatype")) | select("use-attribute-sets", N("qnames.datatype"))))*;
N("top-level-element.category") ::= (N("include.element") | N("strip-space.element") | N("preserve-space.element") | N("template.element") | N("namespace-alias.element") | N("attribute-set.element") | N("variable.element") | N("param.element") | N("key.element") | N("decimal-format.element") | N("output.element"));
N("instruction.category") ::= (N("apply-templates.element") | N("apply-imports.element") | N("call-template.element") | N("element.element") | N("attribute.element") | N("text.element") | N("processing-instruction.element") | N("comment.element") | N("copy.element") | N("value-of.element") | N("number.element") | N("for-each.element") | N("if.element") | N("choose.element") | N("variable.element") | N("copy-of.element") | N("message.element") | N("fallback.element"));
N("extension.atts") ::= (any)*;
N("stylesheet.element") ::= select("stylesheet", N("stylesheet.model"));
N("transform.element") ::= select("transform", N("stylesheet.model"));
N("stylesheet.model") ::= (N("extension.atts") [select("id", value("string"))] [select("extension-element-prefixes", N("prefixes.datatype"))] [select("exclude-result-prefixes", N("prefixes.datatype"))] select("version", N("version")) (N("import.element"))* N("top-level-elements.model"));
N("include.element") ::= select("include", (N("extension.atts") select("href", value("string"))));
N("import.element") ::= select("import", (N("extension.atts") select("href", value("string"))));
N("strip-space.element") ::= select("strip-space", (N("extension.atts") select("elements", N("wildcards.datatype"))));
N("preserve-space.element") ::= select("preserve-space", (N("extension.atts") select("elements", N("wildcards.datatype"))));
N("template.element") ::= select("template", (N("extension.atts") [select("match", N("pattern.datatype"))] [select("name", N("qname.datatype"))] [select("priority", N("number.datatype"))] [select("mode", N("qname.datatype"))] (N("param.element"))* N("template.model")));
N("apply-templates.element") ::= select("apply-templates", (N("extension.atts") [select("select", N("expression.datatype"))] [select("mode", N("qname.datatype"))] ((N("sort.element") | N("with-param.element")))*));
N("apply-imports.element") ::= select("apply-imports", N("extension.atts"));
N("call-template.element") ::= select("call-template", (N("extension.atts") select("name", N("qname.datatype")) (N("with-param.element"))*));
N("namespace-alias.element") ::= select("namespace-alias", (N("extension.atts") select("stylesheet-prefix", N("prefix.datatype")) select("result-prefix", N("prefix.datatype"))));
N("element.element") ::= select("element", (N("extension.atts") select("name", (N("qname.datatype") | N("expr-avt.datatype"))) [select("namespace", (value("string") | N("brace-avt.datatype")))] [select("use-attribute-sets", N("qnames.datatype"))] N("template.model")));
N("attribute.element") ::= select("attribute", (N("extension.atts") select("name", (N("qname.datatype") | N("expr-avt.datatype"))) [select("namespace", (value("string") | N("brace-avt.datatype")))] N("template.model")));
N("attribute-set.element") ::= select("attribute-set", (N("extension.atts") select("name", N("qname.datatype")) [select("use-attribute-sets", N("qnames.datatype"))] (N("attribute.element"))*));
N("text.element") ::= select("text", (N("extension.atts") [select("disable-output-escaping", ("yes" | "no"))] value("string")));
N("processing-instruction.element") ::= select("processing-instruction", (N("extension.atts") select("name", (value("string") | N("expr-avt.datatype"))) N("template.model")));
N("comment.element") ::= select("comment", (N("extension.atts") N("template.model")));
N("copy.element") ::= select("copy", (N("extension.atts") [select("use-attribute-sets", N("qnames.datatype"))] N("template.model")));
N("value-of.element") ::= select("value-of", (N("extension.atts") select("select", N("expression.datatype")) [select("disable-output-escaping", ("yes" | "no"))]));
N("number.element") ::= select("number", (N("extension.atts") [select("level", ("single" | "multiple" | "any"))] [select("count", N("pattern.datatype"))] [select("from", N("pattern.datatype"))] [select("value", N("expression.datatype"))] [select("format", N("avt.datatype"))] [select("lang", (value("string") | N("expr-avt.datatype")))] [select("letter-value", ("alphabetic" | "traditional" | N("expr-avt.datatype")))] [select("grouping-separator", (N("char.datatype") | N("expr-avt.datatype")))] [select("grouping-size", (N("number.datatype") | N("expr-avt.datatype")))]));
N("for-each.element") ::= select("for-each", (N("extension.atts") select("select", N("expression.datatype")) (N("sort.element"))* N("template.model")));
N("if.element") ::= select("if", (N("extension.atts") select("test", N("expression.datatype")) N("template.model")));
N("choose.element") ::= select("choose", (N("extension.atts") (N("when.element"))+ [N("otherwise.element")]));
N("when.element") ::= select("when", (N("extension.atts") select("test", N("expression.datatype")) N("template.model")));
N("otherwise.element") ::= select("otherwise", (N("extension.atts") N("template.model")));
N("sort.element") ::= select("sort", (N("extension.atts") [select("select", N("expression.datatype"))] [select("lang", (value("string") | N("expr-avt.datatype")))] [select("data-type", ("text" | "number" | N("qname-but-not-ncname.datatype") | N("expr-avt.datatype")))] [select("order", ("ascending" | "descending" | N("expr-avt.datatype")))] [select("case-order", ("upper-first" | "lower-first" | N("expr-avt.datatype")))]));
N("variable.element") ::= select("variable", (N("extension.atts") select("name", N("qname.datatype")) (select("select", N("expression.datatype")) | N("template.model"))));
N("param.element") ::= select("param", (N("extension.atts") select("name", N("qname.datatype")) (select("select", N("expression.datatype")) | N("template.model"))));
N("copy-of.element") ::= select("copy-of", (N("extension.atts") select("select", N("expression.datatype"))));
N("with-param.element") ::= select("with-param", (N("extension.atts") select("name", N("qname.datatype")) (select("select", N("expression.datatype")) | N("template.model"))));
N("key.element") ::= select("key", (N("extension.atts") select("name", N("qname.datatype")) select("match", N("pattern.datatype")) select("use", N("expression.datatype"))));
N("decimal-format.element") ::= select("decimal-format", (N("extension.atts") [select("name", N("qname.datatype"))] [select("decimal-separator", N("char.datatype"))] [select("grouping-separator", N("char.datatype"))] [select("infinity", value("string"))] [select("minus-sign", N("char.datatype"))] [select("NaN", value("string"))] [select("percent", N("char.datatype"))] [select("per-mille", N("char.datatype"))] [select("zero-digit", N("char.datatype"))] [select("digit", N("char.datatype"))] [select("pattern-separator", N("char.datatype"))]));
N("message.element") ::= select("message", (N("extension.atts") [select("terminate", ("yes" | "no"))] N("template.model")));
N("fallback.element") ::= select("fallback", (N("extension.atts") N("template.model")));
N("output.element") ::= select("output", (N("extension.atts") [select("method", ("xml" | "html" | "text" | N("qname-but-not-ncname.datatype")))] [select("version", value("string"))] [select("encoding", value("string"))] [select("omit-xml-declaration", ("yes" | "no"))] [select("standalone", ("yes" | "no"))] [select("doctype-public", value("string"))] [select("doctype-system", value("string"))] [select("cdata-section-elements", N("qnames.datatype"))] [select("indent", ("yes" | "no"))] [select("media-type", value("string"))]));
N("prefixes.datatype") ::= ((value("string") | "#default"))*;
N("prefix.datatype") ::= (value("string") | "#default");
N("wildcards.datatype") ::= (value("string"))*;
N("qname.datatype") ::= value("string");
N("qnames.datatype") ::= (value("string"))*;
N("char.datatype") ::= value("string");
N("number.datatype") ::= value("int");
N("expression.datatype") ::= value("string");
N("pattern.datatype") ::= value("string");
N("qname-but-not-ncname.datatype") ::= value("string");
N("expr-avt.datatype") ::= value("string");
N("brace-avt.datatype") ::= value("string");
N("avt.datatype") ::= value("string");
