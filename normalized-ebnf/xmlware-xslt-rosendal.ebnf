N("Boolean") ::= ("true" | "false");
N("Integer") ::= value("int");
N("String") ::= value("string");
N("Node") ::= N("ElementNode");
N("Node") ::= N("AttributeNode");
N("ElementNode") ::= N("RootNode");
N("ElementNode") ::= N("TextNode");
N("ElementNode") ::= N("XSLTNode");
N("ElementNode") ::= (select("nodes", N("Node")))+;
N("AttributeNode") ::= (select("name", N("String")) select("parentNode", N("ElementNode")));
N("RootNode") ::= N("XSLTRootNode");
N("RootNode") ::= select("document", N("Document"));
N("TextNode") ::= select("value", N("String"));
N("XSLTNode") ::= N("ApplyTemplates");
N("XSLTNode") ::= N("If");
N("XSLTNode") ::= N("Template");
N("XSLTNode") ::= N("ValueOf");
N("XSLTNode") ::= N("When");
N("XSLTNode") ::= N("Choose");
N("XSLTNode") ::= N("Otherwise");
N("XSLTNode") ::= N("Sort");
N("XSLTRootNode") ::= (select("document", N("Document")));
N("Document") ::= (select("documentName", N("String")) select("document", N("RootNode")));
N("ApplyTemplates") ::= select("select", N("String"));
N("If") ::= select("test", N("String"));
N("Template") ::= select("match", N("String"));
N("ValueOf") ::= select("select", N("String"));
N("When") ::= select("test", N("String"));
N("Choose") ::= (select("when", N("When")) select("otherwise", N("Otherwise")));
N("Otherwise") ::= epsilon;
N("Sort") ::= select("select", N("String"));
